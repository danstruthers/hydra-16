# The build's: node build.js makes them.  The ROM images (the BIOS ROM's, one for each serial chip, and the paged
# ROM's) are kept, for programming the chips without a toolchain: rebuild and commit them with a change to the kernel
/obj/
/bin/*
!/bin/bios_rockwell.bin
!/bin/bios_wdc.bin
!/bin/prom*.bin
