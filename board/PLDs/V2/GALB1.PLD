Name     GALB1 ;
PartNo   ATF22V10C ;
Date     10/4/2026 ;
Revision 01 ;
Designer Engineer ;
Company  Data Tuning ;
Assembly Hydra 16 V2 ;
Location U82 ;
Device   g22v10 ;

/* GAL B1 - $FFFx page: OS ROM select, vector RAM select, register selects and latch strobes
   (replaces U18, U47, U48 and parts of U9/U14/U15) */

/* *************** INPUT PINS *********************/
PIN 1  = PHI1 ;       /* inverted PHI2 (U19)                 */
PIN 2  = RWB ;
PIN 3  = RESB ;
PIN 4  = nIOP15_S ;   /* $FFF0-$FFFF from GAL A               */
PIN 5  = nOSR1 ;      /* $E000-$FEFF from GAL A               */
PIN 6  = A3 ;
PIN 7  = A2 ;
PIN 8  = A1 ;
PIN 9  = A0 ;

/* *************** OUTPUT PINS *********************/
PIN 23 = nOSR_S ;     /* OS ROM /CE: $E000-$FEFF and $FFFA-$FFFD  */
PIN 22 = nVEC_S ;     /* vector RAM /CE: $FFFE-$FFFF              */
PIN 21 = nFFF0_S ;    /* register read selects (541 G2)           */
PIN 20 = nFFF1_S ;
PIN 19 = nFFF2_S ;
PIN 18 = nFFF3_S ;
PIN 17 = FFF0_L ;     /* register latch enables (573 LE), active high */
PIN 16 = FFF1_L ;
PIN 15 = FFF2_L ;
PIN 14 = FFF3_L ;

FIELD lo = [A3..A0] ;

fffx = !nIOP15_S ;
wrq  = !PHI1 & !RWB & RESB ;      /* PHI2-qualified write, blocked during reset */

!nOSR_S  = !nOSR1 # (fffx & A3 & (A2 $ A1)) ;
!nVEC_S  = fffx & lo:[E..F] ;
!nFFF0_S = fffx & lo:0 ;
!nFFF1_S = fffx & lo:1 ;
!nFFF2_S = fffx & lo:2 ;
!nFFF3_S = fffx & lo:3 ;
FFF0_L   = fffx & lo:0 & wrq ;
FFF1_L   = fffx & lo:1 & wrq ;
FFF2_L   = fffx & lo:2 & wrq ;
FFF3_L   = fffx & lo:3 & wrq ;
