Name     GALC ;
PartNo   ATF22V10C ;
Date     10/6/2026 ;
Revision 01 ;
Designer Engineer ;
Company  Data Tuning ;
Assembly Hydra 16 V2 ;
Location U88 ;
Device   g22v10 ;

/* GAL C - bus clock generator with clock stretching (replaces the U35 74F191 divider and the J36 clock mux)
   Clocked by the 14.31818 MHz master (one period = 69.8 ns).
   Normal cycle: PHI2 low 1 period, high 1 period (7.16 MHz).
   Slow regions (banked RAM $8000-$9FFF, banked ROM $A000-$DFFF, slot I/O $FF20-$FFEF):
     PHI2-low is always extended by 1 period (addresses, bank registers and chip selects settle
     before PHI2 rises), and PHI2-high is extended by N1:N0 periods (0-3, from GAL D / register $FFF5).
   nHALF low (J36 2-3): every phase is twice as long (3.58 MHz base, for Rockwell parts).
   PHI1 is the complement of PHI2, generated by an identical register so the two switch together.
   SND is a free-running 3.579545 MHz clock for the YM2151 and the slots. */

/* *************** INPUT PINS *********************/
PIN 1  = CLK14 ;      /* 14.31818 MHz (HS_CLK_SRC)                       */
PIN 2  = A15 ;
PIN 3  = A14 ;
PIN 4  = A13 ;
PIN 5  = nIOSLOW ;    /* $FF20-$FFEF from GAL A                          */
PIN 6  = N0 ;         /* extra PHI2-high periods for this access (GAL D) */
PIN 7  = N1 ;
PIN 8  = nHALF ;      /* J36: high = 7.16 MHz, low = 3.58 MHz            */

/* *************** OUTPUT PINS *********************/
PIN 21 = PHI2 ;
PIN 16 = !PH2B ;      /* pin is PHI1 = !PHI2                             */
PIN 22 = SND ;        /* 3.579545 MHz                                    */
PIN 23 = F0 ;         /* 7.16 MHz free-running (half-speed timebase; test point) */
PIN 19 = K0 ;         /* period counter within the current phase (test points)   */
PIN 18 = K1 ;

tick = nHALF # F0 ;                                   /* edge on which the bus clock may change   */
slow = A15 & !A14 # A15 & !A13 # !nIOSLOW ;           /* banked RAM/ROM or slot I/O                */
lt   = !K1 & N1 # !K1 & !K0 & N0 # !K0 & N1 & N0 ;    /* K < N: more PHI2-high periods requested   */

/* low phase: rise after one period, or after two for a slow region (K0 marks the extra period)
   high phase: stay high while K < N, then fall */
PHI2.d = !PHI2 & tick & K0
       # !PHI2 & tick & !slow
       #  PHI2 & !tick
       #  PHI2 & lt ;
PH2B.d = !PHI2 & tick & K0
       # !PHI2 & tick & !slow
       #  PHI2 & !tick
       #  PHI2 & lt ;

K0.d = !tick & K0
     # tick & !PHI2 & !K0 & slow
     # tick &  PHI2 & !K0 & lt ;
K1.d = !tick & K1
     # tick &  PHI2 & lt & (K1 $ K0) ;

F0.d  = !F0 ;
SND.d = SND $ F0 ;

[PHI2, PH2B, K0, K1, F0, SND].ar = 'b'0 ;
[PHI2, PH2B, K0, K1, F0, SND].sp = 'b'0 ;
