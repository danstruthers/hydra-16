Name     GALD ;
PartNo   ATF22V10C ;
Date     10/6/2026 ;
Revision 02 ;
Designer Engineer ;
Company  Data Tuning ;
Assembly Hydra 16 V2 ;
Location U84 ;
Device   g22v10 ;

/* GAL D - clock-stretch control register $FFF5 (write-only, cleared by RESB)
     bits 1:0 banked RAM $8000-$9FFF, bits 3:2 banked ROM $A000-$DFFF, bits 5:4 slot I/O $FF20-$FFEF.
   Extra PHI2-high periods for the current access: N = 3 - field (each period 69.8 ns at 7.16 MHz).
   Reset leaves every field at 0 = 3 extra periods (slowest). GAL C also adds one fixed address-setup
   period to every access in these regions. */

/* *************** INPUT PINS *********************/
PIN 1  = PHI1 ;       /* clock: rising edge = end of PHI2-high         */
PIN 2  = D0 ;
PIN 3  = D1 ;
PIN 4  = D2 ;
PIN 5  = D3 ;
PIN 6  = D4 ;
PIN 7  = D5 ;
PIN 8  = nWSWR ;      /* $FFF5 write, from GAL B2                      */
PIN 9  = nBRA_S ;
PIN 10 = nBRO_S ;
PIN 11 = nIOSLOW ;
PIN 13 = RESB ;

/* *************** OUTPUT / BURIED PINS ***************/
PIN 23 = N0 ;         /* extra PHI2-high periods for this access, to GAL C */
PIN 22 = N1 ;
PIN 19 = WS5 ;        /* buried: stretch register                      */
PIN 18 = WS4 ;
PIN 17 = WS3 ;
PIN 16 = WS2 ;
PIN 15 = WS1 ;
PIN 14 = WS0 ;

/* N = 3 - field = bitwise complement of the 2-bit field of the selected region (0 outside slow regions) */
N0 = !nBRA_S & !WS0 # !nBRO_S & !WS2 # !nIOSLOW & !WS4 ;
N1 = !nBRA_S & !WS1 # !nBRO_S & !WS3 # !nIOSLOW & !WS5 ;

/* stretch register: loaded at the end of PHI2 of a write to $FFF5 */
WS0.d = !nWSWR & D0 # nWSWR & WS0 ;
WS1.d = !nWSWR & D1 # nWSWR & WS1 ;
WS2.d = !nWSWR & D2 # nWSWR & WS2 ;
WS3.d = !nWSWR & D3 # nWSWR & WS3 ;
WS4.d = !nWSWR & D4 # nWSWR & WS4 ;
WS5.d = !nWSWR & D5 # nWSWR & WS5 ;

[WS0..5].oe = 'b'0 ;          /* buried registers: pins not driven */
[WS0..5].ar = !RESB ;         /* reset -> field 0 = 3 extra periods everywhere */
[WS0..5].sp = 'b'0 ;
