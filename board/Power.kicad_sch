	(text "SOFT POWER (J37): 1-2 = momentary case button on J7 pins 11/9 toggles the PSU;\n2-3 = latching switch drives PS_ON# directly.\nU78 (74HC14) and U79 (74HC74) run from +5V standby. R20/C112 hold U79 cleared at mains power-up (PSU stays off).\nU78B drives PS_ON# (push-pull) through J37 1-2."
		(exclude_from_sim no)
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "64510988-37ea-410a-9c49-ef8819df0ccc")
	)
