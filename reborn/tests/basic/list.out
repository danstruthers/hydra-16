
10 PRINT "hello, World":REM a comment, Kept AS typed
20 FOR I=1TO10STEP2:NEXT I
30 IF A=1 THEN 10
40 DATA abc, "d e",1:REM not a keyword: print
50 PRINT "short form"
60 GOSUB 100: RETURN
70 X=5 AND 3 OR NOT1
80 A$=LEFT$("ab",1)+RIGHT$("ab",1)+MID$("abc",2,1)+CHR$(65)+STR$(1)
90 REM print goto 10 "quoted"
100 PRINT "rem in a string: print goto"
110 GOSUB100:GOTO10
120 LOVELY=1:FORTY=2
130 X = 1 :  Y=2
140 RESTORE:CLEAR:RESTORE:CLEAR
150 PRINTTAB(5)SPC(2)"x"
160 IFX>=1ANDY<=2ORZ<>3THEN170
170 END
180 PRINT "leading spaces dropped"
190 A=FNB(2)+SGN(-1)+INT(1)+ABS(1)+USR(1)+FRE(0)+POS(0)
200 A=SQR(1)+RND(1)+LOG(1)+EXP(1)+COS(1)+SIN(1)+TAN(1)+ATN(1)
210 A=PEEK(1)+LEN("")+VAL("1")+ASC("a")+EOF(1):B$=STR$(1)+CHR$(1)+ENV$("a")
220 OPEN 1,"x","w":CLOSE 1:SOUND 1,60:BEEP:SLEEP 1:SYS 1:RREG A:HIMEM 40000
230 LOAD "x":SAVE "x",B:BYE:NEW:LIST:CONT:GET A$:POKE 1,2:WAIT 1,2:DEF FNA(X)=X:ON X GOTO 10
240 INPUT A:READ B:DIM C(1):LET D=1:STOP:GO TO 10
250 NOTHING$ = "a"
50 PRINT "short form"

