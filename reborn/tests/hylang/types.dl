; types.dl - type-of, the type tests, symbols and atoms (to-sym, to-atom, gensym), defined?

(check (type-of 1) :number)
(check (type-of 1.5) :number)
(check (type-of "s") :string)
(check (type-of \c) :char)
(check (type-of :a) :atom)
(check (type-of (to-sym "s")) :symbol)
(check (type-of +) :function)
(check (type-of (fn {} {1})) :function)
(check (type-of (fexpr {} {1})) :function)
(check (type-of (error "e")) :error)
(check (type-of T) :t)
(check (type-of {1}) :list)
(check (type-of NIL) :list)
(check (type-of #()) :hash)
(check (type-of stdout) :stream)
(check (type-of (item-at {(a b)} 0)) :sexpr)

(check (t? T) T)
(check (t? 1) NIL)
(check (nil? NIL) T)
(check (nil? 0) NIL)
(check (atom? :a) T)
(check (atom? "a") NIL)
(check (symbol? (to-sym "a")) T)
(check (string? "a") T)
(check (string? \a) NIL)
(check (char? \a) T)
(check (function? +) T)
(check (function? 1) NIL)
(check (error? (error "x")) T)
(check (error? 1) NIL)
(check (qexpr? {1}) T)
(check (qexpr? 1) NIL)
(check (sexpr? (item-at {(a b)} 0)) T)
(check (sexpr? {}) NIL)
(check (expr? 1) T)

; symbols and atoms
(check (to-sym :abc) (to-sym "abc"))
(check (to-sym "ABC") (to-sym "abc"))
(check (to-atom "ab") :ab)
(check (to-atom (to-sym "x")) :x)
(check (to-atom 5) (to-atom "5"))
(check-error (to-sym 5))
(check-error (to-atom {1}))
(check (symbol? (gensym)) T)
(check (eq (gensym) (gensym)) NIL)
(check (eq (gensym "tmp") (gensym "tmp")) NIL)
(check (eval (to-sym "+")) +)

; defined?
(check (defined? +) T)
(check (defined? ty-never-defined) NIL)
(check (defined? {+ -}) T)
(check (defined? {+ ty-never-defined}) NIL)
(check (defined? T) T)
(fun {ty-has-second} {defined? &2})
(check (ty-has-second 1) NIL)
(check (ty-has-second 1 2) T)
(fun {ty-in-let} {let {{x 1}} (defined? &1)})
(check (ty-in-let 5) T)
(check (ty-in-let) NIL)
