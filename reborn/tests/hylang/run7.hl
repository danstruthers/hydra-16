; run7.hl - hylang's own: run.dl's files, as run.dl runs them (a script: hylang run7.hl, args its name), with
; danlang's library loaded first (globals.dl: the test's card has it as /lib/hylang/globals.hl, as it has dice.dl and
; screen.dl), which phase 8 puts in hylang itself; each file's checks in turn (a file that stops with an error counts
; as a failure), then a tail loop of 50,000 steps, and the count; its status 1 if a check failed
(def {regress-dir} (do
  =(here (fst args))
  =(cut (max (last-index-of here "/") (last-index-of here "\\")))
  (substring here 0 (+ cut 1))))
(load "globals")
(load (+ regress-dir "harness.dl"))
(each {f {"reader" "eval" "scope" "control" "errors" "lists" "strings" "numbers" "hashes" "types" "io" "system" "bits" "library"}}
  (def {test-file} f)
  (try (load (+ regress-dir f ".dl"))
    (do
      (def {test-fails} (+ test-fails 1))
      (print (format "FAIL {}: stopped: {}" f &err)))))
(fun {run7-tail n} ?{(zero? n) :done (run7-tail (- n 1))})
(def {test-file} "run7")
(check (run7-tail 50000) :done)
(print (format "{} checks, {} failed" test-count test-fails))
(exit ?((zero? test-fails) 0 1))
