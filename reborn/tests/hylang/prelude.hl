; prelude.hl - hylang's own: what the suite's files want of danlang's globals.dl that hylang doesn't load yet (it
; loads globals.hl from phase 8): unpack (and so the . shorthand), cond, case; each as globals.dl defines it
(fun {unpack f l} {eval (cons f l)})
(fun {cond} ?{
  &_
  ?((eval (head (fst &_)))
    (eval (head (tail (fst &_))))
    .(cond (tail &_)))
  (error "Selection not found")
})
(fun {case x} ?{
  &_
  ?((eq x (eval (head (fst &_))))
    (eval (head (tail (fst &_))))
    .(case (cons x (tail &_))))
  (error "Case not found")
})
