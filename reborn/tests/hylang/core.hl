; core.hl - hylang's own checks, run with the suite's harness.dl: what eval.dl checks, at sizes the emulated test has
; time for (eval.dl's loops go 50,000 times: 4,675M cycles, 22 minutes at 3.58 MHz), and what's hylang's own

; tail calls: a call in tail position (a function's last, through if, do, let and eval) takes its caller's place, so
; these loops take no more of the evaluation stack (16K: some 1300 calls nested) than one call; past fixnums too
(fun {c-loop n} ?{(zero? n) :done (c-loop (- n 1))})
(check (c-loop 3000) :done)
(fun {c-loop-do n} ?{(zero? n) :done (do (+ 1 1) (c-loop-do (- n 1)))})
(check (c-loop-do 3000) :done)
(fun {c-loop-let n} {let {{m (- n 1)}} ?((< m 0) :done (c-loop-let m))})
(check (c-loop-let 3000) :done)
(fun {c-loop-eval n} ?{(zero? n) :done (eval {c-loop-eval (- n 1)})})
(check (c-loop-eval 2000) :done)
(fun {c-even n} ?{(zero? n) T (c-odd (- n 1))})
(fun {c-odd n} ?{(zero? n) NIL (c-even (- n 1))})
(check (c-even 3001) NIL)
(check (c-even 3000) T)
(fun {c-sum-to n acc} ?{(zero? n) acc (c-sum-to (- n 1) (+ acc n))})
(check (c-sum-to 100 0) 5050)
(fun {c-down n} ?{(< n 16380) :done (c-down (- n 1))})
(check (c-down 16390) :done)
(check (c-sum-to 200 16383) 36483)

; depth: calls that aren't in tail position nest as deep as the stack (or the heap) holds; deeper is an error
(fun {c-deep n} ?{(zero? n) 0 (+ 1 (c-deep (- n 1)))})
(check (c-deep 1000) 1000)
(check-error (c-deep 16000))

; equality and order, of lists too
(check (eq {1 {2 "x"} :a} {1 {2 "x"} :a}) T)
(check (eq {1 2} {1 2 3}) NIL)
(check (eq (fn {a} {a}) (fn {a} {a})) T)
(check (cmp {1 9} {1 10}) -1)
(check (cmp "b" "a") 1)
(check (< \a \b) T)

; output caught, nested; a value's text
(check (output-of (write "a" (output-of (write "b")) "c")) "abc")
(check (output-of (print 1 "x" {2 "y"})) "1 x {2 \"y\"}\n")
(check (repr "a\nb") "\"a\\nb\"")
(check (to-str {1 "a" \b}) "{1 \"a\" \\b}")

; eval.dl's checks of a built-in partially applied, and of too many arguments
(check ((eq 1) 1) T)
(check ((substring "hello") 1) "ello")
(check ((item-at {10 20 30}) 2) 30)
(check (function? (len)) T)
(check (map (eq 2) {1 2}) {NIL T})
(check (repr (eq 1)) "<function>(eq 1)")
(check (eq (eq 1) (eq 1)) T)
(check (eq (eq 1) (eq 2)) NIL)
(check-error (if T))
(check-error (len {1} 2))
(check-error ((substring "hello") 1 2 3))
(check-error (if T 1 2 3))
(check-error ((fn {x} {x}) 1 2))
(check ((fn {x} {&_}) 1 2 3) {2 3})
(check ((fn {x} {&2}) 1 :b) :b)

; library.dl's checks of the library's functions built in (library.dl runs from 7.4c): an item as it's written
(check (fst {zz-never-defined 2}) (to-sym "zz-never-defined"))
(check (sexpr? (snd {1 (+ 1 2)})) T)
(check (eq (fst {+ 2}) +) NIL)
(check (map type-of {a 1 "s"}) {:symbol :number :string})
(check-error (fst {}))
(check-error (nth 2 {1 2}))
(check-error (nth -1 {1 2}))
(check-error (last {}))
(check (map (nth 1) {{1 2} {3 4}}) {2 4})
(check ((foldl +) 0 {1 2}) 3)
(check (function? (map 1+)) T)
(check (take -1 {1 2}) {1 2})
(check-error (fst {1} {2}))
(check (foldr - 0 {1 2 3}) 2)
(check (filter neg? {1 -2 3 -4}) {-2 -4})
(check (find neg? {1 -2 -3}) -2)
(check (count num? {1 :a 2}) 2)
(check (sum {1 2 3}) 6)
(check (min 3 1 2) 1)
(check (abs -5) 5)
(fun {c-cl x} {cond {(< x 0) :neg} {(> x 0) :pos} {T :zero}})
(check (c-cl 0) :zero)
(check (c-cl 5) :pos)
