; system.dl - the system library: files and directories, glob, programs and the shell, the environment, the clock,
; error codes, and where it's running.  The same checks hold on a PC (danlang) and on the Hydra (hylang)

(def {sy-dir} (+ regress-dir "sys.tmp"))
(fun {sy-rm-tree p} ?{
  (dir? p)
  (do (each {n (ls p)} (sy-rm-tree (+ p "/" n))) (remove p))
  (if (exists? p) (remove p))
})
(sy-rm-tree sy-dir)

; directories
(check (exists? sy-dir) NIL)
(check (mkdir sy-dir) NIL)
(check (dir? sy-dir) T)
(check (file? sy-dir) NIL)
(check (error-code (mkdir sy-dir)) :exist)
(check (error-code (mkdir (+ sy-dir "/no/such"))) :noent)

; files
(def {sy-a} (+ sy-dir "/a.txt"))
(check (write-file sy-a "one\n" 2 "\n") NIL)
(check (read-file sy-a) "one\n2\n")
(append-file sy-a "three")
(check (read-file sy-a) "one\n2\nthree")
(check (read-lines sy-a) {"one" "2" "three"})
(check (file? sy-a) T)
(check (exists? sy-a) T)
(check ((stat sy-a) :name) "a.txt")
(check ((stat sy-a) :length) 11)
(check ((stat sy-a) :dir) NIL)
; a file is bytes: what's written is read back as it was, a character a byte
(def {sy-u} (+ sy-dir "/u.txt"))
(write-file sy-u "a\xC3\xA9\xff")
(check (read-file sy-u) "a\xC3\xA9\xff")
(check ((stat sy-u) :length) 4)
(check (bytes (read-file sy-u)) {97 195 169 255})
(remove sy-u)
(check ((stat sy-dir) :dir) T)
(check (< (abs (- ((stat sy-a) :mtime) (time))) 100) T)
(write-file (+ sy-dir "/b.txt") "b")
(mkdir (+ sy-dir "/sub"))
(check (ls sy-dir) {"a.txt" "b.txt" "sub"})
(check (map (fn {s} {(s :name)}) (dir sy-dir)) {"a.txt" "b.txt" "sub"})
(check (ls sy-a) {"a.txt"})

; glob: rc's patterns
(check (glob (+ sy-dir "/*.txt")) (list sy-a (+ sy-dir "/b.txt")))
(check (glob (+ sy-dir "/[a]*")) (list sy-a))
(check (glob (+ sy-dir "/?.txt")) (list sy-a (+ sy-dir "/b.txt")))
(check (glob (+ sy-dir "/[~a]*")) (list (+ sy-dir "/b.txt") (+ sy-dir "/sub")))
(check (glob (+ sy-dir "/[a-b].txt")) (list sy-a (+ sy-dir "/b.txt")))
(check (glob (+ sy-dir "/none*")) {})
(check (glob sy-a) (list sy-a))

; rename, copy, remove
(check (rename (+ sy-dir "/b.txt") (+ sy-dir "/c.txt")) NIL)
(check (exists? (+ sy-dir "/b.txt")) NIL)
(check (read-file (+ sy-dir "/c.txt")) "b")
(check (error-code (rename (+ sy-dir "/nope") (+ sy-dir "/x"))) :noent)
(check (error-code (rename sy-a (+ sy-dir "/c.txt"))) :exist)
(copy-file sy-a (+ sy-dir "/d.txt"))
(check (read-file (+ sy-dir "/d.txt")) (read-file sy-a))
(check (error-code (remove (+ sy-dir "/nope"))) :noent)
(write-file (+ sy-dir "/sub/x") "x")
(check (error-code (remove (+ sy-dir "/sub"))) :notempty)
(remove (+ sy-dir "/sub/x"))
(check (remove (+ sy-dir "/sub")) NIL)
(check (exists? (+ sy-dir "/sub")) NIL)

; errors: the Hydra's, a code (error-code) and a text after the name
(check (error-code (read-file (+ sy-dir "/nope"))) :noent)
(check (ends-with? (error-message (read-file (+ sy-dir "/nope"))) "nope: not found") T)
(check (error-code (read-file sy-dir)) :isdir)
(check (error-code (open (+ sy-dir "/nope"))) :noent)
(check (error-code (load (+ sy-dir "/nope.dl"))) :noent)
(check (error-code (stat (+ sy-dir "/nope"))) :noent)
(check (error-code (ls (+ sy-dir "/nope"))) :noent)
(check (error-code (read-lines (+ sy-dir "/nope"))) :noent)
(check-error (write-file (+ sy-dir "/no/such/file") "x"))

; the current directory
(def {sy-home} (cwd))
(check (string? sy-home) T)
(cd sy-dir)
(check (try (ls) &err) {"a.txt" "c.txt" "d.txt"})
(check (try (exists? "a.txt") &err) T)
(cd sy-home)
(check (cwd) sy-home)
(check (error-code (cd (+ sy-dir "/no-such-dir"))) :noent)
(check (error-code (cd sy-a)) :notdir)

(sy-rm-tree sy-dir)
(check (exists? sy-dir) NIL)

; programs and the shell (rc on the Hydra; cmd or sh here)
(check (sh "exit 3") 3)
(check (sh "exit 0") 0)
(check (sh-out "echo hi") "hi\n")
(check (sh-out "sort" "b\na\n") "a\nb\n")
(check (error-code (run "no-such-program-at-all")) :noent)
(def {sy-shell} (cond {(hydra?) {"rc" "-c"}} {(eq (platform) :windows) {"cmd.exe" "/c"}} {T {"/bin/sh" "-c"}}))
(check (run (fst sy-shell) (snd sy-shell) "exit 4") 4)
(check (wait (spawn (fst sy-shell) (snd sy-shell) "exit 2")) 2)
(check (error-code (wait 30000)) :child)
(check (error-code (spawn "no-such-program-at-all")) :noent)
(check (num? (pid)) T)

; the environment
(setenv :hylang_test "value")
(check (env :hylang_test) "value")
(check (env "hylang_test") "value")
(check ((env) "hylang_test") "value")
; $name: (env "name"), the name as it's written (its case kept), read as that
(check (read "$hylang_test") {(env "hylang_test")})
(check (read "$Mixed_Case") {(env "Mixed_Case")})
(check (read "($a $b)") {((env "a") (env "b"))})
(check $hylang_test "value")
(check [$hylang_test] {"value"})
(check (tail {1 2 3}) {2 3})
(unsetenv :hylang_test)
(check (env :hylang_test) NIL)
(check $hylang_test NIL)

; the clock: seconds since 2000-01-01, the Hydra's
(check (> (time) 800000000) T)
(check (date 0) "2000-01-01 00:00:00")
(check (date 86399) "2000-01-01 23:59:59")
(check (seconds-of 2000 1 2) 86400)
(check (date (seconds-of 2024 2 29 12 30 15)) "2024-02-29 12:30:15")
(check ((date-parts 0) :weekday) 6)
(check ((date-parts (seconds-of 2026 10 4)) :month) 10)
(check ((date-parts (seconds-of 2026 10 4)) :year) 2026)
(check (len (date)) 19)
(check (tick-rate) 200)
(check (between? 0 32767 (ticks)) T)
(def {sy-t0} (ticks))
(sleep 0.1)
(check (>= (mod (- (ticks) sy-t0) 32768) 15) T)
(check (sleep 0) NIL)
(check-error (sleep -1))
(check-error (sleep "x"))

; error codes, a program's own
(check (error-code (error "x" :mine)) :mine)
(check (error-code (error "x")) NIL)
(check (error-code 5) NIL)
(check-error (error "x" "not an atom"))
(check (try (error "x" :c) &code) :c)
(check (try (error "x") &code) NIL)

; where it's running
(check (atom? (platform)) T)
(check (eq (hydra?) (eq (platform) :hydra)) T)
