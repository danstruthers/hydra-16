; eval.dl - evaluation: calls, fn and fun, partial application, &N and &_, def, set and set!, eval, tail calls, depth

; calls
(check (+ 1 2) 3)
(check ((fn {x} {* x x}) 7) 49)
(def {plus} +)
(check (plus 1 2) 3)
(check-error (1 2))
(check-error (no-such-function 1))

; fn and fun
(fun {ev-sq x} {* x x})
(check (ev-sq 5) 25)
(check (function? ev-sq) T)
(check ((fn {} {42})) 42)
(check-error (fun {} {1}))

; partial application
(def {ev-add3} (fn {a b c} {+ a b c}))
(check ((ev-add3 1) 2 3) 6)
(check (((ev-add3 1) 2) 3) 6)
(check ((ev-add3 1 2) 3) 6)
(check (function? (ev-add3 1)) T)
; a built-in too: given fewer arguments than it needs, it waits for the rest (not a special form: if, let ...)
(check ((eq 1) 1) T)
(check ((substring "hello") 1) "ello")
(check ((item-at {10 20 30}) 2) 30)
(check (function? (len)) T)
(check (map (eq 2) {1 2}) {NIL T})
(check (repr (eq 1)) "<function>(eq 1)")
(check (repr eq) "<function>(eq)")
(check (repr +) "<function>(+)")
(check (eq (eq 1) (eq 1)) T)
(check (eq (eq 1) (eq 2)) NIL)
(check-error (if T))

; too many arguments: an error, for a built-in and a function alike (but a function whose body takes the extra
; ones, through &_ or &1, &2 ...)
(check-error (len {1} 2))
(check-error ((substring "hello") 1 2 3))
(check-error (if T 1 2 3))
(check-error ((fn {x} {x}) 1 2))
(check-error ((ev-add3 1) 2 3 4))
(check ((fn {x} {&_}) 1 2 3) {2 3})
(check ((fn {x} {&1}) 1 :b) :b)

; extra arguments, those past the formals: &1, &2 ... (the first extra is &1) and &_ (a list of them)
(fun {ev-args} {&_})
(check (ev-args 1 2 3) {1 2 3})
(check (ev-args) {})
(check ((fn {} {&2}) :a :b) :b)
(fun {ev-first-and-rest a} {list a &1 (len &_)})
(check (ev-first-and-rest 1 2 3) {1 2 2})
(check ((fn {a b} {list a b &1 &2}) 1 2 3 4) {1 2 3 4})
(check-error ((fn {a} {&2}) 1 2))
(fun {ev-opt a} ?{(defined? &1) &1 :none})
(check (ev-opt 1) :none)
(check (ev-opt 1 9) 9)

; def, set, set!
(def {ev-g1} 1)
(check ev-g1 1)
(def {ev-m1 ev-m2} 1 2)
(check (list ev-m1 ev-m2) {1 2})
(check-error (def {ev-m3 ev-m4} 1))
(check-error (def {1} 2))
(def {ev-gx} 1)
(fun {ev-set-local} {do =(ev-gx 2) ev-gx})
(check (ev-set-local) 2)
(check ev-gx 1)
(fun {ev-def-global} {def {ev-gy} 7})
(ev-def-global)
(check ev-gy 7)
(def {ev-gz} 1)
(fun {ev-bump} {set! {ev-gz} (+ ev-gz 1)})
(ev-bump)
(ev-bump)
(check ev-gz 3)
(check-error (set! {ev-no-such-var} 1))
(check (do (set! ev-gz 10) ev-gz) 10)

; eval: a Q-expression run as code; anything else is itself
(check (eval {+ 1 2}) 3)
(check (eval (list + 1 2)) 3)
(check (eval {{1 2}}) {1 2})
(check (eval 5) 5)
(check (eval "s") "s")
(check-error (eval {- 1 :a}))

; do
(check (do 1 2 3) 3)
(check (do) NIL)

; tail calls: a call in tail position (a function's last, through if, do, let and eval) takes its caller's place
(fun {ev-loop n} ?{(zero? n) :done (ev-loop (- n 1))})
(check (ev-loop 50000) :done)
(fun {ev-loop-do n} ?{(zero? n) :done (do (+ 1 1) (ev-loop-do (- n 1)))})
(check (ev-loop-do 50000) :done)
(fun {ev-loop-let n} {let {{m (- n 1)}} ?((< m 0) :done (ev-loop-let m))})
(check (ev-loop-let 50000) :done)
(fun {ev-loop-eval n} ?{(zero? n) :done (eval {ev-loop-eval (- n 1)})})
(check (ev-loop-eval 20000) :done)
(fun {ev-even n} ?{(zero? n) T (ev-odd (- n 1))})
(fun {ev-odd n} ?{(zero? n) NIL (ev-even (- n 1))})
(check (ev-even 30001) NIL)
(check (ev-even 30000) T)
(fun {ev-sum-to n acc} ?{(zero? n) acc (ev-sum-to (- n 1) (+ acc n))})
(check (ev-sum-to 10000 0) 50005000)

; depth: calls that aren't in tail position may nest only so deep; deeper is an error, not a crash
(fun {ev-deep n} ?{(zero? n) 0 (+ 1 (ev-deep (- n 1)))})
(check (ev-deep 1000) 1000)
(check-error (ev-deep 1000000))
