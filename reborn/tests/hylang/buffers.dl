; buffers.dl - buffers: bytes, changed in place (buffer, buffer?, a buffer called, buffer-get, buffer-put, buffer-fill,
; buffer-copy, buffer-cmp, read-buffer, and len, bytes, from-bytes, write-bytes of one); shared, not copied; equal by
; their bytes

; made: a count (and a fill), a string, a list of bytes, another buffer (a copy)
(check (bytes (buffer 3)) {0 0 0})
(check (bytes (buffer 2 255)) {255 255})
(check (bytes (buffer 2 \a)) {97 97})
(check (bytes (buffer "hi")) {104 105})
(check (bytes (buffer {1 2 255})) {1 2 255})
(check (len (buffer 0)) 0)
(check (len (buffer "")) 0)
(def {bu-a} (buffer {1 2 3}))
(def {bu-c} (buffer bu-a))
(buffer-put bu-c 0 9)
(check (bytes bu-a) {1 2 3})
(check (bytes bu-c) {9 2 3})
(check-error (buffer -1))
(check-error (buffer 1.5))
(check-error (buffer 2 256))
(check-error (buffer {1 256}))
(check-error (buffer {1 :x}))
(check-error (buffer "ab" 1))
(check-error (buffer :x))
(check (try (buffer 2 -1) &code) :inval)

; its type, and how it shows
(check (type-of (buffer 1)) :buffer)
(check (buffer? (buffer 1)) T)
(check (buffer? "x") NIL)
(check (buffer? (error "x")) NIL)
(check (repr (buffer {1 2})) "<buffer>{1 2}")
(check (output-of (save (buffer {7 8}))) "(buffer {7 8})\n")
(check (bytes (eval (fst (read (output-of (save (buffer {0 255}))))))) {0 255})

; read: called with an index, or buffer-get; outside it, an error
(def {bu-b} (buffer {10 20 30}))
(check (bu-b 0) 10)
(check (bu-b 2) 30)
(check (buffer-get bu-b 1) 20)
(check (map (buffer-get bu-b) {1}) {20})
(check-error (bu-b 3))
(check-error (bu-b -1))
(check-error (bu-b :x))
(check-error (bu-b 0 1))
(check-error (buffer-get "abc" 0))

; written: buffer-put (the old byte its value), a character as its code; the buffer is shared, so a change is seen
; wherever it is
(check (buffer-put bu-b 1 99) 20)
(check (bu-b 1) 99)
(check (buffer-put bu-b 0 \A) 10)
(check (bu-b 0) 65)
(def {bu-h} (to# {{:b bu-b}}))
(buffer-put bu-b 2 7)
(check ((bu-h :b) 2) 7)
(fun {bu-zero b} {buffer-put b 0 0})
(bu-zero bu-b)
(check (bu-b 0) 0)
(check-error (buffer-put bu-b 3 0))
(check-error (buffer-put bu-b 0 256))
(check-error (buffer-put bu-b 0 "x"))
(check (try (buffer-put bu-b 0 -1) &code) :inval)

; filled, copied (overlapping too); a count past the end takes what there is
(def {bu-f} (buffer 6))
(check (buffer-fill bu-f 1) NIL)
(check (bytes bu-f) {1 1 1 1 1 1})
(buffer-fill bu-f 2 4)
(check (bytes bu-f) {1 1 1 1 2 2})
(buffer-fill bu-f 3 1 2)
(check (bytes bu-f) {1 3 3 1 2 2})
(buffer-fill bu-f 0 5 100)
(check (bytes bu-f) {1 3 3 1 2 0})
(check-error (buffer-fill bu-f 0 7))
(check-error (buffer-fill bu-f 0 0 -1))
(def {bu-g} (buffer {1 2 3 4 5}))
(check (buffer-copy bu-g 0 (buffer {9 8})) NIL)
(check (bytes bu-g) {9 8 3 4 5})
(buffer-copy bu-g 3 (buffer {7 6 5 4}) 1)
(check (bytes bu-g) {9 8 3 6 5})
(buffer-copy bu-g 1 bu-g 0 3)
(check (bytes bu-g) {9 9 8 3 5})
(buffer-copy bu-g 0 (buffer "abc") 1 1)
(check (bytes bu-g) {98 9 8 3 5})
(check-error (buffer-copy bu-g 6 bu-g))
(check-error (buffer-copy bu-g 0 "abc"))

; compared: a part of one against a buffer's or a string's bytes (or a part of them), as cmp orders strings
(def {bu-c} (buffer "abcdef"))
(check (buffer-cmp bu-c 0 "abc") 0)
(check (buffer-cmp bu-c 2 "cd") 0)
(check (buffer-cmp bu-c 2 (buffer "cde")) 0)
(check (buffer-cmp bu-c 2 "ce") -1)
(check (buffer-cmp bu-c 2 "cc") 1)
(check (buffer-cmp bu-c 4 "efg") -1)
(check (buffer-cmp bu-c 6 "") 0)
(check (buffer-cmp bu-c 6 "a") -1)
(check (buffer-cmp bu-c 1 "xbcd" 1) 0)
(check (buffer-cmp bu-c 1 "xbcz" 1 2) 0)
(check (buffer-cmp bu-c 1 (buffer "xbcz") 1 3) -1)
(check (buffer-cmp (buffer {0 255}) 0 "\x00\xff") 0)
(check (buffer-cmp (buffer {0 255}) 0 "\x00\xfe") 1)
(check-error (buffer-cmp bu-c 7 "a"))
(check-error (buffer-cmp bu-c 0 "a" 2))
(check-error (buffer-cmp bu-c 0 {97}))
(check-error (buffer-cmp "abc" 0 "a"))

; bytes and strings, equality and order
(check (from-bytes (buffer "a\x00\xff")) "a\x00\xff")
(check (eq (buffer {1 2}) (buffer {1 2})) T)
(check (eq (buffer {1 2}) (buffer {1 3})) NIL)
(check (eq (buffer {1}) {1}) NIL)
(check (cmp (buffer {1 2}) (buffer {1 3})) -1)
(check (cmp (buffer {1 2}) (buffer {1})) 1)
(check (cmp (buffer {1}) (to# {})) 1)
(check (sort (list (buffer {2}) (buffer {1}))) (list (buffer {1}) (buffer {2})))

; a stream's bytes read into one (how many, NIL at the end), and written from one (or a part of one)
(def {bu-tmp} (+ regress-dir "io.tmp"))
(def {bu-s} (open bu-tmp :write))
(write-bytes bu-s (buffer {0 1 2 3 255}))
(write-bytes bu-s (buffer {9 8 7 6}) 1 2)
(close bu-s)
(def {bu-r} (buffer 4))
(def {bu-s} (open bu-tmp))
(check (read-buffer bu-s bu-r) 4)
(check (bytes bu-r) {0 1 2 3})
(check (read-buffer bu-s bu-r 1 2) 2)
(check (bytes bu-r) {0 255 8 3})
(check (read-buffer bu-s bu-r 3) 1)
(check (bytes bu-r) {0 255 8 7})
(check (read-buffer bu-s bu-r) NIL)
(check (read-buffer bu-s bu-r 4) 0)
(close bu-s)
(check-error (read-buffer bu-s bu-r))
(check-error (read-buffer 5 bu-r))
(check-error (write-bytes stdout {1} 0))
