; math.dl - the math functions: sqrt, exp, log, sin, cos, tan, atan, pi, pow of any real power, and digits, the
; precision: exact when the answer is, else a fixed decimal of (digits) significant digits, correctly rounded

; at 12 significant digits, the start's
(check (digits) 12)
(check (pi) 3.14159265359)
(check (sqrt 2) 1.41421356237)
(check (sqrt 3) 1.73205080757)
(check (sqrt 1/3) 0.57735026919)
(check (exp 1) 2.71828182846)
(check (exp -1) 0.367879441171)
(check (exp 0.5) 1.6487212707)
(check (exp 1/3) 1.39561242509)
(check (log 2) 0.69314718056)
(check (log 10) 2.30258509299)
(check (log 0.5) -0.69314718056)
(check (log 1000000) 13.815510558)
(check (sin 1) 0.841470984808)
(check (sin -1) -0.841470984808)
(check (cos 1) 0.540302305868)
(check (tan 1) 1.55740772465)
(check (tan -1) -1.55740772465)
(check (sin 100) -0.50636564111)
(check (cos 100) 0.862318872288)
(check (tan 100) -0.587213915157)
(check (atan 1) 0.785398163397)
(check (atan 0.5) 0.463647609001)
(check (atan 2) 1.10714871779)
(check (atan -5) -1.37340076695)
(check (atan -1/3) -0.321750554397)
(check (fixed? (pi)) T)

; exact when the answer is: a square root of a perfect square is the root's kind, as x is
(check (sqrt 9/4) 3/2)
(check (sqrt 16) 4)
(check (int? (sqrt 16)) T)
(check (sqrt 2.25) 1.5)
(check (fixed? (sqrt 2.25)) T)
(check (sqrt 0.09) 0.3)
(check (sqrt 0) 0)
(check (exp 0) 1)
(check (log 1) 0)
(check (sin 0) 0)
(check (cos 0) 1)
(check (tan 0) 0)
(check (atan 0) 0)

; a negative square root or logarithm is complex
(check (sqrt -4) (complex 0 2))
(check (sqrt -2) (complex 0 1.41421356237))
(check (log -1) (complex 0 3.14159265359))
(check (log -10) (complex 2.30258509299 3.14159265359))

; very large and very small: the digits are significant ones
(check (exp 100) 26881171418200000000000000000000000000000000)
(check (exp -100) 0.0000000000000000000000000000000000000000000372007597602)
(check (sqrt 0.000000000002) 0.00000141421356237)
(check (sqrt 1000000000001) 1000000)
(check (log 1.0000001) 0.000000099999995)
(check (log 0.9999999) -0.000000100000005)
(check (sin 3.14159265358979) 0.00000000000000323846264338)
(check (sin 1/1000) 0.000999999833333)
(check (cos 1/1000) 0.9999995)
(check (sin 1000000) -0.349993502171)
(check (atan 1/1000000) 0.000001)
(check (atan 1000000) 1.57079532679)
(check (tan 1.5707963) 37320539.5867)

; powers: whole ones exact, as the tower multiplies; a rational root exact; else rounded
(check (pow 2 10) 1024)
(check (pow 2 -2) 1/4)
(check (pow 1.5 2) 2.25)
(check (pow (complex 0 1) 2) -1)
(check (pow 4 1/2) 2)
(check (pow 8 1/3) 2)
(check (pow 8 -1/3) 1/2)
(check (pow 27/8 2/3) 9/4)
(check (pow 0.25 0.5) 0.5)
(check (fixed? (pow 0.25 0.5)) T)
(check (pow 9 1.5) 27)
(check (pow 2.25 1.5) 3.375)
(check (pow 32 0.2) 2)
(check (pow 1000000 1/6) 10)
(check (pow 1 0.37) 1)
(check (pow 0 0.5) 0)
(check (pow 2 0.5) 1.41421356237)
(check (pow 2 1/12) 1.05946309436)
(check (pow 1/2 1/2) 0.707106781187)
(check (pow 1.5 2.5) 2.75567596063)
(check (pow 10 0.1) 1.25892541179)

; errors
(check-error (log 0))
(check-error (sqrt (complex 1 1)))
(check-error (exp (complex 0 1)))
(check-error (sin "a"))
(check-error (pow -8 1/3))
(check-error (pow 0 -1/2))
(check-error (pow 2 (complex 0 1)))
(check-error (exp 30000))
(check-error (digits 0))
(check-error (digits 101))
(check-error (digits 1.5))

; the precision: (digits n) sets it, the one before given back
(check (digits 30) 12)
(check (pi) 3.14159265358979323846264338328)
(check (sqrt 2) 1.41421356237309504880168872421)
(check (exp 1) 2.71828182845904523536028747135)
(check (log 2) 0.693147180559945309417232121458)
(check (log 10) 2.30258509299404568401799145468)
(check (sin 1) 0.84147098480789650665250232163)
(check (cos 1) 0.540302305868139717400936607443)
(check (atan 1) 0.78539816339744830961566084582)
(check (digits 3) 30)
(check (pi) 3.14)
(check (exp 10) 22000)
(check (exp 2.302585) 10)
(check (digits 1) 3)
(check (sqrt 2) 1)
(check (pi) 3)
(check (digits 12) 1)
