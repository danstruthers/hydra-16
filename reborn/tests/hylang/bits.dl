; bits.dl - bits and bytes: bit-and, bit-or, bit-xor, bit-not, shl, shr, bit?, hex, bin, lo, hi, word, bytes,
; from-bytes, read-bytes, write-bytes

(check (bit-and 12 10) 8)
(check (bit-or 12 10) 14)
(check (bit-xor 12 10) 6)
(check (bit-and 255 15 7) 7)
(check (bit-or 1) 1)
(check (bit-not 0) -1)
(check (bit-and (bit-not 1) 255) 254)
(check (bit-and -1 #xffff) 65535)
(check (shl 1 8) 256)
(check (shl 1 40) 1099511627776)
(check (shr 256 4) 16)
(check (shr -8 1) -4)
(check (bit? 5 0) T)
(check (bit? 5 1) NIL)
(check (bit? -1 100) T)
(check (bit-and 3 1.0) 1)
(check-error (bit-and 1.5 1))
(check-error (shl 1/2 1))
(check-error (bit-or :a))

(check (hex 255) "FF")
(check (hex 10 4) "000A")
(check (hex 0) "0")
(check (hex -1) "-1")
(check (bin 5) "101")
(check (bin 5 8) "00000101")
(check-error (hex 1/2))

(check (lo #x1234) #x34)
(check (hi #x1234) #x12)
(check (hi #x123456) #x34)
(check (word #x34 #x12) #x1234)
(check (lo -1) 255)

(check (bytes "AB") {65 66})
(check (bytes "") {})
(check (bytes \a) {97})
(check (from-bytes {104 105}) "hi")
(check (from-bytes (bytes "\x00\xff")) "\x00\xff")
(check-error (from-bytes {256}))
(check-error (from-bytes {-1}))
(check-error (from-bytes 5))
; an argument they can't take: the error saying so, its code :inval
(check (try (bit-and 1.5 1) &err) "'bit-and''s argument must be an integer")
(check (try (from-bytes {256}) &code) :inval)

; bytes to and from a stream, as they are
(def {bt-f} (+ regress-dir "bits.tmp"))
(def {bt-s} (open bt-f :write))
(write-bytes bt-s {0 1 255 10})
(close bt-s)
(check ((stat bt-f) :length) 4)
(def {bt-s} (open bt-f))
(check (read-bytes bt-s 3) {0 1 255})
(check (read-bytes bt-s 5) {10})
(check (read-bytes bt-s 1) NIL)
(check (read-bytes bt-s 0) {})
(close bt-s)
(remove bt-f)
(check-error (write-bytes stdin {1}))
