; strings.dl - strings and characters: +, len, substring, char-at, str-split, index-of, the str- functions, format,
; char-code and code-char, the character tests, comparison, to-str and repr, print and write

; + joins strings (and anything with them, as print shows it)
(check (+ "ab" "cd") "abcd")
(check (+ "n=" 5) "n=5")
(check (+ "x" \y) "xy")
(check (+ \a \b) "ab")
(check (+ "" "") "")
(check (+ "a" :b) "a:b")

(check (len "hello") 5)
(check (substring "hello" 1) "ello")
(check (substring "hello" 1 3) "ell")
(check (substring "hello" 3 10) "lo")
(check (char-at "hello" 1) \e)
(check-error (char-at "hi" 5))
(check-error (char-at "hi" -1))

(check (str-split "a,b,c" ",") {"a" "b" "c"})
(check (str-split "a b\tc") {"a" "b" "c"})
(check (str-split "a--b" {"-"}) {"a" "" "b"})
(check (str-split "a,b;c" {"," ";"}) {"a" "b" "c"})
(check (str-split "abc" ",") {"abc"})

(check (index-of "hello" "l") 2)
(check (last-index-of "hello" "l") 3)
(check (index-of "hello" "z") -1)
(check (index-of "hello" \e) 1)
(check (index-of "hello" "") 0)

(check (str-upper "aBc1") "ABC1")
(check (str-lower "aBc1") "abc1")
(check (str-upper \a) \A)
(check (str-trim "  x y  ") "x y")
(check (str-trim "\t\nx\n") "x")
(check (str-replace "a-b-c" "-" "+") "a+b+c")
(check (str-replace "aaa" "a" "bb") "bbbbbb")
(check-error (str-replace "a" "" "x"))
(check (str-join {"a" 1 :b} "/") "a/1/:b")
(check (str-join {"a" "b"}) "ab")
(check (str-join {} ",") "")
(check (str-chars "ab") {\a \b})
(check (str-chars "") {})
(check (str-pad-left "7" 3 "0") "007")
(check (str-pad-left "1234" 3) "1234")
(check (str-pad-right "ab" 4) "ab  ")
(check (str-pad-right "ab" 4 \.) "ab..")
(check (str-repeat "ab" 3) "ababab")
(check (str-repeat "x" 0) "")
(check-error (str-repeat "x" -1))

; format: each {} the next argument, as print shows it
(check (format "{} + {} = {}" 1 2 3) "1 + 2 = 3")
(check (format "{{}}") "{}")
(check (format "s={} c={} a={} l={}" "str" \c :at {1 "x"}) "s=str c=c a=:at l={1 \"x\"}")
(check (format "none") "none")
(check-error (format "{}"))
(check-error (format "x" 1))

; characters
(check (char-code \a) 97)
(check (char-code "a") 97)
(check-error (char-code "ab"))
(check (code-char 65) \A)
(check-error (code-char -1))
(check (alpha? \a) T)
(check (alpha? \1) NIL)
(check (alpha? "abc") T)
(check (alpha? "ab1") NIL)
(check (digit? "123") T)
(check (digit? "") NIL)
(check (space? \space) T)
(check (space? " \t") T)
(check (upper? "AB") T)
(check (upper? \a) NIL)
(check (lower? \a) T)
(check (lower? \A) NIL)

; comparison: by character code
(check (< "apple" "banana") T)
(check (> "b" "a") T)
(check (cmp "b" "a") 1)
(check (cmp "a" "a") 0)
(check (< "B" "a") T)
(check (eq "a" "a") T)
(check (eq "a" "A") NIL)
(check (eq \a \a) T)

; to-str (as print shows it) and repr (as the REPL does)
(check (to-str "x") "x")
(check (to-str :a) ":a")
(check (to-str \a) "a")
(check (to-str {1 "a"}) "{1 \"a\"}")
(check (to-str 42) "42")
(check (repr "x") "\"x\"")
(check (repr "a\nb\t\"") "\"a\\nb\\t\\\"\"")
(check (repr \a) "\\a")
(check (repr \space) "\\space")
(check (repr :a) ":a")
(check (repr (error "e")) "Error: e")

; print and write
(check (output-of (print "a" 1 :b)) "a 1 :b\n")
(check (output-of (print)) "\n")
(check (output-of (print {1 "s"})) "{1 \"s\"}\n")
(check (output-of (print \a)) "a\n")
(check (output-of (write "a" 1)) "a1")
(check (output-of (write)) "")
(check (output-of (print "x") (print "y")) "x\ny\n")
(def {st-printed} :unset)
(output-of (def {st-printed} (print "quiet")))
(check st-printed NIL)
