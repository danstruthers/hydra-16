; numbers.dl - integers of any size, fixed decimals, rationals, complex numbers: arithmetic, comparison, conversion,
; bases, and the number tests

; integers
(check (+ 1 2 3) 6)
(check (+) 0)
(check (*) 1)
(check (- 5) -5)
(check (- 10 1 2) 7)
(check (* 2 3 4) 24)
(check (* 99999999999 99999999999) 9999999999800000000001)
(check (- 0 12345678901234567890) -12345678901234567890)

; division is exact: a rational, or an integer when it's whole
(check (/ 12 2 3) 2)
(check (int? (/ 6 3)) T)
(check (/ 7 2) 7/2)
(check (rational? (/ 7 2)) T)
(check (/ 1 3 2) 1/6)
(check-error (/ 1 0) "Division by zero.")
(check-error (/ 1 0.0))
; one number: its reciprocal
(check (/ 4) 1/4)
(check (/ 1/2) 2)
(check (/ 0.5) 2)
(check-error (/ 0) "Division by zero.")

; fixed decimals: a sum or product of fixed and integer is fixed
(check (+ 0.5 0.25) 0.75)
(check (+ 1 0.5) 1.5)
(check (+ 0.5 1) 1.5)
(check (fixed? (+ 1 0.5)) T)
(check (fixed? (+ 0.5 1)) T)
(check (- 1 0.25) 0.75)
(check (* 1.5 2) 3)
(check (* 0.1 0.1) 0.01)
(check (/ 1.5 0.5) 3)

; rationals, with each other and with fixed decimals
(check (+ 1/2 1/3) 5/6)
(check (+ 1/2 0.5) 1)
(check (int? (+ 1/2 1/2)) T)
(check (rational? (+ 1/3 0.5)) T)
(check (* 2/3 3/4) 1/2)
(check (- 1/2 1/3) 1/6)
(check 6/4 3/2)
(check -1/2 (- 1/2))
(check 1/-2 -1/2)

; comparison: by value, whatever the kinds
(check (< 1.5 2) T)
(check (> 1.5 2) NIL)
(check (< 1/3 1/2) T)
(check (> 1/2 1/3) T)
(check (eq 1/2 0.5) T)
(check (eq 1/2 1) NIL)
(check (eq 1 1.0) T)
(check (cmp 2 1) 1)
(check (cmp 1 2) -1)
(check (cmp 1 1.0) 0)
(check (< -3 -2) T)
; T isn't a number (it's after them, as every other kind is: sort's order)
(check (eq T 1) NIL)
(check (cmp T 1) 1)
(check (cmp 1 "1") -1)

; complex numbers
(check (complex 1 2) (complex 1 2))
(check (to-str (complex 1 2)) "1+2i")
(check (to-str (complex 1 -2)) "1-2i")
(check (* (complex 0 1) (complex 0 1)) -1)
(check (int? (* (complex 0 1) (complex 0 1))) T)
(check (+ (complex 1 2) 1) (complex 2 2))
(check (+ (complex 1 2) (complex 1 -2)) 2)
(check (* (complex 1 2) (complex 3 4)) (complex -5 10))
(check (/ (complex 1 2) (complex 3 4)) (complex 11/25 2/25))
(check (- (complex 1 2)) (complex -1 -2))
(check (+ (complex 1 2) 1.5) (complex 2.5 2))
(check (complex? (complex 1 2)) T)
(check (complex? (complex 1 0)) NIL)
(check (complex 1.5 0) 1.5)
(check ((complex 1) 2) (complex 1 2))
(def {nu-one} 1)
(check (complex nu-one 2) (complex 1 2))
(check-error (complex :a 1))

; conversions
(check (val "42") 42)
(check (val "1/2") 1/2)
(check (val "#xff") 255)
(check-error (val "abc"))
(check (to-fixed 1/3 4) 0.3333)
(check (to-fixed -1/3 2) -0.33)
(check (to-fixed 1/4) 0.25)
(check (to-fixed 2/3) 0.6666666666)
(check-error (to-fixed 1/3 1.5))
(check-error (to-fixed 1/3 -1))
(check-error (to-fixed (complex 1 2)))
(check-error (to-rational (complex 1 2)))
(check-error (truncate (complex 1 2)))
(check-error (rational.n (complex 1 2)))
(def {nb-q} -1/3)
(to-fixed nb-q 4)
(check nb-q -1/3)
(check (to-rational 0.75) 3/4)
; a rational whose denominator is 1 is an integer
(check (int? (to-rational 5)) T)
(check (int? (to-rational 2.0)) T)
(check (truncate 7/2) 3)
(check (truncate -7/2) -3)
(check (truncate 2.75) 2)
(check (rational.n 3/4) 3)
(check (rational.d 3/4) 4)
(check (rational.d 0.75) 4)
(check-error (truncate "a"))
(check-error (to-fixed "a"))

; bases
(check #xFF 255)
(check #b1010 10)
(check #o17 15)
(check -#x10 -16)
(check (to-str 255 "x") "FF")
(check (to-str 255 "#x") "#xFF")
(check (to-str 5 "#b") "#b101")
(check (to-str -5 "#b") "-#b101")
(check (to-str 255 "#16r") "#16rFF")
(check (to-str 255) "255")
(check (to-str 1/2 "#b") "#b0.1")
(check (to-str 1.5 "x") "1.8")
(check (to-str (complex 1 2) "#x") "#x1+#x2i")
(check (val (to-str 12345 "#z")) 12345)
(check (val (to-str -12345 "#c")) -12345)

; a base's prefix: written when its string starts with #
(check (to-str 255 "#d") "#d255")
(check (to-str -255 "x") "-FF")
(check (to-str 255 "16r") "FF")
; a fraction or a fixed decimal in another base: a radix point when it ends there, else a fraction; exact either way
(check (to-str 0.5 "x") "0.8")
(check (to-str 0.1 "x") "1/A")
(check (to-str 3/8 "#b") "#b0.011")
(check (to-str 1/4 "6r") "0.13")
(check (to-str 1/3 "c") "+.0")
(check (to-str 1/3 "x") "1/3")
(check (val (to-str 1/3 "#c")) 1/3)
(check (val (to-str -5/4 "#b")) -5/4)
(check (val "#x1.8") 3/2)
; a complex number in a base: its parts in it; in a base whose digits have +, - or i, in decimal with #d
(check (to-str (complex 1 2) "c") "#d1+#d2i")
(check (val (to-str (complex 1 -2) "c")) (complex 1 -2))
; every named base, a radix, digits of their own, each modifier: numbers written and read back the same
(fun {round-trip b} {filter (fn {n} {not (eq (val (to-str n b)) n)})
  {0 1 -1 2 255 -1000 12345678901234567890 1/3 -7/8 2/9 0.5 3.25}})
(check (filter (fn {b} {not (eq (round-trip b) {})})
  {"#c" "#e" "#g" "#i" "#j" "#m" "#b" "#t" "#q" "#v" "#f" "#s" "#o" "#n" "#d" "#x" "#z" "#k" "#y"
   "#2r" "#16r" "#80r" "#[01]" "#=[abc]" "#<x" "#>c" "#-x" "#+m"}) {})
(check-error (to-str 1 "#=x"))

; complex numbers read: a real part, + or -, an imaginary part and i; or an imaginary part and i
(check 1+2i (complex 1 2))
(check 2i (complex 0 2))
(check -1.5i (complex 0 -1.5))
(check 0.5-1/3i (complex 0.5 -1/3))
(check #x1+#x2i (complex 1 2))
(check 0i 0)
(check (val "1+2i") (complex 1 2))
(check (val (to-str (complex 3 -4))) (complex 3 -4))
(check (type-of 1+i) :error)

; format's placeholders: {} as print shows it, {base} a number in that base
(check (format "{x} is {} in decimal, {#b} in binary" 255 255 255) "FF is 255 in decimal, #b11111111 in binary")
(check (format "{c}/{}" 1/3 1/3) "+.0/1/3")
(check-error (format "{x}" "a"))
(check-error (format "{q?}" 1))

; the base: what numbers are shown and read in, everywhere (a program's text from the next expression read)
(check (base) "d")
(check-error (base "#q?"))
(check (base "x") "d")
(check (to-str 0FF) "FF")
(check 10 #d16)
(check (repr 0FF) "FF")
(check (val "ff") #d255)
(check (val "1.8") 3/2)
(check (repr 1/A) "1/A")
(check (format "{} {d}" 0FF 0FF) "FF 255")
(check (type-of FF) :error)
(check (output-of (save 0FF)) "#xFF\n")
(check (base "#x") "x")
(check (to-str 0FF) "#xFF")
(check (base "c") "#x")
(check (val "+-0") -#d2)
(check (base "d") "c")
(check (base) "d")
; a file read an expression at a time: the base it sets is the one the rest of it is read in
(def {base-tmp} (+ regress-dir "base.tmp"))
(def {base-s} (open base-tmp :write))
(write-to base-s "(base \"x\")\n(def {base-read} 10)\n(base \"d\")\n")
(close base-s)
(load base-tmp)
(check base-read 16)
(check (base) "d")
(remove base-tmp)

; the stored format (number-bytes, bytes-number): a tag byte, then what it says; each number in its one form
(check (number-bytes 0) {0})
(check (number-bytes 63) {63})
(check (number-bytes -64) {64})
(check (number-bytes -1) {127})
(check (number-bytes 64) {128 64})
(check (number-bytes -100) {144 100})
(check (number-bytes 65535) {129 255 255})
(check (number-bytes 2147483648) {131 0 0 0 128})
(check (len (number-bytes (pow 10 20))) 10)
(check (number-bytes 0.5) {177 5})
(check (number-bytes -2.5) {177 103})
(check (number-bytes 3.14) {178 129 58 1})
(check (number-bytes 1.0) {176 1})
(check (number-bytes 1/3) {193 1 3})
(check (number-bytes (complex 1 2)) {194 1 2})
(check (number-bytes 2i) {194 0 2})
(check (len (number-bytes (pow 2 2032))) 257)
(check-error (number-bytes (pow 2 2040)))
(check (bytes-number (number-bytes (pow 2 2032))) (pow 2 2032))
(check (bytes-number {178 129 58 1}) 3.14)
(check (fixed? (bytes-number {176 1})) T)
(check (bytes-number (number-bytes -7/8)) -7/8)
(check (bytes-number (number-bytes (complex 0.5 -1/3))) (complex 0.5 -1/3))
(check-error (bytes-number {128 5}))
(check-error (bytes-number {129 5 0}))
(check-error (bytes-number {193 2 4}))
(check-error (bytes-number {177 10}))
(check-error (bytes-number {1 2}))
(check-error (bytes-number {194 1 0}))
(check-error (bytes-number {192 5 0 1}))
(check-error (bytes-number {256}))

; reading: a number's parts, or not a number at all
(check (type-of 1/x) :error)
(fun {number-or-not s} {try (do (val s) :number) :not})
(check (number-or-not "1/2/3") :not)
(check (number-or-not "1/x") :not)
(check (number-or-not "12") :number)

; the tests
(check (num? 1) T)
(check (num? "1") NIL)
(check (int? 5) T)
(check (int? 1.5) NIL)
(check (int? 1/2) NIL)
(check (fixed? 1.5) T)
(check (rational? 1/2) T)
(check (rational? 1) NIL)
(check (int? #b1.0) T)
(check #b1.1 3/2)
(check (complex? 1) NIL)
; anything else isn't one either
(check (int? "a") NIL)
(check (fixed? :a) NIL)
(check (rational? {1}) NIL)
(check (complex? "1") NIL)

; random and fib
(check (< (random 10) 10) T)
(check (>= (random 10) 0) T)
(check (random 1) 0)
(check (< (random 100000000000000000000000) 100000000000000000000000) T)
(check-error (random 0))
(check-error (random -5))
(check-error (random 1.5))
(check-error (random "a"))
(check (fib 10) 55)
(check (fib 100) 354224848179261915075)

; past 64 bits, either way: the same numbers, a sum, a difference or a product not cut short
(check (+ 9223372036854775807 1) 9223372036854775808)
(check (- -9223372036854775808 1) -9223372036854775809)
(check (- 9223372036854775807 -1) 9223372036854775808)
(check (+ -9223372036854775808 -1) -9223372036854775809)
(check (* 3037000500 3037000500) 9223372037000250000)
(check (* -4611686018427387904 2) -9223372036854775808)
(check (* 4611686018427387904 2) 9223372036854775808)
(check (1+ 9223372036854775807) 9223372036854775808)
(check (1- -9223372036854775808) -9223372036854775809)
(check (+ 1 2 9223372036854775807) 9223372036854775810)
(check (< 9223372036854775807 9223372036854775808) T)

; a balanced base of an even size: one digit fewer above 0 than below (8 below, 7 above in #=16r)
(check (to-str 8 "#=16r") "#=16r90")
(check (to-str 104 "#=16r") "#=16rF0")
(check (to-str -8 "#=16r") "#=16r0")
(check (to-str 0.5 "#=16r") "#=16r9.0")
(check (val "#=16r90") 8)
(check (to-str 5 "#=[0123456789]") "#=[0123456789]60")
(check (val "#=[0123456789]60") 5)
