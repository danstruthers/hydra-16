\ numberstest.fth - HyForth's number words (lib numbers: numbers.fl, on the numbers and math libraries), checked
\ in the test suite's way: tester.fr's T{ ... -> ... }T, each number by its text (N>STR) or a flag.  HyForth's own,
\ not the suite's: tester.fr, string.fl (COMPARE), hydra.fl (CODE-BANKS) and numbers.fl first.  Its last lines are
\ typed (N., N.BASE, N.S, NFORMAT, cells in a base that isn't a radix), for the test to see; then its errors' count.

DECIMAL
: NIS ( c-addr u -- flag ) ( N: x -- ) N>STR COMPARE 0= ;
: NEMPTY ( -- ) ( N: i*x -- ) BEGIN NDEPTH WHILE NDROP REPEAT ;

TESTING literals: what Forth reads as a cell or a double stays one; any other number goes on the number stack
T{ 42 $FF #10 -5 65535 -32768 NDEPTH -> 42 255 10 -5 65535 -32768 0 }T
T{ 123. 4294967295. -2147483648. NDEPTH -> 123 0 -1 -1 0 -32768 0 }T
T{ 1.25 S" 1.25" NIS 2/3 S" 2/3" NIS #xFF S" 255" NIS -> TRUE TRUE TRUE }T
T{ #16r1F S" 31" NIS #b101 S" 5" NIS -1.5 S" -1.5" NIS -> TRUE TRUE TRUE }T
T{ 2i S" 2i" NIS 1+2i S" 1+2i" NIS 0.5-1/3i S" 0.5-1/3i" NIS -> TRUE TRUE TRUE }T
T{ 100000000000000000000 S" 100000000000000000000" NIS -> TRUE }T
T{ 65536 S" 65536" NIS -32769 S" -32769" NIS -> TRUE TRUE }T
T{ 4294967296. S" 4294967296" NIS -2147483649. S" -2147483649" NIS -> TRUE TRUE }T
T{ : LIT1 1/3 1/6 N+ ; LIT1 S" 1/2" NIS -> TRUE }T
T{ : LIT2 100000000000000000000 2 S>N N* ; LIT2 S" 200000000000000000000" NIS -> TRUE }T
FALSE CODE-BANKS
T{ : LIT3 5/6 1/6 N+ ; LIT3 S" 1" NIS -> TRUE }T
T{ : LIT4 12345678901234567890 1.5 N* ; LIT4 S" 18518518351851851835" NIS -> TRUE }T
TRUE CODE-BANKS
T{ S" 1/x" ' EVALUATE CATCH NIP NIP -> -13 }T
T{ S" 1/0" ' EVALUATE CATCH NIP NIP -> -10 }T

TESTING ndepth ndrop ndup nover nswap nrot
T{ NEMPTY NDEPTH 1 S>N 2 S>N NDEPTH -> 0 2 }T
T{ NDUP NDEPTH S" 2" NIS S" 2" NIS S" 1" NIS -> 3 TRUE TRUE TRUE }T
T{ 1 S>N 2 S>N NOVER S" 1" NIS S" 2" NIS S" 1" NIS -> TRUE TRUE TRUE }T
T{ 1 S>N 2 S>N NSWAP S" 1" NIS S" 2" NIS -> TRUE TRUE }T
T{ 1 S>N 2 S>N 3 S>N NROT S" 1" NIS S" 3" NIS S" 2" NIS -> TRUE TRUE TRUE }T
T{ 1/3 100000000000000000000 NSWAP S" 1/3" NIS S" 100000000000000000000" NIS -> TRUE TRUE }T
T{ 2i 12345678901234567890 5 S>N NROT S" 2i" NIS S" 5" NIS -> TRUE TRUE }T
T{ S" 12345678901234567890" NIS 7 S>N NDROP NDEPTH -> TRUE 0 }T

TESTING n+ n- n* n/ n/mod nnegate nabs ngcd npow
T{ 1/3 1/6 N+ S" 1/2" NIS 0.1 0.2 N+ 0.3 N= -> TRUE TRUE }T
T{ 1 S>N 1/3 N- S" 2/3" NIS 1.5 1.5 N* S" 2.25" NIS -> TRUE TRUE }T
T{ 10 S>N 4 S>N N/ S" 5/2" NIS 1+2i 3-4i N* S" 11+2i" NIS -> TRUE TRUE }T
T{ 17 S>N 5 S>N N/MOD S" 3" NIS S" 2" NIS -17 S>N 5 S>N N/MOD S" -3" NIS S" -2" NIS -> TRUE TRUE TRUE TRUE }T
T{ 1/2 NNEGATE S" -1/2" NIS -2.5 NABS S" 2.5" NIS 12 S>N 18 S>N NGCD S" 6" NIS -> TRUE TRUE TRUE }T
T{ 2 S>N 100 S>N NPOW S" 1267650600228229401496703205376" NIS -> TRUE }T
T{ 2/3 -2 S>N NPOW S" 9/4" NIS 8 S>N 1/3 NPOW S" 2" NIS 2 S>N 0.5 NPOW S" 1.41421356237" NIS -> TRUE TRUE TRUE }T

TESTING ncompare n= n< n> n0= n0<
T{ 1/2 1/3 NCOMPARE 1/3 1/2 NCOMPARE 2 S>N 2.0 NCOMPARE -> 1 -1 0 }T
T{ 2 S>N 2.0 N= 1/3 1/2 N= 1/3 0.5 N< 0.5 1/3 N< -> TRUE FALSE TRUE FALSE }T
T{ 1/3 0.5 N> 0.5 1/3 N> 0.0 N0= 2i N0= -1/2 N0< 1/2 N0< -> FALSE TRUE TRUE FALSE TRUE FALSE }T

TESTING int? fixed? rational? complex?
T{ 5 S>N INT? 1.5 FIXED? 1/3 RATIONAL? 1+2i COMPLEX? -> TRUE TRUE TRUE TRUE }T
T{ 1.5 INT? 1/3 FIXED? 5 S>N RATIONAL? 1.5 COMPLEX? -> FALSE FALSE FALSE FALSE }T

TESTING s>n d>n n>s n>d truncate nfloor nround to-fixed to-rational rational.n rational.d complex
T{ -7 S>N S" -7" NIS 65535 S>N S" -1" NIS 0 1 D>N S" 65536" NIS -1. D>N S" -1" NIS -> TRUE TRUE TRUE TRUE }T
T{ -7 S>N N>S 3.9 N>S -3.9 N>S 65535. D>N N>S 70000 N>D 1/2 N>D -> -7 3 -3 -1 70000. 0. }T
T{ 65536 ' N>S CATCH NDEPTH 1+2i ' N>S CATCH NDEPTH NEMPTY -> -11 0 -24 1 }T
T{ 3.5 TRUNCATE S" 3" NIS -3.5 NFLOOR S" -4" NIS 2.5 NROUND S" 2" NIS 3.5 NROUND S" 4" NIS -> TRUE TRUE TRUE TRUE }T
T{ 1/3 3 TO-FIXED S" 0.333" NIS 2.5 TO-RATIONAL S" 5/2" NIS -> TRUE TRUE }T
T{ 6/4 RATIONAL.N S" 3" NIS 6/4 RATIONAL.D S" 2" NIS -> TRUE TRUE }T
T{ 1 S>N 2 S>N COMPLEX S" 1+2i" NIS 1/2 0 S>N COMPLEX S" 1/2" NIS -> TRUE TRUE }T

TESTING nrandom nseed nfib
T{ 100 S>N NFIB S" 354224848179261915075" NIS -> TRUE }T
T{ 7 NSEED 1000 S>N NRANDOM N>S 7 NSEED 1000 S>N NRANDOM N>S = -> TRUE }T
T{ 10 S>N NRANDOM N>S 10 U< 0 S>N NRANDOM NDUP N0< 1 S>N N< -> TRUE FALSE TRUE }T

TESTING nand nor nxor ninvert nlshift nrshift nbit? nbytes nfrom-bytes
T{ 12 S>N 10 S>N NAND S" 8" NIS 12 S>N 10 S>N NOR S" 14" NIS 12 S>N 10 S>N NXOR S" 6" NIS -> TRUE TRUE TRUE }T
T{ 12 S>N NINVERT S" -13" NIS -1 S>N 3 NRSHIFT S" -1" NIS 1 S>N 100 NLSHIFT 2 S>N 100 S>N NPOW N= -> TRUE TRUE TRUE }T
T{ 5 S>N 2 NBIT? 5 S>N 1 NBIT? -> TRUE FALSE }T
T{ 1/3 NBYTES NIP 1/3 NBYTES DROP C@ 1/3 NBYTES NFROM-BYTES S" 1/3" NIS -> 3 193 TRUE }T
T{ S" xyz" ' NFROM-BYTES CATCH NIP NIP NDEPTH -> -24 0 }T

TESTING n>str >n set-base get-base
T{ S" 7/2" >N S" 7/2" NIS S"  2.5 " >N S" 2.5" NIS -> TRUE TRUE TRUE TRUE }T
T{ S" abc" >N S" 1/x" >N S" 1/0" ' >N CATCH NIP NIP NDEPTH -> FALSE FALSE -10 0 }T
T{ HEX 1.8 FF S>N DECIMAL S" 255" NIS S" 3/2" NIS -> TRUE TRUE }T
T{ HEX FF S>N N>STR DECIMAL S" FF" COMPARE 16 BASE ! 0FFFFF N>STR DECIMAL S" FFFFF" COMPARE -> 0 0 }T
T{ GET-BASE S" d" COMPARE S" #b" SET-BASE GET-BASE S" #b" COMPARE BASE @ DECIMAL -> 0 0 2 }T
T{ S" c" SET-BASE 0+ 0+. BASE @ DECIMAL -> 3 3. 3 }T
T{ S" <d" SET-BASE 21 DECIMAL S" #x" SET-BASE 1F DECIMAL S" x" SET-BASE BASE @ 1F DECIMAL -> 12 31 16 31 }T
T{ S" #12r" SET-BASE BASE @ S" 40r" SET-BASE BASE @ DECIMAL S" foo" ' SET-BASE CATCH NIP NIP -> 12 36 -24 }T
T{ S" <d" SET-BASE DECIMAL 12 S>N N>STR S" 12" COMPARE -> 0 }T

TESTING nsqrt nexp nlog nsin ncos ntan natan npi digits
T{ 2 S>N NSQRT S" 1.41421356237" NIS 9/4 NSQRT S" 3/2" NIS -4 S>N NSQRT S" 2i" NIS -> TRUE TRUE TRUE }T
T{ 2 S>N NEXP S" 7.38905609893" NIS 0 S>N NEXP S" 1" NIS 10 S>N NLOG S" 2.30258509299" NIS -> TRUE TRUE TRUE }T
T{ 1 S>N NSIN S" 0.841470984808" NIS 1 S>N NCOS S" 0.540302305868" NIS -> TRUE TRUE }T
T{ 1 S>N NTAN S" 1.55740772465" NIS 1 S>N NATAN S" 0.785398163397" NIS -> TRUE TRUE }T
T{ NPI S" 3.14159265359" NIS DIGITS @ -1 S>N NLOG S" 3.14159265359i" NIS -> TRUE 12 TRUE }T
T{ 30 DIGITS ! NPI S" 3.14159265358979323846264338328" NIS 12 DIGITS ! -> TRUE }T
T{ 0 DIGITS ! ' NPI CATCH 101 DIGITS ! ' NPI CATCH 12 DIGITS ! -> -24 -24 }T

TESTING errors
: NFILL ( n -- ) ( N: -- i*x ) 0 DO I S>N LOOP ;
T{ NEMPTY ' NDROP CATCH ' N. CATCH 100 ' NFILL CATCH NIP NDEPTH NEMPTY -> -45 -45 -44 64 }T
T{ 1 S>N 0 S>N ' N/ CATCH NDEPTH NEMPTY 0 S>N ' NLOG CATCH NEMPTY -> -10 2 -46 }T
T{ 1+2i ' NSQRT CATCH NEMPTY 1 S>N 3000 ' NLSHIFT CATCH NIP NEMPTY -> -24 -11 }T

TESTING nvariable n@ n! nconstant nvalue to nliteral
NVARIABLE NV1
T{ NV1 N@ S" 0" NIS 22/7 NV1 N! NV1 N@ NV1 N@ N= -> TRUE TRUE }T
T{ 100000000000000000000 NV1 N! NV1 N@ S" 100000000000000000000" NIS 1/2 NV1 N! NV1 N@ S" 1/2" NIS -> TRUE TRUE }T
1/9 NCONSTANT NINTH
1/7 NVALUE NQ
T{ NINTH NINTH N+ S" 2/9" NIS NQ S" 1/7" NIS 5 S>N TO NQ NQ S" 5" NIS -> TRUE TRUE TRUE }T
T{ : SETQ 9/4 TO NQ ; SETQ NQ S" 9/4" NIS : NL7 [ 7/8 ] NLITERAL ; NL7 S" 7/8" NIS -> TRUE TRUE }T
T{ : SV NV1 N! ; : FV NV1 N@ ; 2i SV FV S" 2i" NIS -> TRUE }T
T{ : SUMTO 0 S>N 101 1 DO I S>N N+ LOOP ; SUMTO S" 5050" NIS -> TRUE }T
T{ : HARM 0 S>N 21 1 DO 1 S>N I S>N N/ N+ LOOP ; HARM S" 55835135/15519504" NIS NDEPTH -> TRUE 0 }T

CR .( Typed: ) 1/3 N. 255 S>N S" x" N.BASE 255 S>N S" #b" N.BASE 1 S>N 2 S>N 3 S>N N.S NEMPTY
CR 255 S>N 255 S>N 255 S>N S" {} is {x} and {#b}, {{ and }} {" NFORMAT
CR S" c" SET-BASE #-7 #5 .S 2DROP #8 #4 .R #9 U. DECIMAL
CR S" #x" SET-BASE 255 . -1 . #65535 U. DECIMAL 255 .
CR #ERRORS @ . .( errors in the number word tests) CR
