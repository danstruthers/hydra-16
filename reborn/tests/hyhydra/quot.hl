; quot.hl - the hyquot test's (tests/suites/hylang.js): quot and rem against truncate of / (and a - b * it), div and
; mod against globals.hl's definitions before they were built in (old-div, old-mod), over every pair of values of
; every kind: fixnums of both signs, 0, a fixnum's edges, integers past one, big ones, fixed decimals, rationals,
; complex numbers, non-numbers.  Each value compared is its type and its repr (an error's: its message)
(fun {old-div a b} ?{
  (and (num? a) (num? b))
  (floor (/ a b))
  (error "Cannot perform 'div' on non-numbers")
})
(fun {old-mod a b} ?{
  (and (num? a) (num? b))
  (- a (* b (floor (/ a b))))
  (error "Cannot perform 'mod' on non-numbers")
})
(fun {res f a b} {try (do =(v (f a b)) (list (type-of v) (repr v))) (list :err &err &code)})
(fun {tq a b} {truncate (/ a b)})
(fun {tr a b} {- a (* b (truncate (/ a b)))})
(def {vals} (list 0 1 -1 2 -2 3 -3 7 -7 50 -50 63 -64 64 -65 255 256 16383 -16384 16382 -16383 16384 -16385 32767 32768 -32768 65536 100000 -100000 (pow 2 40) (- (pow 2 40)) 12345678901234567890 -12345678901234567890 (pow 3 200) (- (pow 3 200)) 2.0 -2.0 0.0 1.5 -1.5 0.25 3.75 7/2 -7/2 1/3 -2/3 (complex 1 2) (complex 0 1) (complex 4 -2) :a "s" NIL))
(def {n} 0) (def {bad} 0)
(fun {nope what a b got want} {do (set! bad (+ bad 1)) (print "BAD" what (repr a) (repr b) got want)})
(fun {same what f g a b} {do =(x (res f a b)) =(y (res g a b)) (if (not (eq x y)) (nope what a b x y))})
(each {a vals} (each {b vals} (do
  (set! n (+ n 1))
  (same "div" div old-div a b)
  (same "mod" mod old-mod a b)
  (if (and (int? a) (int? b))
    (if (zero? b)
      (do (same "quot0" quot / a b) (same "rem0" rem / a b))
      (do (same "quot" quot tq a b) (same "rem" rem tr a b)))
    (do
      =(x (res quot a b)) =(y (res rem a b))
      (if (not (eq x {:error "Error: Cannot perform 'quot' on non-integers"})) (nope "quotx" a b x NIL))
      (if (not (eq y {:error "Error: Cannot perform 'rem' on non-integers"})) (nope "remx" a b y NIL)))))))
(print "pairs" n "bad" bad)
(print "quot errors" (res quot 1.5 2) (res rem :a 2) (res quot 7 0) (res rem 0 0))
(print "div errors" (res div :a 1) (res old-div :a 1) (res mod 1 "s") (res old-mod 1 "s") (res div 1.5 0) (res mod (complex 0 1) 1) (res old-mod (complex 0 1) 1))
(print "codes" (eq (error-code (div :a 1)) (error-code (old-div :a 1))) (eq (error-code (mod 1 0)) (error-code (old-mod 1 0))) (eq (error-code (div 1i 1)) (error-code (old-div 1i 1))))
(print "signs" (list (quot 7 2) (rem 7 2) (quot -7 2) (rem -7 2) (quot 7 -2) (rem 7 -2) (quot -7 -2) (rem -7 -2)))
(print "floor" (list (div 7 2) (mod 7 2) (div -7 2) (mod -7 2) (div 7 -2) (mod 7 -2) (div -7 -2) (mod -7 -2)))
(print "edges" (list (quot -16384 -1) (div -16384 -1) (rem -16384 -1) (quot 16383 -1) (quot -16384 1) (rem -16384 16383) (div -16384 16383) (mod 16383 -16384)))
(print "past" (list (quot 100000 7) (rem -100000 7) (div -100000 7) (mod -100000 7) (quot (pow 10 30) -7) (rem (pow 10 30) -7) (div (pow 10 30) -7) (mod (pow 10 30) -7)))
(print "library" (list (divmod 7 2) (divmod -7 2) (% -7 3) (odd? 7) (even? -4) (div 7.5 2) (mod 7.5 2) (mod -7/2 1)))
(fun {qr a b} {list (quot a b) (rem a b) (div a b) (mod a b)})
(print "compiled" (qr 1000 -7) (qr 22500 50) (qr -22500 50) ((quot 100) 7))
(print "status" ?((zero? bad) :ok :bad))
