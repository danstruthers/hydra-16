; hydra.hl - hylang's own checks of what only the Hydra has (docs/hylang.md, "Made for the Hydra"): the Hydra's
; built-ins (the system, tasks, memory, namespaces, notes, hold) and the sys- functions.  Run as a script, as run.dl is (hylang hydra.hl,
; with danlang's harness.dl beside it on the card): the count, its status 1 if a check failed
(def {hydra-dir} (do
  =(here (fst args))
  =(cut (max (last-index-of here "/") (last-index-of here "\\")))
  (substring here 0 (+ cut 1))))

(load (+ hydra-dir "harness.dl"))
(def {test-file} "hydra")

; the system
(check ((sysinfo) :abi) 1)
(check (> ((sysinfo) :ram-modules) 0) T)
(check (qexpr? ((sysinfo) :free-tasks)) T)
(check ((fst (mods)) :name) "init")
(check ((fst (mods)) :type) :program)
(check ((find (fn {m} {== (m :name) "hylang"}) (mods)) :banks) 7)
(check ((find (fn {m} {== (m :name) "hysnap"}) (mods)) :type) :library)
(check ((find (fn {m} {== (m :name) "cons"}) (mods)) :type) :driver)
(check (errstr :noent) "not found")
(check (errstr 32) "not found")
(check-error (errstr :nosuch) "'errstr' expects an error's code")

; tasks
(check ((task-info (pid)) :name) "hylang")
(check ((task-info (pid)) :state) :ready)
(check ((task-info (pid)) :task) (pid))
(check ((task-info 0) :name) "kernel")
(check ((task-info 15) :name) "cons")
(check (error-code (task-info 9)) :srch)
(check-error (task-info 16) "'task-info' was given a number out of its range")
(check (any? (fn {x} {== (x :name) "cons"}) (ps)) T)
(check (yield) NIL)
(check (sleep-until (+ (ticks) 2)) NIL)

; memory
(check (do (poke 32512 7) (peek 32512)) 7)
(check (do (poke-word 32512 40000) (peek-word 32512)) 40000)
(check-error (peek 65536) "'peek' was given a number out of its range")
(check-error (poke 32512 256) "'poke' was given a number out of its range")
(check-error (peek -1) "'peek' expects a whole number")
(check (> (banks) 0) T)
(def {hy-bank} (bank-alloc 1))
(check (bank-write hy-bank 100 {1 2 255}) NIL)
(check (bank-read hy-bank 100 3) {1 2 255})
(check-error (bank-read hy-bank 8190 3) "'bank-read' was given a number out of its range")
(check-error (bank-write hy-bank 0 {1 256}) "'bank-write' expects a list of bytes (0-255)")
(check (bank-free hy-bank 1) NIL)
(check (error-code (bank-free hy-bank 1)) :inval)
(def {hy-seg} (seg-create 1))
(check (seg-attach hy-seg) NIL)
(check (seg-write hy-seg 0 0 {9 8}) NIL)
(check (seg-read hy-seg 0 0 2) {9 8})
(check (error-code (seg-read hy-seg 1 0 1)) :range)
(check (seg-detach hy-seg) NIL)
(check (error-code (seg-read hy-seg 0 0 1)) :inval)
(check (> ((free) :shared) 0) T)

; namespaces
(check (bind "/rom/bin" "/hy-b") NIL)
(check (elem? "grep" (ls "/hy-b")) T)
(check (unmount "/hy-b") NIL)
(check (error-code (ls "/hy-b")) :noent)
(check (mount "#f" "/hy-r" "x") NIL)
(check (elem? "lib" (ls "/hy-r")) T)
(check ((find (fn {e} {== (e :old) "/hy-r"}) (ns)) :new) "#fx/")
(check (unmount "/hy-r") NIL)
(check-error (bind "/x" "/y" :sideways) "'bind' expects :before, :after or :create")
(check-error (mount "f" "/y") "'mount' expects a device: # and its letter")
(check (any? (fn {e} {== (e :old) "/bin"}) (ns)) T)
(check (newns) NIL)
(check (elem? "rc" (ls "/bin")) T)
(check (elem? (to-str (pid)) (ls "#fr")) T)

; notes
(def {hy-notes} {})
(on-note (fn {n} {do (def {hy-notes} (join hy-notes (list n))) T}))
(note (pid) 20)
(check hy-notes {20})
(note (pid) :alarm)
(check hy-notes {20 :alarm})
(on-note NIL)
(check (error-code (note 15 :alarm)) :perm)
(check-error (note (pid) :nope) "'note' expects a note: :interrupt, :kill, :hangup, :alarm, :brk, or 1-31")

; hold
(check (hold (+ 1 2) (* 3 4)) 12)
(check-error (hold (error "e")) "e")
(check (hold) NIL)

; system calls: sys- and a call's name, its arguments and its value as spec/api.def's hl: line has them, bound as
; it's first looked up (sys partially applied to the name); (sys :name arg...) the same
(check (fst (sys-sysinfo)) 1)
(check (sys-errstr 32) "not found")
(check (sys-getpid) (pid))
(check (sys :getpid) (pid))
(check (sys "getpid") (pid))
(check (to-str sys-getpid) "<function>(sys :getpid)")
(check-error sys-nothing "Unbound Symbol 'sys-nothing'")
(check-error (sys :nothing) "'sys' has no call :nothing")
(check (len (sys-taskinfo (pid))) 25)
(check (len (sys-modinfo 0)) 16)
(check (sys-env-put 255 "hy-sys" "a value") NIL)
(check (sys-env-get 255 "hy-sys") {7 "a value"})
(check (sys-env-get 255 "hy-sys" 2) {5 "value"})
(check (fst (sys-env-name 255 (- (len (env)) 1))) "hy-sys")
(check (sys-env-del 255 "hy-sys") NIL)
(check (error-code (sys-env-get 255 "hy-sys")) :noent)
(check (substring (fst (sys-taskread 255 1 64)) 0 (len (sys-getcwd))) (sys-getcwd))
(check (len (fst (sys-taskread 255 4 1600))) 1536)
(def {hy-t} (sys-spawn "/bin/rc" {"-c" "exit 3"}))
(check (sys-wait hy-t) (list hy-t 1 "3"))                 ; (rc: its status the message)
(check (sys-sleep 1) NIL)
(check (list (sys-yield) (sys-preempt-off) (sys-preempt-on)) {NIL NIL NIL})
(check (>= (sys-ticks) 0) T)
(check (error-code (sys-note (pid) 99)) :inval)
(check (len (sys-banks)) 2)
(check (len (sys-seginfo)) 3)
(def {hy-seg} (sys-seg-create 1))
(check (len (sys-seg-map hy-seg 0)) 2)
(check (sys-seg-detach hy-seg) NIL)
(check (error-code (sys-seg-detach hy-seg)) :inval)
(def {hy-fd} (sys-create "hy-sys.txt" 1))
(check (sys-write hy-fd "hello, sys") 10)
(check (sys-seek hy-fd -4 2) 6)
(check (sys-close hy-fd) NIL)
(def {hy-fd} (sys-open "hy-sys.txt"))
(check (sys-read hy-fd 100) "hello, sys")
(check (sys-seek hy-fd 7) 7)
(check (sys-read hy-fd 100) "sys")
(check ((sys-fstat hy-fd) :length) 10)
(check (sys-close hy-fd) NIL)
(check (sys-wstat "hy-sys.txt" (hash-create {{:name "hy-sys2.txt"}})) NIL)
(check ((sys-stat "hy-sys2.txt") :length) 10)
(check (sys-remove "hy-sys2.txt") NIL)
(check (error-code (sys-open "hy-sys2.txt")) :noent)
(check-error (sys-open "hy-sys2.txt") "hy-sys2.txt: not found")
(def {hy-p} (sys-pipe))
(check (sys-write (snd hy-p) "piped") 5)
(check (sys-write (snd hy-p) {33 10}) 2)
(check (sys-read (fst hy-p) 100) "piped!\n")
(check (list (sys-close (fst hy-p)) (sys-close (snd hy-p))) {NIL NIL})
(def {hy-cwd} (sys-getcwd))
(check (sys-chdir "/") NIL)
(check (sys-getcwd) "/")
(check (sys-chdir hy-cwd) NIL)
(check (sys-bind hy-cwd "/hy-s" 0) NIL)
(check (elem? "hydra.hl" (ls "/hy-s")) T)
(check (sys-unmount NIL "/hy-s") NIL)
(check (len (sys-nsinfo 255 0)) 140)
(check (> (sys-time) 0) T)
(check (len (sys-rtc 0)) 8)
(check-error (sys-open) "'sys-open' takes at least 1 argument, not 0")
(check-error (sys-open "a" 1 2) "'sys-open' takes at most 2 arguments, not 3")
(check-error (sys-getpid 1) "'sys-getpid' takes 0 arguments, not 1")
(check-error (sys-open 5) "'sys-open' expects a string")
(check (error-code (sys-open 5)) :inval)
(check-error (sys-putc 256) "'sys-putc' expects a whole number below 256")
(check-error (sys-sleep 65536) "'sys-sleep' expects a whole number below 65536")
(check-error (sys-seek 0 -3000000000 1) "'sys-seek' expects an integer, -2^31 to 2^32 - 1")
(check-error (sys-spawn "/bin/rc" {1}) "'sys-spawn' expects a list of strings")
(check-error (sys-wstat "x" 5) "'sys-wstat' expects a stat hash")
(check-error (sys-write 1 {1 300}) "'sys-write' expects a string or a list of bytes")

; keys: none waiting (raw till the end: a script reads no line)
(check (key?) NIL)

(print (format "{} checks, {} failed" test-count test-fails))
(exit ?((zero? test-fails) 0 1))
