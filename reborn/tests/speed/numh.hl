; numh.hl - hylang's number work, by stretch (sim/speed.js: (poke 32767 k) starts the kth, 0 ends them)
(fun {fact n} {if (< n 2) 1 (* n (fact (- n 1)))})
(def {big1} (pow 2 100))
(def {big2} 123456789012345678901234567890)
(def {big3} 987654321098765432109876543210)
(fun {w1} {do =(r 0) (dotimes {k 20} (set! r (fact 60))) (len (to-str r))})
(fun {w2} {do =(a big1) (dotimes {k 300} (set! a (+ a big2))) a})
(fun {w3} {do =(r 0) (dotimes {k 100} (set! r (* big2 big3))) (len (to-str r))})
(fun {w4} {do =(r 0) (dotimes {k 100} (set! r (div (* big2 big3) big2))) r})
(fun {w5} {do =(s 0) (dotimes {k 10} (do (set! s 0) (dotimes {i 20} (set! s (+ s (/ 1 (+ i 1))))))) s})
(fun {w6} {do =(s 0) (dotimes {i 300} (set! s (+ s (+ (/ i 3) (/ i 7))))) s})
(fun {w7} {do =(x 0.0) (dotimes {i 300} (set! x (+ x 0.1))) x})
(fun {w8} {do =(x 0) (dotimes {i 200} (set! x (* 1.25 3.5))) x})
(fun {w9} {do =(s "") (dotimes {i 100} (set! s (to-str big1))) (len s)})
(fun {w10} {do =(r 0) (dotimes {i 100} (set! r (val "123456789012345678901234567890"))) r})
(fun {w11} {do =(y 0) (dotimes {i 20} (set! y (sin i))) y})
(fun {w12} {do =(y 0) (dotimes {i 200} (set! y (+ 1.5 2.25))) y})
(fun {w13} {do =(y 0) (dotimes {i 200} (set! y (/ i 3))) y})
(fun {w14} {do =(y 0) (dotimes {i 200} (set! y (+ 1/3 1/7))) y})
(fun {w15} {do =(y 0) (dotimes {i 200} (set! y (< 1.5 2.25))) y})
(poke 32767 1) (w1) (poke 32767 2) (w2) (poke 32767 3) (w3) (poke 32767 4) (w4) (poke 32767 5) (w5)
(poke 32767 6) (w6) (poke 32767 7) (w7) (poke 32767 8) (w8) (poke 32767 9) (w9) (poke 32767 10) (w10)
(poke 32767 11) (w11) (poke 32767 12) (w12) (poke 32767 13) (w13) (poke 32767 14) (w14) (poke 32767 15) (w15)
(poke 32767 0)
(print "done")
