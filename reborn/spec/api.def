# ****************************************************************************
# api.def - the Hydra-16's system calls: the one source of truth (tools/apigen.js makes the jump table, the
# assembly include, the reference, and the emulator's call names from it).
#
# The format:
#   group NAME BASE SLOTS "what it's for"      a block of the jump table: SLOTS entries of 3 bytes from BASE
#   call NAME GROUP impl=SYMBOL [far]          a call: the next free slot of its group; SYMBOL is the kernel's routine
#                                              (far: on another BIOS ROM page, reached through a stub on page 0)
#     in:     the registers it takes            (indented lines, until the next call; "-" for none)
#     out:    what it gives back
#     errors: the error codes it can give       (C = 1, .A = the code; see errors.def)
#     blocks: yes or no                         whether it can wait
#     doc:    what it does                      (more doc: lines go on with it)
#   const NAME VALUE "what it is"              a constant for programs (hydra.inc)
#
# The rules (docs/conventions.md): .A, .X, .Y and r0-r15 in and out; 16-bit results in .A (low) and .X (high);
# C = 0 success, C = 1 failure with the code in .A, always.  Calls are only ever appended to a group: a slot
# never moves, and a withdrawn call keeps its slot and gives E_NOSYS.

group system   $F800 16 "System information and services"
group task     $F830 32 "Tasks: starting and ending them, waiting, scheduling, ticks"
group memory   $F890 16 "Memory: the break, pages, banks, shared segments (phase 1.8)"
group file     $F8C0 32 "Files (phase 2)"
group name     $F920 16 "Namespaces (phase 2)"
group cons     $F950 16 "Console helpers: a byte or a string to stdout, a byte from stdin"
group time     $F980 16 "The clock (phase 5)"
group server   $F9B0 32 "Servers and drivers"
group dbg      $FA10 16 "Debugging and tests: unstable, may change in any version"

# ---- system

call SYSINFO system impl=K_SYSINFO
  in:     -
  out:    .A = the ABI version (1); .X = how many RAM modules are installed; r0 = the free tasks (bit = task)
  errors: -
  blocks: no
  doc:    What the system has.

call ERRSTR system impl=K_ERRSTR
  in:     .A = an error code; r0 = a buffer (32 bytes)
  out:    the error's text in the buffer, zero-terminated ("error $xx" for an unknown code)
  errors: -
  blocks: no
  doc:    An error code as text, for messages.

# ---- task

call EXITS task impl=K_EXITS
  in:     .A = the exit code (0: success); r0 = a message (zero-terminated, 31 characters at most), or 0 for none
  out:    (doesn't return)
  errors: -
  blocks: no
  doc:    End the calling task, with an exit status (Plan 9's exits).  Returning from a program's entry point
  doc:    is EXITS with code 0 and no message.  Everything the task had is released; its parent can WAIT for
  doc:    the status.

call WAIT task impl=K_WAIT
  in:     .A = a task this one started, or $FF for any; r0 = a buffer for the message (32 bytes), or 0
  out:    .A = the task that ended; .X = its exit code; its message in r0's buffer ("" for none)
  errors: E_CHILD (no such child, or none at all), E_INTR (a note came: taken on the way out)
  blocks: yes
  doc:    Wait for a child to end, and take its exit status.  A child that has ended already isn't waited for.

call SPAWN task impl=K_SPAWN far
  in:     r0 = the program's path (through the namespace: /bin/NAME; or #m/NAME, a module in the paged ROM);
  in:     r1 = its arguments (zero-terminated strings, an empty one after the last: 176 bytes at most), or 0;
  in:     .A = flags (SPAWN_NEWGROUP, SPAWN_NEWNS, SPAWN_FDMAP, SPAWN_NOENV); r2 = an fd map (with SPAWN_FDMAP)
  out:    .A = the new task
  errors: E_NOENT (no such file), E_NOEXEC (not a program this kernel runs), E_NOTASK (no free task), E_TOOBIG
  errors: (the arguments), E_INVAL (the map), E_MFILE, E_INTR (and what else OPEN and READ give)
  blocks: yes
  doc:    Start a program in a task of its own.  SPAWN opens the file and reads its HYX2 header (HX_*): a module of
  doc:    the paged ROM (HF_INPLACE: #m's files) runs in place, in its bank (the module directory's of its name); any
  doc:    other program is read into the new task's RAM at its load address ($0800), by the task itself as it
  doc:    starts, and its BSS cleared (one that can't be read ends at once, with the error as its exit code).  It
  doc:    starts at its entry point with r0 pointing to its arguments (at TASK_ARGS: the list), its name the header's.  Its
  doc:    fds: the caller's 0, 1 and 2; or with SPAWN_FDMAP, the map's: a count (SPAWN_FDS at most), then for each
  doc:    of the child's fds from 0 the caller's fd that becomes it ($FF, or a closed one: closed).  Each shares the
  doc:    caller's channel and offset; the rest are closed.  Its parent is
  doc:    the caller, which can WAIT for it.  It's in the caller's note group unless SPAWN_NEWGROUP starts one (its
  doc:    number: the child's), and it shares the caller's namespace unless SPAWN_NEWNS gives it an empty one.  Its
  doc:    environment is a copy of the caller's (SPAWN_NOENV: empty).

call GETPID task impl=K_GETPID
  in:     -
  out:    .A = this task's number
  errors: -
  blocks: no
  doc:    The calling task's number (0-15).

call YIELD task impl=K_YIELD
  in:     -
  out:    -
  errors: -
  blocks: no
  doc:    Let the other tasks run; come back when it's this one's turn again (at once, if nothing else can run).

call SLEEP task impl=K_SLEEP
  in:     .A/.X = ticks (TICK_HZ a second; 0-32767)
  out:    -
  errors: E_INTR (a note woke it early: taken on the way out)
  blocks: yes
  doc:    Sleep for a number of ticks.  The other tasks run meanwhile, or the system idles.

call SLEEP_UNTIL task impl=K_SLEEP_UNTIL
  in:     .A/.X = a tick count (at most 32767 ticks ahead)
  out:    -
  errors: E_INTR (a note woke it early: taken on the way out)
  blocks: yes
  doc:    Sleep until the tick count reaches a value: for steady timing (a time that's passed returns at once).

call TICKS task impl=K_TICKS
  in:     -
  out:    .A/.X = the tick count (TICK_HZ a second; it wraps after about 5.5 minutes)
  errors: -
  blocks: no
  doc:    The scheduler's tick count.

call PREEMPT_OFF task impl=K_PREEMPT_OFF
  in:     -
  out:    -
  errors: -
  blocks: no
  doc:    Hold the CPU: no task switch until the matching PREEMPT_ON (they nest).  Interrupts keep running.

call PREEMPT_ON task impl=K_PREEMPT_ON
  in:     -
  out:    -
  errors: -
  blocks: no
  doc:    Undo PREEMPT_OFF; a task switch that came due meanwhile happens now.

call TASKINFO task impl=K_TASKINFO far
  in:     .A = a task (0-15); r0 = a buffer (TI_SIZE bytes)
  out:    the buffer: TI_STATE, TI_FLAGS, TI_PARENT, TI_CPU (3 bytes: ticks), TI_BANK, TI_TYPE, TI_NAME (16)
  errors: E_SRCH (not a task)
  blocks: no
  doc:    What the kernel knows of a task, for ps (and /proc's source).  A task's CPU time is the ticks that
  doc:    interrupted it.  TI_STATE is 0 for a free task.

call NOTIFY task impl=K_NOTIFY far
  in:     r0 = the note handler, or 0 for none
  out:    -
  errors: -
  blocks: no
  doc:    Set the task's note handler (Plan 9's notify).  A note runs it in the task, in its own code (never in
  doc:    the middle of a system call), with .A = the note: it returns C = 0 to go on where the task was, or
  doc:    C = 1 for the default; it may call EXITS.  A note that comes meanwhile waits for it to return.

call NOTE task impl=K_NOTE
  in:     .A = a task, or NOTE_GROUP | a note group; .X = the note (1-31: NOTE_*)
  out:    -
  errors: E_INVAL (no such note), E_SRCH (no task, or nobody in the group), E_PERM (the kernel task, a driver)
  blocks: no
  doc:    Send a note (Plan 9's postnote).  It wakes the task if it waits: WAIT, PAUSE, SLEEP and GETC end with
  doc:    E_INTR.  With no handler, and for NOTE_KILL always, the task ends with 128 + the note's Unix number
  doc:    (130 for NOTE_INTERRUPT, 137 for NOTE_KILL) and its name as the message.

call MODINFO task impl=K_MODINFO far
  in:     .A = an entry of the module directory (0 on); r0 = a buffer (ME_SIZE bytes)
  out:    the buffer: ME_BANK, ME_BANKS, ME_TYPE (HT_*), ME_FLAGS (HF_*), ME_NAME (12, zero-padded)
  errors: E_NOENT (past the last)
  blocks: no
  doc:    A module in the paged ROM (SPAWN's #m/NAME), as the module directory has it.

call ENV_GET task impl=K_ENV_GET far
  in:     .A = a task ($FF: this one); r0 = a variable's name; r1 = a buffer; r2 = its size; r3 = an offset in the
  in:     value
  out:    .A/.X = the value's length from the offset (0 at its end or past it); as much of it as fits, in the buffer
  errors: E_NOENT (no such variable), E_SRCH (no such task), E_INVAL (an empty name, or one with a /), E_NAMETOOLONG
  blocks: no
  doc:    A variable of a task's environment (each task has its own: ENV_SIZE bytes; SPAWN copies its parent's).
  doc:    A value is any bytes (rc's lists: each word and a 0).  #e serves the caller's as files, /env/NAME.

call ENV_PUT task impl=K_ENV_PUT far
  in:     .A = a task ($FF: this one); r0 = a variable's name; r1 = bytes; r2 = their count; r3 = where in its value
  in:     they go (the value cut there first: 0 for a new value; its length at most)
  out:    -
  errors: E_NOMEM (no room in the environment), E_INVAL (past the value's end; a bad name), E_SRCH
  errors: E_NOENT (an offset given, and no such variable), E_NAMETOOLONG
  blocks: no
  doc:    Set a variable, or make it (offset 0).  An offset is for writing a long value in parts.

call ENV_DEL task impl=K_ENV_DEL far
  in:     .A = a task ($FF: this one); r0 = a variable's name
  out:    -
  errors: E_NOENT, E_SRCH, E_INVAL, E_NAMETOOLONG
  blocks: no
  doc:    Remove a variable.

call ENV_NAME task impl=K_ENV_NAME far
  in:     .A = a task ($FF: this one); .X = which variable (0 on); r0 = a buffer (ENV_NAME_MAX + 1 bytes)
  out:    its name in the buffer, zero-terminated; .A/.X = its value's length
  errors: E_NOENT (past the last), E_SRCH
  blocks: no
  doc:    The variables of an environment, one at a time, in the order they were made.

call TASKREAD task impl=K_TASKREAD far
  in:     .A = a task ($FF: this one); .X = what: TR_ARGS (its arguments: ARGS_MAX bytes) or TR_CWD (its current
  in:     directory: PATH_MAX + 1 bytes); r0 = a buffer that big
  out:    the bytes in the buffer
  errors: E_SRCH, E_INVAL (another what)
  blocks: no
  doc:    Another task's arguments or current directory, as they are now: /proc's args and cwd, ps.  The kernel
  doc:    task copies them a byte at a time, with IRQs off for each.

# ---- memory (BIOS ROM page 1)

call BREAK memory impl=K_BRK far
  in:     r0 = the new end of the program's data (the first byte past it), or 0 to ask
  out:    r0 = the end
  errors: E_INVAL (below the program's own data), E_NOMEM (over pages PAGES_ALLOC gave, or past the top of RAM)
  blocks: no
  doc:    Move the end of the program's data area: Unix's brk (BRK is the 65C02's instruction, so the call is
  doc:    BREAK).  It starts at the top of the module's data and BSS.  The top of a task's RAM is $7FFF ($7EFF
  doc:    in task F).

call PAGES_ALLOC memory impl=K_PAGES_ALLOC far
  in:     .A = pages (256 bytes each)
  out:    r0 = the first one's address; .A = its page
  errors: E_INVAL (0), E_NOMEM
  blocks: no
  doc:    A run of pages of the task's RAM, above the break, taken from the top down: for a language runtime's
  doc:    heap, or a buffer.

call PAGES_FREE memory impl=K_PAGES_FREE far
  in:     .A = pages; r0 = the first one's address
  out:    -
  errors: E_INVAL (not pages PAGES_ALLOC gave this task)
  blocks: no
  doc:    Give pages back.

call BANKS memory impl=K_BANKS far
  in:     -
  out:    .A = the banks the task has (16 for each good RAM module); r0 = the good modules (bit = module)
  errors: -
  blocks: no
  doc:    The task's own RAM banks: module m's are $m0-$mF, selected by writing $00 (the X16's way).  Modules
  doc:    POST found bad aren't counted.

call BANKS_ALLOC memory impl=K_BANKS_ALLOC far
  in:     .A = banks
  out:    .A = the first (for $00)
  errors: E_INVAL (0), E_NOMEM
  blocks: no
  doc:    A run of the task's banks, from the lowest.  Only bookkeeping, so that the libraries in one program
  doc:    don't use the same banks: a program may use its banks without it.

call BANKS_FREE memory impl=K_BANKS_FREE far
  in:     .A = the first bank; .X = how many
  out:    -
  errors: E_INVAL (not banks BANKS_ALLOC gave this task)
  blocks: no
  doc:    Give banks back.

call SEG_CREATE memory impl=K_SEG_CREATE far
  in:     .A = banks (1-128, 8K each)
  out:    .A = the segment (0-15)
  errors: E_INVAL (0), E_NOMEM
  blocks: no
  doc:    A shared segment: shared RAM banks any task can attach to, with the calling task attached.  It
  doc:    stays while a task is attached (SEG_DETACH, or the task's end).

call SEG_ATTACH memory impl=K_SEG_ATTACH far
  in:     .A = a segment
  out:    -
  errors: E_INVAL (no such segment)
  blocks: no
  doc:    Attach the calling task to a segment (attaching twice is once).

call SEG_DETACH memory impl=K_SEG_DETACH far
  in:     .A = a segment
  out:    -
  errors: E_INVAL (not attached)
  blocks: no
  doc:    Detach the calling task from a segment; the last task to go frees it.

call SEG_MAP memory impl=K_SEG_MAP far
  in:     .A = a segment; .X = one of its banks (0 on)
  out:    .A = the value for U; .X = the value for $00
  errors: E_INVAL (not attached), E_RANGE (no such bank in it)
  blocks: no
  doc:    How to reach a bank of a segment: write U, then $00, and it's at $8000-$9FFF.

call SEGINFO memory impl=K_SEGINFO far
  in:     -
  out:    .A = the shared banks segments can have (8K each: the good chips'); .X = those segments have now; r0 =
  out:    the segments in use (bit = segment)
  errors: -
  blocks: no
  doc:    The shared RAM, as free shows it.

# ---- file (BIOS ROM page 2)

call OPEN file impl=K_OPEN far
  in:     r0 = a path; .A = the mode (O_READ, O_WRITE, O_RDWR; | O_TRUNC, O_NONBLOCK)
  out:    .A = an fd
  errors: E_NOENT, E_NODEV (no such device), E_NAMETOOLONG, E_MFILE (no fd free), E_NFILE (no channel free)
  blocks: yes
  doc:    Open a file.  Its server may answer other errors.  (Until namespaces, a path names a device: "#x",
  doc:    then "/" and the path in it.)

call CREATE file impl=K_CREATE far
  in:     r0 = a path; .A = the mode; .X = the new file's mode, high byte (DM_DIR: a directory)
  out:    .A = an fd
  errors: E_NOENT, E_NODEV, E_NAMETOOLONG, E_MFILE, E_NFILE, E_EXIST
  blocks: yes
  doc:    Make a file or a directory, and open it.

call CLOSE file impl=K_CLOSE far
  in:     .A = an fd
  out:    -
  errors: E_BADF (not open)
  blocks: yes
  doc:    Close an fd.  The last fd naming a channel (DUP, SPAWN share them) tells its server.

call READ file impl=K_READ far
  in:     .A = an fd; r0 = a buffer; r1 = a count
  out:    .A/.X = the count read (0: the end of the file)
  errors: E_BADF (not open for reading), E_AGAIN (non-blocking: nothing yet), E_INTR (a note: taken on the way out)
  blocks: yes
  doc:    Read from the fd's offset, and move it on.  A count short of the one asked for is all there is for now
  doc:    (a console line, say).  A directory reads as stat records (SR_SIZE bytes each).

call WRITE file impl=K_WRITE far
  in:     .A = an fd; r0 = the data; r1 = its count
  out:    .A/.X = the count written
  errors: E_BADF (not open for writing), E_AGAIN, E_INTR
  blocks: yes
  doc:    Write at the fd's offset, and move it on.

call SEEK file impl=K_SEEK far
  in:     .A = an fd; r0, r1 = an offset (low word, high word: signed); .X = from: 0 the start, 1 the offset, 2 the end
  out:    r0, r1 = the new offset
  errors: E_BADF, E_INVAL (before the start, or no such from)
  blocks: yes
  doc:    Move an fd's offset (shared by the fds that DUP or SPAWN made of it).

call STAT file impl=K_STAT far
  in:     r0 = a path; r1 = a buffer (SR_SIZE bytes)
  out:    the file's stat record in the buffer (SR_*)
  errors: E_NOENT, E_NODEV, E_NAMETOOLONG, E_MFILE, E_NFILE
  blocks: yes
  doc:    A file's stat record: its name, qid, mode, length, time, device letter.

call FSTAT file impl=K_FSTAT far
  in:     .A = an fd; r0 = a buffer (SR_SIZE bytes)
  out:    the stat record in the buffer
  errors: E_BADF
  blocks: yes
  doc:    An open file's stat record.

call WSTAT file impl=K_WSTAT far
  in:     r0 = a path; r1 = a stat record
  out:    -
  errors: E_NOENT, E_NODEV, E_NAMETOOLONG, E_MFILE, E_NFILE, E_NOSYS (its server changes nothing)
  blocks: yes
  doc:    Change a file from a stat record: its name, its mode (what its server allows).

call FWSTAT file impl=K_FWSTAT far
  in:     .A = an fd; r0 = a stat record
  out:    -
  errors: E_BADF, E_NOSYS
  blocks: yes
  doc:    Change an open file from a stat record.

call REMOVE file impl=K_REMOVE far
  in:     r0 = a path
  out:    -
  errors: E_NOENT, E_NODEV, E_NAMETOOLONG, E_NOTEMPTY, E_NOSYS
  blocks: yes
  doc:    Remove a file, or an empty directory.

call DUP file impl=K_DUP far
  in:     .A = an fd
  out:    .A = a new fd (the lowest free), on the same channel (the same offset)
  errors: E_BADF, E_MFILE
  blocks: no
  doc:    Another fd for an open file.

call DUP2 file impl=K_DUP2 far
  in:     .A = an fd; .X = another (0-15)
  out:    -
  errors: E_BADF
  blocks: yes
  doc:    Make fd .X name the same channel as fd .A, closing what it named first.

call CHDIR file impl=K_CHDIR far
  in:     r0 = a directory's path
  out:    -
  errors: E_NOTDIR, E_NOENT, E_NODEV, E_NAMETOOLONG
  blocks: yes
  doc:    Change the current directory: the name a relative path starts from.  It's kept whole and clean
  doc:    (GETCWD).

call GETCWD file impl=K_GETCWD far
  in:     r0 = a buffer (PATH_MAX + 1 bytes)
  out:    .A = the current directory's length; the directory in the buffer, zero-terminated
  errors: -
  blocks: no
  doc:    The current directory.

call PIPE file impl=K_PIPE far
  in:     -
  out:    .A = an fd to read from; .X = an fd to write to
  errors: E_NODEV (no pipe server), E_MFILE, E_NFILE, E_NOMEM (no pipe free)
  blocks: yes
  doc:    A pipe (#|): what's written to one end is read from the other, 512 bytes held between them.  A read
  doc:    waits for something to read, and is the end (0) once no writer is left; a write waits for room, and is
  doc:    E_PIPE once no reader is left.

# ---- name: the namespace (BIOS ROM page 3).  Its names are found here, Plan 9's way: the longest mount point a
# name starts with (whole elements), then that union's members in order, each with the rest of the name.  A bind
# binds what new is when it's made (a mount point: all of its members).  A # name is its device's, in no namespace

call BIND name impl=K_BIND far
  in:     r0 = new (a path); r1 = old (a path: absolute); .A = MREPL, MBEFORE or MAFTER, and MCREATE
  out:    -
  errors: E_NOENT, E_INVAL, E_NSFULL, E_NODEV, E_NAMETOOLONG
  blocks: yes
  doc:    Bind new at old: in old's place (MREPL), or a union with what's there, new first (MBEFORE) or last
  doc:    (MAFTER); with MCREATE, a CREATE in the union comes to new.  New is what it is now: a mount point
  doc:    itself is all of its union's members, anything else the first of its candidates that's there.  A
  doc:    union's first bind at a directory that's there (and isn't a mount point itself) keeps it as a member.

call MOUNT name impl=K_MOUNT far
  in:     .X = a device letter; r0 = its spec (a string, 8 characters at most), or 0; r1 = old; .A = BIND's flags
  out:    -
  errors: E_NODEV, E_NOENT, E_INVAL, E_NSFULL, E_NAMETOOLONG
  blocks: yes
  doc:    Mount a device's server, with a spec (which of its file trees: '#f' with x is the ROM disk), at old,
  doc:    as BIND does.

call UNMOUNT name impl=K_UNMOUNT far
  in:     r0 = new, or 0; r1 = old
  out:    -
  errors: E_NOENT, E_INVAL, E_NSFULL, E_NAMETOOLONG
  blocks: yes
  doc:    Undo a bind or a mount at old: all of what's there (r0 = 0), or new's member (as BIND finds new).

call NSINFO name impl=K_NSINFO far
  in:     .A = a task ($FF: this one); .X = which entry of its namespace (0 on); r0 = a buffer (NI_SIZE bytes)
  out:    the entry in the buffer (NI_*): its mount point, its device letter and spec, the path in that device,
  out:    its flags (MCREATE) and its place among the union's members
  errors: E_RANGE (past the last), E_SRCH
  blocks: no
  doc:    A namespace's mount entries, one at a time, in the order of the kernel's table: each a member of the
  doc:    union at its mount point, the members in NI_SEQ's order (lowest first).  /proc's ns, and ns.

# ---- cons: helpers for stdin and stdout (fds 0 and 1: init's #c/cons), or the serial port, polled, for a task
# without them (the boot's messages, a driver's)

call PUTC cons impl=K_PUTC
  in:     .A = a byte
  out:    -
  errors: -
  blocks: yes
  doc:    Write a byte to stdout (the X16's CHROUT).

call PUTS cons impl=K_PUTS
  in:     r0 = a string, zero-terminated
  out:    -
  errors: E_INTR (a note came while it waited: taken on the way out)
  blocks: yes
  doc:    Write a string to stdout.

call GETC cons impl=K_GETC
  in:     -
  out:    .A = a byte
  errors: E_EOF (the end of stdin), E_INTR (a note came: taken on the way out)
  blocks: yes
  doc:    Read a byte from stdin, waiting for one (the X16's CHRIN, unechoed).

call PUTHEX cons impl=K_PUTHEX
  in:     .A = a byte
  out:    -
  errors: -
  blocks: yes
  doc:    Write a byte to stdout as two hex digits (for debugging).

# ---- server

call IRQ_OWN server impl=K_IRQ_OWN
  in:     .A = an IRQ line (0-14), or LINE_VIA_T2 (VIA timer 2)
  out:    -
  errors: E_BUSY (another task owns it), E_RANGE (not a line), E_INVAL (the task has no IRQ entry)
  blocks: no
  doc:    Own an IRQ line: its interrupts run the calling task's irq entry, in the calling task.  The entry gets
  doc:    the line in .A, and returns .A = 0, or IRQ_RESCHED to ask for a task switch (it woke a task).  It
  doc:    runs with interrupts off and must not make calls that wait, and with the dispatch's own cycles it
  doc:    must stay under the 200-cycle budget: about 70 cycles of its own (TASK_EVENT, not WAKE, to wake
  doc:    clients; NOTE_QUEUE for a group).  A task's lines are released when it ends.  LINE_VIA_T2 is VIA
  doc:    timer 2: owning it sets the timer one-shot with its interrupt on; the owner starts it (T2CL, then
  doc:    T2CH), and its entry clears the interrupt (reading T2CL, or starting it again).

call IRQ_RELEASE server impl=K_IRQ_RELEASE
  in:     .A = an IRQ line
  out:    -
  errors: E_PERM (not the caller's), E_RANGE
  blocks: no
  doc:    Give an IRQ line back.

call WAKE server impl=K_WAKE
  in:     .A = a task
  out:    -
  errors: -
  blocks: no
  doc:    Make a waiting task (PAUSE) runnable.  From a task or an irq entry.  Waking a task that isn't
  doc:    waiting does nothing.

call PAUSE server impl=K_UPAUSE
  in:     -
  out:    -
  errors: -
  blocks: yes
  doc:    Wait until another task or an irq entry WAKEs this one, or a note comes (taken on the way out).
  doc:    (Wake-ups can come early: look again after.)

call NOTE_POST server impl=K_NOTE_POST
  in:     .A = a task, or NOTE_GROUP | a note group; .X = the note
  out:    -
  errors: E_INVAL, E_SRCH, E_PERM
  blocks: no
  doc:    NOTE without taking the caller's own notes: the note posted, the tasks woken.  From a task, or an irq
  doc:    entry for a task (a group is too many tasks to look at with interrupts off: NOTE_QUEUE).

call SRV_REGISTER server impl=K_SRV_REGISTER far
  in:     .A = a device letter (printable; not #)
  out:    -
  errors: E_INVAL (not a letter), E_EXIST (another task's), E_NOMEM (no room)
  blocks: no
  doc:    Serve a device: its requests ("#x...") come to the calling task's serve entry.  A task may serve
  doc:    several letters (the request block names it: RQ_DEV).  Freed when the task ends.

call SRV_TAKE server impl=K_SRV_TAKE far
  in:     -
  out:    .A = the request (R_*); .Y = the client; the request block in TASK_INBOX, and (R_OPEN, R_CREATE,
  out:    R_REMOVE) the name in TASK_PATH
  errors: -
  blocks: no
  doc:    In the serve entry: take the request being served from the client (srvlib does it).  It notes the
  doc:    server's event count (TASK_EVENT) in RQ_EVENT: a client answered E_AGAIN waits for it to change.

call SRV_REPLY server impl=K_SRV_REPLY far
  in:     TASK_INBOX's RQ_FID, RQ_DONE, RQ_PERM, RQ_EVENT: what the request returns; .A, C: the answer
  out:    .A and C kept
  errors: -
  blocks: no
  doc:    At the end of the serve entry: what the request returns, back to the client (srvlib does it).

call CLIENT_READ server impl=K_CLIENT_READ far
  in:     r0 = here; r1 = there, in the client's view; r2 = a count
  out:    -
  errors: -
  blocks: no
  doc:    Bytes from the client of the request being served (kcopy).

call CLIENT_WRITE server impl=K_CLIENT_WRITE far
  in:     r0 = here (the data); r1 = there, in the client's view; r2 = a count
  out:    -
  errors: -
  blocks: no
  doc:    Bytes to the client of the request being served (kcopy).

call NOTE_QUEUE server impl=K_NOTE_QUEUE
  in:     IRQs off; .X = a note group (0-15); .A = the note's bit: 1 << (note - 1), for a note 1-8
  out:    .X kept
  errors: -
  blocks: no
  doc:    A note to a note group, from an irq entry (a console's Ctrl-C): queued, and posted by the kernel task
  doc:    as soon as it runs.  Short enough for an irq entry: nothing is checked.

call ROMREAD server impl=K_ROMREAD
  in:     .A = a paged ROM bank; r0 = where in it ($A000-$DFFF); r1 = a buffer (not at $A000-$DFFF); r2 = a count
  out:    the bytes in the buffer
  errors: E_PERM (the task owns an IRQ line: its irq entry would find the wrong bank at $A000)
  blocks: no
  doc:    Copy from any bank of the paged ROM, for a module run in place (the storage driver's ROM disk): the
  doc:    bank is the task's own meanwhile, and its module's is put back.

# ---- dbg (for the tests and the debugger: unstable)

call DBG_SCALL dbg impl=K_SCALL
  in:     .Y = a driver task; .A, .X = what its serve entry gets
  out:    .A, .X and C from its serve entry
  errors: E_SRCH (not a task), E_NODEV (it's free or ended, or has no serve entry: a program)
  blocks: yes
  doc:    Call a driver's serve entry directly, in the driver's task (the file layer will make these calls in
  doc:    phase 2).  A driver serves one call at a time: a second caller waits.

call DBG_KCOPY dbg impl=K_DBG_KCOPY
  in:     .A = another task; r0 = an address in this task; r1 = an address in that task; r2 = a byte count;
  in:     C = 0 to copy from this task to that one, C = 1 the other way
  out:    -
  errors: E_SRCH (not a task)
  blocks: no
  doc:    Copy bytes between this task's memory and another's (the kernel's kcopy).

call DBG_PS dbg impl=K_DBG_PS far
  in:     -
  out:    -
  errors: -
  blocks: yes
  doc:    Print a line for each task in use: its number, state, flags, parent, CPU time and name.

# ---- constants for programs

