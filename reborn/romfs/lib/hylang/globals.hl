; globals.hl - hylang's library, loaded as it starts: danlang's lib/globals.dl, as its master has it.
; Special thanks to buildyourownlisp.com for the inspiration from 'lispy'!
:(math.pi    3.14159_26535_89793_23846_26433_83279_50288_41971_69399_37510_58209_74944_59230_78164_06286_20899_86280_34825_34211_70679_82148_08651_32823_06647_09384)
:(math.e     2.71828_18284_59045_23536_02874_71352_66249_77572_47093_69995)
:(math.phi   1.61803_39887_49894_84820_45868_34365_63811_77203_09179_80576)
:(math.gamma 0.57721_56649_01532_86061)

; function definition: fun, fn, fexpr, def, set, set! and let are built in

; join a single element to the front of a list
(fun {cons a b} |{'(a) b})

; composition helpers
(fun {flip f a b} {f b a})
(fun {ghost}      !{&_})
(fun {comp f g x} {f (g x)}) ; Compose

; comparisons
(fun {not a}  ?{a NIL T})
(fun {>= a b} {not (< a b)})
(fun {<= a b} {not (> a b)})
(fun {== a b} {eq a b})
(fun {neg? a} {< a 0})
(fun {pos? a} {< 0 a})

:({<> !=} neq neq)

; test helpers
:(nil?   (== NIL))
:(t?     (== T))
:(zero?  (== 0))
:(one?   (== 1))
:({=0 =1}  zero? one?)
:({0? 1?}  zero? one?)

; logical operators
(fun {xor a b} {and (or a b) (not (and a b))})

; math helper functions
(fun {1+ n}     {+ n 1})
(fun {1- n}     {- n 1})
(fun {>=0 n}    {>= n 0})
(fun {<=0 n}    {<= n 0})
(fun {>0 n}     {> n 0})
(fun {<0 n}     {< n 0})
(fun {!=0 n}    {not (zero? n)})
(fun {!=1 n}    {not (one? n)})
(fun {square n} {* n n})
(fun {cube n}   {* n (square n)})
(fun {recip n}  {/ 1 n})

:(inverse recip)
:(trunc truncate)

; currying
(fun {unpack f l}  !{(cons f l)})
(fun {pack f}      {f &_})

:({apply curry uncurry} unpack unpack pack)

; nth element 
(fun {fst l} {eval ^(l)})
(fun {snd l} {eval ^($(l))})
(fun {thd l} {eval ^($($(l)))})

; zero-based element of list (evaluated)
(fun {nth n l} ?{
  (zero? n)
  (fst l)
  (nth (1- n) $(l))
})

:({first second third fourth fifth sixth seventh eighth ninth tenth}
  (nth 0) (nth 1) (nth 2) (nth 3) (nth 4) (nth 5) (nth 6) (nth 7) (nth 8) (nth 9))

(fun {last l} {nth (1- (len l)) l})

; coalescing operator to find first non-nil argument in the list
(fun {?? a} ?{a a ?(&_ .(?? &_))})

; take n items (as many as there are)
(fun {take n l} ?{
  (and (!=0 n) l)
  |(^(l) (take (1- n) $(l)))
})

; drop n items (as many as there are)
(fun {drop n l} ?{
  (or (zero? n) (nil? l))
  l
  (drop (1- n) $(l))
})

:(skip drop)

; split list at N
(fun {split n l} '{(take n l) (drop n l)})

; is x in l?
(fun {elem? x l} ?{
  l
  ?((eq x (fst l)) T (elem? x $(l)))
})

(fun {has-element? l x} {elem? x l})

; do (built in) evaluates its arguments in turn and returns the last one's value
:(begin do)
:(block do)

; map
(fun {map f l} ?{
  l
  (cons (f (fst l)) (map f $(l)))
})

; filter
(fun {filter f l} ?{
  l
  |(?((f (fst l)) ^(l) NIL) (filter f $(l)))
})

; fold left
(fun {foldl f z l} ?{
  l
  (foldl f (f z (fst l)) $(l))
  z
})

; fold right
(fun {foldr f z l} ?{
  l
  (f (fst l) (foldr f z $(l)))
  z
})

; pairs of items, one from each list, as long as both have them
(fun {zip a b} ?{
  (and a b)
  (cons '((fst a) (fst b)) (zip $(a) $(b)))
  NIL
})

; is f true of any item? of every item?
(fun {any? f l} ?{l ?((f (fst l)) T (any? f $(l))) NIL})
(fun {all? f l} ?{l ?((f (fst l)) (all? f $(l)) NIL) T})

; the first item f is true of (NIL if there's none), and how many it's true of
(fun {find f l} ?{l ?((f (fst l)) (fst l) (find f $(l))) NIL})
(fun {count f l} {len (filter f l)})

; a list's items, and the items of the lists in it, in one list
(fun {flatten l} ?{
  l
  ?((qexpr? (fst l))
    (join (flatten (fst l)) (flatten $(l)))
    (cons (fst l) (flatten $(l))))
  NIL
})

; the items, each once (the first time it comes)
(fun {distinct l} ?{l (cons (fst l) (distinct (remove-all (fst l) $(l)))) NIL})

(fun {sum s}     {foldl + 0 s})
(fun {avg s}     {/ (sum s) (len s)})
(fun {product p} {foldl * 1 p})

(fun {min} {foldl @(NIL ?{(< &1 &2) &1 &2}) (fst &_) $(&_)})
(fun {max} {foldl @(NIL ?{(> &1 &2) &1 &2}) (fst &_) $(&_)})

; Switch/Cond
(fun {cond} ?{
  &_
  ?((fst (fst &_))
    (snd (fst &_))
    .(cond $(&_)))
  (error "Selection not found")
})

;:(switch cond)

(fun {case x} ?{
  &_
  ?((eq x (fst (fst &_)))
    (snd (fst &_))
    .(case (cons x $(&_))))
  (error "Case not found")
})

; math functions
(fun {abs a} ?{
  (num? a)
  ?((<0 a) (- a) a)
  (error "Cannot perform 'abs' on non-number")
})

(fun {floor a} {
  let {
    do
      =(tr (trunc a))
      (<=> (cmp a tr) {< (1- tr)} {tr})
  }
})

(fun {ceil a} {
  let {
    do
     =(tr (trunc a))
     (<=> (cmp a tr) {> (1+ tr)} {tr})
  }
})

(fun {div a b} ?{
  (and (num? a) (num? b))
  (trunc (/ a b))
  (error "Cannot perform 'div' on non-numbers")
})

(fun {mod a b} ?{
  (and (num? a) (num? b))
  (- a (* b (floor (/ a b))))
  (error "Cannot perform 'mod' on non-numbers")
})

:(% mod)

(fun {divmod a b} ?{
  (and (num? a) (num? b))
  (cons (div a b) (list (mod a b)))
  (error "Cannot perform 'divmod' on non-numbers")
})

(fun {fdiv a b} ?{
  (and (num? a) (num? b))
  (to-fixed (/ a b) ?((and (defined? &3) (num? &3)) &3 10))
  (error "Cannot perform 'fdiv' on non-numbers")
})

(fun {frecip n} ?{(defined? &2) (fdiv 1 n &2) (fdiv 1 n)})
:(finverse frecip)

(fun {odd? n} ?{
  (num? n)
  (=1 (mod n 2))
  (error "Cannot perform 'odd?' on non-number")
})

(fun {even? n} ?{
  (num? n)
  (=0 (mod n 2))
  (error "Cannot perform 'even?' on non-number")
})

(fun {positive? a} ?{(num? a) (pos? a) (error "Only numbers can be positive")})
(fun {negative? a} ?{(num? a) (neg? a) (error "Only numbers can be negative")})

:({+? -? 0?} positive? negative? zero?)

(fun {pow a b} ?{
  (-? b)
  (/ 1 (pow a (- b)))
  ?((zero? b)
    1
    ?((even? b)
      (* (pow a (/ b 2)) (pow a (/ b 2)))
      (* a (pow a (1- b)))
    )
  )
})

(fun {minimum} .{min &1})
(fun {maximum} .{max &1})

; String helpers
(fun {starts-with? s sub} {=0 (index-of s sub)})
(fun {ends-with?   s sub} {and (>= (len s) (len sub)) (eq (substring s (- (len s) (len sub))) sub)})
(fun {contains?    s sub} {>=0 (index-of s sub)})

; Repeat: a list of d's values, run n times
(fun {repeat n d} ?{(=0 n) NIL (cons !(d) (repeat (1- n) d))})
:(times repeat)

; Libraries: (use "name") loads lib/name.dl (on the Hydra, /lib/hylang/name.hl) once; NIL, or the error that
; stopped it (then it isn't counted as loaded)
(def {used} {})
(fun {use name} ?{
  (elem? name used)
  NIL
  (do (load name) (set! {used} (cons name used)) NIL)
})

; sort and related
(fun {in?} ?{&2 (or (eq &1 (fst &2)) (in? &1 $(&2)))})
(fun {remove-fst f l} ?{
  l
  (do
    =(hd (fst l))
    =(tl $(l))
    ?(
      (eq f hd)
      tl
      (cons hd (remove-fst f tl))
    )
  )
})

(fun {remove-min} {remove-fst .(min &1) &1})
(fun {remove-max} {remove-fst .(max &1) &1})

(fun {remove-all f l} ?{
  l
  (do
    =(hd (fst l))
    =(tl $(l))
    ?(
      (eq f hd)
      (remove-all f tl)
      (cons hd (remove-all f tl))
    )
  )
})

; sort is built in: (sort l), or (sort l less)
(fun {sort-desc l} {reverse (sort l)})

(fun {best-of n l} {take n (sort-desc l)})
(fun {worst-of n l} {take n (sort l)})

:({top bottom} best-of worst-of)

(fun {between?} ?{(< &1 &2) (and (>= &3 &1) (<= &3 &2)) (between? &2 &1 &3)})
:(><? between?)
(fun {not-between?} {not (between? &1 &2 &3)})
:(!><? not-between?)

(fun {all-between?} ?{&3 (and (between? &1 &2 (fst &3)) (all-between? &1 &2 $(&3))) T})
:(*><? all-between?)

(fun {all-not-between?} ?{&3 (and (not-between? &1 &2 (fst &3)) (all-not-between? &1 &2 $(&3))) T})
:(*!><? all-not-between?)

(fun {not-all-between?} {not (all-between? &1 &2 &3)})
:(!*><? not-all-between?)
