#!/bin/hylang
; hmchar.hl - a HarnMaster character made, as the book's Character article makes one (harn.hl), and written to a file
; (harnfile.c's text) for a game, Dingus Quest Zero's or any other, to read: C's hmchar (games/hmchar) in hylang, the
; same questions, the same profile, the same file.
;
; hmchar.hl [-o file] [-q] [-p species] [-c occupation] [-u culture]
;   -o file    where it's written (default: NAME.hm, in the current directory, NAME the character's)
;   -q         no questions: the first roll kept, an occupation (one of the book's), weapons and option points chosen
;              at random, a name made up
;   -p species the character's species, not rolled: human, elf (Sindarin) or dwarf (Khuzdul), by its first letter
;              (h, e or s, d or k)
;   -c occupation  the occupation, by its name (case ignored, a beginning enough), not asked or drawn, not held to
;              the character's class or sex
;   -u culture a human's culture, not rolled: feudal, imperial, viking or tribal (a beginning enough)
; (C's -s seed, the same character each time, isn't here: hylang's random can't be seeded.  HyForth's hmchar.fs has
; it, and gives the character C's hmchar does)
;
; The steps (Character 1): the attributes rolled, a human's culture too (Character 3: mostly Feudal), kept, or
; rolled again; a deity, the player's choice (Character 12: one of the ten or none, the book's Morality for each a
; guide; -q's none); an occupation, any of the book's that occupations.txt has (C's hmchar's, its lib/hmchar: the
; Occupational Skills table, Character 15; a soldier's unit by the character's culture, Character 27; a cleric's
; church by its deity, Character 23; not yet a mage's, Character 25) that the character's class and sex allow it (the
; book's limits), its skills opened as the book has them (the weapons or crafts it gives chosen); or the player's own
; (11 points, two in a skill at most and three in one, its primary); the five option points spent (Character 16: a
; skill opened at its OML for one, or improved by its SB for one, two points in a skill at most); a name.  Not here:
; the family's occupation and its skills, contacts, the veterans' points.

; The options (before the library: a wrong one is said at once)
(def {quiet} NIL)
(def {out} NIL)
(def {species} NIL)
(def {cname} NIL)
(def {ucult} NIL)
(def {species-of} (fn {w} {do                   ; -p's: h a human, e or s an elf, d or k a dwarf: 0-2, or NIL
  =(c ?((eq w "") "" (str-lower (substring w 0 1))))
  ?((eq c "h") 0 ?((or (eq c "e") (eq c "s")) 1 ?((or (eq c "d") (eq c "k")) 2 NIL)))}))
(def {culture-of} (fn {w} {do                   ; -u's: a beginning of tribal, viking, feudal or imperial: 0-3, or NIL
  =(lw (str-lower w))
  =(m (filter (fn {k} {starts-with? (nth k {"tribal" "viking" "feudal" "imperial"}) lw}) {0 1 2 3}))
  ?((or (eq lw "") (nil? m)) NIL (fst m))}))
(def {a} (tail args))
(while {a} {do
  =(o (fst a))
  ?((and (eq o "-o") (tail a)) (do (set! {out} (snd a)) (set! {a} (tail a)))
  ?((and (eq o "-c") (tail a)) (do (set! {cname} (snd a)) (set! {a} (tail a)))
  ?((and (eq o "-u") (and (tail a) (not (nil? (culture-of (snd a)))))) (do (set! {ucult} (culture-of (snd a)))
    (set! {a} (tail a)))
  ?((and (eq o "-p") (and (tail a) (not (nil? (species-of (snd a)))))) (do (set! {species} (species-of (snd a)))
    (set! {a} (tail a)))
  ?((eq o "-q") (set! {quiet} T)
    (do
      ?((eq o "-s")
        (print-to stderr "hmchar.hl: -s: hylang's random can't be seeded (hmchar.fs and C's hmchar have -s)") NIL)
      (print-to stderr "usage: hmchar.hl [-o file] [-q] [-p species] [-c occupation] [-u culture]")
      (exit 1)))))))
  (set! {a} (tail a))})

(use "harn")
(set! {harn.species} species)

(def {occname} NIL)
(def {name} "")
(def {h} NIL)

; The column the output's at (the occupation's words wrapped as C's are)
(def {col} 0)
(def {say} (fn {tx} {do (write tx) (set! {col} (+ col (len tx)))}))
(def {nl} (fn {} {do (print) (set! {col} 0)}))
(def {w} (fn {tx} {do ?((> (+ col (len tx)) 77) (do (nl) (say "  ")) (say " ")) (say tx)}))

; A line typed, trimmed (the input's end: the end, nothing written)
(def {ask} (fn {q} {do
  (write q)
  (set! {col} 0)
  =(l (read-line))
  ?((nil? l) (do (print) (exit 1)) (str-trim l))}))

(def {weapons} (map harn.skill-of {"axe" "bow" "clu" "dag" "fla" "net" "pol" "shd" "slg" "spr" "swd" "whp" "blo"}))

; A skill named (case ignored, a beginning of its name enough if only one has it), among some: it, :two (more than
; one begins so), or NIL
(def {skill-named} (fn {w among} {do
  =(w (str-lower w))
  =(n (len w))
  =(begins (filter (fn {sk} {eq (str-lower (substring (harn.skill-name sk) 0 (min n (len (harn.skill-name sk))))) w})
    among))
  =(exact (filter (fn {sk} {eq (len (harn.skill-name sk)) n}) begins))
  ?((zero? n) NIL ?(exact (fst exact) ?((nil? begins) NIL ?((nil? (tail begins)) (fst begins) :two))))}))

; ---- The occupations: occupations.txt (lib/hmchar beside hmchar.hl, as rc's $prog has it, else the card's: C's
; hmchar's), read once, those offered the character kept in its order: {:title KIND TEXT}, {:all KIND SKILLS} (a kind's
; every one's skills), {:occ KIND NAME YEARS SKILLS DEITY NUMBER} (DEITY a church's, else 10)
(def {libdir} "/sd/0/games/lib/hmchar")
(def {find-lib} (fn {} {do
  =(p (try (read-file "/env/prog") {""}))
  =(i (last-index-of p "/"))
  =(d (+ ?((>= i 0) (substring p 0 (+ i 1)) "") "lib/hmchar"))
  ?((exists? (+ d "/occupations.txt")) (set! {libdir} d) NIL)}))

(def {items} {})
(def {kind} "")
(def {sect} NIL)
(def {sdty} 10)
(def {dnames} (map str-lower harn.deity-names))
(def {snames} (map (fn {k} {str-lower (harn.skill-name k)}) (range 0 91)))
(def {cnames} (map str-lower harn.culture-names))
(def {xnames} (map str-lower harn.sex-names))
(def {name-in} (fn {l q k} {?(l ?((eq (fst l) q) k (name-in (tail l) q (+ k 1))) k)}))   ; (q's place in l, or its length)
; Whether a header's word (its kind, or a qualifier) lets the character have the group (C's admits, hmocc's): a
; deity's name, if the character's is that deity or it has none (sdty: the deity); a culture's, if it's the
; character's; a class's (Guilded, Noble), if the character's is that or higher; a sex's, if it's the character's; any
; other, yes.  -c's occupation isn't held to the class or the sex
(def {admits} (fn {w} {do
  =(lw (str-lower w))
  =(d (name-in dnames lw 0))
  =(c (name-in cnames lw 0))
  =(k (name-in {"guilded" "noble"} lw 0))
  =(x (name-in xnames lw 0))
  ?((< d 10) (do (set! {sdty} d) (or (eq (h :dty) 10) (eq (h :dty) d)))
  ?((< c 6) (eq (h :culture) c)
  ?((< k 2) (or (not (nil? cname)) (>= (h :social) (+ k 3)))
  ?((< x 2) (or (not (nil? cname)) (eq (h :sx) x)) T))))}))
(def {all-admit} (fn {ws} {?(ws (do =(a (admits (fst ws))) =(r (all-admit (tail ws))) (and a r)) T)}))
; A group's header, [KIND] or [KIND QUALIFIER ...] and its title, if it has one: offered if every word of it admits
; the character
(def {header} (fn {l} {do
  =(i (index-of l "]"))
  =(ws (str-split (substring l 1 (- i 1)) " "))
  (set! {kind} (fst ws))
  (set! {sdty} 10)
  (set! {sect} (all-admit ws))
  =(title (str-trim (substring l (+ i 1))))
  ?((and sect (> (len title) 0)) (set! {items} (cons (list :title kind title) items)) NIL)}))
(def {occ-line} (fn {l} {?(sect (do              ; (Its skills kept as they're written: skills-of splits them)
  =(i (index-of l "|"))
  =(nm (str-trim ?((>= i 0) (substring l 0 i) l)))
  =(r ?((>= i 0) (substring l (+ i 1)) ""))
  =(j (index-of r "|"))
  =(yr (str-trim ?((>= j 0) (substring r 0 j) r)))
  =(sk ?((>= j 0) (substring r (+ j 1)) ""))
  ?((> (len nm) 0)
    (set! {items} (cons ?((eq (str-lower nm) "all") (list :all kind sk) (list :occ kind nm yr sk sdty)) items)) NIL))
  NIL)}))
(def {skills-of} (fn {s} {?((eq (str-trim s) "") {} (map str-trim (str-split s ",")))}))
(def {num} 0)
(def {read-occs} (fn {} {do                    ; (A line at a time: read-lines garbles a file over 8K)
  (set! {items} {})
  =(f (try (open (+ libdir "/occupations.txt")) {NIL}))
  =(l ?(f (read-line f) NIL))
  (while {not (nil? l)} {do
    =(c (substring l 0 1))
    ?((or (eq c ";") (eq (str-trim l) "")) NIL ?((eq c "[") (header l) (occ-line l)))
    (set! {l} (read-line f))})
  ?(f (close f) NIL)
  (set! {items} (map (fn {x} {?((eq (fst x) :occ) (do (set! {num} (+ num 1)) (join x (list num))) x)})
    (reverse items)))}))
(def {occs} (fn {} {filter (fn {x} {eq (fst x) :occ}) items}))

; The menu: each kind's numbers, from its first to its last
(def {upto} (fn {first last} {print ?((eq first last) "" (+ "-" last))}))
(def {menu-kinds} (fn {l k last first} {
  ?(l ?((eq (snd (fst l)) last) (menu-kinds (tail l) (+ k 1) last first)
        (do ?((eq last "") NIL (upto first (- k 1))) (write (+ "  " (snd (fst l)) " " k))
          (menu-kinds (tail l) (+ k 1) (snd (fst l)) k)))
    ?((eq last "") NIL (upto first (- k 1))))}))

; A list of skills said, a comma between (and a full stop after the last: dot), wrapped
(def {say-list} (fn {l dot} {?(l (do (w (fst l)) (say ?((tail l) "," ?(dot "." ""))) (say-list (tail l) dot)) NIL)}))
(def {say-skills} (fn {p l} {do (say p) (say-list l NIL) (nl)}))

; A group listed (its kind's first letter g): its titles, its every one's skills, its occupations three to a line;
; how many
(def {cell} 0)
(def {listed} 0)
(def {brk} (fn {} {do ?((> col 0) (nl) NIL) (set! {cell} 0)}))
(def {pad} (fn {c} {?((< col c) (do (say " ") (pad c)) NIL)}))
(def {title} (fn {tx} {do                         ; (A long one broken at a space past the 68th column)
  =(ws (str-split tx " "))
  (say (fst ws))
  (each (fn {x} {do ?((> col 68) (do (nl) (say "  ")) (say " ")) (say x)}) (tail ws))}))
(def {list-item} (fn {x} {
  ?((eq (fst x) :title) (do (brk) (title (thd x)) (nl))
  ?((eq (fst x) :all) (do (brk) (say-skills (+ "Every " (snd x) ":") (skills-of (thd x))))
    (do
      ?((eq cell 3) (brk) NIL)
      (pad (* cell 26))
      (say (+ ?((< (nth 6 x) 10) "   " "  ") (nth 6 x) " " (nth 2 x)))
      (set! {cell} (+ cell 1))
      (set! {listed} (+ listed 1)))))}))
(def {list-group} (fn {g} {do
  (set! {listed} 0)
  (each (fn {x} {?((eq (substring (snd x) 0 1) g) (list-item x) NIL)}) items)
  (brk)
  listed}))

; The occupation numbered so, or named by a beginning of its name (exactly: that one): it, :two (more than one
; begins so), or NIL
(def {find-occ} (fn {w} {do
  =(l (occs))
  ?((digit? w) (do =(n (val w)) ?((and (> n 0) (<= n (len l))) (nth (- n 1) l) NIL))
    (do
      =(lw (str-lower w))
      =(b (filter (fn {x} {starts-with? (str-lower (nth 2 x)) lw}) l))
      =(e (filter (fn {x} {eq (str-lower (nth 2 x)) lw}) b))
      ?(e (fst e) ?((nil? b) NIL ?((nil? (tail b)) (fst b) :two)))))}))

; A skill of an occupation's: SKILL/N, SKILL (at its OML), Ritual/N (the deity's), or weapons N/M or crafts N/M
; (chosen after: pend, {weapons? N M}); a skill listed twice, the higher
(def {pend} NIL)
(def {raise} (fn {sk m} {do
  =(v ?((zero? m) (harn.get-oml h sk) (* m (harn.get-sb h sk))))
  ?((< (harn.get-ml h sk) v) (harn.put-ml h sk v) NIL)}))
(def {skill-token} (fn {tx} {do
  =(i (index-of tx "/"))
  =(m ?((>= i 0) (val (substring tx (+ i 1))) 0))
  =(nm ?((>= i 0) (substring tx 0 i) tx))
  =(lw (str-lower nm))
  ?((or (starts-with? lw "weapons ") (starts-with? lw "crafts "))
    (set! {pend} (list (starts-with? lw "w") (val (snd (str-split nm " "))) m))
  ?((eq lw "ritual") ?((eq (h :dty) 10) NIL (raise (+ 21 (h :dty)) m))
    (do
      =(sk (name-in snames lw 0))
      ?((< sk 91) NIL (set! {sk} (skill-named nm (range 0 91))))
      ?((or (nil? sk) (eq sk :two)) (print-to stderr (+ "hmchar.hl: occupations.txt: no skill " nm)) (raise sk m)))))}))

; An occupation's skills said (its kind's every one's, then its own), and taken (apply)
(def {take-occ} (fn {x apply} {do
  (each (fn {a} {?((and (eq (fst a) :all) (eq (snd a) (snd x)))
    (do
      =(s (skills-of (thd a)))
      ?(quiet NIL (say-skills (+ "Every " (snd a) ":") s))
      ?(apply (each skill-token s) NIL)) NIL)}) items)
  =(s (skills-of (nth 4 x)))
  ?(quiet NIL (say-skills (+ (nth 2 x) ", " (nth 3 x) " years:") s))
  ?(apply (each skill-token s) NIL)}))

; The weapons (pend's first) or crafts an occupation gives the character to choose: N of them, each opened at its
; OML plus SB times M (a weapon), or at SB times M (a craft)
(def {choose} (fn {} {do
  =(wp (fst pend))
  =(n (snd pend))
  =(m (thd pend))
  =(among ?(wp weapons (range 48 91)))
  ?(quiet NIL (do
    (say (+ (nth (- n 1) {"One" "Two" "Three"}) ?(wp " weapon skill" " craft") ?((> n 1) "s, opened at " ", opened at ")))
    ?(wp (do (say "their OML") ?((zero? m) NIL (say " plus "))) NIL)
    ?((or (> m 0) (not wp)) (say (+ (nth m {"" "" "twice " "three times "}) ?(wp "SB" "their SB"))) NIL)
    (say ?(wp ". The weapons:" ". The crafts:"))
    (say-list (map harn.skill-name among) T)
    (nl)))
  =(got 0)
  (while {< got n} {do
    =(sk ?(quiet (nth (random (len among)) among)
      (skill-named (ask (nth got {"The first: " "The second: " "The third: "})) among)))
    ?((or (nil? sk) (eq sk :two)) (print ?((eq sk :two) "Which? More than one begins so." "That's not one of them."))
      (do
        =(v (+ (* m (harn.get-sb h sk)) ?(wp (harn.get-oml h sk) 0)))
        ?((>= (harn.get-ml h sk) v) ?(quiet NIL (print "That one's chosen already."))
          (do
            (harn.put-ml h sk v)
            (set! {got} (+ got 1))))))})}))

; The skills listed (? at the points' prompt): the open ones at their ML; the others (but the rituals: the character
; has no deity, or its own's open) at the OML they'd open at; three to a line
(def {cells} (fn {l n} {do
  ?(l
    (do
      =(sk (fst (fst l)))
      =(v (snd (fst l)))
      =(nm (harn.skill-name sk))
      (write "  " nm (str-repeat " " (max 0 (- 17 (len nm)))) ?((< v 100) ?((< v 10) "  " " ") "") v)
      ?((eq (mod n 3) 2) (print) NIL)
      (cells (tail l) (+ n 1)))
    ?((zero? (mod n 3)) NIL (print)))}))
(def {list-skills} (fn {} {do
  (print "Your skills, at their ML:")
  (cells (map (fn {sk} {list sk (harn.get-ml h sk)}) (filter (fn {sk} {> (harn.get-ml h sk) 0}) (range 0 91))) 0)
  (print "The others, at the OML they would open at:")
  (cells (map (fn {sk} {list sk (harn.get-oml h sk)})
    (filter (fn {sk} {and (zero? (harn.get-ml h sk)) (or (< sk 21) (> sk 30))}) (range 0 91))) 0)}))

; Points spent, op of them (Character 16's option points; or own, the player's own occupation's): a skill's name opens
; it at its OML for one, or improves an open one by its SB for one; no more than two points in a skill (an option
; point's: an open skill has had one, its opening), but three in one skill, the player's own occupation's primary
(def {spend} (fn {op own} {do
  =(pts (buffer 91))
  (each (fn {k} {?((and (not own) (> (harn.get-ml h k) 0)) (buffer-put pts k 1) NIL)}) (range 0 91))
  =(primary (not own))
  =(left op)
  ?(quiet NIL ?(own (do
      (print)
      (print "Your own occupation, 11 points: a skill's name opens it at its OML (1 point),")
      (print "or improves an open one by its SB (1 point); two points in a skill at most, but")
      (print "three in one, its primary. ? lists them. Enter alone keeps what's left."))
    (do
      (print)
      (print "Five option points: a skill's name opens it at its OML (1 point), or improves an open one by its SB")
      (print "(1 point), no more than two points in a skill. ? lists them. Enter alone keeps what's left."))))
  (while {> left 0} {do
    =(sk ?(quiet (random 91)
      (do =(w (ask (+ "Points left: " left ". A skill: "))) ?((eq w "") :done ?((eq w "?") :list
        (skill-named w (range 0 91)))))))
    ?((eq sk :done) (set! {left} 0)
    ?((eq sk :list) (list-skills)
    ?((or (nil? sk) (eq sk :two)) (print ?((eq sk :two) "Which? More than one begins so." "There's no such skill."))
    ?((and (and (>= sk 21) (<= sk 30)) (or quiet (not (eq sk (+ 21 (h :dty))))))
      ?(quiet NIL (print "Not your deity's ritual."))           ; (-q's draws none)
      (do
        =(p (buffer-get pts sk))
        ?((and (>= p 2) (or primary (> p 2)))
          ?(quiet NIL (print (+ "No more than two points in a skill" ?(own ", or three in one" "")
            ": that one's had its share.")))
          (do
            ?((eq p 2) (set! {primary} T) NIL)
            (buffer-put pts sk (+ p 1))
            =(ml (harn.get-ml h sk))
            ?((zero? ml) (harn.open-skill h sk) (harn.put-ml h sk (+ ml (harn.get-sb h sk))))
            (set! {left} (- left 1))
            ?(quiet NIL (print (+ (harn.skill-name sk) " is " (harn.get-ml h sk)))))))))))})}))

; ---- The culture (Character 3; C's culture, hmocc's): a human's rolled, mostly Feudal (01-70 Feudal, 71-80 Imperial,
; 81-90 Viking, 91-00 Tribal), or -u's; an elf's and a dwarf's harn.create's.  One not Feudal has its own social class
; rolled (the book's table by culture), and so the native tongue's OML again
(def {culture} (fn {} {?((zero? (h :sp)) (do
  =(c ?((nil? ucult) (nth (harn.table {70 80 90 100} (harn.d 100)) {2 3 1 0}) ucult))
  ?((eq c 2) NIL (do
    (hash-put h [:culture c] [:social (harn.table (nth c harn.class-table) (harn.d 100))])
    (harn.put-ml h 19 (harn.get-oml h 19))))) NIL)}))

; ---- The deity (Character 12; C's deity, hmocc's): the player's choice, one of the ten or none (-q's none), the
; book's Morality for each shown as a guide; its ritual skill opened, as harn.create opens a religious character's
(def {morals} {3 13 5 16 5 16 8 18 3 7 3 10 8 18 5 16 8 18 11 18})
(def {deity} (fn {} {do
  (nl)
  (say (+ "A deity (Character 12): the Morality each favours, a guide (yours is " (h :mor) "):"))
  (each (fn {d} {w (+ (nth d harn.deity-names) " " (nth (* 2 d) morals) "-" (nth (+ 1 (* 2 d)) morals)
    ?((< d 9) "," "."))}) (range 0 10))
  (nl)
  =(pick NIL)
  (while {nil? pick} {do
    =(a (str-lower (ask "Which (a beginning enough; Enter alone, none)? ")))
    =(m (filter (fn {d} {starts-with? (str-lower (nth d harn.deity-names)) a}) (range 0 11)))
    ?((eq a "") (set! {pick} 10)
    ?((nil? m) (print "There's no such deity.")
    ?((tail m) (print "Which? More than one begins so.") (set! {pick} (fst m)))))})
  ?((< pick 10) (do
    (hash-put h [:dty pick])
    (harn.open-skill h (+ 21 pick))
    (print (+ (harn.skill-name (+ 21 pick)) " is " (harn.get-ml h (+ 21 pick))))) NIL)}))

; ---- The occupation: one of the book's, chosen (by its number or its name, a group listed by its kind's first
; letter, ? and one its skills shown), or -c's, or -q's at random; its skills opened (an automatic skill listed takes
; the occupation's OML, not the two added: Character 16); or the player's own (:own).  The deity first (Character
; 12), asked of the player
(def {choose-occ} (fn {count} {do
  =(pick NIL)
  (while {nil? pick} {do
    =(a (ask "Which? "))
    =(show (starts-with? a "?"))
    =(p (str-trim ?(show (substring a 1) a)))
    ?((eq p "") NIL
    ?((and (not show) (and (eq (len p) 1) (> (list-group (str-lower p)) 0))) NIL
      (do
        =(x ?((and (digit? p) (eq (val p) (+ count 1))) :own
          ?((and (not (digit? p)) (starts-with? "your own" (str-lower p))) :own (find-occ p))))
        ?((or (nil? x) (eq x :two)) (print ?((eq x :two) "Which? More than one begins so." "There's no such occupation."))
        ?(show ?((eq x :own) (print "Your own: 11 points spent as option points are, three in one skill (its primary).")
            (take-occ x NIL))
          (set! {pick} x))))))})
  pick}))
(def {occupation} (fn {} {do
  ?(quiet NIL (deity))
  (read-occs)
  =(l (occs))
  =(count (len l))
  ?((zero? count) (do (print-to stderr "hmchar.hl: no lib/hmchar/occupations.txt") (exit 1)) NIL)
  ?((and (not quiet) (nil? cname)) (do
    (print)
    (print "An occupation (Character 15; not yet a mage's, Character 25: theirs come with magic):")
    (menu-kinds l 1 "" 0)
    (print (+ "  your own " (+ count 1)))
    (print "A group's first letter lists it; a number or a name chooses one (a beginning")
    (print "enough), and ? before one shows its skills.")) NIL)
  =(pick ?(quiet (nth (random count) l) NIL))
  ?(cname (do
    (set! {pick} (find-occ cname))
    ?((or (nil? pick) (eq pick :two)) (do (print-to stderr "hmchar.hl: -c: no such occupation, or more than one begins so")
      (exit 1)) NIL))
    ?(quiet NIL (set! {pick} (choose-occ count))))
  ?((eq pick :own)
    (do
      (spend 11 T)
      (set! {occname} "")
      (while {eq occname ""} {do (print) (set! {occname} (ask "Your occupation's name: "))}))
    (do
      =(d (nth 5 pick))
      ?((and (< d 10) (eq (h :dty) 10)) (do (hash-put h [:dty d]) (harn.open-skill h (+ 21 d))) NIL)
      (set! {occname} (nth 2 pick))
      (set! {pend} NIL)
      (take-occ pick T)
      ?(pend (choose) NIL)))}))

; ---- The profile
(def {profile} (fn {} {do
  (print)
  (write ?((eq name "") "" (+ name ", ")) (nth (h :sp) harn.species-names) " " (nth (h :sx) harn.sex-names) ", born "
    (bit-and (h :bd) 255) " " (harn.month-name (shr (h :bd) 8)) " (" (harn.sunsign-name (h :ss)) "); "
    (nth (h :culture) harn.culture-names) " " (nth (h :social) harn.class-names))
  (print ?(occname (+ ", " occname) ""))
  (print (+ "" (h :sibrank) " of " (h :famsize) "; " (nth (h :parent) harn.parent-names) ", "
    (nth (h :estrange) harn.estrangement-names) "; clanhead: " (nth (h :clanhead) harn.clanhead-names)))
  (print (+ "" (h :ht) "\", " (nth (h :fr) harn.frame-names) ", " (h :wt) " lb (size " (harn.size h) "); "
    (harn.comeliness-name (h :cml)) " " (h :cml) "; " (nth (h :complexion) harn.complexion-names) ", "
    (nth (h :hair) harn.hair-names) " hair, " (nth (h :eyes) harn.eye-names) " eyes"))
  (print (+ "Strength " (h :str) ", Stamina " (h :sta) ", Dexterity " (h :dex) ", Agility " (h :agl) ", Eyesight "
    (h :eye) ", Hearing " (h :hrg) ", Smell " (h :sml) ", Voice " (h :voi)))
  (print (+ "Intelligence " (h :int) ", Aura " (h :aur) ", Will " (h :wil) ", Morality " (h :mor)))
  (write "Endurance " (harn.end h) ", Move " (harn.move h) ", Piety " (h :pty)
    ?((eq (h :dty) 10) "" (+ " (" (nth (h :dty) harn.deity-names) ")")) "; medical:")
  (medical (h :med))
  (write "Skills (ML):")
  (skills 0 0)}))

(def {medical} (fn {l} {
  ?(l (do (write " " (nth (fst l) harn.medical-names)) (medical (tail l))) (print ?((h :med) "" " none")))}))

; The open skills, from k on, the line's column col (a line 78 at most, as C's)
(def {skills} (fn {k col} {?((< k 91) (do
  =(ml (harn.get-ml h k))
  ?((zero? ml) (skills (+ k 1) col) (do
    =(nm (harn.skill-name k))
    =(w (+ (len nm) 5))
    =(wrap (> (+ col w) 78))
    (write ?(wrap "\n  " " ") nm " " ml)
    (skills (+ k 1) (+ w ?(wrap 1 col))))))
  (print))}))

; ---- Names (-q's): two syllables of a few, Harnic-sounding enough
(def {make-name} (fn {} {set! {name}
  (+ (nth (random 12) {"Al" "Bra" "Dor" "Ka" "Ly" "Mo" "Ne" "Ro" "Sa" "Tor" "Wy" "Ha"})
  (nth (random 11) {"dan" "ric" "nel" "gyn" "wen" "lor" "vik" "mar" "seth" "ka" "ven"}))}))

; ---- The program
(find-lib)
(def {kept} NIL)
(while {not kept} {do
  (set! {h} (harn.create))
  (culture)
  ?(quiet (set! {kept} T)
    (do
      (profile)
      (print)
      =(b (ask "Keep this character, or roll again (k or r)? "))
      ?((and (> (len b) 0) (eq (str-lower (substring b 0 1)) "k")) (set! {kept} T) NIL)))})
(occupation)
(spend 5 NIL)
?(quiet (make-name) (while {eq name ""} {do (print) (set! {name} (ask "A name: "))}))
(profile)
?(out NIL (set! {out} (+ name ".hm")))
(try (harn.write out h (list (+ "name " name) (+ "occupation " occname)))
  {do (print-to stderr (+ "hmchar.hl: " out ": can't write it")) (exit 1)})
(print (+ "Written to " out))
