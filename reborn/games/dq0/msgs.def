# msgs.def - Dingus Quest Zero's messages' payloads: each kind's fields, where they sit in its struct (ENGINE-CRITIQUE.md's
# §2, step 3's second stage; DECISIONS.md's "The messages' payloads, declared").  Read by the build (games/dq0/hubgen.js),
# which writes from it obj/gen/dq0msg.h (hub.h includes it) and the payloads in obj/gen/dq0hub.json (the tests'
# decoders: hubgen's load ().decode, sim/lib/dq0meaning.js's).  What each field means at length is hub.h's, beside its
# kind; this is where it sits.  The layout is hub.h's struct msg as it was: nothing here moves a byte.
#
#   struct NAME                         the struct the kinds after it travel in (hub.h's: struct msg; struct req)
#   KIND[:FORM]  PART; PART ...         a kind's payload: a line indented goes on with the one before
#     a PART:  SLOT FIELD ...           a slot of the struct (msg's a, b, w1, w2, t, x[0] ... x[3]) and its fields
#              SLOT(name) FIELD ...     a packed slot, named whole too: KIND_NAME (m) the slot (to test it for none, to
#                                       copy it, to set it by its packer)
#              < KIND[:FORM]            another's fields, first (I_DEN's: the denizens' intents' head)
#     a FIELD: name                     the slot whole: KIND_NAME (m) is the slot, an lvalue
#              name:N  name:N-M         bit N, bits N to M: KIND_NAME (m) the bits (one bit: in its place, true or not;
#                                       a word's bits 0-7, its low byte)
#              ...=CONST                one bit's constant, the headers' (checked: it must be that bit)
#              ...@FIRST                its values an enum's (FIRST a member): the tests read the member's name;
#              ...@A,B,C  ...@a/b/c     or the enums' of A, B (or A, B the constants themselves), or words for 0, 1, 2
#              ...==CONST[,CONST]       the form's selector: a FORM of the kind is the one whose field has that value
#              ...!  ...+K              a signed byte (bits 0-7); a value stored plus K (an actor's entry plus 1: the
#                                       tests read it less K, the C as it's stored)
#   A slot of flags the headers name (WA_*, KT_*, POS_*) is one field, the slot whole, tested by its flags' names.
# The referee's requests' besides (struct req: the third part):
#   KIND[:FORM]  PART ... -> PART ...   a request, and after its -> its reply's (written over the same slots): a form
#                                       of its own, KIND:reply or KIND:FORM_reply (no request before it: a reply's alone)
#     a SLOT:  x[4-7]                   an array's elements spanned: a word, two bytes; a long, four (the accessor a
#                                       cast of its first byte's address, an lvalue); else its bytes, the address
#              x                        the array whole, its bytes (the address: a reply's struct rs_effect ...)
#     a FIELD: name[]                   a span's bytes, the address, whatever its width (x[0-3] resist[], resist[k])
#   A SLOT alone is its field of its own name (steps, grade); a request has no builder (its slots filled as the code
#   computes them, around its words in the text: a builder's order would move bytes).
#
# Generated for each form (C macros, costing what the hand-packed code did: the images byte for byte the same):
#   KIND_FIELD (m)                      a field of message m (a struct: *p for a pointer's)
#   KIND[_FORM]_SLOT (fields ...)       a packed slot's value, its fields in the order written here (one bit: its bit
#                                       or none; the slot's lowest field as given, the top one cut by the slot, a
#                                       field between them masked to its bits)
#   KIND[_FORM]_SET (m, who, ...)       kind, who and every slot it names set, in the struct's order
# A FORM is another shape of the same kind (the denizens' I_STEP, a search's I_PORTAL): its own builder and packers,
# its fields' accessors KIND_FIELD as the kind's (a name in two forms the same field, or the build stops).  A form
# chosen by a selector (the events': E_TASK:robbed  w1 te:0-7==TE_ROBBED ...) has its own accessors, KIND_FORM_FIELD
# (E_TASK_ROBBED_PURSE), but for its selector and a field the kind's own form has the same (E_TASK_TE, E_TASK_TASK);
# a selector of one value is no argument of its packer or builder, its constant in its place (E_TASK_ROBBED_W1 (purse,
# caught, asleep)).  The tests' decoder reads a denizen's intent by its :den form, if its kind has one, else by the
# kind's; an event by the form its selector chooses, else by the kind's.

struct msg

# ---- The intents (I_*: an actor's, to the world; the UI's for the character, who 0; the denizens' who the actor's
# entry plus 1, their ring the hub's di: the :den forms)

I_DEN           x[0] doing@DO_ROAM; x[1] face          # (Not a kind: the denizens' intents' head, what it's doing now
                                                        #   and the way it faces, 0xFF either as it is)
I_WAIT          a how; w1 tenths; w2(busy) task:8-15@LT_NONE what:1-7 quiet:0
                # (a: WA_MIN, WA_SLEEP, WA_REST, WA_TREAD, WA_DIVE; w1 tenths, or minutes (WA_MIN); w2: a timed work's long task (LT_*)
                #   and its thing's kind (0x80 | it, the long task's what), quiet 1 a thing's handling)
I_WAIT:den      < I_DEN; w1 tenths
I_GO            a head:0-2@H_N; w1 x; w2 y              # (The door or the mouth that way meant: its square, 0 any)
I_CLIMB         a way                                   # (DIR_UP, DIR_DOWN | I_JUMP, I_WELL)
I_CLIMB:den     < I_DEN; w1 x; w2 y; x[2] sn            # (Come along with the character: beside it, its stratum)
I_TURN          a head:0-2@H_N
I_LIGHT         a lit; w1 tenths                        # (1 lit, 0 put out; its time, 0 the lighting's)
I_DIG           a way                                   # (DIR_N ... DIR_W, DIR_DOWN)
I_PORTAL        a act@PA_OPEN; b which@PW_ANY; w1 x; w2 y; x[0] bar; x[1] strike; x[2] hand
                # (What's done, to which (a door, a window); the one meant, its square (0: the one it faces); PA_BAR's
                #   bar's width; what it strikes with, SK_*; the hand it's in, IH_*, 0 the world's to find)
I_PORTAL:search a act@PA_OPEN; b(which) form:0-3@SF_ABOUT way:4-7; w1 tenths; x[0] bar; x[1] strike
                # (PA_SEARCH's: the search's form, SF_*, and its way (H_*); its time)
I_PORTAL:den    < I_DEN; a act@PA_OPEN; b which@PW_ANY; w1 x; w2 y; t step
                # (A door worked by a denizen: its try (a pick's, a force's, a battering's blow), its low bit begun or done)
I_GOTO          a near; w1 x; w2 y                      # (a 1: walked to, across the room, the place's)
I_GOTO:den      < I_DEN; a heard@DE_MOVED; b loud; w1 x; w2 y       # (A dash: what it's heard as, how loud)
I_STEP          w1 head:0-2@H_N keep:8=STEP_KEEP; w2 squares
I_STEP:den      < I_DEN; a heard@DE_MOVED; b loud; w1(way) head:0-2@H_N coarse:9=STEP_COARSE scent:10=STEP_SCENT;
                w2(sense) one:0 feels:1=STEP_FEELS; x[2] nose
                # (A square: coarse, no time, nothing heard; scent, the heading none: the character's scent's way, by
                #   its nose; one always (a square); feels, no darkvision: its way felt in the dark)
I_QUIT          -
I_ATTACK        a foe; b aim; w1 split; x[1] strike; x[2] hand    # (The actor struck at plus 1 (the denizens': 0 the
                                                        #   character); the aim, Z_* | AIM_SHOT, AIM_HARD; as I_PORTAL's;
                                                        #   split, a second struck at by turns, plus 1: B1's, 2026-11-10)
I_ATTACK:den    < I_DEN; a foe; b aim
I_ENTER         < I_DEN; a step; b bleeding; w1 x; w2 y; t ready; x[2] sn; x[3] legs
I_LEAVE         < I_DEN
I_ROUSE         < I_DEN; w1 tenths; w2 whenever         # (Free w1 tenths from now; w2 1, whenever it was free)
I_DONE          w1 turn; t now                          # (who 0: the turn it's done, the clock then)
I_TAKE          a alone; w1 x; w2 y; t thing            # (Walked over to it and taken up; a 1, walked over to alone)
I_TAKE:den      < I_DEN; a want; b unused; w1 x; w2 y; t thing      # (Its wants, TW_*: the world's take rule)
I_STOP          a named@LT_NONE; w1 over                # (The kind named, LT_NONE any; w1 1, a command taking over)
I_GO_ON         -
I_ASK           w1 why@TE_STOPPED                       # (TE_ASK_HEARD: a sound the UI heard)
I_CLOSE         a foe; b aim; w1 walk; w2 run; x[1] strike; x[2] hand     # (w1 1: walked up to alone, no blow;
                                                        #   run, a charge's pace, GA_*, 0 the character's own: B1's)
I_LOOK          w1 tenths; w2 peek                     # (w2 1: through the closed door ahead's little window, or its spy-hole)
I_DISENGAGE     w1 way; w2 flight                       # (H_*, 0xFF away from them; 1 a flight)
I_TRACE         w1(form) how:0-7@TRC_FLOOR sniff:8-15; w2 tenths      # (TRC_*; a sniff's way (H_*, 0xFF about it); 0 the world's)
I_TROD          a how; b stay; w1 x; w2 y; x[1] tkind; x[2] sn  # (who 0: a passing; its face | TS_STAY; the TQs stayed)
I_SWEPT         w1 x; w2 y; x[2] sn
I_KIT           a draw; b faction; w1 x; w2 y; t id; x[0] standing; x[1] dkind; x[2] sn
                # (who 0: a denizen's things made: KT_ROLE, KT_LAIR, KT_PURSE; its lair's home square; its kind)
I_KIT:dig       < I_DEN; a draw; b head; w1 x; w2 y; x[2] with      # (An actor's dig (KT_DIG) or build (KT_BUILD): its
                                                        #   heading, the square dug; what it digs with, DG_*)
I_KIT:rdig      a draw; b head; w1 x; w2 y; x[0] tools; x[2] sn     # (who 0: a record's spell, untested)
I_ROB           < I_DEN; a errand@FE_ROB; b faction; w1 x; w2 y; x[2] keep; x[3] purse
                # (FE_ROB: the takings to w1 w2, RB_HOARD (b's faction's hoard) or RB_HIDE; RB_PURSE, RB_CAUGHT)
I_ROB:fetch     < I_DEN; a errand@FE_ROB; w1 x; w2 y; t thing       # (FE_TAKE: an ally's errand, where it lies)
I_ROB:give      < I_DEN; a errand@FE_ROB; w1 count; w2 kept; t thing   # (FE_GIVE, FE_GIFT: a lot's count, 0 all; kept 1)
I_ROB:rest      < I_DEN; a errand@FE_ROB; b fellow; t thing         # (FE_DROP, FE_PASS (to actor b less 1), FE_THROW)
I_RISE          w1 pos                                  # (POS_*, or POS_HIDE | HD_*)
I_RISE:den      < I_DEN; w1 pos
I_TRAVEL        b place; w1 x; w2 y; x[0] w; x[1] h; x[2] sn       # (The name's entry, TRV_IN, TRV_KIND | a room's kind)
I_LOAD          -
I_GATHER        a family                                # (FM_*: 0 any)
I_NOISE         a loud; b what@NZ_WORK; w1 x; w2 y      # (A noise made: its loudness (1 a whisper, 3 a word, 6 a yell),
                                                        #   what it is (NZ_VOICE, NZ_KNOCK ...), its square, 0 the character's)

# ---- The events (E_*: the world's, what's happened; to the UI's ring (the hub's eq) and the denizens' (dq: E_DEN,
# E_FIGHT, the limbs' E_BEAT); who 0 the character's).  A kind of many meanings has a form for each, chosen by a field's
# value (FIELD==CONST: E_TASK's by its TE_*, E_BEAT's by its WB_*), the kind's own its fields for any other value.  The
# tests' event records keep the slots raw beside the fields (e.a, e.b, e.w1, e.w2, e.t, e.x: sim/lib/dq0meaning.js's),
# so no field of an event is named as a slot is, nor kind, who, line or den.  A square's x and y are sx and sy.
#
# The outcome events (ENGINE-CRITIQUE.md's §3.2, narration as data): what came of an action, its kind the action (E_DIG,
# E_CLIMB, E_PORTAL, E_TRAP), its words the UI's one renderer's (games/dq0/said.c), a row of its phrase table
# (games/dq0/said.txt) chosen by its kind and its outcome.  Each includes E_OUTCOME, their head: who the actor; w1's high
# byte the outcome, its low byte n1, a number of the kind's; b n2, another; x[0-1] the thing it's done to (obj) and
# x[2-3] the thing it's done with (instr), their handles (a thing's id, struct item's; 0 none).  A kind names the head's
# fields its own way (E_DIG's how its outcome, its feet n1): a field of its own in a slot of the head's, within one
# field's bits, takes that field's place (E_TRAP's tk, tt and touch, n1's bits).  The phrase table reads them by those
# names (said.txt's {feet}).  Kinds older than the head, their outcome a field of their own where it's always been
# (E_BEAT's beat, E_HARM's hc, E_TASK's te), are worded by the table too: said.txt's kind lines name the field (stage 2,
# 2026-11-11: their bytes where they were, their senders and the tests' readings as they were).

E_OUTCOME       b n2; w1 n1:0-7 outcome:8-15; x[0-1] obj; x[2-3] instr
                # (Not a kind: the outcome events' head, as I_DEN is the denizens' intents')

E_TIME          b(how) mins:0=WA_MIN asleep:1=WA_SLEEP rest:2=WA_REST; w1 tenths
                # (The time passed, tenths, or minutes (mins); b the character's wait's, its I_WAIT's a)
E_READY         -
E_BYE           -
E_ARRIVE        w1 how:0-7@A_WALKED first:8 halted:9 mouth:10=E_MOUTH_LIT link:12-15
                # (First: the first time there; halted, A_WENT_TO's: stopped short; up or down, the link's kind (O_*),
                #   mouth a well's, its mouth lit far above)
E_NOWAY         w1 why:0-7@N_NO_EXIT actor:8-15                     # (N_DEN: the actor in the way)
E_VIEW          b way; w1 why@V_TURNED                  # (V_FACING, V_SETOFF: b the way it turns, sets off)
E_DIG           < E_OUTCOME; b(spell) tool:0-1 fresh:3 rock:4-7; w1 how:8-15@D_BEGUN feet:0-7
                # (The feet to go; a spell's b its tool's place (the hub's dig_tool), the rock (RK_*), fresh new to it)
E_DIG:notool    < E_OUTCOME; w1 how:8-15==D_NO_TOOL@D_BEGUN into:0-4 lit:5=DN_LIT hands:6=DN_HANDS
                # (What it's into, MAT_* + 1; a light in hand, a chisel and a hammer not both in hand: b the same)
E_NOISE         a loud; b what@NZ_WORK; w1 sx; w2 sy   # (How loud, 0-9; what made it; its square)
E_LEDGE         w1 rise:0-7!                            # (Its rise, a fall less; past LEDGE_MET, what a walk met)
E_CLIMB         < E_OUTCOME; w1 how:8-15@K_BEGUN feet:0-7
E_PORTAL        < E_OUTCOME; a what:0-1@WB_DARK lit:2; b room; w1 pk:0-6@PK_DOOR shows:7=PO_SHOWS po:8-15@PO_NONE; w2 far:0-7
                # (What came of it, the portal's kind; an opening's view told with it (shows): what the look after it
                #   found beyond (level.h's WB_*), lit, the room's kind, how far it sees, squares)
E_PORTAL:search < E_OUTCOME; a reach; b touch; w1 pk:0-6@PK_DOOR po:8-15==PO_FOUND,PO_NOTHING,PO_FOUND_TRAP@PO_NONE
                # (A search's: its reach (the squares searched those nearer than it, squared: the UI's things' search
                #   the same, IO_SEARCH's to), by touch)
E_HARM          w1 hc:0-7@HC_FALL band:8-10 deep:12=E_DEEP shallow:13=E_SHALLOW out:14=E_OUT caught:15=E_CAUGHT
                # (Its cause, its worst wound's band (0 unhurt), knocked senseless; a fall's into water, stopped)
E_HARM:struck   w1 hc:0-7==HC_STRUCK@HC_FALL band:8-10 out:14=E_OUT stopped:15=E_STOPPED     # (The striker too hurt)
E_TRAP          < E_OUTCOME; w1 tk:0-3@TK_PIT tt:4-5@TT_PLATE touch:7 to:8-15@TO_SPRUNG    # (Touch: found by it, in the dark)
E_DEN           a de@DE_MOVED; b loud; w1 sx; w2 sy; x[0] sn; x[1] dkind; x[2] seen; x[3] between
                # (who the actor plus 1: what it did, how loud, its square, stratum and kind; seen, the character
                #   sees the square; the walls and the shut doors between, a loud one's: SOUND.md)
E_LEFT          w1 end                                  # (EL_WAY, EL_SKY; EL_RULE + a theme's take rule)
E_FIGHT         a def; b loud; w1 sx; w2 sy; x[0] sn; x[1] out@O_MISS,FO_GONE,FO_BLED,FO_BOUND; x[2] ff; x[3] words
                # (who the attacker, def the defender (0 the character, else the actor plus 1), at the attacker's
                #   square; how it came out (O_*, FO_*), what it left them in (FF_*), its words in the ring, FIGHT_AT)
E_LIGHT         a sn; w1 sx; w2 sy
E_TAKEN         w1 ir@IR_OK; w2 lit                     # (How it went; the light carried before, the hub's pc_light)
E_TASK          b named@LT_NONE; w1 te:0-7@TE_STOPPED task:8-15@LT_NONE
                # (What came of the long task, its kind; b, TE_NOT's: the kind the stop named; the rest's below)
E_TASK:engaged  b by:0-5+1 quiet:6=TE_QUIET still:7=TE_STILL; w1 te:0-7==TE_ENGAGED,TE_FAR,TE_AWAY,TE_FIGHT@TE_STOPPED
                task:8-15@LT_NONE                       # (The enemy, its entry plus 1)
E_TASK:hurt     b health@H_FINE; w1 te:0-7==TE_ASK_HURT@TE_STOPPED task:8-15@LT_NONE
E_TASK:nofoe    b shock; w1 te:0-7==TE_NO_FOE@TE_STOPPED task:8-15@LT_NONE  # (In shock, in no state to fight)
E_TASK:break    b by:0-5+1; w1 te:0-7==TE_BREAK@TE_STOPPED how:8-15@back/flight/run
E_TASK:free     b none@engaged/near/way; w1 te:0-7==TE_FREE@TE_STOPPED task:8-15@LT_NONE
E_TASK:light    b lamp; w1 te:0-7==TE_LOW,TE_OUT@TE_STOPPED task:8-13@LT_NONE seen:14 another:15
                # (The light's kind; one it sees lying there, another of its name lit still: TO_SEEN, TO_ANOTHER)
E_TASK:robbed   b by+1; w1 te:0-7==TE_ROBBED@TE_STOPPED purse:8 caught:9 asleep:10     # (RB_PURSE ... RB_ASLEEP)
E_TASK:fetched  b by:0-3+1 ft:4-7@FT_TOOK; w1 te:0-7==TE_FETCHED@TE_STOPPED thing:8-15
E_TASK:begun    b what; w1 te:0-7==TE_BEGUN,TE_ASK_SHORT@TE_STOPPED task:8-15@LT_NONE  # (What it's done to)
E_TASK:shot     b shot; w1 te:0-7==TE_NO_SHOT,TE_LOADED,TE_GATHERED,TE_READIED@TE_STOPPED arms:8-15
                # (The missiles', slice 4.7's: b why there's no shot (SH_*), how many gathered, 1 loaded already; the
                #   launcher's or the missile's kind, the catalogue's: said.txt's TASK rows)
E_BEAT          b whose; w1 beat:0-7@WB_QUIET side:8-15@WS_AHEAD
                # (A walk's beat, its side; the body's and the limbs' whose, 0 the character, else the actor plus 1)
E_BEAT:feel     w1 beat:0-7==WB_FEEL@WB_QUIET head:8-10 gait:12-15      # (Set out on in the dark, faster than
                                                        #   feeling its way: gait)
E_BEAT:met      w1 beat:0-7==WB_FELT,WB_OFF,WB_SHORT@WB_QUIET fa:8-15@FA_NONE
E_BEAT:hit      w1 beat:0-7==WB_HIT@WB_QUIET fa:8-11@FA_NONE gait:12-15
E_BEAT:thing    w1 beat:0-7==WB_THING,WB_TRIP,WB_STUMBLE,WB_SPENT,WB_CRUTCH@WB_QUIET thing:8-15     # (A thing's kind, the catalogue's)
E_BEAT:limb     b whose; w1 beat:0-7==WB_DROP,WB_PICKS,WB_DRAWS,WB_READIES,WB_BROKE,WB_EATS,WB_HANDS,WB_THREW,WB_FELL@WB_QUIET
                thing:8-15
                # (The limbs': b whose, 0 the character, else the actor plus 1, | 0x80 a fall unseen; the thing's kind)
E_BEAT:rise     b whose; w1 beat:0-7==WB_RISEN,WB_NOT_UP@WB_QUIET already:8     # (On its feet already; no leg to
                                                        #   stand on)
E_BEAT:swat     w1 beat:0-7==WB_SWAT@WB_QUIET foe:8-15+1
E_BEAT:water    w1 beat:0-7==WB_WATER,WB_SWIM,WB_UNDER,WB_DOUSED@WB_QUIET wet:8-9 runs:15
                # (The water's, the character's: its band, 0 out of it ... 3 out of its depth; a swim's, 1 well, 2 up
                #   again from under; gone under, 1 drowned; running.  said.txt's BEAT rows)
E_BEAT:search   b touch; w1 beat:0-7==WB_SEARCH@WB_QUIET rsw:8-15@RSW_BEGUN; w2 detail; x[0] mx; x[1] my
                # (A room searched whole, as it goes: by touch; detail, a thing's item or kind, the block's (its
                #   middle mx, my), as RSW_* says)
E_BEARING       w1 brg:0-7@BRG_NONE
E_BEARING:sky   b sky; w1 brg:0-7==BRG_SKY@BRG_NONE refusal:8-15@SKP_NONE
                # (The sky seen: b its phase, SKP_*, and what showed it; a shaft's refusal, w1's high byte, b none)

# ---- The UI's own kinds (UK_*: dq0.h's; no world's event, the UI's words of its own, a row of said.txt's each:
# narration as data, stage 4, 2026-11-12).  The UI fills one on the C stack and has it worded (said.c's outcome_words),
# its outcome E_OUTCOME's place; never in the hub

UK_THROW        < E_OUTCOME; w1 ir:8-15@IR_OK how:0-1@TH_HIT hard:2
                # (A throw told: how it went, IR_*; how it came out, TH_*; thrown hard.  obj the thing, text the mark)
UK_SKY          < E_OUTCOME; w1 phase:8-15@SKP_NONE shows:0-7@SKS_WAY
                # (The sky seen: its phase, a shaft's refusal, a rope's; what shows it.  text the time in words)
UK_SWAY         < E_OUTCOME; a order@OR_NONE; b now@AT_HOSTILE; w1 res:8-15@SR_OK how:0-7@SW_LOOK
                # (A sway's answer: its result, its kind, the attitude now, an ally's request.  obj the one it's about
                #   ("the giant rat", "Grub"; "" none), text a name given or a thing to fetch; arg the attitude's move)
UK_FIGHT        < E_OUTCOME; a(ff) adown:0 adead:1 ddown:2 ddead:3 flees:4; b(which) f1:0 f2:1 stray:2 thrown:3
                missile:4 shield:5 again:6 first:7; w1 out:8-15@O_MISS wk:0-2 hard:3 black:4;
                w2(lines) s2:0-1 s3:2-3 au:4 du:5
                # (A blow (an E_FIGHT, its record's): who the attacker; how it came out (O_*; the UI's own gone, bled,
                #   bound for FO_*); what it left them in (FF_*); the record's which (FW_*: whose a fumble, a stumble);
                #   the attacker's weapon's word (0 another, 1 foot, 2 head, 3 bite, 4 claws, 5 none); thrown hard; a
                #   black-out told already; the strikes' lines, the third and the fourth (0 none, 1 a wound, 2 the armour
                #   that stopped it); the attacker, the defender not seen.  w4 the attacker's name, obj the
                #   defender's (none: the character), instr the weapon, w5 the defender's, w6 and text the strikes';
                #   arg the attacker's body)
UK_NO           < E_OUTCOME; w1 no:8-15@U_VERB
                # (A refusal, refuse.c's say_no: U_*, A_*.  text the thing's name, as it's put in)
UK_FIRST        < E_OUTCOME; w1 fs:8-15@FS_THE
                # (A command's first words, sway.c's: their form, FS_*.  arg the verb, FV_*; w4 the word that tells
                #   it apart, "spent "; text its name)
UK_SA           < E_OUTCOME; w1 sa:8-15@SA_HOLD
                # (The world's things' words, coded in things_text (items.h's SAY_AT): its SA_*.  text the thing's
                #   name, obj the other's: refuse.c's tt_words, stage 5, 2026-11-12)
UK_SELF         < E_OUTCOME; w1 my:8-15@MY_WANT v:0-7
                # (The character's own state, its body and its bearings, in words: MY_*; v a number or a choice, n2
                #   another, text a word (a heading's name, the time).  narration as data's rest, 2026-11-15)
UK_AHEAD        < E_OUTCOME; a pl; b rel; w1 ah:8-15@AH_PEER k:0-7; w2 far:0-7 room:8-15
                # (A look one way's words, way.c's focus_words: AH_*; k the opening's noun (BN_*) or a choice, pl its
                #   plural or a choice, rel its way (0 ahead to the left, 1 ahead, 2 to the right), far its squares,
                #   room a room's kind or a choice.  narration as data's rest, 2026-11-15)

UK_LIST         < E_OUTCOME; b d; w1 lf:8-15@LF_LIE v:0-7; w2 r:0-2 pl:3 at:4-7 g:8-9 mail:10
                # (A sentence with a list, the look's lists (the user's, 2026-11-16): LF_*; a its entries (said_li);
                #   v a choice, d squares or a room's kind, r a way (REL8), pl a verb's plural, at where or a choice, g
                #   and mail a denizen's gear.  obj a surface's name, part 8's words for where)
UK_LI           < E_OUTCOME; a tk:0-1 side:2-4; b n; w1 li:8-15@LI_THING f:0-2 sz:3-4 lit:5 kpl:6 the:7; w2 q;
                t nf:0-2 pf:3-4 dur:8-9 lt:10 fuel:11-13 wear:16-18 shut:19-20
                # (A list's entry, struct li: LI_*; f its form, n how many alike, q a count, sz its size made out,
                #   lit, kpl a plural kind's, the: one told already; tk a kind of wall felt, side its sides; a thing's
                #   own words, the world's (items.h's SAY_LI): nf how its count is said, pf its noun's form, dur, lt,
                #   fuel, wear and shut its state.  text its name, w4 its capital)

struct req

# ---- The referee's requests (RS_*: rs.h's, to the referee in a slot of the hub's, the world's or the UI's, or the
# denizens' own, DSLOT; answered by the ruleset's, dq0harn).  A request's fields, then after -> its reply's, written
# over the same slots (a form of its own: KIND:reply, KIND:FORM_reply).  Every request's own, not declared: kind, actor
# and other (who asks about whom: 0 the character, else an actor's entry plus 1; RS_THING not an actor), and the text
# (a request's path or key, a reply's words).  What each means at length is rs.h's, beside its kind

RS_HELLO        -  -> w1 round                          # (The ruleset's round, tenths; its name and generator the text's)
RS_LOAD_PC      -  -> a gait@GA_CREEP; b watch; result bad
                # (The file the text's path; the pace and watchfulness it says; 1 no character, 2 too many tongues)
RS_NEW_ACTOR    c want; w1 record  -> result bad; x summary
                # (Its key the text; its want and fatigue levels, its record (the denizens'); its struct rs_summary)
RS_TEST         a purpose@P_NOTICE_SIGHT; b how; steps  -> grade; result cant
                # (b by purpose: P_SEARCH's, P_DISARM's HIDE_*; P_NOTICE_SIGHT's 1 a hazard underfoot.  1 it can't (by
                #   magic alone, no picks), 2 not a tongue it speaks)
RS_TEST:dig     a purpose@P_NOTICE_SIGHT; b mat@MAT_EARTH; steps  -> grade; result cant; w1 rate; w2 wear
                # (The tool named the text, the one taken back; steps RS_DIG_QUERY no test; half-feet a spell, its wear)
RS_TEST:appraise a purpose@P_NOTICE_SIGHT; b craft@AP_WEAPON; w1 item; steps  -> grade; w2 mastery
                # (The thing's number, its first answer kept; the craft's mastery)
RS_TEST:read    a purpose@P_NOTICE_SIGHT; b how; w1 item; steps  -> grade; result cant
                # (A writing's, its tongue and script the text: 1 no script at all, 2 not the tongue, 3 not the script)
RS_TEST:swim    -> grade; w1 squares; w2 breath         # (A minute's swim: its squares; its breath held, seconds)
RS_TEST:bearing -> grade; result drift                  # (P_BEARING's: a failure's drift, the world's to make)
RS_TEST:draw    -> grade; result opened                 # (P_DRAW's: 1 Drawing opened by it)
RS_CONTEST      a purpose@P_NOTICE_SIGHT; b against@P_NOTICE_SIGHT; steps; c osteps  -> grade; c ograde; result better
                # (The other's purpose and steps (signed); its grade; 1 the actor did better, 2 the other, 0 alike)
RS_ATTACK       a aim@Z_MID; b aspect@AS_BLUNT; c outnumbered; steps; w2(flags) shy:0; x[0] heart; x[4-7] when
                -> result outcome@O_MISS; a whose; b defence@D_AUTO; c af; w1(health) hatt:0-7@H_FINE hdef:8-15@H_FINE;
                w2 out; grade left; x effects
                # (A blow.  flags RS_PRONE_A ... RS_ASLEEP, MS_*, shy a shy creature's; heart RS_HEART's; when its
                #   moment, the clock's tenths (a denizen's its intent's; 0 the clock as it's asked).  whose a fumble
                #   or a stumble was; af AF_*; their healths; the tenths one's out for; left FF_*; its struct rs_effects)
RS_ATTACK:missile a aim@Z_MID; b band; c missile; steps; w1 range; w2(flags) shy:0; x[4-7] when
                # (RS_MISSILE's: its range's band, the kind shot or thrown, the squares; the reply a blow's)
RS_ATTACK:grapple a move@GM_NONE; c(hold) choked:0-6 pinned:7=GH_PIN; steps; w2(flags) shy:0; x[4-7] when
                # (RS_GRAPPLE's: the move; the hold as it stands, the rounds choked; the reply a blow's)
RS_ATTACK:thing c run; w2(flags) shy:0; x[0-3] resist[]; x[4-7] when
                -> result(struck) stop:0 part:1 short:2 broke:3; a drop; b aspect@AS_BLUNT; c worst; w1 harm; w2 out
                # (At RS_THING: the blow's number in a run, the thing's resistance to blunt, edge, point, fire.  The harm
                #   it takes, by aspect; a part struck: hurt enough to stop, its band, out for; stopped short; a weapon
                #   broken, the hands that let go)
RS_ATTACK:rise  -> result outcome@O_MISS; a down            # (O_RISE: 1 still down)
RS_HARM         a cause@HC_FALL; b ground@GR_FLOOR; c how; w1 feet  -> result caught; b band; w2 out; x effects
                # (HC_FALL: how HF_*.  A hold grabbed; the worst wound's band; the tenths it's out for)
RS_HARM:strike  a cause@HC_FALL; b aspect@AS_BLUNT; c dice; w1 impact; w2 zone@Z_MID     # (HC_STRIKE, HC_FIRE: d6s)
RS_HARM:struck  a cause@HC_FALL; c part; w1 impact; w2 run  -> result stop; b band; w2 out; x effects
                # (HC_STRUCK: the striker's own part; the blow's number in a run; hurt enough to stop)
RS_TIME         a about; b pc; w1 minutes; w2 bleeders; x[0] fighting; x[2] drowned; x[8-13] want[];
                x[14](meal) meals:0-6 ration:7; x[15](drink) pints:0-5 taken:6=RT_TAKEN foul:7; x[16-17] spent;
                x[18] aff@AK_NONE; x[19] dose; x[20] air; x[21] flame
                -> result died; b health@H_FINE; c bound; grade news; w1 dead; w2 out; x[4-7] next
                # (0 at rest, 1 about, 2 at vigorous work; 1 the character's too; the actors bleeding, and fighting, a bit
                #   each; 3 drowned; the hub's want and the minutes, the referee's own; a meal, a ration begun; pints
                #   drunk, or a remedy (its kind bits 0-1), foul water; AK_*, its dose, AQ_*, FLM_*.  The character
                #   dead, its health; those that bound their bleeding, and died; news 2 words, 4 hurt anew, 8 a want's
                #   level; the tenths senseless; the clock it's next asked at)
RS_EXERT        a pace; w1 tenths  -> result tired      # (GA_*, GA_WORK, GA_REST, GA_STOOD; 1 a level more)
RS_TREAT        a done  -> result cant; b wound; c how; w1 tenths; x[0] loc
                # (other the patient, the text the part.  a 0 planned: the wound, the treatment (TR_*), where, its time;
                #   1 nothing to treat, 2 not one it can treat itself, 3 no patient)
RS_TREAT:done   a done; b wound; c how; x[0] loc  -> result undone      # (a 1, done: 1 still bleeding, 2 the plan gone)
RS_EQUIP        a how; w1 load; w2 held                 # (0 put away, 1 taken up, the key the text; 2 all to hand)
RS_MORALE       a why@MR_NONE; b field; c bonds; steps; w1 fallen; w2(leaders) band:0-7 faction:8-15
                -> result state@M_STEADY; grade
RS_DESCRIBE     a brief; b what                         # (0 its sheet, 1 brief, 2 its wounds, 3 its state, 4 time's news,
                                                        #   5 its deity's name: RD_DEITY)
RS_SAVE         -  -> result failed                     # (The text the path)
RS_DICE         a(how) seeded:0; b rest; w1 seed; x faces  -> c unrolled; w1 rolled; x sides
                # (The faces next, to a 0, and every die's after; seeded anew from w1.  The dice since, the faces
                #   forced but not rolled, the first ones' sides)
RS_WIELD        b thing; x[0-1] held[]  -> result which  # (At a thing; the kinds held; 1 x[0]'s, 2 x[1]'s, 0 none)
RS_OUTFIT       -  -> result none; a level; w1 money; w2 seed; x[0-1] tags[]; x[2] heft; x[3] bears
                # (0xFF none; its wealth; farthings; its draw's seed; its tags' bits (the ruleset's); its weapons' version; quarter pounds)
