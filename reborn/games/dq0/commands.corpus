# --- naming and meta-commands (question 15) ---
name the sword Linda	VB_NAME_OBJECT	object=sword;name=Linda	near=sword	name a thing
call the room the Mausoleum	VB_NAME_PLACE	place=room;name=Mausoleum	-	call a place
alias the sword as Linda	ERROR:USE_NAME	-	near=sword	question 15: refused, points to name
