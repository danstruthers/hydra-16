# Dingus Quest Zero: the command corpus. One case per line, five tab-separated fields:
#   input <TAB> expected <TAB> roles <TAB> context <TAB> note
# expected: a VB_* action from commands.actions, or ERROR:/QUESTION:/ALIAS: codes from its [results].
# roles: key=value pairs separated by ';' ('-' for none). context: key=value pairs separated by ';':
#   last=<thing>  near=<a,b,...>  facing=<N|E|S|W|...>  pending=<kind:...>  ('-' for none).
# The checker (sim/tools/commandcorpus.js) checks the format, the actions and codes, and coverage.

# --- looking ---
look	VB_OBSERVE_LOCALE	place=here	-	bare look
look around	VB_OBSERVE_LOCALE	place=here	-	around the place
look here	VB_OBSERVE_LOCALE	place=here	-	here is the place
peer	VB_OBSERVE_LOCALE	place=here	-	synonym
gaze	VB_OBSERVE_LOCALE	place=here	-	synonym
gander	VB_OBSERVE_LOCALE	place=here	-	synonym
take a gander	VB_OBSERVE_LOCALE	place=here	-	gander as a phrase
take a look	VB_OBSERVE_LOCALE	place=here	-	question 4
look north	VB_OBSERVE_DIRECTION	direction=N	-	a compass look
look to the north	VB_OBSERVE_DIRECTION	direction=N	-	with 'to the'
look left	VB_OBSERVE_DIRECTION	direction=L	facing=N	relative to facing
look ahead	VB_OBSERVE_DIRECTION	direction=F	facing=N	relative
look down	VB_OBSERVE_DIRECTION	direction=D	-	vertical
look at the wall	VB_OBSERVE_OBJECT	object=wall	near=wall	question 3: a glance
look at me	VB_OBSERVE_OBJECT	object=me	-	'me' only
look through the window	VB_OBSERVE_THROUGH	object=window	near=window	through an opening
look around the corner	VB_OBSERVE_AROUND	object=corner	near=corner	orientation point
look under the table	VB_OBSERVE_OBJECT	object=table	near=table	locative look
look at the dragon	ERROR:NOT_PERCEIVED	-	near=wall	not in sight
look at you	ERROR:NOT_UNDERSTOOD	-	-	question 14: 'you' is refused

# --- examining (question 1, 2) ---
examine the box	VB_EXAMINE_OBJECT	object=box	near=box	synonym of inspect
inspect the box	VB_EXAMINE_OBJECT	object=box	near=box	synonym of examine
look closely at the box	VB_EXAMINE_OBJECT	object=box	near=box	close look
close look at the box	VB_EXAMINE_OBJECT	object=box	near=box	close look, adjective order
take a close look at the box	VB_EXAMINE_OBJECT	object=box	near=box	close look
really look at the box	VB_EXAMINE_OBJECT	object=box	near=box	question 1: 'really' kept
examine	VB_EXAMINE_LOCALE	place=here	-	examine the place
look closely	VB_EXAMINE_LOCALE	place=here	-	close look, the place
examine me	VB_EXAMINE_OBJECT	object=me	-	self
examine you	ERROR:NOT_UNDERSTOOD	-	-	question 14

# --- handling (question 2: close and open) ---
get the sword	VB_RETRIEVE_OBJECT	object=sword	near=sword	the core case
take the sword	VB_RETRIEVE_OBJECT	object=sword	near=sword	take
grab the sword	VB_RETRIEVE_OBJECT	object=sword	near=sword	grab
pick up the sword	VB_RETRIEVE_OBJECT	object=sword	near=sword	pick up is one token
get the sword from the chest	VB_RETRIEVE_OBJECT	object=sword;source=chest	near=sword,chest	from a source
take the lamp off the hook	VB_RETRIEVE_OBJECT	object=lamp;source=hook	near=lamp,hook	from, with 'off'
take	VB_RETRIEVE_OBJECT	object=sword	last=sword	bare take, last named (question 8)
take	ERROR:NOTHING_HERE	-	-	bare take, nothing near (question 8)
take all	VB_RETRIEVE_OBJECT	object=all-near	near=sword,rat	take all
drop the sword	VB_DROP_OBJECT	object=sword	near=sword	drop
put down the sword	VB_DROP_OBJECT	object=sword	near=sword	put down
put the sword in the chest	VB_PUT_OBJECT	object=sword;container=chest	near=sword,chest	put in
put the apple under the table	VB_PUT_OBJECT	object=apple;container=table	near=apple,table	under as a container
use the key	VB_USE_OBJECT	object=key	near=key	use
use the key on the door	VB_USE_OBJECT	object=key;target=door	near=key,door	use on
make use of the key	VB_USE_OBJECT	object=key	near=key	make use of
ready the sword	VB_EQUIP_OBJECT	object=sword	near=sword	question 6: ready is equip
equip the helm	VB_EQUIP_OBJECT	object=helm	near=helm	equip
doff the helm	VB_UNEQUIP_OBJECT	object=helm	-	doff
take off the helm	VB_UNEQUIP_OBJECT	object=helm	-	take off is one token
store the sword	VB_UNEQUIP_OBJECT	object=sword	-	store
stow the sword	VB_UNEQUIP_OBJECT	object=sword	-	stow, a synonym of unequip
put away the sword	VB_UNEQUIP_OBJECT	object=sword	-	put away, a synonym of unequip
put the sword away	VB_UNEQUIP_OBJECT	object=sword	-	put <object> away, the same as put away <object>
open the door	VB_OPEN_OBJECT	object=door	near=door	question 2
open the right door	VB_OPEN_OBJECT	object=door;adj=right	near=door	adjective, not direction
close the door	VB_CLOSE_OBJECT	object=door	near=door	question 2: a close action
close the lid	VB_CLOSE_OBJECT	object=lid	near=lid	question 2
close the door carefully	VB_CLOSE_OBJECT	object=door;manner=carefully	near=door	manner

