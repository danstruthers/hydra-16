help fighting	VB_META_HELP	topic=fighting	-	help by topic
inventory	VB_META_INVENTORY	-	-	inventory
i	VB_META_INVENTORY	-	-	short inventory
map	VB_META_MAP	-	-	map
m	VB_META_MAP	-	-	the map's short form (the user's, 2026-10-21: not a thing's, the mail hauberk)
save	VB_META_SAVE	-	-	save
quit	VB_META_QUIT	-	-	quit

# --- aliases (question 15, the alias design) ---
alias zz is take off	ALIAS:DEFINE	alias=zz;substitution=take off	-	define with 'is'
alias zz = take off	ALIAS:DEFINE	alias=zz;substitution=take off	-	define with '='
alias look	ERROR:BUILT_IN_WORD	alias=look	-	a built-in word
alias zz	ALIAS:SHOW	alias=zz	-	show a meaning
alias	ALIAS:LIST	-	-	list all
unalias zz	ALIAS:REMOVE	alias=zz	-	remove
forget alias zz	ALIAS:REMOVE	alias=zz	-	remove, the longer form
alias zz is take off	QUESTION:OVERWRITE	alias=zz;current=take up;new=take off	zz=take up	overwrite asks first
yes	ALIAS:REPLACE	alias=zz	pending=overwrite:zz:take up:take off	the answer to the overwrite question
no	ALIAS:KEEP	alias=zz	pending=overwrite:zz:take up:take off	the answer to the overwrite question
n	ALIAS:KEEP	alias=zz	pending=overwrite:zz:take up:take off	'n' answers the question, not north
zz sword	VB_UNEQUIP_OBJECT	object=sword	zz=take off	an alias expands once, trailing words added

