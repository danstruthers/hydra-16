# Dingus Quest Zero: the action catalogue. One abstract action per line: NAME then its roles.
# Roles: object, instrument, target, container, source, place, direction, text, manner, topic,
# spell, name, duration, task, distance. Defaults for unsaid roles are in the design doc's action table.
# The result codes at the end are the non-action results of compile().

[actions]
VB_OBSERVE_LOCALE       place
VB_OBSERVE_DIRECTION    direction
VB_OBSERVE_OBJECT       object
VB_OBSERVE_THROUGH      object
VB_OBSERVE_AROUND       object
VB_EXAMINE_OBJECT       object aspect (* aspect: what's judged of it, its value, its quality, both, its weight, its lock, traps, its condition (2026-10-22); none, a closer look *)
VB_EXAMINE_LOCALE       place aspect
VB_RETRIEVE_OBJECT      object source
VB_DROP_OBJECT          object
VB_PUT_OBJECT           object container
VB_USE_OBJECT           object target
VB_EQUIP_OBJECT         object
VB_UNEQUIP_OBJECT       object
VB_OPEN_OBJECT          object instrument
VB_CLOSE_OBJECT         object
VB_MOVE_DIRECTION       direction pace distance
VB_MOVE_TOWARD          object
VB_FACE_DIRECTION       direction
VB_STEP_DIRECTION      direction
VB_SET_PACE            pace
VB_PACE_SHOW            pace
VB_CHARGE              direction pace text
VB_THROW_DIRECTION     object direction distance manner
VB_JUMP                 direction object
VB_SWIM                 direction object
VB_ATTACK_OBJECT        object instrument manner blow engage (* blow: the unarmed blow, or knock out; engage: the target must be engaged first *)
VB_GRAPPLE_OBJECT       object maneuver (* grapple, wrestle, tackle, pin, choke, hold, grab, headlock, throw: the target must be engaged *)
VB_THROW_OBJECT         object target instrument manner
VB_SHOOT_OBJECT         object target instrument
VB_LOAD_OBJECT          object
VB_SAY                 text volume
VB_TELL_OBJECT          object text topic
VB_CAST_SPELL           spell target
VB_EAT_OBJECT           object
VB_DRINK
VB_LIGHT_OBJECT            object container instrument
VB_EXTINGUISH_OBJECT       object container      object
VB_FIND_OBJECT          object
VB_SEARCH               object aspect
VB_LISTEN               object direction
VB_SMELL                object direction
VB_TRACK                object
VB_TARGET_SET           object
VB_TARGET_CLEAR
VB_TARGET_SHOW          target
VB_WAIT                 duration
VB_SLEEP                              short (* length from fatigue, injury and sickness; optional duration; short: a 30-60 minute try *)
VB_SIT
VB_STAND
VB_LIE_DOWN
VB_PRETEND             state
VB_STOP                 task
VB_NAME_OBJECT          object name
VB_NAME_PLACE           place name
VB_META_STATUS
VB_META_HELP            topic
VB_META_INVENTORY
VB_META_MAP
VB_META_SAVE
VB_META_QUIT
VB_ENTER                object
VB_LEAVE                object direction
VB_CLIMB                object direction
VB_DIG                  direction object instrument
VB_WAKE                 object
VB_CROUCH               
VB_HIDE                 object container
VB_SNEAK                direction
VB_KNOCK_OBJECT         object
VB_PUSH_OBJECT          object
VB_PULL_OBJECT          object
VB_GIVE_OBJECT          object target
VB_HOLD_OBJECT          object
VB_LOCK_OBJECT          object instrument
VB_UNLOCK_OBJECT        object instrument
VB_FILL_OBJECT          object source
VB_READ_OBJECT          object
VB_TASTE_OBJECT         object
VB_TOUCH_OBJECT         object
VB_DEFEND               defence
VB_FLEE                 direction
VB_FOLLOW_OBJECT        object
VB_REPEAT               
VB_WHERE                
VB_ATTACK_SPLIT          targets (* one attack per turn, split between the targets in turn; each engaged in turn if not already *)
VB_ENGAGE               object
VB_DISENGAGE            direction pace
VB_PASS
VB_SEQUENCE            steps (* the steps in order, each a whole action; the runtime runs one, then checks for an interrupt (a stop cancels the rest) before the next *)
VB_PRAY                 
VB_PRAY_FOR             task
VB_CALL_INTERVENTION    deity intent
VB_INVOKE               invocation target deity
VB_LEARN_INVOCATION     invocation source
VB_FASTING              
VB_MEMORIZE             spell
VB_UNMEMORIZE           spell
VB_LEARN_SPELL          spell source
VB_RESEARCH             spell
VB_DISPEL               target
VB_COUNTER              spell
VB_RELEASE_PRINCIPLE    object
VB_USE_TALENT           talent target
VB_POSSESS              target
VB_LINK_MIND            target
VB_ACTIVATE             object
VB_INTIMIDATE           target
VB_ORDER                target action
VB_PERSUADE             target topic
VB_ORATE                audience topic
VB_NEGOTIATE            target
VB_FAST_TALK            target topic
VB_TAUNT                target topic
VB_JUDGE_SINCERITY      target
# The game's own (the old parser's commands): a verb alone works on what is in front
VB_BREAK_OBJECT         object lies instrument
VB_RAISE_OBJECT         object lies
VB_LOWER_OBJECT         object lies
VB_BEND_OBJECT          object lies instrument
VB_FORCE_OBJECT         object lies instrument
VB_DISARM_OBJECT        object lies instrument
VB_BAR_OBJECT           object lies
VB_HANG_OBJECT          object support
VB_COMBINE_OBJECT       object other
VB_APPROACH_OBJECT      object lies
VB_DECEIVE              target
VB_THREATEN             target
VB_CALM                 target
VB_BEFRIEND             target
VB_ALLY_COME
VB_ALLY_STAY
VB_ALLY_DISMISS         target
VB_META_SHEET
VB_META_PAUSE
VB_OBSERVE_IN           object

