(* Dingus Quest Zero: the command grammar. Source for the command compiler.
   Revised 2026-10-19 after the user's answers, and including command aliases.

   Notation: ::= defines a rule; "word" is a terminal, matched case-insensitively after normalisation;
   <name> a nonterminal; [ x ] optional; { x } zero or more; ( x | y ) a choice.
   A rule may continue on following lines. Comments are (* ... *).

   open: name noun alias adj number ordinal task-name meta-topic name-word spell-word pretense-word deity-name text
   (the open names come from the game's data: see the design doc, "The grammar"; the checker reads this line) *)

(* ---- Entry ---- *)
<line>           ::= <alias-cmd> | <quoted-speech> | <command> | <sequence>
<quoted-speech> ::= <quoted-text> [ "!" ]   (* said aloud. A w or y directly before the quote is part of the quote token:
                                                 w"Psst" whispers, y"Here!" yells; a quote ending in ! (inside it, or after it) is yelled *)
<quoted-text>    ::= '"' <text> '"'
                                                                (* only while a question is pending (question 13) *)
<command>        ::= <phrase> [ <manner> ]   (* "open the chest carefully", "drop the pick quietly": how, after any command *)
<phrase>         ::= <look> | <examine> | <move> | <face> | <get> | <grab> | <drop> | <put> | <use>
                   | <equip> | <unequip> | <open> | <close> | <attack> | <grapple>
                   | <throw> | <shoot> | <load> | <jump> | <say> | <tell> | <cast> | <eat>
                   | <drink> | <swim> | <find> | <search> | <listen> | <smell> | <track>
                   | <target> | <wait> | <rest> | <sleep> | <stop> | <naming> | <meta>
                   | <step> | <pace-set> | <charge> | <light> | <extinguish> | <posture> | <pretend>
                   | <enter> | <leave> | <climb> | <dig> | <wake> | <hide> | <sneak>
                   | <knock> | <push> | <pull> | <give> | <lock> | <unlock> | <fill> | <dip> | <read> | <taste> | <touch>
                   | <defend> | <flee> | <follow> | <where> | <again>
                   | <knock-out> | <engage> | <disengage> | <pass>
                   | <pray> | <intervene> | <invoke> | <learn-invocation> | <fasting>
                   | <memorize> | <unmemorize> | <learn-spell> | <research> | <dispel> | <counter> | <release>
                   | <talent> | <possess> | <link-mind> | <activate> | <baptise>
                   | <talk>
                   | <sit-on>
                   | <intimidate> | <order> | <persuade> | <orate> | <negotiate> | <fast-talk> | <taunt> | <judge>
                   | <break> | <raise> | <lower> | <bend> | <force> | <disarm> | <rebar> | <hang> | <combine>
                   | <appraise>
                   | <deceive> | <threaten> | <calm> | <befriend> | <approach> | <ally>
                   | <swap>

(* ---- Observing (question 3: "look at" is a glance; question 4: "take a look" is a look) ---- *)
<look>           ::= <LOOK> [ <look-target> ] | <LOOK> <object> "over" | <LOOK> "over" <object>   (* "look the torch over":
                                                 a look at it, 2026-10-22 *)
<look-target>    ::= <direction> | <locale-ref> | [ <look-prep> ] <object>
<locale-ref>     ::= "around" [ <here-ref> ] | "about" | "here" | "this place"
<look-prep>      ::= "at" | "through" | "toward" | "towards" | "around" | "in" | "into" | "inside" | "under" | "behind" | "beside" | "near" | "to" | "on" | "for"   (* "look in the sack", "look on the table": into it, onto it *)
<examine>        ::= <EXAMINE> [ [ "at" ] <thing> [ <for-traps> ] ] | <EXAMINE> <aspect> [ "of" <thing> ]   (* "check the
                                                 chest for traps", "examine the value of the sword", "check its
                                                 condition" (2026-10-22) *)
<EXAMINE>        ::= "x" | [ "take a" ] <DETAIL> <LOOK>   (* "look closely" is an alias of examine: commands.aliases; so are
                                                 check, study and determine *)
<for-traps>      ::= "for" "traps"
(* ---- A thing's aspects judged (added 2026-10-22, the user's: "examine value [of] item", "quality [of] item"): the aspect
   said, or the verb's own (assess its value, judge its quality, appraise both, heft its weight) ---- *)
<appraise>       ::= <APPRAISE> [ <thing> ] | <APPRAISE> <aspect> [ "of" <thing> ] | <JUDGED> "of" <thing>
                   | "what" "is" <thing> "worth" | "how" "well" "made" "is" <thing>
<APPRAISE>       ::= "assess" | "appraise" | "judge" | "heft" | "weigh" | "value" | "price"
<aspect>         ::= [ "the" | "its" ] <ASPECT>
<ASPECT>         ::= "value" | "worth" | "price" | "quality" | "make" | "condition" | "damage" | "weight" | "lock" | "traps"
<JUDGED>         ::= "value" | "worth" | "price" | "quality" | "condition" | "weight"   (* "value of the sword" *)

(* ---- Moving and facing ---- *)
<move>           ::= [ <pace-word> ] [ <MOVE> ] [ <manner> ] <move-dir> [ <number> [ "space" | "spaces" | "square" | "squares" ] ]
                   [ <manner> ]   (* "run north": this move at run; "walk north": the verb; "walk quickly north", "walk
                                     slowly north": a pace said with it, pace.c's (2026-10-22: outright, the dark's) *)
<move-dir>       ::= <direction> [ <TOWARD> <thing> ] | <TOWARD> <thing> | <ALONG> <thing>   (* "go down the stairs", "walk down the corridor", "walk forward to the other side" *)
<face>           ::= [ "change" ] ( "face" | "facing" | "turn" ) [ "half" ] [ "to" ] <direction> | "turn" "around"   (* "turn around" is a half turn: facing back; "turn half left": an eighth *)

(* ---- Handling things (question 2: CLOSE and OPEN are actions) ---- *)
<get>            ::= <GET> [ <object> ] [ <from-phrase> ] [ <hand-phrase> ] | <GET> <object> <off-phrase> | <GET> <object> "up"   (* bare: the last thing named, else things near (question 8); "pick the sword up"; "take the torch in my right hand" (slice 4.1b) *)
<drop>           ::= <DROP> [ <object> ] | "put" <object> "down"   (* bare: the last thing named *)
<put>            ::= <PUT> <thing> <put-prep> <object> | <PUT> <thing> <hand-phrase>   (* "put the bar back in its brackets": back, a way, passed over; "put the dagger in my other hand": held there (slice 4.1b) *)
<put-prep>       ::= "in" | "into" | "inside" | "on" | "onto" | "on top of" | "under" | "against"
<use>            ::= <USE> <object> [ ( "on" | "with" ) <object> ]
<equip>          ::= <EQUIP> [ <object> ] [ <hand-phrase> ]   (* bare: the last thing named; "wield the sword in my left hand" *)
(* ---- The hands (added 2026-10-22, slice 4.1b): the hand a thing goes in, or the one that holds what strikes ---- *)
<hand-phrase>    ::= "in" [ "my" ] ( ( "left" | "right" | "other" | "off" | "main" ) "hand" | "both" "hands" )
<swap>           ::= ( "swap" | "switch" | "change" ) "hands" | "swap"   (* what's in the hands changed over, left to right *)
<unequip>        ::= <UNEQUIP> [ <object> ] | "put" <object> "away" | "take" <object> "off"   (* "put away the sword", "put the sword away", "take the helm off" *)
<open>           ::= "o" [ <thing> [ <USING> <object> ] ]   (* "open" alone: what's in front *)
<close>          ::= "close" [ <thing> ]           (* "close look" is <DETAIL> <LOOK>, not this *)
<from-phrase>    ::= "from" <object> | "out" "of" <object>
<off-phrase>     ::= "off" <object>

(* ---- Fighting ---- *)
<attack>         ::= <ATTACK> [ <thing> [ <USING> <object> [ <hand-phrase> ] ] ]   (* bare: the target, else the nearest foe; "attack the rat with the dagger in my left hand" *)
<USING>          ::= "with" | "using"                (* what it's done with: an instrument, to hand (2026-10-22) *)
<grapple>        ::= <GRAPPLE> <object> | <THROW> <object> | "put" <object> "in" [ "a" ] ( "head" "lock" | "headlock" )   (* a grapple maneuver: the object is engaged; "toss" and "throw" a creature are grapples too *)
<throw>          ::= <THROW> [ <throwing> ] <at-phrase>          (* at something: a target *)
                   | <THROW> [ <throwing> ] <throw-dir>
                   | <THROW>          (* in a direction: a floor square, distance asked *)
<throwing>       ::= <manner> [ <object> ] | <object> [ <manner> ]   (* "throw hard the apple", "throw the apple hard" *)
<throw-dir>      ::= <direction> | "around the corner"
<shoot>          ::= <SHOOT> [ <object> ] [ <at-phrase> ]   (* "fire the bow at the goblin", "shoot at the goblin", "shoot the goblin" *)
<load>           ::= <LOAD> <object>
<at-phrase>      ::= ( "at" | "toward" | "towards" | "to" | "on" ) <object>

(* ---- Other actions ---- *)
<jump>           ::= <JUMP> [ <direction> | ( "over" | "onto" ) <object> ]
<say>            ::= <SAY> <quoted-text> | <VOLUME-SAY> <quoted-text> [ "!" ]   (* yell, scream, whisper *)
<tell>           ::= <TELL> <object> [ "to" | "about" ] ( <quoted-text> | <object> | <phrase> ) | <TELL> <object> "that" <text> { <text> }   (* "tell the goblin that the bridge is out" *)
<cast>           ::= <CAST> [ <det> ] [ <spell-word> ] [ "spell" ] [ <at-phrase> ]       (* "concentrate" alone: the spell in use *)
<eat>            ::= <EAT> <object>
<drink>          ::= <DRINK> [ "from" <object> | <object> ]
<swim>           ::= <SWIM> [ <move-dir> ]
<find>           ::= <FIND> <object>                            (* question 10: FIND locates a known thing *)
<search>         ::= <SEARCH> [ <around> ] [ "for" ] [ <thing> ] | <SEARCH> [ <thing> ] "for" "traps"
                   | <SEARCH> [ <around> ] ( "on" | "in" ) <thing> | <SEARCH> [ "the" ] ( <compass> | <LR> ) "wall"
                   | <GROPE> [ <around> ] [ "for" <thing> | ( "on" | "in" ) <thing> ]
                                                (* question 10: SEARCH looks for hidden things; a long task; "search the
                                                   chest for traps": that thing alone, 2026-10-22; its forms, the same day
                                                   (search.c): "search nearby", "search around", "search the east wall",
                                                   "search the wall to my left", "search around for a dagger", "search
                                                   around on the floor", "search on the table"; by feel, "feel around",
                                                   "feel about for the key", "grope around" *)
<around>         ::= "around" | "about"
<GROPE>          ::= "grope" | "feel"
<listen>         ::= <LISTEN> [ <look-target> ]
<smell>          ::= <SMELL> [ <look-target> ]
<track>          ::= <TRACK> [ "for" ] [ <object> ]
<target>         ::= <TARGET> [ <object> ] | "clear target" | "untarget"
<wait>           ::= <WAIT> [ "for" ] [ <duration> ] | "pass" "the" "time"   (* "wait", "wait for 10 minutes"; "pass the time" is a wait *)
<rest>           ::= [ "short" ] <REST> [ "for" <duration> ]   (* rest and sleep are the same: VB_SLEEP, the player unaware. "short rest" is a sleep of 30 to 60 minutes, which fatigue, illness and injury may turn into a full sleep *)
<sleep>          ::= [ "short" ] <SLEEP> [ "for" <duration> | ( "in" | "on" ) <object> ]   (* VB_SLEEP: its length is not typed (fatigue, injury, sickness); a duration overrides it *)
<stop>           ::= <STOP> [ <task-name> ]                     (* question 9: "stop" alone, or "stop digging" *)
<step>           ::= "step" <direction>                 (* one square; facing unchanged: "step r" *)
<pace-set>       ::= "pace" [ <pace-word> | "walk" ] | "double time" [ "!" ]  (* sets the default pace; "double time!" is a run *)
<pace-word>      ::= "crawl" | "slow walk" | "trot" | "jog" | "run" | "sprint" | "dash"
<charge>         ::= [ "fast" ] "charge" [ "!" ]        (* run at the closest enemy ahead, attack it, shout "Charge!"; fast: a sprint *)

(* ---- Naming and meta-commands (question 15: naming things is "name" or "call") ---- *)
<naming>         ::= <NAME> ( <object> | "room" | "place" ) [ "as" | "the" ] <name-word>
<meta>           ::= <META-WORD> [ <meta-topic> ]
<alias-cmd>      ::= <ALIAS> <alias> ( "is" | "=" ) <substitution>   (* define, or overwrite after a question *)
                   | <ALIAS> <alias>                                   (* show its meaning *)
                   | <ALIAS>                                           (* list them all *)
                   | <UNALIAS> <alias>                                 (* remove *)
<substitution>   ::= <line>                                          (* one command line; no alias definition inside it *)

(* ---- Adjuncts ---- *)
<locative>       ::= <loc-prep> <object>
<loc-prep>       ::= "in" | "on" | "at" | "under" | "behind" | "beside" | "near" | "by" | "against"
                   | "through" | "around" | "over" | "across"
<manner>         ::= "carefully" | "slowly" | "quickly" | "quietly" | "hard" | "gently" | "lightly" | "firmly"
<duration>       ::= <number> ( "minute" | "minutes" | "hour" | "hours" ) | "an hour" | "a minute"
<here-ref>       ::= "me" | "myself"        (* question 14: "me" only, never "you" *)

(* ---- Objects ---- *)
<object>         ::= <object-one> { "and" <object-one> }
<object-one>     ::= <np> | <pronoun> | <me-phrase> | <everything> | <way-out>   (* "the sword and the shield": a list, one command for each *)
<chosen>         ::= ( "closest" | "nearest" | "largest" | "biggest" | "smallest" | "lead" | <ordinal> ) [ "one" ]   (* "the closest", "the second one": of those it perceives *)
<way-out>        ::= [ "the" ] "way" "out"          (* the theme's way out of the dungeon *)
<np>             ::= [ <det> ] ( [ <selector> ] { <adj> } <head> | <chosen> ) | <portion> [ "of" ] <det> { <adj> } <head>
<portion>        ::= "all" | "half" | "both" | <number>   (* "all the sacks", "half the rations", "two of the sacks": how many of them, slice 4.1's *)
<thing>          ::= <object> [ <of-room> ] [ <lies> ]   (* a thing in the place, and where it lies: "the door ahead to my left" *)
<of-room>        ::= "of" [ "the" | "this" ] ( "room" | "chamber" | "hall" | "cave" | "cavern" )   (* "the centre of the room" *)
<lies>           ::= <compass> | <relative>
<det>            ::= "a" | "an" | "the" | "this" | "that" | "these" | "those" | "its"   (* "my coat": <me-phrase> *)
<selector>       ::= <number> | "all" | "every" | "each" | "any" | "both" | <ordinal>
                   | "closest" | "nearest" | "largest" | "biggest" | "smallest" | "lead"
<head>           ::= { <noun> } <name>                (* every word a thing can be called: "the mail hauberk" (a noun: no adjective, number or ordinal) *)
<pronoun>        ::= "it" | "them" | "that" | "this" | "one" | "he" | "she" | "him" | "her"   (* "it": the last thing of any kind (question 7); he, she, him, her: the last person named (context "person=") *)
<me-phrase>      ::= <here-ref> | ( "my" | "your" ) <np>
<everything>     ::= "everything" [ "near" | "here" ] | "all"

(* ---- Directions (question 5: the single letters are commands) ---- *)
<direction>      ::= <compass> | <relative> | <vertical>
<compass>        ::= [ <offto> ] <NS> [ [ "and" ] <EW> ] [ <ofme> ]
                   | [ <offto> ] <EW> [ <ofme> ]
                   | [ <offto> ] <DIAG> [ <ofme> ]   (* ne, nw, se, sw; "northeast" and "north east" are aliases *)
<NS>             ::= "n" | "s"                       (* the short forms; "north" is an alias: commands.aliases *)
<EW>             ::= "e" | "w"
<DIAG>           ::= "ne" | "nw" | "se" | "sw"
<offto>          ::= "off" [ "to the" | "to" ] | "to the" | "to"   (* at least one word: a nullable part would parse two ways *)
<ofme>           ::= "of" <here-ref>
<relative>       ::= [ <offto> ] ( <FB> [ [ "and" ] <side> ] | <side> )   (* "ahead to my left", "behind me on my right", "off to the left" *)
<side>           ::= [ "to my" | "on my" | "on the" ] <LR>
<FB>             ::= "f" | [ "to the" ] "front" [ <ofme> ] | "in front of" [ <here-ref> ]
                   | "b" | "behind" [ <here-ref> ]
<LR>             ::= "l" | "left" | "r" | "right"
<vertical>       ::= "u" | "up" | "over my head" | "above" [ <here-ref> ]
                   | "d" | "down" | "below" | "underneath" | "under" [ <here-ref> | "my feet" ]

(* ---- Lexicon: the classes. Each is one abstract meaning; the words are its synonyms. ---- *)
<LOOK>       ::= "look" | "take a gander" | "take a look"
<DETAIL>     ::= "close" | "in detail"
<MOVE>       ::= "walk" | "go"
<TOWARD>     ::= "to" | "towards" | "toward" | "in the direction of" | "into" | "onto" | "past" | "through"
<ALONG>      ::= "up" | "down" | "along" | "across"   (* up or down a stairway or a ladder; along a passage *)
<GET>        ::= "get" | "take" | "pick up" | "pick"
<DROP>       ::= "drop" | "put down"
<PUT>        ::= "put" | "place"
<USE>        ::= "use" | "make use of"
<EQUIP>      ::= "equip"
<UNEQUIP>    ::= "doff" | "take off" | "put away"
<ATTACK>     ::= "fight" | "slash" | "bash" | "stab" | "punch" | "kick" | "bite" | "headbutt" | "elbow" | "knee" | "slap" | "butt"
<GRAPPLE>    ::= "grapple" | "wrestle" | "tackle" | "pin" | "choke"
<THROW>      ::= "t" | "sling"
<SHOOT>      ::= "fire"
<LOAD>       ::= "draw"
<JUMP>       ::= "j"
<SAY>        ::= "say"
<VOLUME-SAY>  ::= "yell" | "whisper"
<TELL>       ::= "tell"
<CAST>       ::= "c"
<EAT>        ::= "eat"
<DRINK>      ::= "drink"
<LIGHT>      ::= "light" | "turn on"
<EXTINGUISH> ::= "quench" | "put out" | "turn off"
<SWIM>       ::= "swim"
<FIND>       ::= "find" | "where is"
<SEARCH>     ::= "search"
<LISTEN>     ::= "listen"
<SMELL>      ::= "smell" | "sniff"
<TRACK>      ::= "track"
<TARGET>     ::= "target" | "aim at"
<WAIT>       ::= "wait"
<REST>       ::= "rest"
<SLEEP>      ::= "sleep"
<STOP>       ::= "stop"
<NAME>       ::= "name" | "call"
<ALIAS>      ::= "alias"
<UNALIAS>    ::= "unalias" | "forget alias"
<META-WORD>  ::= "status" | "help" | "i" | "map" | "m" | "save" | "q" | "sheet" | "pause"

(* ---- Fire (added 2026-10-19) ---- *)
<light>          ::= <LIGHT> [ "a" ] "fire" | <LIGHT> <object> [ <in-phrase> ] [ <USING> <object> ] | "turn" <object> "on"   (* "light the torch", "start a fire", "turn it on", "light the torch in the sconce" *)
<extinguish>     ::= <EXTINGUISH> [ "the" ] "fire" | <EXTINGUISH> <object> [ <in-phrase> ] | "put" <object> "out" | "turn" <object> "off"   (* "quench the fire", "put out the torch", "put the torch out", "turn it off", "put out the torch in the sconce" *)
<in-phrase>      ::= ( "in" | "on" ) <object>   (* the thing it's in, or on: a sconce's torch *)
(* ---- Posture and pretence (added 2026-10-19) ---- *)
<posture>        ::= <SIT> | <STAND> | <LIE-DOWN> | <CROUCH> | ( "lie" | "lay" ) [ "down" ] ( "on" | "in" ) <object>          (* a change of the standing state; no object *)
<SIT>            ::= "sit" [ "down" ]
<sit-on>        ::= "sit" [ "down" ] "on" <object>   (* sitting on a surface: VB_SIT *)
<STAND>          ::= "stand" [ "up" ] | "get" "up" | "rise"   (* "get up" is a stand, not a get with a direction; "rise" (slice 4.1b: prone, the book's Rise) *)
<LIE-DOWN>       ::= "lie" [ "down" | "prone" ] | "lay" [ "down" ] | "go" "prone" | "prone"
<pretend>        ::= <PRETEND> [ "to" "be" ] <pretense>     (* a state the player does not have: "pretend dead",
                                                             "feign ignorance", "pretend to be asleep" *)
<PRETEND>        ::= "pretend"
<pretense>       ::= <pretense-word> { <pretense-word> }     (* the words of the state, none of them a command word *)
(* ---- Movement, climbing and digging (added 2026-10-19: the gaps the probes found) ---- *)
<enter>          ::= "enter" [ <object> ]
<leave>          ::= <LEAVE> [ <object> | <direction> ]
<LEAVE>          ::= "exit"
<climb>          ::= <CLIMB> [ <direction> ] [ <object> ] | <CLIMB> ( "over" | "onto" | "into" | "through" ) <object>
<CLIMB>          ::= "climb"
<dig>            ::= <DIG> [ <direction> | "for" <object> | <object> ] [ <USING> <object> ]   (* "dig down", "dig the wall",
                                                   "dig for treasure", "dig down with the pick" *)
<DIG>            ::= "dig"
<wake>           ::= <WAKE> [ <object> ] | "wake" <object> "up"   (* "wake the goblin", "wake the goblin up" *)
<WAKE>           ::= "wake" [ "up" ] | "rouse" | "awaken"
(* ---- Stealth ---- *)
<CROUCH>         ::= "crouch" | "kneel" [ "down" ] | "squat"
<hide>           ::= "h" [ <object> ] [ <locative> ]            (* "hide behind the table": the locative adjunct; "hide the pouch": a thing hidden *)
<sneak>          ::= <SNEAK> [ <direction> ]
<SNEAK>          ::= "sneak"
(* ---- Handling and senses ---- *)
<knock>          ::= "knock" [ "on" ] <object>
<push>           ::= <PUSH> <object>
<PUSH>           ::= "push"
<pull>           ::= <PULL> <object>
<PULL>           ::= "pull"
<give>           ::= <GIVE> <object> ( "to" | "for" ) <object>
<GIVE>           ::= "g"
<grab>           ::= ( "grab" | "hold" ) <object> [ <from-phrase> ] [ <hand-phrase> ]   (* a grapple when the object is engaged; else a get, or a carry for hold; "hold the spear in both hands" *)
<lock>           ::= "lock" <thing> [ <USING> <object> ]
<unlock>         ::= "unlock" <thing> [ <USING> <object> ]
                   | ( "unlock" | "pick" ) ( "the" | "its" ) "lock" ( "of" | "on" ) <thing> [ <USING> <object> ]   (* "pick
                                                   the lock of the chest", slice 4.1's; "... with the lockpicks" *)
<fill>           ::= "fill" <object> [ <from-phrase> | "with" <object> ]   (* "fill the lantern", "fill the lantern with oil" (a light renewed, slice 4.1's) *)
<dip>            ::= ( "dip" | "soak" ) <object> ( "in" | "into" ) <object>   (* "dip the torch in the oil", "soak the torch in pitch" *)
<read>           ::= "read" [ <object> ]   (* bare: the last thing named *)
<taste>          ::= "taste" <object>
<touch>          ::= ( "touch" | "feel" ) <object>
(* ---- Defence, fleeing and following ---- *)
<defend>         ::= <DEFEND> | "defend" [ <DEFEND> | "none" | "counter" | "best" ]   (* a stance for the next blow: dodge, block, parry, duck *)
<DEFEND>         ::= "dodge" | "block" | "parry" | "duck"
<flee>           ::= ( "flee" | "escape" | "run" "away" ) [ <direction> ]
<follow>         ::= ( "follow" | "tail" ) <object>
(* ---- Repeating and place ---- *)
<again>          ::= <AGAIN>                                    (* repeat the last command *)
<AGAIN>          ::= "again"
<where>          ::= "where" "am" "i"

(* ---- Sequences (added 2026-10-19: the user, VB_SEQUENCE) ---- *)
<sequence>       ::= <seq-part> "then" <seq-part> { "then" <seq-part> }   (* a list of actions, done in order; each part
                                                                              is a whole command, and the runtime may
                                                                              interrupt between parts *)
<seq-part>       ::= <command> | <quoted-speech> | <object>   (* an object alone repeats the verb before: "attack the rat then the goblin" *)
(* ---- Unarmed blows (HarnMaster Combat 8-9: unarmed combat is a melee attack) ---- *)
<knock-out>      ::= "knock" "out" <object> | "knock" "the" <slang> "out" "of" <object>
<slang>          ::= "shit" | "daylights" | "living" "daylights" | "crap"
(* ---- Engagement (HarnMaster Combat 6-7): engage, disengage and pass ---- *)
<engage>         ::= "engage" <object>                          (* an Engage option: a half-move, then a melee attack *)
<disengage>      ::= <DISENGAGE> [ <direction> ]
<DISENGAGE>      ::= "disengage" | "withdraw" | "break" "off" | "b" "away"   (* one hex, then a half-move if now unengaged; no attack; "back away": back is b's alias *)
<pass>           ::= "pass"                                     (* an engaged character forfeits the turn *)

(* ---- Religion (HarnMaster Religion: prayer, divine intervention, performing invocations) ---- *)
<pray>            ::= "pray" [ "for" <text> { <text> } ]        (* alone: an hour of prayer, for piety; "for": a prayer that spends piety on an endeavour *)
<intervene>       ::= ( "call" "on" | "beseech" ) <DEITY> [ "for" <text> { <text> } ]   (* a call for divine intervention *)
<DEITY>           ::= <deity-name>                 (* the world's deities: an open name, given by the world, not the grammar *)
<invoke>          ::= ( "invoke" | "perform" | "chant" ) <INVOCATION> [ "on" ] [ <object> ] [ "to" <DEITY> ]   (* clerics perform a ritual; the deity acts *)
<INVOCATION>      ::= "divination" | "baptism" | "passage" "of" "the" "soul" | "consecration" | "exorcism" | "curse" | "blessing" | "balefire"
<learn-invocation> ::= "learn" <INVOCATION> [ "from" <object> ]  (* from a mentor or scripture; 5 piety per circle *)
<fasting>         ::= "fast"                                       (* a day of fasting: piety accrues each day *)
(* ---- Baptism is the invocation that converts a willing convert: "baptise", "convert" ---- *)
<baptise>         ::= ( "baptise" | "baptize" | "convert" ) <object> [ "to" <DEITY> ]
(* ---- Magic (HarnMaster Magic: memorization, learning, research, dispelling, countering) ---- *)
<spell>           ::= [ <det> ] <spell-word> [ "spell" ]          (* a spell by name *)
<memorize>        ::= "memorize" <spell>
<unmemorize>      ::= "unmemorize" <spell>                         (* instant *)
<learn-spell>     ::= "learn" <spell> [ "from" <object> ]
<research>        ::= "research" <spell>
<dispel>          ::= "dispel" <object>                            (* removes a temporary enchantment *)
<counter>         ::= "counter" <spell>                            (* a defensive spell against one being cast *)
<release>         ::= "release" <object>                           (* a principle stored in a jorum, let out into the mundane world *)
(* ---- The game's own (added 2026-10-19: the old parser's commands, games/dq0/parse.c, now dq0c's: what the game does
   with each is commands.words's, the verb as typed) ---- *)
<break>           ::= "break" [ <thing> [ <USING> <object> ] ]   (* "break the window", "break" alone: what's in front *)
<raise>           ::= "raise" [ <thing> ]                     (* a portcullis raised *)
<lower>           ::= "lower" [ <thing> ]
<bend>            ::= "bend" [ <thing> [ <USING> <object> ] ]    (* a window's bars bent *)
<force>           ::= "force" [ <thing> [ <USING> <object> ] ]   (* a door forced *)
<disarm>          ::= "disarm" [ <thing> [ <USING> <object> ] ]  (* a trap disarmed *)
<rebar>           ::= "rebar" [ <thing> ]                     (* a door barred: "bar the door" (bar an alias) *)
<hang>            ::= "hang" <object> [ ( "on" | "from" ) <object> ]   (* "hang the quiver on my belt" *)
<combine>         ::= "combine" <object> [ "with" <object> ]   (* the theme's pieces put together: "combine the sunstone with the moonstone", "join the pieces" *)
<deceive>         ::= "deceive" <object>                       (* a denizen swayed: deceived, threatened, calmed, befriended *)
<threaten>        ::= "threaten" <object>
<calm>            ::= "calm" <object>
<befriend>        ::= "befriend" <object>
<approach>        ::= "approach" <thing>                      (* up to it *)
<ally>            ::= ( "come" | "heel" | "stay" | "halt" ) [ "here" ] | "dismiss" <object>   (* an ally's request *)

(* ---- Psionic talents (HarnMaster core, Psionics: latent until found; the GM generates them) ---- *)
<talk>            ::= "talk" [ "to" | "with" ] <object> [ "about" <text> { <text> } ]   (* a conversation: VB_TELL_OBJECT *)
<talent>          ::= <TALENT> [ "on" ] [ <object> ]          (* the talent is used on the object, if any *)
<TALENT>          ::= "charm" | "clairvoyance" | "disembodiment" | "heal" | "healing" | "hex" | "medium" | "mental" "bolt" | "bolt"
                    | "negation" | "negate" | "prescience" | "foresee" | "psychometry" | "pyrokinesis" | "ignite" | "sensitivity"
                    | "telekinesis" | "telepathy" | "transference" | "transmutation" | "transmute"
(* ---- Mental conflict (HarnMaster core, Mental Conflict: the battle of wills) ---- *)
<possess>         ::= "possess" <object>                         (* an alien spirit takes a body by winning a conflict *)
<link-mind>       ::= "link" [ "minds" ] [ "with" ] <object>      (* the benign mind link *)
<activate>        ::= "activate" <object>                        (* an artifact's powers: it may resist *)
(* ---- Influence: Rhetoric and its specialties (HarnMaster core, Skills 12): taunt and fast-talk are kinds of Rhetoric ---- *)
<intimidate>      ::= "intimidate" <object>                      (* Intimidation: establish dominance *)
<order>           ::= "command" <object> [ "to" <text> { <text> } ]   (* Command: a subordinate accepts leadership *)
<persuade>       ::= ( "persuade" | "convince" ) [ "with" | "over" ] <object> [ "to" <text> { <text> } ]   (* Rhetoric: to do something *)
<orate>           ::= ( "orate" [ "to" <object> ] | "address" <object> ) [ "about" <text> { <text> } ]   (* Oratory: a speech *)
<negotiate>       ::= "negotiate" [ "with" <object> ]            (* Diplomacy *)
<fast-talk>       ::= ( "fast" "talk" | "bluff" | "lie" [ "to" ] ) <object> [ "about" <text> { <text> } ]   (* Rhetoric: persuade them to believe you *)
<taunt>           ::= "taunt" <object> [ "to" <text> { <text> } ]   (* Rhetoric: persuade them to attack *)
<judge>           ::= "sense" "a" "lie" "from" <object>   (* Diplomacy: is the speaker bluffing (a thing judged, its
                                                   quality: <appraise>, 2026-10-22) *)
