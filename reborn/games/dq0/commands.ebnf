(* Dingus Quest Zero: the command grammar. Source for the command compiler.
   Revised 2026-10-19 after the user's answers, and including command aliases.

   Notation: ::= defines a rule; "word" is a terminal, matched case-insensitively after normalisation;
   <name> a nonterminal; [ x ] optional; { x } zero or more; ( x | y ) a choice.
   A rule may continue on following lines. Comments are (* ... *).

   open: name noun alias adj number ordinal task-name meta-topic name-word spell-word pretense-word deity-name text
   (the open names come from the game's data: see the design doc, "The grammar"; the checker reads this line) *)

(* ---- Entry ---- *)
<line>           ::= <alias-cmd> | <quoted-speech> | <command> | <sequence>
<quoted-speech> ::= <quoted-text> [ "!" ]   (* said aloud. A w or y directly before the quote is part of the quote token:
                                                 w"Psst" whispers, y"Here!" yells; a quote ending in ! (inside it, or after it) is yelled *)
<quoted-text>    ::= '"' <text> '"'
                                                                (* only while a question is pending (question 13) *)
<command>        ::= <phrase> [ <manner> ]   (* "open the chest carefully", "drop the pick quietly": how, after any command *)
<phrase>         ::= <look> | <examine> | <move> | <face> | <get> | <grab> | <drop> | <put> | <use>
                   | <equip> | <unequip> | <open> | <close> | <attack> | <grapple>
                   | <throw> | <shoot> | <load> | <gather> | <jump> | <say> | <tell> | <cast> | <eat>
                   | <drink> | <swim> | <find> | <search> | <listen> | <smell> | <track>
                   | <target> | <wait> | <rest> | <stop> | <naming> | <meta>
                   | <step> | <pace-set> | <charge> | <light> | <extinguish> | <posture> | <pretend>
                   | <enter> | <leave> | <climb> | <dig> | <wake> | <hide> | <sneak>
                   | <knock> | <push> | <pull> | <give> | <lock> | <unlock> | <fill> | <dip> | <read> | <copy> | <taste> | <touch>
                   | <defend> | <flee> | <follow> | <where> | <again>
                   | <knock-out> | <engage> | <disengage> | <pass>
                   | <pray> | <intervene> | <invoke> | <learn-invocation> | <fasting>
                   | <memorize> | <unmemorize> | <learn-spell> | <research> | <dispel> | <counter> | <release>
                   | <talent> | <possess> | <link-mind> | <activate> | <baptise> | <empty>
                   | <talk>
                   | <sit-on>
                   | <intimidate> | <order> | <persuade> | <orate> | <negotiate> | <fast-talk> | <taunt> | <judge>
                   | <break> | <raise> | <lower> | <bend> | <force> | <disarm> | <rebar> | <hang> | <tie> | <untie> | <combine>
                   | <appraise>
                   | <deceive> | <threaten> | <calm> | <befriend> | <approach> | <ally>
                   | <swap> | <tend> | <trade> | <rip>

(* ---- Observing (question 3: "look at" is a glance; question 4: "take a look" is a look) ---- *)
<look>           ::= <LOOK> [ <look-target> ] | <LOOK> <object> "over" | <LOOK> "over" <object>   (* "look the torch over":
                                                 a look at it, 2026-10-22 *)
<look-target>    ::= <direction> | <locale-ref> | [ <look-prep:skip> ] <object>   (* its preposition the look's own:
                                                 "look under the table" a search of it, commands.verbs' [turns] *)
<locale-ref>     ::= "around" [ <here-ref> ] | "about" | "here" | "this place"
<look-prep>      ::= "at" | "through" | "toward" | "towards" | "around" | "in" | "into" | "inside" | "under" | "behind" | "beside" | "near" | "to" | "on" | "for"   (* "look in the sack", "look on the table": into it, onto it *)
<examine>        ::= <EXAMINE> [ [ "at" ] <object> [ <for-traps> ] ] | <EXAMINE> <aspect> [ "of" <object> ]   (* "check the
                                                 chest for traps", "examine the value of the sword", "check its
                                                 condition" (2026-10-22) *)
<EXAMINE>        ::= "x" | [ "take a" ] <DETAIL> <LOOK>   (* "look closely" is an alias of examine: commands.aliases; so are
                                                 check, study and determine *)
<for-traps>      ::= "for" "traps"
(* ---- A thing's aspects judged (added 2026-10-22, the user's: "examine value [of] item", "quality [of] item"): the aspect
   said, or the verb's own (assess its value, judge its quality, appraise both, heft its weight) ---- *)
<appraise>       ::= <APPRAISE> [ <object> ] | <APPRAISE> <aspect> [ "of" <object> ] | <JUDGED> "of" <object>
                   | "what" "is" <object> "worth" | "how" "well" "made" "is" <object>
<APPRAISE>       ::= "assess" | "appraise" | "judge" | "heft" | "weigh" | "value" | "price"
<aspect>         ::= [ "the" | "its" ] <ASPECT>
<ASPECT>         ::= "value" | "worth" | "price" | "quality" | "make" | "condition" | "damage" | "weight" | "lock" | "traps"
<JUDGED>         ::= "value" | "worth" | "price" | "quality" | "condition" | "weight"   (* "value of the sword" *)

(* ---- Moving and facing ---- *)
<move>           ::= [ <pace-word> ] [ <MOVE> ] [ <manner> ] <move-dir> [ <number> [ "space" | "spaces" | "square" | "squares" ] ]
                   [ <manner> ]   (* "run north": this move at run; "walk north": the verb; "walk quickly north", "walk
                                     slowly north": a pace said with it, pace.c's (2026-10-22: outright, the dark's) *)
<move-dir>       ::= <direction> [ <TOWARD> <object> ] | <TOWARD> <object> | <ALONG> <object>   (* "go down the stairs", "walk down the corridor", "walk forward to the other side" *)
<face>           ::= [ "change" ] ( "face" | "facing" | "turn" ) [ "half" ] [ "to" ] <direction> | "turn" "around"   (* "turn around" is a half turn: facing back; "turn half left": an eighth *)

(* ---- Handling things (question 2: CLOSE and OPEN are actions) ---- *)
<get>            ::= <GET> [ <object> ] [ <from-phrase:other> ] [ <hand-phrase:hand> ] | <GET> <object> <off-phrase:other> | <GET> <object> "up"   (* bare: the last thing named, else things near (question 8); "pick the sword up"; "take the torch in my right hand" (slice 4.1b) *)
<drop>           ::= <DROP> [ <object> ] | "put" <object> "down" | "shrug" <object> "off"   (* bare: the last thing named *)
                   | <DROP> <object> ( "into" | "in" | "inside" | "down" | "on" | "onto" ) <object:other>   (* "drop the dagger into the well", "down the shaft": put in it (2026-11-06);
                                                 "drop the dagger on the table": put on it, "on the floor" put down,
                                                 "on the stairs" placed there (2026-11-17) *)
<put>            ::= <PUT> <object> <hand-phrase:hand> | <PUT> <object> <worn-phrase:worn> | <PUT> <object> <put-prep:other> <object:other>   (* "put the bar back in its brackets": back, a way, passed over; "put the dagger in my other hand": held there (slice 4.1b) *)
<empty>          ::= <EMPTY> <object> [ "out" ] [ <put-prep:other> <object:other> ]   (* "empty the sack", "empty the sack onto the table": its things put out, here or on the other, a liquid poured away (the user's P4, 2026-11-18) *)
<put-prep>       ::= "in" | "into" | "inside" | "on" | "onto" | "on top of" | "under" | "against" | "down"   (* "down the shaft": in it, 2026-11-06 *)
<use>            ::= <USE> <object> [ ( "on" | "with" ) <object:other> ]
<equip>          ::= <EQUIP> [ <object> ] [ <hand-phrase:hand> | <worn-phrase:worn> ]   (* bare: the last thing named; "wield the sword in my left hand"; "wear the ring on my left hand" *)
<worn-phrase>    ::= ( "on" | "over" | "around" | "about" | "at" | "in" ) "my" [ "left" | "right" ] ( <object> | "head" | "hand" | "hands" | "face" )   (* where a
                                                 thing's worn (2026-11-10, the user's): "put the scarf over my face", "wear the earrings
                                                 in my ears"; the place the UI's to read (worn.c), the world's to keep *)
(* ---- The hands (added 2026-10-22, slice 4.1b): the hand a thing goes in, or the one that holds what strikes ---- *)
<hand-phrase>    ::= "in" [ "my" ] ( ( "left" | "right" | "other" | "off" | "main" ) "hand" | "both" "hands" )
<swap>           ::= ( "swap" | "switch" | "change" ) "hands" | "swap"   (* what's in the hands changed over, left to right *)
<tend>           ::= <TEND> [ <object:mine> ]       (* first aid (slice 4.3): "tend my wounds", "bandage my left arm", "treat the
                                                 bandit", "first aid"; none said, its own wounds *)
<TEND>           ::= "tend" [ "to" ] | "treat" | "bandage" | "dress" | "bind" | "staunch" | "first" "aid" [ "to" | "for" ]
                   | "change" [ "the" | "my" ] ( "bandage" | "bandages" | "dressing" ) [ "on" ]   (* a dressing changed: "change the
                                                 bandage on my arm" (2026-11-10, HOUSE.md's bandages) *)
<rip>            ::= <RIP> <object> [ "up" ] [ <USING> <object:tool> ] | "wash" <object>   (* a cloth torn up for bandages, "cut up the
                                                 cloak with the dagger"; washed, "wash the bandages" (2026-11-10) *)
<RIP>            ::= ( "rip" | "tear" ) [ "up" ] | "cut" "up"
<trade>          ::= ( "buy" | "purchase" ) <object> [ "from" <object:other> ] | "sell" <object> [ "to" <object:other> ]
                   | "how" "much" [ "will" "you" "give" ] [ "for" | "is" | "are" ] <object> | "what" ( "will" | "would" ) "you" "give" [ "me" ] "for" <object>
                   | ( "haggle" | "bargain" | "barter" ) [ ( "for" | "over" ) <object> ] [ "with" <object:other> ]
                   | "entertain" [ <object> ] | ( "sing" | "play" | "dance" ) [ ( "to" | "for" | "with" ) <object> ]   (* the market and
                                                 entertaining (2026-11-02): "buy the rope from the dwarf", "sell my dagger", "how much for the
                                                 lantern", "what will you give for this", "haggle for the rope", "sing to the dwarf": VB_TRADE,
                                                 its verb's aux the sway's SW_* *)
<unequip>        ::= <UNEQUIP> [ <object> [ <from-phrase:other> ] ] | "put" <object> "away" | "take" <object> "off"   (* "remove
                                                 the key from the chest": taken from it (2026-11-17) *)   (* "put away the sword", "put the sword away", "take the helm off" *)
<open>           ::= "o" [ <object> [ <USING> <object:tool> ] ]   (* "open" alone: what's in front *)
<close>          ::= ( "close" | "slam" ) [ <object> ]   (* "close look" is <DETAIL> <LOOK>, not this; "slam the door": shut, louder (2026-11-21) *)
<from-phrase>    ::= "from" <object> | "out" "of" <object>
<off-phrase>     ::= "off" <object>

(* ---- Fighting ---- *)
<attack>         ::= <ATTACK> [ <object> [ <USING> <object:tool> [ <hand-phrase:hand> ] ] ]   (* bare: the target, else the nearest foe; "attack the rat with the dagger in my left hand" *)
<USING>          ::= "with" | "using"                (* what it's done with: an instrument, to hand (2026-10-22) *)
<headlock>       ::= "in" [ "a" ] ( "head" "lock" | "headlock" )   (* "put the goblin in a headlock": the hold the other
                                                 thing, as a put's *)
<grapple>        ::= <GRAPPLE> <object> | <THROW> <object> | "put" <object> <headlock:skip> | "let" "go" [ "of" <object> ]   (* a grapple maneuver: the object is engaged; "toss" and "throw" a creature are grapples too *)
<throw>          ::= <THROW> [ <throwing> ] <at-phrase:other>          (* at something: a target *)
                   | <THROW> [ <throwing> ] ( "into" | "in" | "down" ) <object:other>   (* "throw the dagger into the well", "down the shaft": let fall in it (2026-11-06) *)
                   | <THROW> [ <throwing> ] <throw-dir>
                   | <THROW>          (* in a direction: a floor square, distance asked *)
<throwing>       ::= <manner> [ <object> ] | <object> [ <manner> ]   (* "throw hard the apple", "throw the apple hard" *)
<throw-dir>      ::= <direction> | "around the corner"
<shoot>          ::= <SHOOT> <at-phrase> [ <USING> <object:tool> ] | <SHOOT> [ <object> ] [ <at-phrase:other> ] [ <USING> <object:tool> ]   (* "fire the bow at
                                                 the goblin", "shoot at the goblin" (the target the thing: none said
                                                 before it), "shoot the goblin", "shoot at the goblin with my bow" *)
<load>           ::= <LOAD> <object>   (* "load the crossbow", "nock an arrow" (nock: an alias), "draw the bow" *)
<gather>         ::= <GATHER> [ <object> ]   (* "gather the arrows", "collect the bolts", "gather": the missiles lying about, each walked to (slice 4.7) *)
<at-phrase>      ::= ( "at" | "toward" | "towards" | "to" | "on" ) <object>

(* ---- Other actions ---- *)
<jump>           ::= <JUMP> [ <direction> [ <object> ] | ( "over" | "onto" | "into" | "in" ) <object> ]   (* "jump into the well", "jump down the well" (2026-11-06) *)
<say>            ::= <SAY> <quoted-text> | <VOLUME-SAY> <quoted-text> [ "!" ]   (* yell, scream, whisper *)
<tell>           ::= <TELL> <object> [ "to" | "about" ] ( <quoted-text> | <object:other> | <phrase:other> | <errand:other> ) | <TELL> <object> "that" <text:other> { <text:other> }   (* "tell the goblin that the bridge is out" *)
<errand>         ::= ( "fetch" | "bring" | "retrieve" ) [ "me" ] <object> | ( "follow" | "come" ) [ "me" ] "at" <number> [ "space" | "spaces" | "square" | "squares" ]
                   | ( "open" | "close" | "shut" | "unlock" | "lock" | "bar" | "rebar" | "unbar" | "unbolt" | "force" | "pick" ) <object>   (* an errand at a door, 2026-11-02: "ask the dwarf to open the door"; lock, bar, unbar, force, pick the lock: 2026-11-21 *)   (* an ally's errand (slice 4.8): "tell Grub to fetch the key", "ask the dwarf to bring me the torch", "tell Grub to follow me at 3 squares" *)
<cast>           ::= <CAST> [ <det> ] [ <spell-word> ] [ "spell" ] [ <at-phrase:other> ]       (* "concentrate" alone: the spell in use *)
<eat>            ::= <EAT> [ <object> ]   (* "eat" alone: a meal from what it carries, as "drink" alone drinks (2026-11-17) *)
<drink>          ::= <DRINK> [ "from" <object> | <object> ]
<swim>           ::= <SWIM> [ <move-dir> ] | "dive" | "tread" "water"   (* alone in deep water: treading water a minute; "dive", "swim down": under on purpose (2026-11-10) *)
<find>           ::= <FIND> <object>                            (* question 10: FIND locates a known thing *)
<search>         ::= <SEARCH> [ <around:skip> ] [ <for:skip> ] [ <object> ] | <SEARCH> [ <object> ] "for" "traps"
                   | <SEARCH> [ <around:skip> ] ( "on" | "in" ) <object>
                   | <GROPE> [ <around:skip> ] [ <for:skip> <object> | ( "on" | "in" ) <object> ]
                                                (* question 10: SEARCH looks for hidden things; a long task; "search the
                                                   chest for traps": that thing alone, 2026-10-22; its forms, the same day
                                                   (search.c): "search nearby", "search around", "search the east wall",
                                                   "search the wall to my left", "search around for a dagger", "search
                                                   around on the floor", "search on the table"; by feel, "feel around",
                                                   "feel about for the key", "grope around" *)
<around>         ::= "around" | "about"
<for>            ::= "for"                       (* the search's own words, its verb made another by them: "search
                                                 around" a grope, "search for" a seek (commands.verbs' [turns],
                                                 2026-11-17) *)
<GROPE>          ::= "grope" | "feel"
<listen>         ::= <LISTEN> [ <look-target> ]
<smell>          ::= <SMELL> [ <look-target> ]
<track>          ::= <TRACK> [ "for" ] [ <object> ]
<target>         ::= <TARGET> [ <object> ] | "clear target" | "untarget"
<wait>           ::= <WAIT> [ "for" ] [ <duration> ] | <WAIT> "until" <time-of-day> | "pass" "the" "time" | "watch" "the" ( "sun" | "sky" | "stars" )   (* "wait", "wait for 10 minutes"; "pass the time" is a wait; "wait until dawn", the hour as the character believes the time (the UI's, from the line); "watch the sun", a wait in the sky's sight (2026-10-31) *)
<rest>           ::= [ "short" ] ( <REST> | <SLEEP> ) [ [ "for" ] <duration> | "until" <time-of-day> | ( "in" | "on" ) <object> ]   (* rest and sleep are the same: VB_SLEEP, the player unaware. "short rest" is a sleep of 30 to 60 minutes, which fatigue, illness and injury may turn into a full sleep. Its length is not typed (fatigue, injury, sickness); a duration overrides it ("sleep 8 hours", "rest for an hour").  (One rule, rest's and sleep's: the rules' room, 2026-10-28) *)
<stop>           ::= <STOP> [ <task-name> ]                     (* question 9: "stop" alone, or "stop digging" *)
<step>           ::= "step" <direction>                 (* one square; facing unchanged: "step r" *)
<pace-set>       ::= "pace" [ <pace-word> | "walk" ] | "double time" [ "!" ]  (* sets the default pace; "double time!" is a run *)
<pace-word>      ::= "crawl" | "hop" | "slow walk" | "trot" | "jog" | "run" | "sprint" | "dash"
<charge>         ::= [ "fast" ] "charge" [ "!" ]        (* run at the closest enemy ahead, attack it, shout "Charge!"; fast: a sprint *)

(* ---- Naming and meta-commands (question 15: naming things is "name" or "call") ---- *)
<naming>         ::= <NAME> ( <object> | "room" | "place" ) [ "as" | "the" ] <name-word:other>
<meta>           ::= <META-WORD> [ <meta-topic> ]
<alias-cmd>      ::= <ALIAS> <alias> ( "is" | "=" ) <substitution>   (* define, or overwrite after a question *)
                   | <ALIAS> <alias>                                   (* show its meaning *)
                   | <ALIAS>                                           (* list them all *)
                   | <UNALIAS> <alias>                                 (* remove *)
<substitution>   ::= <line>                                          (* one command line; no alias definition inside it *)

(* ---- Adjuncts ---- *)
<locative>       ::= <loc-prep> <object>
<loc-prep>       ::= "in" | "on" | "at" | "under" | "behind" | "beside" | "near" | "by" | "against"
                   | "through" | "around" | "over" | "across"
<manner>         ::= "carefully" | "slowly" | "quickly" | "quietly" | "hard" | "gently" | "lightly" | "firmly"
<time-of-day>    ::= "midnight" | "dawn" | "daybreak" | "sunrise" | "morning" | "noon" | "midday" | "afternoon" | "dusk" | "sunset" | "evening" | "nightfall" | "night"   (* a wait's end, the hour the character means (2026-10-31: the time of day believed) *)
<duration>       ::= ( <number> | "an" | "a" | "half" "an" ) ( "minute" | "minutes" | "hour" | "hours" ) [ [ "and" ] <duration> ]   (* "an hour", "half an hour", "3 hours 20 minutes", "3 hours and 20 minutes": its spans added up (the long durations, 2026-10-28) *)
<here-ref>       ::= "me" | "myself"        (* question 14: "me" only, never "you" *)

(* ---- Objects ---- *)
<object>         ::= <object-one> { "and" <object-one:list> }
<object-one>     ::= <np> [ <of-room:skip> ] [ <lies> ] | [ "the" ] <compass> <np> | <pronoun> | <me-phrase> | <everything>
                   | <way-out>   (* "the sword and the shield": a list, one command for each; a thing in the place, and where it
                                                 lies: "the door ahead to my left", "the north wall": one noun phrase for
                                                 every slot, <object> gone (GAME-CRITIQUE.md's 2.8 step 3, 2026-11-17) *)
<chosen>         ::= ( <superlative> | <ordinal> ) [ "one" ]   (* "the closest", "the second one": of those it perceives *)
<superlative>    ::= "closest" | "nearest" | "largest" | "biggest" | "smallest" | "lead"   (* (<chosen>'s and <selector>'s: the rules' room, 2026-10-28) *)
<way-out>        ::= [ "the" ] "way" "out"          (* the theme's way out of the dungeon *)
<np>             ::= [ <det> ] ( [ <selector> ] { <adj> } <head> | <chosen> ) | <portion> [ "of" ] <det> { <adj> } <head>
<portion>        ::= "all" | "half" | "both" | <number>   (* "all the sacks", "half the rations", "two of the sacks": how many of them, slice 4.1's *)
<of-room>        ::= "of" [ "the" | "this" ] ( "room" | "chamber" | "hall" | "cave" | "cavern" )   (* "the centre of the room" *)
<lies>           ::= <compass> | <relative>
<det>            ::= "a" | "an" | "the" | "this" | "that" | "these" | "those" | "its"   (* "my coat": <me-phrase> *)
<selector>       ::= <number> | "all" | "every" | "each" | "any" | "both" | <ordinal> | <superlative>
<head>           ::= { <noun> } <name>                (* every word a thing can be called: "the mail hauberk" (a noun: no adjective, number or ordinal) *)
<pronoun>        ::= "it" | "them" | "that" | "this" | "one" | "he" | "she" | "him" | "her"   (* "it": the last thing of any kind (question 7); he, she, him, her: the last person named (context "person=") *)
<me-phrase>      ::= <here-ref> | ( "my" | "your" ) <np:mine>
<everything>     ::= "everything" [ "near" | "here" ] | "all"

(* ---- Directions (question 5: the single letters are commands) ---- *)
<direction>      ::= <compass> | <relative> | <vertical>
<compass>        ::= [ <offto> ] <NS> [ [ "and" ] <EW> ] [ <ofme> ]
                   | [ <offto> ] <EW> [ <ofme> ]
                   | [ <offto> ] <DIAG> [ <ofme> ]   (* ne, nw, se, sw; "northeast" and "north east" are aliases *)
<NS>             ::= "n" | "s"                       (* the short forms; "north" is an alias: commands.aliases *)
<EW>             ::= "e" | "w"
<DIAG>           ::= "ne" | "nw" | "se" | "sw"
<offto>          ::= "off" [ "to the" | "to" ] | "to the" | "to"   (* at least one word: a nullable part would parse two ways *)
<ofme>           ::= "of" <here-ref>
<relative>       ::= [ <offto> ] ( <FB> [ [ "and" ] <side> ] | <side> )   (* "ahead to my left", "behind me on my right", "off to the left" *)
<side>           ::= [ "to my" | "on my" | "on the" ] <LR>
<FB>             ::= "f" | [ "to the" ] "front" [ <ofme> ] | "in front of" [ <here-ref> ]
                   | "b" | "behind" [ <here-ref> ]
<LR>             ::= "l" | "left" | "r" | "right"
<vertical>       ::= "u" | "up" | "over my head" | "above" [ <here-ref> ]
                   | "d" | "down" | "below" | "underneath" | "under" [ <here-ref> | "my feet" ]

(* ---- Lexicon: the classes. Each is one abstract meaning; the words are its synonyms. ---- *)
<LOOK>       ::= "look" | "take a gander" | "take a look"
<DETAIL>     ::= "close" | "in detail"
<MOVE>       ::= "walk" | "go" | ( "make" | "find" ) "my" "way"   (* "make my way back to the Mausoleum": travel's,
                                                 slice 4.2; "return to", "travel to", "head back to": walk's aliases *)
<TOWARD>     ::= "to" | "towards" | "toward" | "in the direction of" | "into" | "onto" | "past" | "through"
                 | "for" | "near" | "by" | "beside" | "next to" | "over to"   (* "head for the pot",
                                                 "walk over to the chest" (going to anything, 2026-11-02) *)
<ALONG>      ::= "up" | "down" | "along" | "across"   (* up or down a stairway or a ladder; along a passage *)
<GET>        ::= "get" | "take" | "pick up" | "pick"
<DROP>       ::= "drop" | "put down" | "shrug off"
<PUT>        ::= "put" | "place"
<EMPTY>      ::= "empty" | "empty out" | "tip out" | "pour out" | "dump" | "dump out" | "pour"
<USE>        ::= "use" | "make use of"
<EQUIP>      ::= "equip" | "put on"
<UNEQUIP>    ::= "doff" | "take off" | "put away"
<ATTACK>     ::= "fight" | "slash" | "bash" | "stab" | "punch" | "kick" | "bite" | "headbutt" | "elbow" | "knee" | "slap" | "butt"
<GRAPPLE>    ::= "grapple" | "wrestle" | "tackle" | "pin" | "choke" | "strangle" | "throttle"
<THROW>      ::= "t" | "sling"
<SHOOT>      ::= "fire"
<LOAD>       ::= "draw"
<GATHER>     ::= "gather"
<JUMP>       ::= "j"
<SAY>        ::= "say"
<VOLUME-SAY>  ::= "yell" | "whisper"
<TELL>       ::= "tell"
<CAST>       ::= "c"
<EAT>        ::= "eat"
<DRINK>      ::= "drink"
<LIGHT>      ::= "light" | "turn on"
<EXTINGUISH> ::= "quench" | "put out" | "turn off"
<SWIM>       ::= "swim"
<FIND>       ::= "find" | "where is"
<SEARCH>     ::= "search"
<LISTEN>     ::= "listen"
<SMELL>      ::= "smell" | "sniff"
<TRACK>      ::= "track"
<TARGET>     ::= "target" | "aim at"
<WAIT>       ::= "wait"
<REST>       ::= "rest"
<SLEEP>      ::= "sleep"
<STOP>       ::= "stop" | "halt" | "enough"     (* 2026-11-06: the stop's kind, acted on at once *)
<NAME>       ::= "name" | "call"
<ALIAS>      ::= "alias"
<UNALIAS>    ::= "unalias" | "forget alias"
<META-WORD>  ::= "status" | "help" | "i" | "map" | "m" | "save" | "q" | "sheet" | "pause" | "time" | "what time is it"

(* ---- Fire (added 2026-10-19) ---- *)
<light>          ::= <LIGHT> [ "a" ] "fire" | <LIGHT> <object> [ <in-phrase:other> ] [ <USING> <object:tool> ] | "turn" <object> "on"   (* "light the torch", "start a fire", "turn it on", "light the torch in the sconce" *)
<extinguish>     ::= <EXTINGUISH> [ "the" ] "fire" | <EXTINGUISH> <object> [ <in-phrase:other> ] | "put" <object> "out" | "turn" <object> "off"   (* "quench the fire", "put out the torch", "put the torch out", "turn it off", "put out the torch in the sconce" *)
<in-phrase>      ::= ( "in" | "on" ) <object>   (* the thing it's in, or on: a sconce's torch *)
(* ---- Posture and pretence (added 2026-10-19) ---- *)
<posture>        ::= <SIT> | <STAND> | <LIE-DOWN> | <CROUCH> | ( "lie" | "lay" ) [ "down" ] ( "on" | "in" ) <object>          (* a change of the standing state; no object *)
<SIT>            ::= "sit" [ "down" ]
<sit-on>        ::= "sit" [ "down" ] ( "on" | "in" ) <object>   (* sitting on a surface: VB_SIT *)
<STAND>          ::= "stand" [ "up" ] | "get" "up" | "rise"   (* "get up" is a stand, not a get with a direction; "rise" (slice 4.1b: prone, the book's Rise) *)
<LIE-DOWN>       ::= "lie" [ "down" | "prone" ] | "lay" [ "down" ] | "go" "prone" | "prone"
<pretend>        ::= <PRETEND> [ "to" "be" ] <pretense>     (* a state the player does not have: "pretend dead",
                                                             "feign ignorance", "pretend to be asleep" *)
<PRETEND>        ::= "pretend"
<pretense>       ::= <pretense-word> { <pretense-word> }     (* the words of the state, none of them a command word *)
(* ---- Movement, climbing and digging (added 2026-10-19: the gaps the probes found) ---- *)
<enter>          ::= "enter" [ <object> ] | "get" "in" [ <object> ] | "in"   (* "get in", "in" (2026-11-17) *)
<leave>          ::= <LEAVE> [ <object> | <direction> ] | "get" "out" | "out"   (* "get out", "out" (2026-11-17) *)
<LEAVE>          ::= "exit" | "go" "out" | "go" "outside"
<climb>          ::= <CLIMB> [ <direction> ] [ <object> ] | <CLIMB> ( "over" | "onto" | "on" | "into" | "in" | "through" ) <object>
                   | "get" ( "on" | "onto" ) <object> | "get" "off" [ <object> ] | "get" "out" "of" <object>   (* "climb on the
                                                 table", "get on the ledge", "get off", "get out of the well" (2026-11-17) *)
                   | <CLIMB> "out" [ "of" <object> ]   (* "climb out", "climb out of the well": up it (2026-11-06) *)
<CLIMB>          ::= "climb"
<dig>            ::= <DIG> [ <direction> | "for" <object> | <object> ] [ <USING> <object:tool> ]   (* "dig down", "dig the wall",
                                                   "dig for treasure", "dig down with the pick" *)
<DIG>            ::= "dig"
<wake>           ::= <WAKE> [ <object> ] | "wake" <object> "up"   (* "wake the goblin", "wake the goblin up" *)
<WAKE>           ::= "wake" [ "up" ] | "rouse" | "awaken"
(* ---- Stealth ---- *)
<CROUCH>         ::= "crouch" | "kneel" [ "down" ] | "squat"
<hide>           ::= "h" [ <object> ] [ <locative:loc> ]            (* "hide behind the table": the locative adjunct; "hide the pouch": a thing hidden *)
<sneak>          ::= <SNEAK> [ <direction> ]
<SNEAK>          ::= "sneak"
(* ---- Handling and senses ---- *)
<knock>          ::= "knock" [ "on" | "along" ] <object>   (* "knock on the north wall": along it, by ear (2026-11-10) *)
<push>           ::= <PUSH> <object>
<PUSH>           ::= "push"
<pull>           ::= <PULL> <object>
<PULL>           ::= "pull"
<give>           ::= <GIVE> <object> ( "to" | "for" ) <object:other> | <GIVE> <object:other> <object>   (* "give the bandit 5 pennies", "offer the orc my dagger": the one given it first (2026-11-02) *)
<GIVE>           ::= "give"                                     (* spelt out: "g" is again's (the user's, 2026-11-11) *)
<grab>           ::= ( "grab" | "hold" ) <object> [ <from-phrase:other> ] [ <hand-phrase:hand> ]   (* a grapple when the object is engaged; else a get, or a carry for hold; "hold the spear in both hands" *)
<lock>           ::= "lock" <object> [ <USING> <object:tool> ]
<unlock>         ::= "unlock" <object> [ <USING> <object:tool> ]
                   | ( "unlock" | "pick" ) [ "the" | "its" ] "lock" [ ( "of" | "on" ) <object> ] [ <USING> <object:tool> ]   (* "pick
                                                   the lock of the chest", slice 4.1's; "... with the lockpicks"; "pick the lock", "pick lock"
                                                   alone, the one in front, as the help has it (2026-11-17) *)
<fill>           ::= "fill" <object> [ <from-phrase:other> | "with" <object:other> ]   (* "fill the lantern", "fill the lantern with oil" (a light renewed, slice 4.1's) *)
<dip>            ::= ( "dip" | "soak" ) <object> [ ( "in" | "into" ) <object:other> ]   (* "dip the torch in the oil", "soak the torch in pitch"; "dip the torch": the first fuel carried *)
<read>           ::= "read" [ <object> ]   (* bare: the last thing named *)
<copy>           ::= ( "copy" | "transcribe" ) [ <object> ]   (* a writing copied onto a sheet (the plan's step 9: Drawing's); bare: the last thing named *)
<taste>          ::= "taste" <object>
<touch>          ::= ( "touch" | "feel" ) <object>
(* ---- Defence, fleeing and following ---- *)
<defend>         ::= <DEFEND> | "defend" [ <DEFEND> | "none" | "counter" | "best" ]   (* a stance for the next blow: dodge, block, parry, duck *)
<DEFEND>         ::= "dodge" | "block" | "parry" | "duck"
<flee>           ::= ( "flee" | "escape" | "run" "away" ) [ <direction> ]
<follow>         ::= ( "follow" | "tail" ) <object>             (* a denizen trailed; "follow me" the allies' come (2026-11-10) *)
(* ---- Repeating and place ---- *)
<again>          ::= <AGAIN>                                    (* repeat the last command; "repeat" and "g" its aliases *)
<AGAIN>          ::= "again"
<where>          ::= "where" "am" "i"

(* ---- Sequences (added 2026-10-19: the user, VB_SEQUENCE) ---- *)
<sequence>       ::= <seq-part> "then" <seq-part> { "then" <seq-part> }   (* a list of actions, done in order; each part
                                                                              is a whole command, and the runtime may
                                                                              interrupt between parts *)
<seq-part>       ::= <command> | <quoted-speech> | <object>   (* an object alone repeats the verb before: "attack the rat then the goblin" *)
(* ---- Unarmed blows (HarnMaster Combat 8-9: unarmed combat is a melee attack) ---- *)
<knock-out>      ::= "knock" <out:skip> <object> | "knock" "the" <slang:skip> "out" "of" <object>   (* a punch: its words
                                                 the knock's made a punch's (commands.verbs' [turns], 2026-11-17) *)
<out>            ::= "out"
<slang>          ::= "shit" | "daylights" | "living" "daylights" | "crap"
(* ---- Engagement (HarnMaster Combat 6-7): engage, disengage and pass ---- *)
<engage>         ::= "engage" <object>                          (* an Engage option: a half-move, then a melee attack *)
<disengage>      ::= <DISENGAGE> [ <direction> ]
<DISENGAGE>      ::= "disengage" | "withdraw" | "break" "off" | "b" "away"   (* one hex, then a half-move if now unengaged; no attack; "back away": back is b's alias *)
<pass>           ::= "pass"                                     (* an engaged character forfeits the turn *)

(* ---- Religion (HarnMaster Religion: prayer, divine intervention, performing invocations) ---- *)
<pray>            ::= "pray" [ "for" <text> { <text> } ]        (* alone: an hour of prayer, for piety; "for": a prayer that spends piety on an endeavour *)
<intervene>       ::= ( "call" "on" | "beseech" ) [ <DEITY> [ "for" <text> { <text> } ] ]   (* a call for divine intervention; alone, to its own deity (as "pray" alone; 2026-11-21) *)
<DEITY>           ::= <deity-name>                 (* the world's deities: an open name, given by the world, not the grammar *)
<invoke>          ::= ( "invoke" | "perform" | "chant" ) <INVOCATION> [ "on" ] [ <object:other> ] [ "to" <DEITY:other> ]   (* clerics perform a ritual; the deity acts *)
<INVOCATION>      ::= "divination" | "baptism" | "passage" "of" "the" "soul" | "consecration" | "exorcism" | "curse" | "blessing" | "balefire"
<learn-invocation> ::= "learn" <INVOCATION> [ "from" <object:other> ]  (* from a mentor or scripture; 5 piety per circle *)
<fasting>         ::= "fast" | "break" "my" "fast"                 (* a day of fasting: piety accrues each day; "break my fast" (or "stop fasting") ends the vow (2026-11-10) *)
(* ---- Baptism is the invocation that converts a willing convert: "baptise", "convert" ---- *)
<baptise>         ::= ( "baptise" | "baptize" | "convert" ) <object> [ "to" <DEITY:other> ]
(* ---- Magic (HarnMaster Magic: memorization, learning, research, dispelling, countering) ---- *)
<spell>           ::= [ <det> ] <spell-word> [ "spell" ]          (* a spell by name *)
<memorize>        ::= "memorize" <spell>
<unmemorize>      ::= "unmemorize" <spell>                         (* instant *)
<learn-spell>     ::= "learn" <spell> [ "from" <object:other> ]
<research>        ::= "research" <spell>
<dispel>          ::= "dispel" <object>                            (* removes a temporary enchantment *)
<counter>         ::= "counter" <spell>                            (* a defensive spell against one being cast *)
<release>         ::= "release" <object>                           (* a principle stored in a jorum, let out into the mundane world *)
(* ---- The game's own (added 2026-10-19: the old parser's commands, games/dq0/parse.c, now dq0c's: what the game does
   with each is commands.words's, the verb as typed) ---- *)
<break>           ::= "break" [ <object> [ <USING> <object:tool> ] ]   (* "break the window", "break" alone: what's in front *)
<raise>           ::= "raise" [ <object> ]                     (* a portcullis raised *)
<lower>           ::= "lower" [ <object> ]
<bend>            ::= "bend" [ <object> [ <USING> <object:tool> ] ]    (* a window's bars bent *)
<force>           ::= "force" [ <object> [ <USING> <object:tool> ] ]   (* a door forced *)
<disarm>          ::= "disarm" [ <object> [ <USING> <object:tool> ] ]  (* a trap disarmed *)
<rebar>           ::= ( "rebar" | "unbar" | "unbolt" ) [ <object> ]   (* a door barred: "bar the door" (bar an alias); unbarred: its bar lifted out *)
<hang>            ::= "hang" <object> [ ( "on" | "from" ) <object:other> ]   (* "hang the quiver on my belt" *)
<tie>             ::= ( "tie" | "fasten" ) [ "off" ] <object> [ ( "to" | "on" | "onto" | "round" | "around" ) <object:other> ]   (* "tie the rope to the ring", "tie off the rope"; 2026-11-04 *)
                    | "let" "down" <object> | "let" <object> "down"            (* "let down the rope": tied to what holds, let down *)
<untie>           ::= ( "untie" | "unfasten" ) <object>                         (* a rope in place untied, coiled at the feet; a sack's tie *)
<combine>         ::= "combine" <object> [ "with" <object:other> ]   (* the theme's pieces put together: "combine the sunstone with the moonstone", "join the pieces" *)
<deceive>         ::= "deceive" <object>                       (* a denizen swayed: deceived, threatened, calmed, befriended *)
<threaten>        ::= "threaten" <object>
<calm>            ::= "calm" <object>
<befriend>        ::= "befriend" <object>
<approach>        ::= "approach" <object>                      (* up to it *)
<ally>            ::= ( "come" | "heel" | "stay" ) [ "here" ] | "dismiss" <object>   (* an ally's request *)

(* ---- Psionic talents (HarnMaster core, Psionics: latent until found; the GM generates them) ---- *)
<talk>            ::= "talk" [ "to" | "with" ] <object> [ "about" <text:other> { <text:other> } ]   (* a conversation: VB_TELL_OBJECT *)
<talent>          ::= <TALENT> [ "on" ] [ <object> ]          (* the talent is used on the object, if any *)
<TALENT>          ::= "charm" | "clairvoyance" | "disembodiment" | "heal" | "healing" | "hex" | "medium" | "mental" "bolt" | "bolt"
                    | "negation" | "negate" | "prescience" | "foresee" | "psychometry" | "pyrokinesis" | "ignite" | "sensitivity"
                    | "telekinesis" | "telepathy" | "transference" | "transmutation" | "transmute"
(* ---- Mental conflict (HarnMaster core, Mental Conflict: the battle of wills) ---- *)
<possess>         ::= "possess" <object>                         (* an alien spirit takes a body by winning a conflict *)
<link-mind>       ::= "link" [ "minds" ] [ "with" ] <object>      (* the benign mind link *)
<activate>        ::= "activate" <object>                        (* an artifact's powers: it may resist *)
(* ---- Influence: Rhetoric and its specialties (HarnMaster core, Skills 12): taunt and fast-talk are kinds of Rhetoric ---- *)
<intimidate>      ::= "intimidate" <object>                      (* Intimidation: establish dominance *)
<order>           ::= "command" <object> [ "to" <text:other> { <text:other> } ]   (* Command: a subordinate accepts leadership *)
<persuade>       ::= ( "persuade" | "convince" ) [ "with" | "over" ] <object> [ "to" <text:other> { <text:other> } ]   (* Rhetoric: to do something *)
<orate>           ::= ( "orate" [ "to" <object> ] | "address" <object> ) [ "about" <text:other> { <text:other> } ]   (* Oratory: a speech *)
<negotiate>       ::= "negotiate" [ "with" <object> ]            (* Diplomacy *)
<fast-talk>       ::= ( "fast" "talk" | "bluff" | "lie" [ "to" ] ) <object> [ "about" <text:other> { <text:other> } ]   (* Rhetoric: persuade them to believe you *)
<taunt>           ::= "taunt" <object> [ "to" <text:other> { <text:other> } ]   (* Rhetoric: persuade them to attack *)
<judge>           ::= "sense" "a" "lie" "from" <object>   (* Diplomacy: is the speaker bluffing (a thing judged, its
                                                   quality: <appraise>, 2026-10-22) *)
