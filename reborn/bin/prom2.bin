$C8 constant tick_hz         \ Ticks a second
$350 constant task_args       \ A task's arguments: zero-terminated strings, an empty one after the last (176
$B0 constant args_max        \ SPAWN's arguments: their bytes at most (each string's 0, and the empty one that
$230 constant task_name       \ A task's name, zero-terminated
$01 constant ht_program      \ HYX2 module types
$02 constant ht_driver       \
$03 constant ht_library      \
$01 constant hf_inplace      \ HYX2 flags: runs in place in the paged ROM
$02 constant hf_boot         \ HYX2 flags: a driver the kernel starts at boot
$00 constant me_bank         \ MODINFO's answer (ME_SIZE bytes): the module's first paged ROM bank
$01 constant me_banks        \ MODINFO: the banks it spans
