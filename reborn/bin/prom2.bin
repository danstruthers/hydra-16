})

(fun {special-die sides cases} .{case (cons (die sides) cases)})

; open ended dice rolls
(fun {oe-die+ sides mod} {
  do
    =(rl (die+ sides 0))
    ?((eq rl sides) (+ sides (oe-die+ sides mod)) (+ rl mod))
})
(fun {oe-die sides}         {oe-die+ sides 0})
(fun {oe-dice+ n sides mod} ?{(=0 n) mod (+ (oe-die sides) (oe-dice+ (1- n) sides mod))})
(fun {oe-dice n sides}      {oe-dice+ n sides 0})


(fun {best-of-rolls a b f} {best-of a (roll b f)})
(fun {worst-of-rolls a b f} {worst-of a (roll b f)})

(fun {dnd-attr-rolls} ?{
  (defined? &1)
  (roll &1 {
    take 6 (sort-desc (roll 8 {sum (best-of-rolls 3 4 {d6})}))
  })
  (dnd-attr-rolls 1)
})

(fun {dnd-attr-rolls-detailed} ?{
  (defined? &1)
  (roll &1 {do
    take 6 (sort-desc (roll 8 {do
      =(rs (sort-desc (roll 4 {d6})))
      [(sum (take 3 rs)) rs]
    }))
  })
  (dnd-attr-rolls-detailed 1)
})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; disk.hl - the disks, by their files (#d, /dev/sd): (use "disk").  A disk is named by its letter, a string (0-f a
; card on that SPI device, x the ROM disk, r the RAM disk, s the shared one; a number, 0-15, for a card).  A disk's
; ctl reads as it ("sdhc 7580 MB 15523840 blocks", or "none"; then its file system's lines: "hydrafs label=ROM",
; "free 192 KB of 252 KB"), and takes init (a card started again), stop (a RAM disk's banks given back), format,
; label, check.  The directory lists the disks started.  A failure is the system's error.

(use "dev")

(fun {disk.name d} {if (num? d) (dev.hex d 1) d})
(fun {disk.ctl d} {dev.lines (format "/dev/sd/{}/ctl" (disk.name d))})
(fun {disk.cmd d line} {dev.write (format "/dev/sd/{}/ctl" (disk.name d)) line})

; The first of its ctl's lines that has the text, from the text on (NIL: none)
(fun {disk.find lines text} {do
  =(l (filter (fn {x} {>= (index-of x text) 0}) lines))
  (if l (substring (fst l) (index-of (fst l) text) (len (fst l))) NIL)})

; The disks started, a list of hashes: :disk (its letter), :kind (:sdhc, :sdsc, :rom, :ram ...), :blocks (512 bytes
; each), and :label if it has a file system
(fun {disks} {filter (fn {h} {not (eq (h :kind) :none)}) (map disk.info (ls "/dev/sd"))})
(fun {disk.info d} {do
  =(l (disk.ctl d))
  =(w (str-split (fst l) " "))
  =(lb (disk.find l "label="))
  (hash-create (join (list (list :disk d) (list :kind (to-atom (fst w))))
    (if (> (len w) 4) (list (list :blocks (val (nth 3 w)))) NIL)
    (if lb (do =(x (fst (str-split lb " "))) (list (list :label (substring x 6 (- (len x) 6))))) NIL)))})

; Each disk's file system's room, a list of hashes: :disk, :label, :free and :size (KB)
(fun {df} {filter (fn {h} {not (nil? h)}) (map disk.room (ls "/dev/sd"))})
(fun {disk.room d} {do
  =(f (disk.find (disk.ctl d) "free "))
  (if f
    (do =(w (str-split f " "))
      (hash-create (list (list :disk d) (list :label ((disk.info d) :label)) (list :free (val (nth 1 w))) (list :size (val (nth 4 w))))))
    NIL)})

; A card started again (as after it's changed); a RAM disk stopped (its banks given back)
(fun {disk-start d} {disk.cmd d "init"})
(fun {disk-stop d} {disk.cmd d "stop"})

; The SD cards there: their SPI devices, a list (0-15; each one's ctl read, which starts it)
(fun {cards} {filter (fn {n} {try (not (== (fst (disk.ctl n)) "none")) NIL}) (range 16)})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; Special thanks to buildyourownlisp.com for the inspiration from 'lispy'!
:(math.pi    3.14159_26535_89793_23846_26433_83279_50288_41971_69399_37510_58209_74944_59230_78164_06286_20899_86280_34825_34211_70679_82148_08651_32823_06647_09384)
:(math.e     2.71828_18284_59045_23536_02874_71352_66249_77572_47093_69995)
:(math.phi   1.61803_39887_49894_84820_45868_34365_63811_77203_09179_80576)
:(math.gamma 0.57721_56649_01532_86061)

; function definition: fun, fn, fexpr, def, set, set! and let are built in

; cons (an item onto the front of a list) is built in

; composition helpers
(fun {flip f a b} {f b a})
(fun {ghost}      {eval &_})
(fun {comp f g x} {f (g x)}) ; Compose

; comparisons: not, ==, >=, <=, neg? and pos? are built in

:({<> !=} neq neq)

; test helpers: nil?, t?, zero? and one? are built in
:({=0 =1}  zero? one?)
:({0? 1?}  zero? one?)

; logical operators
(fun {xor a b} {and (or a b) (not (and a b))})

; math helper functions (1+ and 1- are built in)
(fun {>=0 n}    {>= n 0})
(fun {<=0 n}    {<= n 0})
(fun {>0 n}     {> n 0})
(fun {<0 n}     {< n 0})
(fun {!=0 n}    {not (zero? n)})
(fun {!=1 n}    {not (one? n)})
(fun {square n} {* n n})
(fun {cube n}   {* n (square n)})
(fun {recip n}  {/ 1 n})

:(inverse recip)
:(trunc truncate)

; currying
(fun {unpack f l}  {eval (cons f l)})
(fun {pack f}      {f &_})

:({apply curry uncurry} unpack unpack pack)

; a list's items, as they're written (not evaluated): fst, snd, thd, nth (from 0) and last are built in; past the
; list's end is an error
:({first second third fourth fifth sixth seventh eighth ninth tenth}
  (nth 0) (nth 1) (nth 2) (nth 3) (nth 4) (nth 5) (nth 6) (nth 7) (nth 8) (nth 9))

; coalescing operator to find first non-nil argument in the list
(fun {?? a} ?{a a ?(&_ .(?? &_))})

; take n items, and drop n (as many as there are) are built in

:(skip drop)

; split list at N
(fun {split n l} {[(take n l) (drop n l)]})

; is x in l? (elem? x l) is built in

(fun {has-element? l x} {elem? x l})

; do (built in) evaluates its arguments in turn and returns the last one's value
:(begin do)
:(block do)

; map, filter, foldl and foldr are built in

; pairs of items, one from each list, as long as both have them
(fun {zip a b} ?{
  (and a b)
  (cons [(fst a) (fst b)] (zip (tail a) (tail b)))
  NIL
})

; is f true of any item? of every item? the first it's true of, and how many: any?, all?, find and count are built in

; a list's items, and the items of the lists in it, in one list
(fun {flatten l} ?{
  l
  ?((qexpr? (fst l))
    (join (flatten (fst l)) (flatten (tail l)))
    (cons (fst l) (flatten (tail l))))
  NIL
})

; the items, each once (the first time it comes)
(fun {distinct l} ?{l (cons (fst l) (distinct (remove-all (fst l) (tail l)))) NIL})

; sum, product, min and max are built in
(fun {avg s}     {/ (sum s) (len s)})

; Switch/Cond
; a clause's test and value run where the clause was written (each the first of a list, made code: eval (head ...))
(fun {cond} ?{
  &_
  ?((eval (head (fst &_)))
    (eval (head (tail (fst &_))))
    .(cond (tail &_)))
  (error "Selection not found")
})

;:(switch cond)

(fun {case x} ?{
  &_
  ?((eq x (eval (head (fst &_))))
    (eval (head (tail (fst &_))))
    .(case (cons x (tail &_))))
  (error "Case not found")
})

; math functions (abs is built in)

(fun {floor a} {
  let {
    do
      =(tr (trunc a))
      (<=> (cmp a tr) {< (1- tr)} {tr})
  }
})

(fun {ceil a} {
  let {
    do
     =(tr (trunc a))
     (<=> (cmp a tr) {> (1+ tr)} {tr})
  }
})

; round: the nearest integer, a half away from zero
(fun {round a} {
  ?((neg? a) (- (floor (- 1/2 a))) (floor (+ a 1/2)))
})

; div and mod: the quotient rounded down (toward minus infinity, as mod has it), so (+ (* b (div a b)) (mod a b)) is a
(fun {div a b} ?{
  (and (num? a) (num? b))
  (floor (/ a b))
  (error "Cannot perform 'div' on non-numbers")
})

(fun {mod a b} ?{
  (and (num? a) (num? b))
  (- a (* b (floor (/ a b))))
  (error "Cannot perform 'mod' on non-numbers")
})

:(% mod)

(fun {divmod a b} ?{
  (and (num? a) (num? b))
  (cons (div a b) (list (mod ap drop ;
: vid-fields ( -- x y buttons ) vid-rec 1+ 11 vid-num  vid-rec 13 + 11 vid-num  vid-rec 25 + 11 vid-num ;
: mouse ( -- x y buttons )                        \ As it is (an open's first read)
  s" /dev/vid/mouse" r/o open-file throw >r vid-rec 49 r@ read-file r> close-file throw throw drop vid-fields ;
: mouse-wait ( -- x y buttons )                   \ Its next change (a click's, each in turn)
  vid-mfd @ 0= if s" /dev/vid/mouse" r/o open-file throw vid-mfd !  vid-rec 49 vid-mfd @ read-file throw drop then
  vid-rec 49 vid-mfd @ read-file throw drop vid-fields ;
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; clock.hl - the clock and the DS1747, by their files (#t, /dev): (use "clock").  /dev/time reads as the time
; (2026-10-03 15:04:05), and a write of that sets it (the chip too); /dev/rtc reads as what the boot found: running
; (and battery low), stopped (set the time), or none.  The time as numbers is the system library's (time, date,
; date-parts).  A failure is the system's error.

(use "dev")

; The clock (and the chip) set: "2026-10-04 12:00:00"
(fun {set-date text} {dev.write "/dev/time" text})

; The chip, a list of atoms: :running, :stopped or :none; and :battery-low
(fun {rtc} {do
  =(r (str-trim (dev.read "/dev/rtc")))
  (join (list (to-atom (fst (str-split r " ")))) (if (elem? "low" (str-split r " ")) {:battery-low} NIL))})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; cons.hl - the console's windows, by their files (#c, /dev): (use "cons").  /dev/wctl takes new (a window made) and
; current N (window N shown), and reads as the windows, a line each (* the one shown); /dev/consctl takes
; rawon and rawoff (raw lasts while a consctl is open: each key as it comes, unechoed); /dev/bell, a write, rings the
; console's bell (#a's: a short beep).  $window is this shell's window; (window-size) its size, consctl's size line
; (the smaller of the terminals it's shown on); (window-label s), (window-status s), (window-ctl s) its chrome (W4:
; /dev/label, wctl's status and any wctl line); (snarf), (snarf! s) the console's cut buffer (W6: /dev/snarf, all
; the windows' one, 8K at most; Ctrl-] y pastes it).  A failure is the system's error.

(use "dev")

(def {cons.ctl} NIL)

; This one's window ($window; none: 0)
(fun {window} {do =(w (env "window")) (if w (val w) 0)})

; This window's size, {cols rows}: its consctl's size line; with no console, $COLUMNS and $LINES, else 80 and 24
(fun {window-size} {do
  =(l (if (exists? "/dev/consctl") (filter (fn {l} {== (fst (str-split l " ")) "size"}) (dev.lines "/dev/consctl")) NIL))
  (if l (map val (tail (str-split (fst l) " "))) (list (cons.env "COLUMNS" 80) (cons.env "LINES" 24)))})
(fun {cons.env n d} {do =(v (env n)) (if v (val v) d)})

; This window's title (OSC 2's too): set (s; "": its program's name again), or with none, read
(fun {window-label} {if &_ (dev.write "/dev/label" (+ (fst &_) "\n")) (dev.read "/dev/label")})

; Its status line (the footer's %s), and any line of its wctl ("chrome screen off" ...)
(fun {window-status s} {dev.write "/dev/wctl" (+ "status " s)})
(fun {window-ctl s} {dev.write "/dev/wctl" s})

; The console's cut buffer: its text, or set (a write replaces it)
(fun {snarf} {dev.read "/dev/snarf"})
(fun {snarf! s} {dev.write "/dev/snarf" s})

; The windows, a list of their numbers; and the one shown
(fun {windows} {map (fn {l} {val (fst (str-split l " "))}) (dev.lines "/dev/wctl")})
(fun {shown-window} {val (fst (str-split (fst (filter (fn {l} {elem? "*" (str-split l " ")}) (dev.lines "/dev/wctl"))) " "))})

; A window made and shown, in this one's group, running the command line (rc's; none: the shell): the new-window
; command's; new-group's window in a group of its own (a shell session)
(fun {new-window} {if &_ (run "new-window" (fst &_)) (run "new-window")})
(fun {new-group} {if &_ (run "new-window" "-g" (fst &_)) (run "new-window" "-g")})

; Window n shown
(fun {show-window n} {dev.write "/dev/wctl" (format "current {}" n)})

; The keys raw (each as it comes, unechoed), till raw-off: consctl kept open meanwhile
(fun {raw-on} {do
  (if cons.ctl NIL (set! {cons.ctl} (sys-open "/dev/consctl" 1)))
  (sys-write cons.ctl "rawon")
  NIL})
(fun {raw-off} {if cons.ctl (do (sys-write cons.ctl "rawoff") (sys-close cons.ctl) (set! {cons.ctl} NIL) NIL) NIL})

; The bell: #a's beep (a BEL written, with no sound driver)
(fun {beep} {if (exists? "/dev/bell") (dev.write "/dev/bell" "\a") (do (write "\a") NIL)})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; dev.hl - what the device libraries share (gpio.hl, i2c.hl, spi.hl ...): (use "dev").  A device is files, each
; driven by one request at a time: a read is one READ (a pin's level, a transaction's bytes, a ctl's text) and a
; write one WRITE (a command, a transaction), the file opened for it and closed after, by the sys- functions (so it's
; an example of driving a device by hand too).  Bytes are a list of integers, 0-255 (a string's will do where
; they're written).  A failure is the system's error, the file closed first.

; (f fd) with the file open (mode: 0 to read, 1 to write, 2 both); its value, the file closed after.  (An error
; passes what it reaches: a failed open calls nothing, and a failure of f's closes the file and goes on.)
(fun {dev.with path mode f} {dev.with2 (sys-open path mode) f})
(fun {dev.with2 fd f} {dev.close fd (try (f fd) (do (sys-close fd) (error &err &code)))})
(fun {dev.close fd v} {do (sys-close fd) v})

; What one READ of the file gives, a string: n bytes at most (256 if n isn't given)
(fun {dev.read path} {do
  =(n ?(&_ (fst &_) 256))
  (dev.with path 0 (fn {fd} {sys-read fd n}))})

; Its text, its lines (a list of strings, without their line ends)
(fun {dev.lines path} {filter (fn {l} {> (len l) 0}) (str-split (dev.read path) "\n")})

; Its text, trimmed, a number
(fun {dev.num path} {val (str-trim (dev.read path))})

; One WRITE of the text (a string) or the bytes (a list) to the file; NIL
(fun {dev.write path data} {do
  (dev.with path 1 (fn {fd} {sys-write fd data}))
  NIL})

; A string's bytes, a list
(fun {dev.bytes s} {map char-code (str-chars s)})

; A number in hex, w digits, lower case (a device's name: an I2C address, an SPI device's 0-f)
(fun {dev.hex n w} {str-lower (hex n w)})
