\ tools/apigen.js from spec/: don't edit.  A library: its words in a word list of its own, hydra, which goes first
\ in the search order.  An error code's ior (a file word's, a sys- word's) is -512 less it.

require search.fl            \ (library)
library hydra

\ ---- constants
$01 constant abi_version     \ The ABI version this include describes
$C8 constant tick_hz         \ Ticks a second
$9F00 constant rb_dir          \ A code cache bank's directory (BANK_LOAD): its entries at RB_DIR + 16 x n, n
$00 constant re_start        \ A cache directory entry: where its module is (2)
$02 constant re_end          \ A cache directory entry: the first byte past it (2)
$04 constant re_table        \ A cache directory entry: a child's exports' table (2)
$06 constant re_gen          \ A cache directory entry: its load's number (0: free)
$07 constant re_flags        \ A cache directory entry: RF_*
$08 constant re_stamp        \ A cache directory entry: when it was last used (TK_RCLOCK) (2)
$EC constant tk_rclock       \ A task's code cache's uses counted (2): its zero page's
$08 constant rc_banks        \ A task's code cache's banks at most, to start with (BANK_FLUSH)
$02 constant bl_file         \ BANK_LOAD's why (.X): its file not there, or not read
$03 constant bl_format       \ BANK_LOAD's why (.X): not a child (o65, linked at $8000, in a bank)
$04 constant bl_zp           \ BANK_LOAD's why (.X): its zero page more than the caller gives
$05 constant bl_exports      \ BANK_LOAD's why (.X): the caller's exports' file not there, or not of its form
$06 constant bl_import       \ BANK_LOAD's why (.X): an import the caller hasn't (its name in TA_SCRATCH)
$07 constant bl_bank         \ BANK_LOAD's why (.X): no bank, or no room in one
$280 constant ta_scratch      \ A task's call scratch (32 bytes): an exit message, BANK_LOAD's missing import
