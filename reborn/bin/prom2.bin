$02 constant spawn_newns     \ SPAWN's flags: the child starts with an empty namespace of its own (else it sha
$04 constant spawn_fdmap     \ SPAWN's flags: the child's fds are r2's map (else the caller's 0, 1 and 2)
$08 constant spawn_noenv     \ SPAWN's flags: the child starts with an empty environment (else a copy of its p
$10 constant spawn_stopped   \ SPAWN's flags: the child stops at its entry point, for the debugger (/proc/N/ct
$400 constant env_size        \ TASKREAD's TR_ENV: its buffer, an environment's first variables, whole, and a
$2000 constant env_max         \ An environment's bytes at most: each variable its name's length, its name, it
$1F constant env_name_max    \ A variable's name's length at most
$0F constant spawn_fds       \ SPAWN's fd map: the child's fds it can give, at most (its fd 15 is its loader's
$00 constant mrepl           \ BIND's and MOUNT's flags: in place of what's at old
$01 constant mbefore         \ BIND's and MOUNT's flags: a union, new first
$02 constant mafter          \ BIND's and MOUNT's flags: a union, new last
$04 constant mcreate         \ BIND's and MOUNT's flags: a CREATE in the union comes to new
$1F constant exit_msg_max    \ An exit message's length at most (WAIT's buffer: 32 bytes)
$1000 constant kmesg_size      \ KMESG: the kernel's messages held at most (then the oldest go)
$00 constant tr_args         \ TASKREAD: a task's arguments (ARGS_MAX bytes)
$01 constant tr_cwd          \ TASKREAD: a task's current directory (PATH_MAX + 1 bytes)
$02 constant tr_env          \ TASKREAD: a task's environment's first variables, whole, and a 0 (ENV_SIZE byte
$03 constant tr_frame        \ TASKREAD: a task's state and frame (TF_SIZE bytes)
$04 constant tr_envat        \ TASKREAD: part of a task's environment (r1 bytes at most, from offset r2; .A/.X
$05 constant tr_fd           \ TASKREAD: a task's fd r2 (FI_SIZE bytes)
$00 constant fi_name         \ TR_FD's: the name its file was opened by (PATH_MAX + 1 bytes, zero-terminated)
$40 constant fi_mode         \ TR_FD's: its open mode (O_*) ...
$41 constant fi_dev          \ TR_FD's: its server's device letter ...
$42 constant fi_qtype        \ TR_FD's: its qid type (QT_DIR ...) ...
$43 constant fi_offset       \ TR_FD's: and its offset (4 bytes, low first)
$47 constant fi_size         \
$00 constant tf_state        \ TR_FRAME's: the task's state (0 free, 1 ready, 2 waiting, 3 calling, 4 idle, 5
$01 constant tf_s            \ TR_FRAME's: its stack pointer, as it was before the frame
