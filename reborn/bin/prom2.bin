; Dice
(fun {die+ sides mod}    {+ 1 mod (random sides)})
(fun {die sides}         {die+ sides 0})

(fun {d3+ m} {die+ 3 m})
(fun {d3} {d3+ 0})
(fun {d4+ m} {die+ 4 m})
(fun {d4} {d4+ 0})
(fun {d6+ m} {die+ 6 m})
(fun {d6} {d6+ 0})
