(fun {d12} {d12+ 0})
(fun {d20+ m} {die+ 20 m})
(fun {d20} {d20+ 0})
(fun {d24+ m} {die+ 24 m})
(fun {d24} {d24+ 0})
(fun {d30+ m} {die+ 30 m})
(fun {d30} {d30+ 0})
(fun {d60+ m} {die+ 60 m})
(fun {d60} {d60+ 0})
(fun {d100+ m} {die+ 100 m})
(fun {d100} {d100+ 0})

(fun {dice+ n sides mod} ?{(=0 n) mod (+ (die sides) (dice+ (1- n) sides mod))})
(fun {dice n sides}      {dice+ n sides 0})
:(roll repeat)
(fun {sumrolls d} ?{
  d
  (+
    (let {
      do
        =(hd (fst d))
        (cond
          {(num? hd) (die hd)}
          {(qexpr? hd)
            (case (len hd) 
              {1 .(die hd)}
             **********
(def {harn.attr-keys} {:sp :sx :bd :ss :ht :fr :owt :wt :cml :str :sta :dex :agl :eye :hrg :sml :voi :int :aur :wil
  :mor :dty :pty})
(def {harn.attr-names} {"Species" "Sex" "Birthday" "Sunsign" "Height" "Frame" "Optimum Weight" "Weight" "Comeliness"
  "Strength" "Stamina" "Dexterity" "Agility" "Eyesight" "Hearing" "Smell" "Voice" "Intelligence" "Aura" "Will"
  "Morality" "Deity" "Piety" "Endurance"})
(def {harn.species-names} {"Human" "Sindarin" "Khuzdul" "Other"})
(def {harn.sex-names} {"Female" "Male"})
(def {harn.month-names} {"Nuzyael" "Peonu" "Kelen" "Nolus" "Larane" "Agrazhar" "Azura" "Halane" "Savor" "Ilvin"
  "Navek" "Morgat"})
(def {harn.sign-names} {"Ulandus" "Aralius" "Feniri" "Ahnu" "Angberelius" "Nadai" "Hirin" "Tarael" "Tai" "Skorus"
  "Masara" "Lado"})
(def {harn.culture-names} {"Tribal" "Viking" "Feudal" "Imperial" "Khuzan" "Sindarin"})
(def {harn.class-names} {"Slave" "Serf" "Unguilded" "Guilded" "Noble"})
(def {harn.parent-names} {"Offspring" "Fostered" "Adopted" "Bastard" "Orphan"})
(def {harn.estrangement-names} {"Outcast" "Unpopular" "Average" "Popular" "Favorite"})
(def {harn.clanhead-names} {"Distant Relation" "Aunt or Uncle" "Cousin" "Father or Mother"})
(def {harn.frame-names} {"Scant" "Light" "Medium" "Heavy" "Massive"})
(def {harn.complexion-names} {"Fair" "Medium" "Dark"})
(def {harn.hair-names} {"Brown" "Black" "Red" "Silver" "Blond"})
(def {harn.eye-names} {"Hazel" "Gray" "Violet" "Green" "Blue"})
(def {harn.medical-names} {"None" "Addiction" "Albinism" "Allergy" "Ambidextrous" "Arm" "Birthmark" "Dwarfism"
  "Epilepsy" "Ear" "Eye" "Gigantism" "Hemophilia" "Hirsutism" "Leg" "Left-Handed" "Leprosy" "Lycanthropy"
  "Monochromasia" "Obesity" "Parasites" "Poxmarks" "Scars" "Sterile"})
(def {harn.psyche-names} {"None" "Acrophobia" "Aichmophobia" "Algophobia" "Astraphobia" "Ballistophobia" "Bulimia"
  "Claustrophobia" "Cynophobia" "Dyslexia" "Entomophobia" "Gamblamania" "Gephyrophobia" "Heliophobia" "Hemophobia"
  "Hydrophobia" "Hypochondria" "Ivashuphobia" "Kleptomania" "Megalomania" "Mysophobia" "Multiple Personality"
  "Musophobia" "Necrophobia" "Nyctophobia" "Ophidiophobia" "Ornithophobia" "Paranoia" "Psychopathy" "Pvaraphobia"
  "Pyromania" "Pyrophobia" "Sadism" "Sex Mania" "Theophobia" "Toxicophobia" "Violent Temper" "Xenophobia"
  "Yaelaphobia"})
(def {harn.sexuality-names} {"Heterosexual" "Bi-Sexual" "Homosexual"})
(def {harn.deity-names} {"Agrik" "Halea" "Ilvir" "Larani" "Morgath" "Naveh" "Peoni" "Sarajin" "Save-K'nor" "Siem"
  "None"})

; A month's name (1-12), a comeliness's (Character 6)
(def {harn.month-name} (fn {m} {nth (- m 1) harn.month-names}))
(def {harn.comeliness-name} (fn {n} {
  nth (harn.table {5 8 12 15 99} n) {"Ugly" "Plain" "Average" "Attractive" "Handsome"}}))

; A sunsign's signs (Character 3): its own, then the other of a cusp (the one before for its first days, after for
; its last; its own again for the sign alone)
(def {harn.sunsign-signs} (fn {ss} {do
  =(s (truncate (/ ss 3)))
  =(k (- ss (* 3 s)))
  (list s ?((eq k 1) s ?((zero? k) ?((zero? s) 11 (- s 1)) ?((eq s 11) 0 (+ s 1)))))}))

(def {harn.sunsign-name} (fn {ss} {do
  =(s (harn.sunsign-signs ss))
  ?((eq (fst s) (snd s)) (nth (fst s) harn.sign-names)
    (+ (nth (fst s) harn.sign-names) "-" (nth (snd s) harn.sign-names) " Cusp"))}))

; ************************
; *** Birth (Character 2-3) ***
; ************************
; Each sign's first day of the year (0 the 1st of Nuzyael): Ulandus from the 4th of Nuzyael ... Lado from the 2nd of
; Morgat to the 3rd of Nuzyael; a sign's first two days and last two its cusps
(def {harn.sign-starts} {3 33 62 93 124 156 185 214 243 272 302 331})
(def {harn.sunsign-of} (fn {m d} {do
  =(day (+ (* 30 (- m 1)) d -1))
  =(s (harn.table harn.sign-starts (+ day 1)))
  =(s ?((< day 3) 11 ?((< day (nth s harn.sign-starts)) (- s 1) s)))
  =(from (nth s harn.sign-starts))
  =(ln (- ?((< s 11) (nth (+ s 1) harn.sign-starts) 363) from))
  =(at (- day from))
  =(at ?((< at 0) (+ at 360) at))
  (+ (* 3 s) ?((< at 2) 0 ?((>= at (- ln 2)) 2 1)))}))

; Each culture's upper bounds for slave, serf, unguilded and guilded (noble the rest).  (The Viking column has
; unguilded 81-93 and guilded 86-98: here unguilded 81-85.  Feudal slaves are Rethem's, serfs elsewhere: the table
; as it is)
(def {harn.class-table} {{10 10 99 99 100} {15 80 85 98 100} {15 70 93 98 100} {25 25 90 98 100} {0 0 15 98 100}
  {0 0 70 99 100}})

; *****************************
; *** Appearance (Character 6) ***
; *****************************
; The Height/Weight table: 75 pounds at 40", 2 more an inch to 51", 3 from 52", 4 from 64", 3 at 70", 5 from 71"
; (to 89": 255); then the frame's -20% ... +20%, rounded
(def {harn.weight} (fn {ht fr} {do
  =(h (min 89 (max 40 ht)))
  =(w ?((<= h 51) (+ 75 (* 2 (- h 40))) ?((<= h 63) (+ 97 (* 3 (- h 51))) ?((<= h 69) (+ 133 (* 4 (- h 63)))
    (+ 160 (* 5 (- h 70)))))))
  (truncate (/ (+ (* w (+ 8 fr)) 5) 10))}))

; Hair and eyes by the complexion (humans +25 for a fair one, -25 for a dark one): each species' upper bounds (Human,
; Sindarin, Khuzdul; Other as Human)
(def {harn.colour-roll} (fn {sp c} {do
  =(r (harn.d 100))
  (max 1 (min 100 ?((or (zero? sp) (eq sp 3)) (+ r (nth c {25 0 -25})) r)))}))

; **********************************************
; *** The attributes' modifiers (Character 6-10) ***
; **********************************************
; By species (a human female's own), frame (Agility: scant +2 ... massive -2), weight (Strength: 56-85 -4 ...
; 146-155 0 ... 216-245 +4, the table's ends past it)
(def {harn.species-mods} (list #({}) #({{:fr -2} {:str 1} {:sta 1} {:cml 2} {:dex 2} {:agl 2} {:eye 2} {:hrg 2}
  {:voi 2} {:sml 3} {:mor 3} {:aur 4}}) #({{:aur -2} {:dex 1} {:eye 1} {:hrg 2} {:sml 2} {:fr 3} {:wil 3} {:str 4}
  {:sta 4}}) #({})))
(def {harn.female-mods} #({{:fr -3} {:aur 2}}))
(def {harn.species-attr-mod} (fn {sp sx a} {do
  =(v (?((and (zero? sx) (zero? sp)) harn.female-mods (nth sp harn.species-mods)) a))
  ?(v v 0)}))

; An attribute rolled: 3d6 and its modifiers, at least 1
(def {harn.rand-attr} (fn {sp sx fr wt a} {do
  =(r (+ (harn.dice 3 6) (harn.species-attr-mod sp sx a)))
  (max 1 ?((eq a :agl) (+ r 2 (- fr))
    ?((eq a :str) (+ r -4 (harn.table {85 110 130 145 155 170 190 215 999} wt)) r)))}))

; ***********************************
; *** Medical traits (Character 9) ***
; ***********************************
; Each trait's upper bound (1, Addiction ... 23, Sterile): a male's roll, a female's
(def {harn.medical-m} {8 9 14 17 20 24 25 27 28 30 31 32 33 35 39 41 42 44 47 57 60 63 65})
(def {harn.medical-f} {5 6 10 14 15 19 20 22 23 25 26 27 29 30 40 42 43 45 48 58 61 63 65})

; A trait's effects (dwarfism's and gigantism's on height aren't made: the height's taken).  Epilepsy's Intelligence
; is :int+ till Intelligence is rolled (harn_create's order: the traits before the personality)
(def {harn.less} (fn {ch a n} {hash-put ch [a (max 1 (- (ch a) n))]}))
(def {harn.medical-effect} (fn {ch m} {
  ?((eq m 4) (hash-put ch [:dex (+ (ch :dex) (harn.d 3))])
  ?((eq m 5) (harn.less ch :dex (harn.d 3))
  ?((elem? m {6 13 21 22}) (harn.less ch :cml (harn.d 3))
  ?((eq m 8) (hash-put ch [:int+ (harn.d 3)])
  ?((eq m 9) (harn.less ch :hrg (harn.d 3))
  ?((or (eq m 10) (eq m 18)) (harn.less ch :eye (harn.d 3))
  ?((eq m 14) (harn.less ch :agl (shr (ch :agl) 1))
  ?((eq m 15) (hash-put ch [:dex (+ (ch :dex) (harn.d 2))])
  ?((eq m 16) (harn.less ch :cml (harn.dice 2 6))
  ?((eq m 19)
    (do (hash-put ch [:wt (truncate (/ (* (ch :wt) (+ 150 (random 51))) 100))]) (harn.less ch :agl (harn.d 3)))
  NIL))))))))))}))

; A roll on the table: a trait (with its effects; each once, four at most), multiple (two rolls more), or none
(def {harn.rand-medical} (fn {ch depth} {do
  =(r (harn.d 100))
  ?((> r 70) NIL
  ?((> r 65) ?((< depth 3) (do (harn.rand-medical ch (+ depth 1)) (harn.rand-medical ch (+ depth 1))) NIL)
    (do
      =(m (+ 1 (harn.table ?((zero? (ch :sx)) harn.medical-f harn.medical-m) r)))
      ?((or (elem? m (ch :med)) (>= (len (ch :med)) 4)) NIL
        (do (hash-put ch [:med (join (ch :med) (list m))]) (harn.medical-effect ch m))))))}))

; ****************** b)))
  (error "Cannot perform 'divmod' on non-numbers")
})

(fun {fdiv a b} ?{
  (and (num? a) (num? b))
  (to-fixed (/ a b) ?((and (defined? &1) (num? &1)) &1 10))
  (error "Cannot perform 'fdiv' on non-numbers")
})

(fun {frecip n} ?{(defined? &1) (fdiv 1 n &1) (fdiv 1 n)})
:(finverse frecip)

(fun {odd? n} ?{
  (num? n)
  (=1 (mod n 2))
  (error "Cannot perform 'odd?' on non-number")
})

(fun {even? n} ?{
  (num? n)
  (=0 (mod n 2))
  (error "Cannot perform 'even?' on non-number")
})

(fun {positive? a} ?{(num? a) (pos? a) (error "Only numbers can be positive")})
(fun {negative? a} ?{(num? a) (neg? a) (error "Only numbers can be negative")})

:({+? -? 0?} positive? negative? zero?)

(fun {minimum} .{min &1})
(fun {maximum} .{max &1})

; String helpers
(fun {starts-with? s sub} {=0 (index-of s sub)})
(fun {ends-with?   s sub} {and (>= (len s) (len sub)) (eq (substring s (- (len s) (len sub))) sub)})
(fun {contains?    s sub} {>=0 (index-of s sub)})

; Repeat: a list of d's values, run n times
(fun {repeat n d} ?{(=0 n) NIL (cons (eval d) (repeat (1- n) d))})
:(times repeat)

; Libraries: (use "name") loads lib/name.dl (on the Hydra, /lib/hylang/name.hl) once; NIL, or the error that
; stopped it (then it isn't counted as loaded)
(def {used} {})
(fun {use name} ?{
  (elem? name used)
  NIL
  (do (load name) (set! {used} (cons name used)) NIL)
})

; sort and related
; (in? x l) is built in
(fun {remove-fst f l} ?{
  l
  (do
    =(hd (fst l))
    =(tl (tail l))
    ?(
      (eq f hd)
      tl
      (cons hd (remove-fst f tl))
    )
  )
})

(fun {remove-min} {remove-fst .(min &1) &1})
(fun {remove-max} {remove-fst .(max &1) &1})

(fun {remove-all f l} ?{
  l
  (do
    =(hd (fst l))
    =(tl (tail l))
    ?(
      (eq f hd)
      (remove-all f tl)
      (cons hd (remove-all f tl))
    )
  )
})

; sort is built in: (sort l), or (sort l less)
(fun {sort-desc l} {reverse (sort l)})

(fun {best-of n l} {take n (sort-desc l)})
(fun {worst-of n l} {take n (sort l)})

:({top bottom} best-of worst-of)

(fun {between?} ?{(<= &1 &2) (and (>= &3 &1) (<= &3 &2)) (between? &2 &1 &3)})
:(><? between?)
(fun {not-between?} {not (between? &1 &2 &3)})
:(!><? not-between?)

(fun {all-between?} ?{&3 (and (between? &1 &2 (fst &3)) (all-between? &1 &2 (tail &3))) T})
:(*><? all-between?)

(fun {all-not-between?} ?{&3 (and (not-between? &1 &2 (fst &3)) (all-not-between? &1 &2 (tail &3))) T})
:(*!><? all-not-between?)

(fun {not-all-between?} {not (all-between? &1 &2 &3)})
:(!*><? not-all-between?)
