d©É )©9… © …! Â°|­0 constant o_trunc         \ Open modes: empty the file first
$40 constant o_nonblock      \ Open modes: E_AGAIN rather than wait
$10 constant fd_max          \ Fds a task has (0 stdin, 1 stdout, 2 stderr)
$3F constant path_max        \ A path's length at most
$200 constant io_unit         \ The most a READ or WRITE asks of a server in one request
$00 constant sr_name         \ The stat record (SR_SIZE bytes): its name (32, zero-terminated)
$20 constant sr_qtype        \ Stat: the qid's type (QT_*)
$21 constant sr_qvers        \ Stat: the qid's version
$22 constant sr_qpath        \ Stat: the qid's path (4: unique in its server)
$26 constant sr_mode         \ Stat: the mode (2: permissions; high byte DM_DIR)
$28 constant sr_length       \ Stat: the length (4)
$2C constant sr_mtime        \ Stat: the time it changed (4: seconds since 2000)
$30 constant sr_dev          \ Stat: the device letter
$31 constant sr_inst         \ Stat: the device's instance (its spec's first character)
$40 constant sr_size         \
$80 constant qt_dir          \ Qid types: a directory
$00 constant qt_file         \
$80 constant dm_dir          \ A mode's high byte: a directory
$40 constant dm_append       \ A mode's high byte: append-only (writes go to the end)
$18 constant snd_channels    \ Sound (#a): its channels: 0-7 the YM2151's, 8-23 the Vera X's PSG (its voices 0
$08 constant snd_psg         \ Sound: the PSG's first channel (its voice 0)
$A3 constant snd_patches     \ Sound: its patches (0-127: General MIDI's programs; 128-162: drums and percussi
$80 constant snd_drums       \ Sound: General MIDI's drums (MIDI channel 10's notes)
$02 constant snd_r_ch        \ Sound: a command, at a register the chip doesn't have: the channel the next com
$03 constant snd_r_patch     \ Sound: load patch n into the channel (its speakers stay)
$04 constant snd_r_note      \ Sound: key on MIDI note n (60: middle C; 69: A, 440 Hz), with the channel's ben
$05 constant snd_r_off       \ Sound: key off (the release)
$06 constant snd_r_vol       \ Sound: the channel's volume (0-127, as General MIDI's)
$07 constant snd_r_pan       \ Sound: the channel's speakers (SND_PAN_*)
$09 constant snd_r_bend      \ Sound: the channel's bend (signed: 64ths of a semitone; the note playing too)
$0A constant snd_r_drum      \ Sound: a General MIDI drum (its patch and pitch), keyed on
$0B constant snd_r_freq_lo   \ Sound: a frequency's low byte (Hz), for SND_R_FREQ (only kept)
$0C constant snd_r_freq      \ Sound: key on at a frequency, SND_R_FREQ_LO's byte and this its high one (Hz; 0
$0D constant snd_r_glide     \ Sound: the channel's pitch to note n without a new attack (legato)
$0E constant snd_r_wave      \ Sound: a PSG channel's waveform: SND_WAVE_* << 6 | its pulse width (0-63: 63 a
$01 constant snd_pan_left    \ Sound: SND_R_PAN's speakers
$02 constant snd_pan_right   \
$03 constant snd_pan_both    \
$00 constant snd_wave_pulse  \ Sound: SND_R_WAVE's waveforms (the PSG's)
$01 constant snd_wave_saw    \
$02 constant snd_wave_triangle \
$03 constant snd_wave_noise  \

\ ---- error codes
$01 constant e_perm          \ not allowed
$02 constant e_inval         \ invalid argument
$03 constant e_nosys         \ no such call
$04 constant e_again         \ not yet: try again
$05 constant e_intr          \ interrupted
$06 constant e_nomem         \ out of memory
$07 constant e_busy          \ busy
$08 constant e_range         \ out of range
$09 constant e_fault         \ bad address
$0A constant e_nametoolong   \ name too long
$0B constant e_toobig        \ too big
$20 constant e_noent         \ not found
$21 constant e_exist         \ already exists
$22 constant e_notdir        \ not a directory
$23 constant e_isdir         \ is a directory
$24 constant e_notempty      \ directory not empty
$25 constant e_badf          \ bad file descriptor
$26 constant e_mfile         \ no free file descriptor
$27 constant e_nfile         \ too many open files
$28 constant e_nospc         \ disk full
$29 constant e_rofs          \ read-only
$2A constant e_io            \ i/o error
$2B constant e_nodev         \ no such device
$2C constant e_pipe          \ broken pipe
$2D constant e_noexec        \ not a program
$2E constant e_eof           \ end of file
$2F constant e_notfs         \ no file system
$30 constant e_media         \ medium error
$40 constant e_notask        \ no free task
$41 constant e_srch          \ no such task
$42 constant e_child         \ no such child
$50 constant e_nsfull        \ namespace full
$51 constant e_nsloop        \ too many binds

end-library
