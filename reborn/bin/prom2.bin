; reads as 0 or 1; a write of 0 or 1 sets it, the pin an output), port (all 8: a byte), ctl (in N, out N, ddr N,
; ca1 rise or fall, ca2 0, 1 or in; it reads as the pins and the handshake lines, a line each) and ca1 (a read waits
; for CA1's next edge, then gives the edges counted).  A pin is 0-7, the pin first.  A failure is the system's error.

(use "dev")

(fun {gpio.ctl line} {dev.write "/dev/gpio/ctl" line})
(fun {gpio.file pin} {+ "/dev/gpio/" (to-str pin)})

; A pin's level, 0 or 1
(fun {gpio pin} {dev.num (gpio.file pin)})

; The pin made an output, its level set (0 or 1)
(fun {gpio! pin level} {dev.write (gpio.file pin) ?((== level 0) "0" "1")})

; The pin made an input, or an output
(fun {gpio-in pin} {gpio.ctl (format "in {}" pin)})
(fun {gpio-out pin} {gpio.ctl (format "out {}" pin)})

; All 8 pins' levels, a byte (bit n, pin n)
(fun {gpio-port} {char-code (char-at (dev.read "/dev/gpio/port" 1) 0)})

; The outputs' levels set from a byte (the inputs keep theirs)
(fun {gpio-port! byte} {dev.write "/dev/gpio/port" (list byte)})

; The pins' directions: bit n 1, pin n an output
(fun {gpio-ddr! byte} {gpio.ctl (format "ddr {}" byte)})

; CA1's active edge, :rise or :fall
(fun {gpio-ca1! edge} {if (eq edge :rise) (gpio.ctl "ca1 rise")
  (if (eq edge :fall) (gpio.ctl "ca1 fall") (error "'gpio-ca1!' expects :rise or :fall" :inval))})

; CA2: 0 (an output, low), 1 (high) or :in (an input)
(fun {gpio-ca2! v} {gpio.ctl ?((eq v :in) "ca2 in" (format "ca2 {}" ?((== v 0) 0 1)))})

; CA1's next edge waited for: the edges counted
(fun {gpio-wait} {dev.num "/dev/gpio/ca1"})

; The pins and the handshake lines, a hash: each pin (0-7) its direction and level, {:out 1}; :ca1 its edge and
; the edges counted, {:rise 3}; :ca2 its level, or :in
(fun {gpio-state} {hash-create (map gpio.entry (dev.lines "/dev/gpio/ctl"))})
(fun {gpio.entry line} {do
  =(w (str-split line " "))
  ?((digit? (char-at line 0))
    (list (val (fst w)) (list (to-atom (snd w)) (val (thd w))))
    ?((== (fst w) "ca1")
      (list :ca1 (list (to-atom (snd w)) (val (thd w))))
      (list (to-atom (fst w)) ?((== (snd w) "in") :in (val (snd w))))))})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; harn.hl - HarnMaster (third edition, 3.5) characters and their rules: (use "harn").  danlang's lib/harn.dl made
; for hylang's speed: the same rules, by the C SDK's numbers (harn.h's: a species 0-3, a sunsign 0-35 ...), so a
; character is harn.h's and its file harnfile.c's, which the C game and every generator read.  Each value's names are
; lists (nth): (nth sp harn.species-names).  harntest.hl has the tests, the penalties and development (as harn.h's
; harntest.c); combat and healing are harn.dl's and harn.h's.  As harn.dl, occupations, contacts, aging, psionics,
; magic and rituals are left out.
;
; A character is a hash: its attributes by harn.dl's keys (:sp :sx :bd :ss :ht :fr :owt :wt :cml :str ... :mor :dty
; :pty: harn.attr-keys), its family (:culture :social :sibrank :famsize :parent :estrange :clanhead), its colours
; (:complexion :hair :eyes), :med (its medical traits), :psy (its disorders, a list of {disorder severity}),
; :sexuality, :ml (a buffer: each skill's mastery level by its number, 0 not opened), its volatiles (:fl :bl :dp
; :state :shockhr, and :inj, a list of injuries: {loc aspect sev il hr flags}), and :sg (its sunsign's two signs'
; letters, for the skills' bonuses).
;
; hylang reads a library slowly, and compiles each function fun makes as it's read: these are def's and fn's, each
; compiled at its second call, so those a program calls once or not at all cost it no time.  The Skill Data table is
; text, for the same reason.  hylang's random can't be seeded: the same character twice is HyForth's (harn.fs) or C's.

; ****************
; *** Dice ***
; ****************
(def {harn.d} (fn {n} {+ 1 (random n)}))
(def {harn.dice} (fn {n s} {?((zero? n) 0 (+ 1 (random s) (harn.dice (- n 1) s)))}))

; A table's place for a roll: the first of its upper bounds the roll doesn't pass (the last if it passes them all)
(def {harn.table} (fn {upto r} {?((or (nil? (tail upto)) (<= r (fst upto))) 0 (+ 1 (harn.table (tail upto) r)))}))

; ***************************
; *** The names ***
; *******************************************************
; *** Penalties (Skills 6), move (Combat 6), size (Character 6) ***
; *****************************************************************
; UP: fatigue and the injuries' levels; PP: UP and EP, the load (:load, pounds) over Endurance, rounded
(def {harn.il} (fn {i} {nth 3 i}))
(def {harn.get-up} (fn {ch} {+ (ch :fl) (sum (map harn.il (ch :inj)))}))
(def {harn.get-ep} (fn {ch} {do =(l (ch :load)) =(e (harn.end ch)) ?(l (truncate (/ (+ l l e) (* 2 e))) 0)}))
(def {harn.get-pp} (fn {ch} {+ (harn.get-up ch) (harn.get-ep ch)}))
(def {harn.move} (fn {ch} {max 1 (- (ch :agl) (harn.get-pp ch))}))

; Size: 1-10 by weight (Character 6)
(def {harn.size} (fn {ch} {+ 1 (harn.table {65 75 90 110 135 165 200 240 285 9999} (ch :wt))}))

; ************************************************
; *** A new character (Character 2-12): harn.create ***
; ************************************************
; In harn_create's order (harngen.c's): birth, culture and class, family, appearance, the physical attributes, the
; medical traits, the personality, piety; then the automatic skills opened
; (A hash made whole is made faster than one put an entry at a time: the attributes as far as the physical ones,
; and harn.blank's, in one)
(def {harn.blank} {{:med {}} {:psy {}} {:inj {}} {:sexuality 0} {:fl 0} {:bl 0} {:dp 0} {:state 0} {:shockhr 0}})
(def {harn.new} (fn {} {hash-create (cons [:ml (buffer 100)] harn.blank)}))
(def {harn.signs-of} (fn {ss} {do
  =(s (harn.sunsign-signs ss))
  (list (char-at "abcdefghijkl" (fst s)) (char-at "abcdefghijkl" (snd s)))}))

(def {harn.species} NIL)                        ; A species fixed (0-2, harn_template's), or NIL: rolled
(def {harn.create} (fn {} {do
  =(rolled (harn.table {97 98 99 100} (harn.d 100)))
  =(sp ?((nil? harn.species) rolled harn.species))
  =(sx ?((<= (harn.d 100) (nth sp {48 45 75 48})) 1 0))
  =(m (harn.d 12))
  =(d (harn.d 30))
  =(ss (harn.sunsign-of m d))
  =(culture (nth sp {2 5 4 2}))
  =(social (harn.table (nth culture harn.class-table) (harn.d 100)))
  =(rank (+ 1 (harn.table {25 50 70 85 95 100} (max 1 (- (harn.d 100) ?((or (eq sp 1) (eq sp 2)) 20 0))))))
  =(size (+ rank (harn.d 6) -1))
  =(parent (harn.table {50 70 75 90 100} (harn.d 100)))
  =(est (harn.table {10 40 60 95 100} (min 100 (+ (harn.d 100) ?((eq rank 1) 5 0)))))
  =(head (harn.table {50 75 85 100} (harn.d 100)))
  =(ht (+ (nth sp ?((zero? sx) {52 50 40 52} {54 51 40 54})) (harn.dice 4 6)))
  =(fr (harn.table {5 8 12 15 99} (+ (harn.dice 3 6) (harn.species-attr-mod sp sx :fr))))
  =(wt (harn.weight ht fr))
  =(cml (harn.rand-attr sp sx fr wt :cml))
  =(c (harn.table (nth sp {{27 74 100} {97 99 100} {90 100 100} {27 74 100}}) (harn.d 100)))
  =(hair (harn.table (nth sp {{40 55 65 70 100} {25 48 50 60 100} {40 45 70 90 100} {40 55 65 70 100}})
    (harn.colour-roll sp c)))
  =(eyes (harn.table (nth sp {{40 55 56 70 100} {15 65 75 80 100} {50 69 70 85 100} {40 55 56 70 100}})
    (harn.colour-roll sp c)))
  =(ch (hash-create (join (list [:sp sp] [:sx sx] [:bd (+ (* 256 m) d)] [:ss ss] [:sg (harn.signs-of ss)]
    [:culture culture] [:social social] [:sibrank rank] [:famsize size] [:parent parent] [:estrange est]
    [:clanhead head] [:ht ht] [:fr fr] [:owt wt] [:wt wt] [:cml cml] [:complexion c] [:hair hair] [:eyes eyes]
    [:ml (buffer 100)])
    (harn.rolls sp sx fr wt {:str :sta :dex :agl :eye :hrg :sml :voi}) harn.blank)))
  (harn.rand-medical ch 0)
  =(e (ch :int+))
  (hash-put ch [:int (+ (harn.rand-attr sp sx fr wt :int) ?(e e 0))] [:aur (harn.rand-attr sp sx fr wt :aur)]
    [:wil (harn.rand-attr sp sx fr wt :wil)] [:mor (harn.rand-attr sp sx fr wt :mor)] [:dty 10] [:pty (harn.dice 5 6)])
  ?(e (hash-remove ch :int+) NIL)
  (harn.open-autos ch 0)
  ch}))

; Attributes rolled, a list of entries
(def {harn.rolls} (fn {sp sx fr wt l} {
  ?(l (cons [(fst l) (harn.rand-attr sp sx fr wt (fst l))] (harn.rolls sp sx fr wt (tail l))) {})}))

; The automatic skills, at their OMLs (from skill k on)
(def {harn.open-autos} (fn {ch k} {
  ?((< k 91) (do ?((eq (harn.sk k 38) \1) (harn.open-skill ch k) NIL) (harn.open-autos ch (+ k 1))) NIL)}))

; ************************************************
; *** Files (harnfile.c's): a line a thing ***
; ************************************************
; harn 1; att KEY VALUE (each attribute, harn.attr-keys' order); fam culture social sibrank famsize parent estrange
; clanhead; look complexion hair eyes; med (the traits); psy DISORDER SEVERITY (a line each); sexuality N; ml KEY ML
; (each open skill); vol fl bl dp state shockhr; inj loc aspect sev il hr flags (each injury); then the program's own
; lines (more: a list of strings, "name Dorn" ...)
(def {harn.att-line} (fn {ch a} {+ "att " (substring (to-str a) 1) " " (ch a)}))
(def {harn.ml-lines} (fn {ch k l} {?((< k 0) l (do =(ml (buffer-get (ch :ml) k))
  (harn.ml-lines ch (- k 1) ?((zero? ml) l (cons (+ "ml " (harn.skill-key k) " " ml) l)))))}))
(def {harn.of} (fn {ch a} {ch a}))
(def {harn.nums} (fn {ch l} {str-join (map (harn.of ch) l) " "}))
(def {harn.lines} (fn {ch} {join
  {"harn 1"}
  (map (harn.att-line ch) harn.attr-keys)
  (list (+ "fam " (harn.nums ch {:culture :social :sibrank :famsize :parent :estrange :clanhead}))
    (+ "look " (harn.nums ch {:complexion :hair :eyes}))
    (str-join (cons "med" (ch :med)) " "))
  (map (fn {x} {+ "psy " (fst x) " " (snd x)}) (ch :psy))
  (list (+ "sexuality " (ch :sexuality)))
  (harn.ml-lines ch 90 {})
  (list (+ "vol " (harn.nums ch {:fl :bl :dp :state :shockhr})))
  (map (fn {i} {str-join (cons "inj" i) " "}) (ch :inj))}))

(def {harn.write} (fn {path ch more} {write-file path (str-join (join (harn.lines ch) more {""}) "\n")}))

; A character read from a file (NIL: none there): its lines that aren't harn.h's in :other, a list
(def {harn.read} (fn {path} {do
  =(ch (harn.new))
  (hash-put ch [:other {}])
  (each (harn.read-line ch) (read-lines path))
  ?((ch :ss) (do (hash-put ch [:sg (harn.signs-of (ch :ss))]) ch) NIL)}))

(def {harn.put-all} (fn {ch keys vals} {?((and keys vals) (do (hash-put ch [(fst keys) (fst vals)])
  (harn.put-all ch (tail keys) (tail vals))) NIL)}))
(def {harn.read-line} (fn {ch l} {do
  =(w (str-split (str-trim l) " "))
  =(k (fst w))
  =(n (map val (filter digit? (tail w))))
  ?((eq k "att") (hash-put ch [(to-atom (snd w)) (val (thd w))])
  ?((eq k "fam") (harn.put-all ch {:culture :social :sibrank :famsize :parent :estrange :clanhead} n)
  ?((eq k "look") (harn.put-all ch {:complexion :hair :eyes} n)
  ?((eq k "med") (hash-put ch [:med n])
  ?((eq k "psy") (hash-put ch [:psy (join (ch :psy) (list n))])
  ?((eq k "sexuality") (hash-put ch [:sexuality (fst n)])
  ?((eq k "ml") (do =(sk ?((digit? (snd w)) (val (snd w)) (harn.skill-of ?((eq (snd w) "tar") "trt" (snd w)))))
    ?((>= sk 0) (harn.put-ml ch sk (val (thd w))) NIL))
  ?((eq k "vol") (harn.put-all ch {:fl :bl :dp :state :shockhr} n)
  ?((eq k "inj") (hash-put ch [:inj (join (ch :inj) (list n))])
  ?((or (eq k "harn") (eq k "")) NIL
  (hash-put ch [:other (join (ch :other) (list l))])))))))))))}))
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; harntest.hl - HarnMaster's tests, penalties and development (Skills 5-6, 21-22), for harn.hl's characters: (use
; "harntest"), which uses harn.  Kept apart from harn.hl, as harn.h's harntest.c is, so a program that only makes a
; character (hmchar.hl) doesn't wait for hylang to read them.  A test's result is 0 CF, 1 MF, 2 MS or 3 CS.

(use "harn")

; Development (Skills 6): d100 and SB over ML raise it by 1 (it can't pass 100 + SB): :improved, :not-improved,
; :maxed; a development point spent on one (apply-dr): :no-dp if there's none
(def {harn.develop} (fn {ch sk} {do
  =(ml (harn.get-ml ch sk))
  =(sb (harn.get-sb ch sk))
  ?((>= ml (+ 100 sb)) :maxed
    ?((> (+ (harn.d 100) sb) ml) (do (harn.put-ml ch sk (+ ml 1)) :improved) :not-improved))}))
(def {harn.apply-dr} (fn {ch sk} {?((zero? (ch :dp)) :no-dp
  (do =(r (harn.develop ch sk)) ?((eq r :maxed) NIL (hash-put ch [:dp (- (ch :dp) 1)])) r))}))

; d100 at or under the EML (kept from 5 to 95): 0 CF, 1 MF, 2 MS, 3 CS (a roll ending in 0 or 5 critical)
(*******************************************************
; *** Mental disorders and sexuality (Character 11: optional rules, not made) ***
; *************************************************************************
; A disorder (1, Acrophobia ... 38, Yaelaphobia) or more, each with its severity (0 mild, 1 moderate, 2 severe), into
; :psy; a sexuality (0 heterosexual, 1 bisexual, 2 homosexual)
(def {harn.psyche-table} {3 5 6 8 9 11 14 15 17 19 22 24 25 26 28 31 32 35 36 37 38 40 43 45 46 47 48 49 51 54 56 57
  59 60 61 63 64 65})
(def {harn.rand-psyche} (fn {ch depth} {do
  =(r (harn.d 100))
  ?((> r 70) NIL
  ?((> r 65) ?((< depth 3) (do (harn.rand-psyche ch (+ depth 1)) (harn.rand-psyche ch (+ depth 1))) NIL)
    (do
      =(p (+ 1 (harn.table harn.psyche-table r)))
      =(s (harn.table {60 90 100} (harn.d 100)))
      ?((< (len (ch :psy)) 3) (hash-put ch [:psy (join (ch :psy) (list (list p s)))]) NIL))))}))
(def {harn.rand-sexuality} (fn {} {harn.table {90 96 100} (harn.d 100)}))

; ***************************************************
; *** Skills (Skills 3-4: the Skill Data table, its order) ***
; ***************************************************
; A line a skill, 42 bytes with its LF (skill n's from byte 1 + 42n): its key (harn.dl's, the file's), its name, its
; three attributes (S STR, T STA, D DEX, A AGL, E EYE, H HRG, M SML, V VOI, I INT, U AUR, W WIL, C CML), its sunsign
; bonuses (each a sign, a Ulandus ... l Lado, and its bonus), its OML's multiple of SB (L a native tongue, 50-80 + SB
; by social class; S a native script, 70 + SB), 1 if it's automatic, its group (0 physical, 1 communication,
; 2 religion, 3 combat, 4 craft: physical and combat skills take the physical penalty, the rest the universal), and a
; craft's months of teaching (0: opened on its first use).  (A table as text: hylang reads it many times faster)
(def {harn.skill-rows} (+ """
acr  Acrobatics         SAA f2g1     2000
cli  Climbing           SDA a2b2     4100
cnd  Condition          STW a1l1     5100
dan  Dancing            DAA h2g1i1   2000
jmp  Jumping            SAA f2g2     4100
leg  Legerdemain        DDW j2i2h2   1000
ski  Skiing             SDA k2j1l1   1000
stl  Stealth            AHW g2h2i2   3100
swi  Swimming           TDA j1k3l3   1000
thr  Throwing           SDE g2h1f1   4100
act  Acting             AVI h1i1     2010
awa  Awareness          EHM g2h2     4110
ntr  Intrigue           IUW i1h1j1   3110
lov  Lovecraft          CAV k1e1     3010
men  Mental Conflict    UWW          3010
mus  Musician           DHH k1e1     1010
ora  Oratory            CVI h1       2110
rhe  Rhetoric           VIW i1h1j1   3110
sng  Singing            HVV k1       3110
lan  Language           VIW i1       L110
scr  Script             DEI h1i1     S011
ragr Ritual: Agrik      VIS f2e1d1   1020
rhal Ritual: Halea      VIC h2g1k1   1020
rilv Ritual: Ilvir      VIU j2i1a1   1020
rlar Ritual: Larani     VIW e2d1c1   1020
rmor Ritual: Morgath    VIU l2d1k1   1020
rnav Ritual: Naveh      VIW k2j1h1   1020
rpeo Ritual: Peoni      VID b2e1a1   1020
rsar Ritual: Sarajin    VIS c2b1l1   1020
rsav Ritual: Save-K'nor VII i2j1h1   1020
rsie Ritual: Siem       VIU g2c1a1   1020
ini  Initiative         AWW          4130
una  Unarmed            SDA k2l2a2   4130
rid  Riding             DAW a1b1     1030
axe  Axe                SSD d1c1e1   3030
blo  Blowgun            TDE g2h1f1   4030
bow  Bow                SDE g1h1f1   2030
clu  Club               SSD a1b1     4030
dag  Dagger             DDE e2f2     3030
fla  Flail              DDD g1h1f1   1030
net  Net                DDE k1j1l1   1030
pol  Polearm            SSD e1b1     2030
shd  Shield             SDD a1l1k1   3030
slg  Sling              DDE g1h1f1   1030
spr  Spear              SSD b1c1a1   3030
swd  Sword              SDD e3d1f1   3030
whp  Whip               DDE g1f1     1030
dge  Dodge              AAA          5130
""" (substring """
agr  Agriculture        STW a2b2     2041
alc  Alchemy            MIU j3i2k2   1046
ani  Animalcraft        AVW a1b1     1041
ast  Astrology          EIU h1       1043
bre  Brewing            DMM j3i2k2   2041
cer  Ceramics           DDE a2b2     2042
coo  Cookery            DMM j1       3040
dra  Drawing            DEE j1i1     2041
emb  Embalming          DEM j1a1     1042
eng  Engineering        DII a2b2c1   1043
fis  Fishing            DEW k2l2     3040
fle  Fletching          DDE g2h1f1   1041
fol  Folklore           VII i2       3040
for  Foraging           DMI a2b2     3040
gla  Glassworking       DEW c2       1043
hrl  Heraldry           DEW j1i1     1041
hrb  Herblore           EMI a3b2     1041
hid  Hidework           DMW a1b1     2041
hun  Hunting            AMI a2b2     2040
ink  Inkcraft           EMI j2i1     1041
jew  Jewelcraft         DEW c3h1b1   1042
law  Law                VIW h1i1     1042
lck  Lockcraft          DEW c1       1042
lor  Lore               EII i2       2041
msn  Masonry            SDI a2b2     1041
mat  Mathematics        IIW i3h1j1   1043
met  Metalcraft         SDW c3d1e1   1042
mil  Milling            SDM a1       2041
min  Mining             SEI a2b2c1   1041
prf  Perfumery          MMI g1j1h1   1041
phy  Physician          DEI k2j1i1   1040
pil  Piloting           DEI l3k1     1046
run  Runecraft          IUU i2j1     1046
sea  Seamanship         SDA l3k1j1   2041
shw  Shipwright         SDI l3k1     1042
sur  Survival           SDI a2b1     3041
trt  Tarotry            IUW h2i2j1g1 1044
tex  Textilecraft       DDE a1b1     2041
tim  Timbercraft        SDA a3b1     2041
trk  Tracking           EMW a3b3     2041
wpn  Weaponcraft        SDW c3d1e1   1044
wea  Weatherlore        IEM g1h1k1l1 3041
woo  Woodcraft          DDW a2b1l1   2041
""" 1)))
(def {harn.nskills} 91)
(def {harn.codes} {:str :sta :dex :agl :eye :hrg :sml :voi :int :aur :wil :cml})

; A skill's byte i (its line's), its key, its name, its group; a skill by its key ("cli": -1, none)
(def {harn.sk} (fn {sk i} {char-at harn.skill-rows (+ 1 i (* 42 sk))}))
(def {harn.skill-key} (fn {sk} {str-trim (substring harn.skill-rows (+ 1 (* 42 sk)) 5)}))
(def {harn.skill-name} (fn {sk} {str-trim (substring harn.skill-rows (+ 6 (* 42 sk)) 19)}))
(def {harn.skill-group} (fn {sk} {- (char-code (harn.sk sk 39)) 48}))
(def {harn.skill-keys} (map harn.skill-key (range 0 91)))
(def {harn.skill-of} (fn {key} {index-of harn.skill-keys key}))

; *****************************
; *** A character's skills ***
; *****************************
; The average of three attributes, rounded (half up); Endurance: Strength's, Stamina's and Will's
(def {harn.avg} (fn {a b c} {shr (* (+ a b c a b c 3) 171) 10}))
(def {harn.end} (fn {ch} {harn.avg (ch :str) (ch :sta) (ch :wil)}))

; The best bonus of a skill's signs that the character's sunsign has (a cusp: either of its two; :sg, their letters)
(def {harn.get-ssb} (fn {ch sk} {harn.ssb (+ 29 (* 42 sk)) (fst (ch :sg)) (snd (ch :sg)) 0 0}))
(def {harn.ssb} (fn {o a b p m} {do
  =(c (char-at harn.skill-rows (+ o p p)))
  ?((or (eq p 4) (eq c \space)) m
    (harn.ssb o a b (+ p 1)
      ?((or (eq c a) (eq c b)) (max m (- (char-code (char-at harn.skill-rows (+ o p p 1))) 48)) m)))}))

; SB: the three attributes' average and the sunsign's bonus (Condition's SB is Endurance: Skills 9)
(def {harn.att} (fn {ch sk i} {ch (nth (index-of "STDAEHMVIUWC" (harn.sk sk i)) harn.codes)}))
(def {harn.get-sb} (fn {ch sk} {?((eq sk 2) (harn.end ch)
  (+ (harn.avg (harn.att ch sk 24) (harn.att ch sk 25) (harn.att ch sk 26)) (harn.get-ssb ch sk)))}))

; OML: SB times its multiple; a native script 70 + SB, a native tongue 50-80 + SB by social class (Skills 11)
(def {harn.get-oml} (fn {ch sk} {do
  =(m (harn.sk sk 37))
  =(sb (harn.get-sb ch sk))
  ?((eq m \S) (+ 70 sb) ?((eq m \L) (+ sb (nth (ch :social) {50 50 60 60 70})) (* sb (- (char-code m) 48))))}))

(def {harn.get-ml} (fn {ch sk} {buffer-get (ch :ml) sk}))
(def {harn.get-si} (fn {ch sk} {truncate (/ (harn.get-ml ch sk) 10)}))
(def {harn.put-ml} (fn {ch sk v} {buffer-put (ch :ml) sk (min 255 v)}))
(def {harn.open-skill} (fn {ch sk} {?((zero? (harn.get-ml ch sk)) (harn.put-ml ch sk (harn.get-oml ch sk)) NIL)}))

; ***************************  DEW c1       1042"
sk" lor  Lore               EII i2       2041"
sk" msn  Masonry            SDI a2b2     1041"
sk" mat  Mathematics        IIW i3h1j1   1043"
sk" met  Metalcraft         SDW c3d1e1   1042"
sk" mil  Milling            SDM a1       2041"
sk" min  Mining             SEI a2b2c1   1041"
sk" prf  Perfumery          MMI g1j1h1   1041"
sk" phy  Physician          DEI k2j1i1   1040"
sk" pil  Piloting           DEI l3k1     1046"
sk" run  Runecraft          IUU i2j1     1046"
sk" sea  Seamanship         SDA l3k1j1   2041"
sk" shw  Shipwright         SDI l3k1     1042"
sk" sur  Survival           SDI a2b1     3041"
sk" trt  Tarotry            IUW h2i2j1g1 1044"
sk" tex  Textilecraft       DDE a1b1     2041"
sk" tim  Timbercraft        SDA a3b1     2041"
sk" trk  Tracking           EMW a3b3     2041"
sk" wpn  Weaponcraft        SDW c3d1e1   1044"
sk" wea  Weatherlore        IEM g1h1k1l1 3041"
sk" woo  Woodcraft          DDW a2b1l1   2041"

: sk-row ( sk -- addr ) 41 * harn-skills + ;
: harn-skill-key ( sk -- c-addr u ) sk-row 5 -trailing ;
: harn-skill-name ( sk -- c-addr u ) sk-row 5 + 19 -trailing ;
: harn-skill-group ( sk -- g ) sk-row 39 + c@ [char] 0 - ;
: harn-skill-auto ( sk -- flag ) sk-row 38 + c@ [char] 1 = ;
\ A skill by its key (-1: none)
: harn-skill-of ( c-addr u -- sk )
  harn-nskills 0 do 2dup i harn-skill-key compare 0= if 2drop i unloop exit then loop 2drop -1 ;

\ ---- A character's skills
\ The average of three attributes, rounded (half up); Endurance: Strength's, Stamina's and Will's
: harn-avg ( a b c -- n ) + + 2* 3 + 6 / ;
: harn-end ( -- n ) harn-str harn@ harn-sta harn@ harn-wil harn@ harn-avg ;
\ A skill's attribute i (0-2), by its letter
create sk-codes 9 c, 10 c, 11 c, 12 c, 13 c, 14 c, 15 c, 16 c, 17 c, 18 c, 19 c, 8 c,
: sk-att ( sk i -- n )
  swap sk-row 24 + + c@  s" STDAEHMVIUWC" 0 do 2dup i + c@ = if 2drop i leave then loop  sk-codes + c@ harn@ ;
\ The best bonus of a skill's signs that the character's sunsign has (a cusp: either of its two)
variable sign1   variable sign2
: harn-ssb ( sk -- b )
  harn-ss harn@ harn-sunsign-signs [char] a + sign2 ! [char] a + sign1 !
  sk-row 28 +  0 swap  4 0 do
    dup c@ dup bl = if drop leave then
    dup sign1 @ = swap sign2 @ = or if dup 1+ c@ [char] 0 - rot max swap then  2 +
  loop drop ;
\ SB: the three attributes' average and the sunsign's bonus (Condition's SB is Endurance: Skills 9)
: harn-sb ( sk -- sb )
  dup 2 = if drop harn-end exit then
  dup 0 sk-att over 1 sk-att 2 pick 2 sk-att harn-avg  swap harn-ssb + ;
\ OML: SB times its multiple; a native script 70 + SB, a native tongue 50-80 + SB by social class (Skills 11)
: harn-oml ( sk -- oml )
  dup sk-row 37 + c@ swap harn-sb swap
  case
    [char] S of 70 + endof
    [char] L of harn-social c@ dup 2 < if drop 50 else 4 = if 70 else 60 then then + endof
    dup [char] 0 - rot * swap
  endcase ;
: harn-ml@ ( sk -- ml ) harn-ml c@ ;
: harn-ml! ( ml sk -- ) swap 255 min swap harn-ml c! ;
: harn-open ( sk -- ) dup harn-ml@ if drop else dup harn-oml swap harn-ml! then ;

\ ---- Penalties (Skills 6), move (Combat 6), size (Character 6)
\ UP: the fatigue levels (and the injuries' levels: not kept here); PP: UP and EP, the load over endurance, rounded
: harn-up ( -- n ) harn-fl c@ ;
: harn-ep ( -- n ) harn-load @ 2* harn-end + harn-end 2* / ;
: harn-pp ( -- n ) harn-up harn-ep + ;
: harn-move ( -- n ) harn-agl harn@ harn-pp - 1 max ;
create size-t 65 , 75 , 90 , 110 , 135 , 165 , 200 , 240 , 285 , 9999 ,
: harn-size ( -- n ) harn-wt harn@ size-t 10 htable 1+ ;

\ ---- Tests (Skills 5, 21-22) and development (Skills 6)
\ d100 at or under the EML (kept from 5 to 95): 0 CF, 1 MF, 2 MS, 3 CS (a roll ending in 0 or 5 critical)
: harn-test ( eml -- level )
  5 max 95 min  d100 tuck < 0= 2 and  swap 5 mod 0= if 1+ else 1- abs then ;
\ (The roll at or under: 2, critical 3; over: 1, critical 0)
: harn-eml ( sk -- eml )
  dup harn-ml@ swap harn-skill-group dup 0= swap 3 = or if harn-pp else harn-up then 5 * - ;
: harn-test-skill ( sk mod -- level ) swap harn-eml + harn-test ;
\ d100 and SB over ML raise it by 1 (it can't pass 100 + SB): 0 improved, 1 not improved, 2 maxed
: harn-develop ( sk -- r )
  dup harn-ml@ over harn-sb  2dup 100 + < 0= if 2drop drop 2 exit then
  d100 + < if dup harn-ml@ 1+ swap harn-ml! 0 else drop 1 then ;

\ ---- A new character (Character 2-12), in harn_create's order (harngen.c's): birth, culture and class, family,
\ appearance, the physical attributes, the medical traits, the personality, piety; then the automatic skills opened
variable harn-species  -1 harn-species !
: harn-create ( -- )
  harn-c /harn erase  0 int-bonus !
  d100 species-t 4 htable  harn-species @ 0< 0= if drop harn-species @ then  harn-sp harn!
  d100 harn-sp harn@ cells sex-t + @ > 0= 1 and harn-sx harn!
  12 die 30 die  over 8 lshift over or harn-bd harn!  harn-sunsign-of harn-ss harn!
  harn-sp harn@ culture-t + c@ harn-culture c!
  d100 harn-culture c@ 5 * cells class-t + 5 htable harn-social c!
  d100 harn-sp harn@ 1 3 within if 20 - then 1 max sibs-t 6 htable 1+ harn-sibrank c!
  harn-sibrank c@ 6 die + 1- harn-famsize c!
  d100 parent-t 5 htable harn-parent c!
  d100 harn-sibrank c@ 1 = 5 and + 100 min estrange-t 5 htable harn-estrange c!
  d100 clanhead-t 4 htable harn-clanhead c!
  harn-sx harn@ 4 * harn-sp harn@ + height-t + c@ 4 6 dice + harn-ht harn!
  3 6 dice harn-fr harn-species-mod + frame-t 5 htable harn-fr harn!
  harn-ht harn@ harn-fr harn@ harn-weight dup harn-owt harn! harn-wt harn!
  harn-cml harn-rand-attr harn-cml harn!
  d100 harn-sp harn@ 3 * cells complexion-t + 3 htable harn-complexion c!
  colour-roll harn-sp harn@ 5 * cells hair-t + 5 htable harn-hair c!
  colour-roll harn-sp harn@ 5 * cells eyes-t + 5 htable harn-eyes c!
  harn-voi 1+ harn-str do i harn-rand-attr i harn! loop
  0 medical
  harn-mor 1+ harn-int do i harn-rand-attr i harn! loop
  harn-int int-bonus @ more
  10 harn-dty harn!  5 6 dice harn-pty harn!
  harn-nskills 0 do i harn-skill-auto if i harn-open then loop ;

\ ---- Files (harnfile.c's): harn 1; att KEY VALUE (each attribute, in order); fam culture social sibrank famsize parent
\ estrange clanhead; look complexion hair eyes; med (the traits); psy DISORDER SEVERITY (a line each); sexuality N; ml
\ KEY ML (each open skill); vol fl bl dp state shockhr; then the program's own lines
create harn-line 100 allot   variable harn-n
: line{ ( -- ) 0 harn-n ! ;
: line+ ( c-addr u -- ) tuck harn-line harn-n @ + swap move harn-n +! ;
: line+n ( u -- ) s"  " line+ 0 <# #s #> line+ ;
: line+bytes ( addr n -- ) 0 ?do dup i + c@ line+n loop drop ;
variable harn-fd
: line} ( -- ior ) harn-line harn-n @ harn-fd @ write-line ;
: harn-write-line ( c-addr u fileid -- ior ) write-line ;
: harn-att-key ( a -- c-addr u )                 \ Its key in a file: harn.dl's
  >r s" sp|sx|bd|ss|ht|fr|owt|wt|cml|str|sta|dex|agl|eye|hrg|sml|voi|int|aur|wil|mor|dty|pty" r> |field ;
: harn-write ( fileid -- ior )
  harn-fd !  s" harn 1" harn-fd @ write-line
  harn-nattrs 0 do line{ s" att " line+ i harn-att-key line+ i harn@ line+n line} or loop
  line{ s" fam" line+ harn-culture 7 line+bytes line} or
  line{ s" look" line+ harn-complexion 3 line+bytes line} or
  line{ s" med" line+ 4 0 do i harn-med c@ ?dup if line+n else leave then loop line} or
  3 0 do i harn-psy c@ ?dup if line{ s" psy" line+ line+n i harn-psysev c@ line+n line} or then loop
  line{ s" sexuality" line+ harn-sexuality 1 line+bytes line} or
  100 0 do i harn-ml@ ?dup if
    line{ s" ml " line+ i harn-nskills < if i harn-skill-key line+ else i 0 <# #s #> line+ then line+n line} or
  then loop
  line{ s" vol" line+ harn-fl 5 line+bytes line} or ;


\ ---- Reading one back: each line by its first word; any other line harn-other's
defer harn-other ( c-addr u -- )   ' 2drop is harn-other
create harn-in 102 allot   create harn-rest 2 cells allot
: next-word ( -- c-addr u )                          \ The line's next word (spaces before it skipped)
  harn-rest 2@ begin dup if over c@ bl = else false then while 1 /string repeat
  over swap begin dup if over c@ bl <> else false then while 1 /string repeat  ( a a' u' )
  2dup harn-rest 2!  drop     50 , 69 , 70 , 85 , 100 ,   40 , 55 , 56 , 70 , 100 ,
\ Hair's and eyes' roll: humans +25 for a fair complexion, -25 for a dark one
: colour-roll ( -- r )
  d100  harn-sp harn@ dup 0= swap 3 = or if
    harn-complexion c@ case 0 of 25 + endof 2 of 25 - endof endcase
  then  1 max 100 min ;

\ ---- The attributes' modifiers (Character 6-10): species and sex, frame (Agility: scant +2 ... massive -2), weight
\ (Strength: 56-85 -4 ... 146-155 0 ... 216-245 +4, the table's ends past it); each species' by attribute
create sin-m 0 c, 0 c, 0 c, 0 c, 0 c, -2 c, 0 c, 0 c, 2 c, 1 c, 1 c, 2 c,
              2 c, 2 c, 2 c, 3 c, 2 c, 0 c, 4 c, 0 c, 3 c, 0 c, 0 c,
create khu-m 0 c, 0 c, 0 c, 0 c, 0 c, 3 c, 0 c, 0 c, 0 c, 4 c, 4 c, 1 c,
              0 c, 1 c, 2 c, 2 c, 0 c, 0 c, -2 c, 3 c, 0 c, 0 c, 0 c,
: sbyte ( c -- n ) dup 127 > if 256 - then ;
: harn-species-mod ( a -- n )
  harn-sp harn@ case
    0 of harn-sx harn@ if drop 0 else dup harn-fr = if drop -3 else harn-aur = 2 and then then endof
    1 of sin-m + c@ sbyte endof
    2 of khu-m + c@ sbyte endof
    nip 0 swap
  endcase ;
create weight-t 85 , 110 , 130 , 145 , 155 , 170 , 190 , 215 , 9999 ,
\ An attribute rolled: 3d6 and its modifiers, at least 1
: harn-rand-attr ( a -- n )
  3 6 dice over harn-species-mod +
  over harn-agl = if 2 harn-fr harn@ - + then
  swap harn-str = if harn-wt harn@ weight-t 9 htable 4 - + then  1 max ;

\ ---- Medical traits (Character 9): each trait's upper bound (1, Addiction ... 23, Sterile), a male's roll, a female's
create med-m 8 , 9 , 14 , 17 , 20 , 24 , 25 , 27 , 28 , 30 , 31 , 32 ,
             33 , 35 , 39 , 41 , 42 , 44 , 47 , 57 , 60 , 63 , 65 ,
create med-f 5 , 6 , 10 , 14 , 15 , 19 , 20 , 22 , 23 , 25 , 26 , 27 ,
             29 , 30 , 40 , 42 , 43 , 45 , 48 , 58 , 61 , 63 , 65 ,
variable int-bonus                            \ (Epilepsy's: Intelligence isn't rolled yet)
: lower ( a n -- ) over harn@ swap - 1 max swap harn! ;
: more ( a n -- ) over harn@ + swap harn! ;
\ A trait's effects (dwarfism's and gigantism's on height aren't made: the height's taken)
: lower? ( m m2 a -- m ) \ (A trait m2's: its attribute a less 1d3)
  >r over = if r> 3 die lower else r> drop then ;
: medical-effect ( m -- )
  dup 4 = if drop harn-dex 3 die more exit then
  dup 8 = if drop 3 die int-bonus ! exit then
  dup 14 = if drop harn-agl dup harn@ 2/ lower exit then
  dup 15 = if drop harn-dex 2 die more exit then
  dup 16 = if drop harn-cml 2 6 dice lower exit then
  dup 19 = if drop harn-wt harn@ 51 random 150 + 100 */ harn-wt harn!  harn-agl 3 die lower exit then
  5 harn-dex lower?  6 harn-cml lower?  13 harn-cml lower?  21 harn-cml lower?  22 harn-cml lower?
  9 harn-hrg lower?  10 harn-eye lower?  18 harn-eye lower?  drop ;
\ A roll on the table: a trait (with its effects; each once, four at most), multiple (two rolls more), or none
: medical ( depth -- )
  d100  dup 70 > if 2drop exit then
  dup 65 > if drop dup 3 < if 1+ dup recurse recurse else drop then exit then
  nip  harn-sx harn@ if med-m else med-f then 23 htable 1+
  4 0 do  i harn-med c@ dup 0= if drop dup i harn-med c! medical-effect unloop exit then
    over = if drop unloop exit then  loop drop ;

\ ---- Mental disorders and sexuality (Character 11: optional rules, not made): a disorder (1, Acrophobia ... 38,
\ Yaelaphobia) or more, each with its severity (0 mild, 1 moderate, 2 severe); a sexuality (0 heterosexual, 1
\ bisexual, 2 homosexual)
create psyche-t 3 , 5 , 6 , 8 , 9 , 11 , 14 , 15 , 17 , 19 , 22 , 24 , 25 , 26 , 28 , 31 , 32 , 35 , 36 , 37 , 38 , 40 ,
  43 , 45 , 46 , 47 , 48 , 49 , 51 , 54 , 56 , 57 , 59 , 60 , 61 , 63 , 64 , 65 ,
create severity-t 60 , 90 , 100 ,
: harn-rand-psyche ( depth -- )
  d100  dup 70 > if 2drop exit then
  dup 65 > if drop dup 3 < if 1+ dup recurse recurse else drop then exit then
  nip psyche-t 38 htable 1+  d100 severity-t 3 htable
  3 0 do i harn-psy c@ 0= if i harn-psysev c! i harn-psy c! unloop exit then loop 2drop ;
create sexuality-t 90 , 96 , 100 ,
: harn-rand-sexuality ( -- s ) d100 sexuality-t 3 htable ;

\ ---- Skills (Skills 3-4: the Skill Data table, its order): a line a skill, 41 bytes: its key (harn.dl's, the file's),
\ its name, its three attributes (S STR, T STA, D DEX, A AGL, E EYE, H HRG, M SML, V VOI, I INT, U AUR, W WIL, C CML),
\ its sunsign bonuses (each a sign, a Ulandus ... l Lado, and its bonus), its OML's multiple of SB (L a native tongue,
\ 50-80 + SB by social class; S a native script, 70 + SB), 1 if it's automatic, its group (0 physical, 1
\ communication, 2 religion, 3 combat, 4 craft: physical and combat skills take the physical penalty, the rest the
\ universal), and a craft's months of teaching (0: opened on its first use).  hylang's harn.hl has the same table.
91 constant harn-nskills
: sk" ( "line<quote>" -- ) [char] " parse  here swap dup allot move ;
