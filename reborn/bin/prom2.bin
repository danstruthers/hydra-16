\ its order (the pin first).  Its files: 0-7 (a pin: reads as 0 or 1; a write of 0 or 1 sets it, the pin an
\ output), port (all 8: a byte), ctl (in N, out N, ddr N, ca1 rise or fall, ca2 0, 1 or in; it reads as the pins and
\ the handshake lines), ca1 (a read waits for CA1's next edge, then gives the edges counted).  A failure THROWs.
\ Only the words forth starts with (File Access's), so it's an example of driving the pins by hand too.

create gpio-buf 64 allot   variable gpio-n          \ A name or a line being made
create gpio-text 128 allot                          \ What's read

: gpio{ ( -- ) 0 gpio-n ! ;
: gpio+ ( c-addr u -- ) tuck gpio-buf gpio-n @ + swap move gpio-n +! ;
: gpio+n ( n -- ) base @ >r decimal 0 <# #s #> gpio+ r> base ! ;
: gpio} ( -- c-addr u ) gpio-buf gpio-n @ ;
: gpio-file ( c-addr u -- c-addr2 u2 ) gpio{ s" /dev/gpio/" gpio+ gpio+ gpio} ;
: gpio-pin ( pin -- c-addr u ) gpio{ s" /dev/gpio/" gpio+ gpio+n gpio} ;
: gpio-read ( c-addr u -- c-addr2 u2 )             \ A file's text (128 bytes at most)
  r/o open-file throw >r gpio-text 128 r@ read-file r> close-file throw throw gpio-text swap ;
: gpio-write ( c-addr u c-addr2 u2 -- )            \ Text c-addr u written to the file c-addr2 u2
  w/o open-file throw >r r@ write-file r> close-file throw throw ;
: gpio-ctl ( c-addr u -- ) s" /dev/gpio/ctl" gpio-write ;
: gpio-num ( c-addr u -- n ) 0. 2swap >number 2drop drop ;

: gpio ( pin -- level ) gpio-pin gpio-read gpio-num ;               \ Its level, 0 or 1
: gpio! ( pin level -- ) 0<> 1 and [char] 0 + gpio-text c! gpio-text 1 rot gpio-pin gpio-write ;   \ The pin an output, set
: gpio-in ( pin -- ) >r gpio{ s" in " gpio+ r> gpio+n gpio} gpio-ctl ;          \ The pin an input
: gpio-out ( pin -- ) >r gpio{ s" out " gpio+ r> gpio+n gpio} gpio-ctl ;        \ An output
: gpio-port ( -- byte )                             \ All 8 pins' levels
  s" port" gpio-file r/o bin open-file throw >r gpio-text 1 r@ read-file r> close-file throw throw drop gpio-text c@ ;
: gpio-port! ( byte -- )                            \ The outputs' levels (the inputs keep theirs)
  gpio-text c! gpio-text 1 s" port" gpio-file w/o bin open-file throw >r r@ write-file r> close-file throw throw ;
: gpio-ddr! ( byte -- ) >r gpio{ s" ddr " gpio+ r> gpio+n gpio} gpio-ctl ;      \ Bit n 1: pin n an output
: gpio-ca1! ( rise? -- ) if s" ca1 rise" else s" ca1 fall" then gpio-ctl ;    \ CA1's active edge
: gpio-ca2! ( n -- )                                \ CA2: 0 low, 1 high, -1 an input
  dup 0< if drop s" ca2 in" gpio-ctl exit then
  >r gpio{ s" ca2 " gpio+ r> 0<> 1 and gpio+n gpio} gpio-ctl ;
: gpio-wait ( -- count ) s" ca1" gpio-file gpio-read gpio-num ;    \ CA1's next edge: the edges counted
: gpio-state ( -- c-addr u ) s" ctl" gpio-file gpio-read ;          \ The pins and lines, a line each
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀\ harn.fs - HarnMaster (third edition, 3.5) characters and their rules: lib harn.  danlang's lib/harn.dl and the C
\ SDK's harn.h in HyForth: harn.h's numbers (a species 0-3, a sunsign 0-35 ...), its dice in harn_create's order (so a
\ seed, rseed's, makes the character C's harn_create makes from it), and its file (harnfile.c's lines), which the C
\ game and every generator read.  The book's parts: Character 2-12 (a character made), Skills 2-6 and 21-22 (skills,
\ tests, penalties, development).  Combat and healing are harn.dl's and harn.h's; occupations, contacts, aging,
\ psionics, magic and rituals are left out, as there.
\
\ A character is a record of /harn bytes; harn-c is the one the words work on (harn-c0 at the start: to harn-c for
\ another).  Its attributes, by harn.h's numbers (harn-sp ... harn-pty), a cell each: harn@ ( a -- n ), harn! ( n a --
\ ); its bytes: harn-culture harn-social harn-sibrank harn-famsize harn-parent harn-estrange harn-clanhead,
\ harn-complexion harn-hair harn-eyes, harn-med ( i -- addr ) (its traits, 0 an empty place), harn-psy ( i -- addr )
\ and harn-psysev, harn-sexuality, harn-ml ( sk -- addr ) (a skill's mastery level, 0 not opened), the volatiles
\ harn-fl harn-bl harn-dp harn-state harn-shockhr.  harn-load is what it carries, in pounds.  Injuries aren't kept.
\
\   harn-create ( -- )             a character made at random (harn.h's harn_create); of the species
\                                  harn-species holds, if it's set (0-2: harn_template's; -1, rolled, at first)
\   harn-sb harn-oml ( sk -- n )   a skill's base and opening mastery; harn-open ( sk -- ) opens it
\   harn-end harn-size harn-move ( -- n )   endurance, size (1-10), move
\   harn-test ( eml -- level )     d100 against an EML: 0 CF, 1 MF, 2 MS, 3 CS; harn-eml ( sk -- eml ) and
\                                  harn-test-skill ( sk mod -- level ); harn-develop ( sk -- r ): 0 improved,
\                                  1 not improved, 2 maxed
\   harn-write ( fileid -- ior )   the character as harnfile.c writes it; harn-write-line ( c-addr u fileid -- ior )
\                                  a line of the program's own after it
\   harn-read ( fileid -- ior )    one read back; each line not harn.h's given to harn-other ( c-addr u -- )
\   the names: harn-species-name ( i -- c-addr u ) ... harn-skill-name ( sk -- c-addr u ), harn-skill-key

require random.fl
require string.fl

\ ---- Dice: random's numbers (xorshift32, as dice.h's and hylang's), random's way to a die (the high cell of rand * n)
: die ( n -- 1..n ) random 1+ ;
: dice ( n sides -- sum ) 0 rot 0 ?do over die + loop nip ;
: d100 ( -- 1..100 ) 100 die ;

\ A table of n upper bounds (cells): the first a roll doesn't pass (the last if it passes them all)
: htable ( r a n -- k )
  dup >r 1- 0 ?do  2dup @ > 0= if 2drop i unloop r> drop exit then  cell+  loop  2drop r> 1- ;

\ ---- The character
0 constant harn-sp     1 constant harn-sx     2 constant harn-bd     3 constant harn-ss     4 constant harn-ht
