,9lџъiљїП␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; disk.hl - the disks, by their files (#d, /dev/sd): (use "disk").  A disk is named by its letter, a string (0-f a
; card on that SPI device, x the ROM disk, r the RAM disk, s the shared one; a number, 0-15, for a card).  A disk's
; ctl reads as it ("sdhc 7580 MB 15523840 blocks", or "none"; then its file system's lines: "hydrafs label=ROM",
; "free 192 KB of 252 KB"), and takes init (a card started again), stop (a RAM disk's banks given back), format,
; label, check.  The directory lists the disks started.  A failure is the system's error.

(use "dev")

(fun {disk.name d} {if (num? d) (dev.hex d 1) d})
(fun {disk.ctl d} {dev.lines (format "/dev/sd/{}/ctl" (disk.name d))})
(fun {disk.cmd d line} {dev.write (format "/dev/sd/{}/ctl" (disk.name d)) line})

; The first of its ctl's lines that has the text, from the text on (NIL: none)
(fun {disk.find lines text} {do
  =(l (filter (fn {x} {>= (index-of x text) 0}) lines))
  (if l (substring (fst l) (index-of (fst l) text) (len (fst l))) NIL)})

; The disks started, a list of hashes: :disk (its letter), :kind (:sdhc, :sdsc, :rom, :ram ...), :blocks (512 bytes
; each), and :label if it has a file system
(fun {disks} {filter (fn {h} {not (eq (h :kind) :none)}) (map disk.info (ls "/dev/sd"))})
(fun {disk.info d} {do
  =(l (disk.ctl d))
  =(w (str-split (fst l) " "))
  =(lb (disk.find l "label="))
  (hash-create (join (list (list :disk d) (list :kind (to-atom (fst w))))
    (if (> (len w) 4) (list (list :blocks (val (nth 3 w)))) NIL)
    (if lb (do =(x (fst (str-split lb " "))) (list (list :label (substring x 6 (- (len x) 6))))) NIL)))})

; Each disk's file system's room, a list of hashes: :disk, :label, :free and :size (KB)
(fun {df} {filter (fn {h} {not (nil? h)}) (map disk.room (ls "/dev/sd"))})
(fun {disk.room d} {do
  =(f (disk.find (disk.ctl d) "free "))
  (if f
    (do =(w (str-split f " "))
      (hash-create (list (list :disk d) (list :label ((disk.info d) :label)) (list :free (val (nth 1 w))) (list :size (val (nth 4 w))))))
    NIL)})

; A card started again (as after it's changed); a RAM disk stopped (its banks given back)
(fun {disk-start d} {disk.cmd d "init"})
(fun {disk-stop d} {disk.cmd d "stop"})

; The SD cards there: their SPI devices, a list (0-15; each one's ctl read, which starts it)
(fun {cards} {filter (fn {n} {try (not (== (fst (disk.ctl n)) "none")) NIL}) (range 16)})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; Special thanks to buildyourownlisp.com for the inspiration from 'lispy'!
:(math.pi    3.14159_26535_89793_23846_26433_83279_50288_41971_69399_37510_58209_74944_59230_78164_06286_20899_86280_34825_34211_70679_82148_08651_32823_06647_09384)
:(math.e     2.71828_18284_59045_23536_02874_71352_66249_77572_47093_69995)
:(math.phi   1.61803_39887_49894_84820_45868_34365_63811_77203_09179_80576)
:(math.gamma 0.57721_56649_01532_86061)

; function definition: fun, fn, fexpr, def, set, set! and let are built in

; cons (an item onto the front of a list) is built in

; composition helpers
(fun {flip f a b} {f b a})
(fun {ghost}      {eval &_})
(fun {comp f g x} {f (g x)}) ; Compose

; comparisons: not, ==, >=, <=, neg? and pos? are built in

:({<> !=} neq neq)

; test helpers: nil?, t?, zero? and one? are built in
:({=0 =1}  zero? one?)
:({0? 1?}  zero? one?)

; logical operators
(fun {xor a b} {and (or a b) (not (and a b))})

; math helper functions (1+ and 1- are built in)
(fun {>=0 n}    {>= n 0})
(fun {<=0 n}    {<= n 0})
(fun {>0 n}     {> n 0})
(fun {<0 n}     {< n 0})
(fun {!=0 n}    {not (zero? n)})
(fun {!=1 n}    {not (one? n)})
(fun {square n} {* n n})
(fun {cube n}   {* n (square n)})
(fun {recip n}  {/ 1 n})

:(inverse recip)
:(trunc truncate)

; currying
(fun {unpack f l}  {eval (cons f l)})
(fun {pack f}      {f &_})

:({apply curry uncurry} unpack unpack pack)

; a list's items, as they're written (not evaluated): fst, snd, thd, nth (from 0) and last are built in; past the
; list's end is an error
:({first second third fourth fifth sixth seventh eighth ninth tenth}
  (nth 0) (nth 1) (nth 2) (nth 3) (nth 4) (nth 5) (nth 6) (nth 7) (nth 8) (nth 9))

; coalescing operator to find first non-nil argument in the list
(fun {?? a} ?{a a ?(&_ .(?? &_))})

; take n items, and drop n (as many as there are) are built in

:(skip drop)

; split list at N
(fun {split n l} {[(take n l) (drop n l)]})

; is x in l? (elem? x l) is built in

(fun {has-element? l x} {elem? x l})

; do (built in) evaluates its arguments in turn and returns the last one's value
:(begin do)
:(block do)

; map, filter, foldl and foldr are built in

; pairs of items, one from each list, as long as both have them
(fun {zip a b} ?{
  (and a b)
  (cons [(fst a) (fst b)] (zip (tail a) (tail b)))
  NIL
})

; is f true of any item? of every item? the first it's true of, and how many: any?, all?, find and count are built in

; a list's items, and the items of the lists in it, in one list
(fun {flatten l} ?{
  l
  ?((qexpr? (fst l))
    (join (flatten (fst l)) (flatten (tail l)))
    (cons (fst l) (flatten (tail l))))
  NIL
})

; the items, each once (the first time it comes)
(fun {distinct l} ?{l (cons (fst l) (distinct (remove-all (fst l) (tail l)))) NIL})

; sum, product, min and max are built in
(fun {avg s}     {/ (sum s) (len s)})

; Switch/Cond
; a clause's test and value run where the clause was written (each the first of a list, made code: eval (head ...))
(fun {cond} ?{
  &_
  ?((eval (head (fst &_)))
    (eval (head (tail (fst &_))))
    .(cond (tail &_)))
  (error "Selection not found")
})

;:(switch cond)

(fun {case x} ?{
  &_
  ?((eq x (eval (head (fst &_))))
    (eval (head (tail (fst &_))))
    .(case (cons x (tail &_))))
  (error "Case not found")
})

; math functions (abs is built in)

(fun {floor a} {
  let {
    do
      =(tr (trunc a))
      (<=> (cmp a tr) {< (1- tr)} {tr})
  }
})

(fun {ceil a} {
  let {
    do
     =(tr (trunc a))
     (<=> (cmp a tr) {> (1+ tr)} {tr})
  }
})

; round: the nearest integer, a half away from zero
(fun {round a} {
  ?((neg? a) (- (floor (- 1/2 a))) (floor (+ a 1/2)))
})

; div and mod: the quotient rounded down (toward minus infinity, as mod has it), so (+ (* b (div a b)) (mod a b)) is a
(fun {div a b} ?{
  (and (num? a) (num? b))
  (floor (/ a b))
  (error "Cannot perform 'div' on non-numbers")
})

(fun {mod a b} ?{
  (and (num? a) (num? b))
  (- a (* b (floor (/ a b))))
  (error "Cannot perform 'mod' on non-numbers")
})

:(% mod)

(fun {divmod a b} ?{
  (and (num? a) (num? b))
  (cons (div a b) (list (mod a b)))
  (error "Cannot perform 'divmod' on non-numbers")
})

(fun {fdiv a b} ?{
  (and (num? a) (num? b))
  (to-fixed (/ a b) ?((and (defined? &1) (num? &1)) &1 10))
  (error "Cannot perform 'fdiv' on non-numbers")
})

(fun {frecip n} ?{(defined? &1) (fdiv 1 n &1) (fdiv 1 n)})
:(finverse frecip)

(fun {odd? n} ?{
  (num? n)
  (=1 (mod n 2))
  (error "Cannot perform 'odd?' on non-number")
})

(fun {even? n} ?{
  (num? n)
  (=0 (mod n 2))
  (error "Cannot perform 'even?' on non-number")
})

(fun {positive? a} ?{(num? a) (pos? a) (error "Only numbers can be positive")})
(fun {negative? a} ?{(num? a) (neg? a) (error "Only numbers can be negative")})

:({+? -? 0?} positive? negative? zero?)

(fun {minimum} .{min &1})
(fun {maximum} .{max &1})

; String helpers
(fun {starts-with? s sub} {=0 (index-of s sub)})
(fun {ends-with?   s sub} {and (>= (len s) (len sub)) (eq (substring s (- (len s) (len sub))) sub)})
(fun {contains?    s sub} {>=0 (index-of s sub)})

; Repeat: a list of d's values, run n times
(fun {repeat ; clock.hl - the clock and the DS1747, by their files (#t, /dev): (use "clock").  /dev/time reads as the time
; (2026-10-03 15:04:05), and a write of that sets it (the chip too); /dev/rtc reads as what the boot found: running
; (and battery low), stopped (set the time), or none.  The time as numbers is the system library's (time, date,
; date-parts).  A failure is the system's error.

(use "dev")

; The clock (and the chip) set: "2026-10-04 12:00:00"
(fun {set-date text} {dev.write "/dev/time" text})

; The chip, a list of atoms: :running, :stopped or :none; and :battery-low
(fun {rtc} {do
  =(r (str-trim (dev.read "/dev/rtc")))
  (join (list (to-atom (fst (str-split r " ")))) (if (elem? "low" (str-split r " ")) {:battery-low} NIL))})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; cons.hl - the console's windows, by their files (#c, /dev): (use "cons").  /dev/wctl takes new (a window made) and
; current N (window N shown), and reads as the windows, a line each (* the one shown); /dev/consctl takes
; rawon and rawoff (raw lasts while a consctl is open: each key as it comes, unechoed); /dev/bell, a write, rings the
; console's bell (#a's: a short beep).  $window is this shell's window; (window-size) its size, consctl's size line
; (the smaller of the terminals it's shown on); (window-label s), (window-status s), (window-ctl s) its chrome (W4:
; /dev/label, wctl's status and any wctl line); (snarf), (snarf! s) the console's cut buffer (W6: /dev/snarf, all
; the windows' one, 8K at most; Ctrl-] y pastes it).  A failure is the system's error.

(use "dev")

(def {cons.ctl} NIL)

; This one's window ($window; none: 0)
(fun {window} {do =(w (env "window")) (if w (val w) 0)})

; This window's size, {cols rows}: its consctl's size line; with no console, $COLUMNS and $LINES, else 80 and 24
(fun {window-size} {do
  =(l (if (exists? "/dev/consctl") (filter (fn {l} {== (fst (str-split l " ")) "size"}) (dev.lines "/dev/consctl")) NIL))
  (if l (map val (tail (str-split (fst l) " "))) (list (cons.env "COLUMNS" 80) (cons.env "LINES" 24)))})
(fun {cons.env n d} {do =(v (env n)) (if v (val v) d)})

; This window's title (OSC 2's too): set (s; "": its program's name again), or with none, read
(fun {window-label} {if &_ (dev.write "/dev/label" (+ (fst &_) "\n")) (dev.read "/dev/label")})

; Its status line (the footer's %s), and any line of its wctl ("chrome screen off" ...)
(fun {window-status s} {dev.write "/dev/wctl" (+ "status " s)})
(fun {window-ctl s} {dev.write "/dev/wctl" s})

; The console's cut buffer: its text, or set (a write replaces it)
(fun {snarf} {dev.read "/dev/snarf"})
(fun {snarf! s} {dev.write "/dev/snarf" s})

; The windows, a list of their numbers; and the one shown
(fun {windows} {map (fn {l} {val (fst (str-split l " "))}) (dev.lines "/dev/wctl")})
(fun {shown-window} {val (fst (str-split (fst (filter (fn {l} {elem? "*" (str-split l " ")}) (dev.lines "/dev/wctl"))) " "))})

; A window made and shown, in this one's group, running the command line (rc's; none: the shell): the new-window
; command's; new-group's window in a group of its own (a shell session)
(fun {new-window} {if &_ (run "new-window" (fst &_)) (run "new-window")})
(fun {new-group} {if &_ (run "new-window" "-g" (fst &_)) (run "new-window" "-g")})

; Window n shown
(fun {show-window n} {dev.write "/dev/wctl" (format "current {}" n)})

; The keys raw (each as it comes, unechoed), till raw-off: consctl kept open meanwhile
(fun {raw-on} {do
  (if cons.ctl NIL (set! {cons.ctl} (sys-open "/dev/consctl" 1)))
  (sys-write cons.ctl "rawon")
  NIL})
(fun {raw-off} {if cons.ctl (do (sys-write cons.ctl "rawoff") (sys-close cons.ctl) (set! {cons.ctl} NIL) NIL) NIL})

; The bell: #a's beep (a BEL written, with no sound driver)
(fun {beep} {if (exists? "/dev/bell") (dev.write "/dev/bell" "\a") (do (write "\a") NIL)})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; dev.hl - what the device libraries share (gpio.hl, i2c.hl, spi.hl ...): (use "dev").  A device is files, each
; driven by one request at a time: a read is one READ (a pin's level, a transaction's bytes, a ctl's text) and a
; write one WRITE (a command, a transaction), the file opened for it and closed after, by the sys- functions (so it's
; an example of driving a device by hand too).  Bytes are a list of integers, 0-255 (a string's will do where
; they're written).  A failure is the system's error, the file closed first.

; (f fd) with the file open (mode: 0 to read, 1 to write, 2 both); its value, the file closed after.  (An error
; passes what it reaches: a failed open calls nothing, and a failure of f's closes the file and goes on.)
(fun {dev.with path mode f} {dev.with2 (sys-open path mode) f})
(fun {dev.with2 fd f} {dev.close fd (try (f fd) (do (sys-close fd) (error &err &code)))})
(fun {dev.close fd v} {do (sys-close fd) v})

; What one READ of the file gives, a string: n bytes at most (256 if n isn't given)
(fun {dev.read path} {do
  =(n ?(&_ (fst &_) 256))
  (dev.with path 0 (fn {fd} {sys-read fd n}))})

; Its text, its lines (a list of strings, without their line ends)
(fun {dev.lines path} {filter (fn {l} {> (len l) 0}) (str-split (dev.read path) "\n")})

; Its text, trimmed, a number
(fun {dev.num path} {val (str-trim (dev.read path))})

; One WRITE of the text (a string) or the bytes (a list) to the file; NIL
(fun {dev.write path data} {do
  (dev.with path 1 (fn {fd} {sys-write fd data}))
  NIL})

; A string's bytes, a list
(fun {dev.bytes s} {map char-code (str-chars s)})

; A number in hex, w digits, lower case (a device's name: an I2C address, an SPI device's 0-f)
(fun {dev.hex n w} {str-lower (hex n w)})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; dice.dl - dice for games: (load "dice") (harn.dl does)

; Dice
(fun {die+ sides mod}    {+ 1 mod (random sides)})
(fun {die sides}         {die+ sides 0})

(fun {d3+ m} {die+ 3 m})
(fun {d3} {d3+ 0})
(fun {d4+ m} {die+ 4 m})
(fun {d4} {d4+ 0})
(fun {d6+ m} {die+ 6 m})
(fun {d6} {d6+ 0})
(fun {d8+ m} {die+ 8 m})
(fun {d8} {d8+ 0})
(fun {d10+ m} {die+ 10 m})
(fun {d10} {d10+ 0})
(fun {d12+ m} {die+ 12 m})
(fun {d12} {d12+ 0})
(fun {d20+ m} {die+ 20 m})
(fun {d20} {d20+ 0})
(fun {d24+ m} {die+ 24 m})
(fun {d24} {d24+ 0})
(fun {d30+ m} {die+ 30 m})
(fun {d30} {d30+ 0})
(fun {d60+ m} {die+ 60 m})
(fun {d60} {d60+ 0})
(fun {d100+ m} {die+ 100 m})
(fun {d100} {d100+ 0})

(fun {dice+ n sides mod} ?{(=0 n) mod (+ (die sides) (dice+ (1- n) sides mod))})
(fun {dice n sides}      {dice+ n sides 0})
:(roll repeat)
(fun {sumrolls d} ?{
  d
  (+
    (let {
      do
        =(hd (fst d))
        (cond
          {(num? hd) (die hd)}
          {(qexpr? hd)
            (case (len hd) 
              {1 .(die hd)}
              {2 .(dice hd)}
              {3 .(dice+ hd)}
            )
          }
        )
    })
    (sumrolls (tail d))
  )
  0
})

(fun {special-die sides cases} .{case (cons (die sides) cases)})

; open ended dice rolls
(fun {oe-die+ sides mod} {
  do
    =(rl (die+ sides 0))
    ?((eq rl sides) (+ sides (oe-die+ sides mod)) (+ rl mod))
})
(fun {oe-die sides}         {oe-die+ sides 0})
(fun {oe-dice+ n sides mod} ?{(=0 n) mod (+ (oe-die sides) (oe-dice+ (1- n) sides mod))})
(fun {oe-dice n sides}      {oe-dice+ n sides 0})


(fun {best-of-rolls a b f} {best-of a (roll b f)})
(fun {worst-of-rolls a b f} {worst-of a (roll b f)})

(fun {dnd-attr-rolls} ?{
  (defined? &1)
  (roll &1 {
    take 6 (sort-desc (roll 8 {sum (best-of-rolls 3 4 {d6})}))
  })
  (dnd-attr-rolls 1)
})

(fun {dnd-attr-rolls-detailed} ?{
  (defined? &1)
  (roll &1 {do
    take 6 (sort-desc (roll 8 {do
      =(rs (sort-desc (roll 4 {d6})))
      [(sum (take 3 rs)) rs]
    }))
  })
  (dnd-attr-rolls-detailed 1)
})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀an"})
(def {harn.estrangement-names} {"Outcast" "Unpopular" "Average" "Popular" "Favorite"})
(def {harn.clanhead-names} {"Distant Relation" "Aunt or Uncle" "Cousin" "Father or Mother"})
(def {harn.frame-names} {"Scant" "Light" "Medium" "Heavy" "Massive"})
(def {harn.complexion-names} {"Fair" "Medium" "Dark"})
(def {harn.hair-names} {"Brown" "Black" "Red" "Silver" "Blond"})
(def {harn.eye-names} {"Hazel" "Gray" "Violet" "Green" "Blue"})
(def {harn.medical-names} {"None" "Addiction" "Albinism" "Allergy" "Ambidextrous" "Arm" "Birthmark" "Dwarfism"
  "Epilepsy" "Ear" "Eye" "Gigantism" "Hemophilia" "Hirsutism" "Leg" "Left-Handed" "Leprosy" "Lycanthropy"
  "Monochromasia" "Obesity" "Parasites" "Poxmarks" "Scars" "Sterile"})
(def {harn.psyche-names} {"None" "Acrophobia" "Aichmophobia" "Algophobia" "Astraphobia" "Ballistophobia" "Bulimia"
  "Claustrophobia" "Cynophobia" "Dyslexia" "Entomophobia" "Gamblamania" "Gephyrophobia" "Heliophobia" "Hemophobia"
  "Hydrophobia" "Hypochondria" "Ivashuphobia" "Kleptomania" "Megalomania" "Mysophobia" "Multiple Personality"
  "Musophobia" "Necrophobia" "Nyctophobia" "Ophidiophobia" "Ornithophobia" "Paranoia" "Psychopathy" "Pvaraphobia"
  "Pyromania" "Pyrophobia" "Sadism" "Sex Mania" "Theophobia" "Toxicophobia" "Violent Temper" "Xenophobia"
  "Yaelaphobia"})
(def {harn.sexuality-names} {"Heterosexual" "Bi-Sexual" "Homosexual"})
(def {harn.deity-names} {"Agrik" "Halea" "Ilvir" "Larani" "Morgath" "Naveh" "Peoni" "Sarajin" "Save-K'nor" "Siem"
  "None"})

; A month's name (1-12), a comeliness's (Character 6)
(def {harn.month-name} (fn {m} {nth (- m 1) harn.month-names}))
(def {harn.comeliness-name} (fn {n} {
  nth (harn.table {5 8 12 15 99} n) {"Ugly" "Plain" "Average" "Attractive" "Handsome"}}))

; A sunsign's signs (Character 3): its own, then the other of a cusp (the one before for its first days, after for
; its last; its own again for the sign alone)
(def {harn.sunsign-signs} (fn {ss} {do
  =(s (truncate (/ ss 3)))
  =(k (- ss (* 3 s)))
  (list s ?((eq k 1) s ?((zero? k) ?((zero? s) 11 (- s 1)) ?((eq s 11) 0 (+ s 1)))))}))

(def {harn.sunsign-name} (fn {ss} {do
  =(s (harn.sunsign-signs ss))
  ?((eq (fst s) (snd s)) (nth (fst s) harn.sign-names)
    (+ (nth (fst s) harn.sign-names) "-" (nth (snd s) harn.sign-names) " Cusp"))}))

; ************************
; *** Birth (Character 2-3) ***
; ************************
; Each sign's first day of the year (0 the 1st of Nuzyael): Ulandus from the 4th of Nuzyael ... Lado from the 2nd of
; Morgat to the 3rd of Nuzyael; a sign's first two days and last two its cusps
(def {harn.sign-starts} {3 33 62 93 124 156 185 214 243 272 302 331})
(def {harn.sunsign-of} (fn {m d} {do
  =(day (+ (* 30 (- m 1)) d -1))
  =(s (harn.table harn.sign-starts (+ day 1)))
  =(s ?((< day 3) 11 ?((< day (nth s harn.sign-starts)) (- s 1) s)))
  =(from (nth s harn.sign-starts))
  =(ln (- ?((< s 11) (nth (+ s 1) harn.sign-starts) 363) from))
  =(at (- day from))
  =(at ?((< at 0) (+ at 360) at))
  (+ (* 3 s) ?((< at 2) 0 ?((>= at (- ln 2)) 2 1)))}))

; Each culture's upper bounds for slave, serf, unguilded and guilded (noble the rest).  (The Viking column has
; unguilded 81-93 and guilded 86-98: here unguilded 81-85.  Feudal slaves are Rethem's, serfs elsewhere: the table
; as it is)
(def {harn.class-table} {{10 10 99 99 100} {15 80 85 98 100} {15 70 93 98 100} {25 25 90 98 100} {0 0 15 98 100}
  {0 0 70 99 100}})

; *****************************
; *** Appearance (Character 6) ***
; *****************************
; The Height/Weight table: 75 pounds at 40", 2 more an inch to 51", 3 from 52", 4 from 64", 3 at 70", 5 from 71"
; (to 89": 255); then the frame's -20% ... +20%, rounded
(def {harn.weight} (fn {ht fr} {do
  =(h (min 89 (max 40 ht)))
  =(w ?((<= h 51) (+ 75 (* 2 (- h 40))) ?((<= h 63) (+ 97 (* 3 (- h 51))) ?((<= h 69) (+ 133 (* 4 (- h 63)))
    (+ 160 (* 5 (- h 70)))))))
  (truncate (/ (+ (* w (+ 8 fr)) 5) 10))}))

; Hair and eyes by the complexion (humans +25 for a fair one, -25 for a dark one): each species' upper bounds (Human,
; Sindarin, Khuzdul; Other as Human)
(def {harn.colour-roll} (fn {sp c} {do
  =(r (harn.d 100))
  (max 1 (min 100 ?((or (zero? sp) (eq sp 3)) (+ r (nth c {25 0 -25})) r)))}))

; **********************************************
; *** The attributes' modifiers (Character 6-10) ***
; **********************************************
; By species (a human female's own), frame (Agility: scant +2 ... massive -2), weight (Strength: 56-85 -4 ...
; 146-155 0 ... 216-245 +4, the table's ends past it)
(def {harn.species-mods} (list #({}) #({{:fr -2} {:str 1} {:sta 1} {:cml 2} {:dex 2} {:agl 2} {:eye 2} {:hrg 2}
  {:voi 2} {:sml 3} {:mor 3} {:aur 4}}) #({{:aur -2} {:dex 1} {:eye 1} {:hrg 2} {:sml 2} {:fr 3} {:wil 3} {:str 4}
  {:sta 4}}) #({})))
(def {harn.female-mods} #({{:fr -3} {:aur 2}}))
(def {harn.species-attr-mod} (fn {sp sx a} {do
  =(v (?((and (zero? sx) (zero? sp)) harn.female-mods (nth sp harn.species-mods)) a))
  ?(v v 0)}))

; An attribute rolled: 3d6 and its modifiers, at least 1
(def {harn.rand-attr} (fn {sp sx fr wt a} {do
  =(r (+ (harn.dice 3 6) (harn.species-attr-mod sp sx a)))
  (max 1 ?((eq a :agl) (+ r 2 (- fr))
    ?((eq a :str) (+ r -4 (harn.table {85 110 130 145 155 170 190 215 999} wt)) r)))}))

; ***********************************
; *** Medical traits (Character 9) ***
; ***********************************
; Each trait's upper bound (1, Addiction ... 23, Sterile): a male's roll, a female's
(def {harn.medical-m} {8 9 14 17 20 24 25 27 28 30 31 32 33 35 39 41 42 44 47 57 60 63 65})
(def {harn.medical-f} {5 6 10 14 15 19 20 22 23 25 26 27 29 30 40 42 43 45 48 58 61 63 65})

; A trait's effects (dwarfism's and gigantism's on height aren't made: the height's taken).  Epilepsy's Intelligence
; is :int+ till Intelligence is rolled (harn_create's order: the traits before the personality)
(def {harn.less} (fn {ch a n} {hash-put ch [a (max 1 (- (ch a) n))]}))
(def {harn.medical-effect} (fn {ch m} {
  ?((eq m 4) (hash-put ch [:dex (+ (ch :dex) (harn.d 3))])
  ?((eq m 5) (harn.less ch :dex (harn.d 3))
  ?((elem? m {6 13 21 22}) (harn.less ch :cml (harn.d 3))
  ?((eq m 8) (hash-put ch [:int+ (harn.d 3)])
  ?((eq m 9) (harn.less ch :hrg (harn.d 3))
  ?((or (eq m 10) (eq m 18)) (harn.less ch :eye (harn.d 3))
  ?((eq m 14) (harn.less ch :agl (shr (ch :agl) 1))
  ?((eq m 15) (hash-put ch [:dex (+ (ch :dex) (harn.d 2))])
  ?((eq m 16) (harn.less ch :cml (harn.dice 2 6))
  ?((eq m 19)
    (do (hash-put ch [:wt (truncate (/ (* (ch :wt) (+ 150 (random 51))) 100))]) (harn.less ch :agl (harn.d 3)))
  NIL))))))))))}))

; A roll on the table: a trait (with its effects; each once, four at most), multiple (two rolls more), or none
(def {harn.rand-medical} (fn {ch depth} {do
  =(r (harn.d 100))
  ?((> r 70) NIL
  ?((> r 65) ?((< depth 3) (do (harn.rand-medical ch (+ depth 1)) (harn.rand-medical ch (+ depth 1))) NIL)
    (do
      =(m (+ 1 (harn.table ?((zero? (ch :sx)) harn.medical-f harn.medical-m) r)))
      ?((or (elem? m (ch :med)) (>= (len (ch :med)) 4)) NIL
        (do (hash-put ch [:med (join (ch :med) (list m))]) (harn.medical-effect ch m))))))}))

; *************************************************************************
; *** Mental disorders and sexuality (Character 11: optional rules, not made) ***
; *************************************************************************
; A disorder (1, Acrophobia ... 38, Yaelaphobia) or more, each with its severity (0 mild, 1 moderate, 2 severe), into
; :psy; a sexuality (0 heterosexual, 1 bisexual, 2 homosexual)
(def {harn.psyche-table} {3 5 6 8 9 11 14 15 17 19 22 24 25 26 28 31 32 35 36 37 38 40 43 45 46 47 48 49 51 54 56 57
  59 60 61 63 64 65})
(def {harn.rand-psyche} (fn {ch depth} {do
  =(r (harn.d 100))
  ?((> r 70) NIL
  ?((> r 65) ?((< depth 3) (do (harn.rand-psyche ch (+ depth 1)) (harn.rand-psyche ch (+ depth 1))) NIL)
    (do
      =(p (+ 1 (harn.table harn.psyche-table r)))
      =(s (harn.table {60 90 100} (harn.d 100)))
      ?((< (len (ch :psy)) 3) (hash-put ch [:psy (join (ch :psy) (list (list p s)))]) NIL))))}))
(def {harn.rand-sexuality} (fn {} {harn.table {90 96 100} (harn.d 100)}))

; ************************n d} ?{(=0 n) NIL (cons (eval d) (repeat (1- n) d))})
:(times repeat)

; Libraries: (use "name") loads lib/name.dl (on the Hydra, /lib/hylang/name.hl) once; NIL, or the error that
; stopped it (then it isn't counted as loaded)
(def {used} {})
(fun {use name} ?{
  (elem? name used)
  NIL
  (do (load name) (set! {used} (cons name used)) NIL)
})

; sort and related
; (in? x l) is built in
(fun {remove-fst f l} ?{
  l
  (do
    =(hd (fst l))
    =(tl (tail l))
    ?(
      (eq f hd)
      tl
      (cons hd (remove-fst f tl))
    )
  )
})

(fun {remove-min} {remove-fst .(min &1) &1})
(fun {remove-max} {remove-fst .(max &1) &1})

(fun {remove-all f l} ?{
  l
  (do
    =(hd (fst l))
    =(tl (tail l))
    ?(
      (eq f hd)
      (remove-all f tl)
      (cons hd (remove-all f tl))
    )
  )
})

; sort is built in: (sort l), or (sort l less)
(fun {sort-desc l} {reverse (sort l)})

(fun {best-of n l} {take n (sort-desc l)})
(fun {worst-of n l} {take n (sort l)})

:({top bottom} best-of worst-of)

(fun {between?} ?{(<= &1 &2) (and (>= &3 &1) (<= &3 &2)) (between? &2 &1 &3)})
:(><? between?)
(fun {not-between?} {not (between? &1 &2 &3)})
:(!><? not-between?)

(fun {all-between?} ?{&3 (and (between? &1 &2 (fst &3)) (all-between? &1 &2 (tail &3))) T})
:(*><? all-between?)

(fun {all-not-between?} ?{&3 (and (not-between? &1 &2 (fst &3)) (all-not-between? &1 &2 (tail &3))) T})
:(*!><? all-not-between?)

(fun {not-all-between?} {not (all-between? &1 &2 &3)})
:(!*><? not-all-between?)
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; gpio.hl - the VIA's port A on header J27, by its files (#g, /dev/gpio): (use "gpio").  Its files: 0-7 (a pin:
; reads as 0 or 1; a write of 0 or 1 sets it, the pin an output), port (all 8: a byte), ctl (in N, out N, ddr N,
; ca1 rise or fall, ca2 0, 1 or in; it reads as the pins and the handshake lines, a line each) and ca1 (a read waits
; for CA1's next edge, then gives the edges counted).  A pin is 0-7, the pin first.  A failure is the system's error.

(use "dev")

(fun {gpio.ctl line} {dev.write "/dev/gpio/ctl" line})
(fun {gpio.file pin} {+ "/dev/gpio/" (to-str pin)})

; A pin's level, 0 or 1
(fun {gpio pin} {dev.num (gpio.file pin)})

; The pin made an output, its level set (0 or 1)
(fun {gpio! pin level} {dev.write (gpio.file pin) ?((== level 0) "0" "1")})

; The pin made an input, or an output
(fun {gpio-in pin} {gpio.ctl (format "in {}" pin)})
(fun {gpio-out pin} {gpio.ctl (format "out {}" pin)})

; All 8 pins' levels, a byte (bit n, pin n)
(fun {gpio-port} {char-code (char-at (dev.read "/dev/gpio/port" 1) 0)})

; The outputs' levels set from a byte (the inputs keep theirs)
(fun {gpio-port! byte} {dev.write "/dev/gpio/port" (list byte)})

; The pins' directions: bit n 1, pin n an output
(fun {gpio-ddr! byte} {gpio.ctl (format "ddr {}" byte)})

; CA1's active edge, :rise or :fall
(fun {gpio-ca1! edge} {if (eq edge :rise) (gpio.ctl "ca1 rise")
  (if (eq edge :fall) (gpio.ctl "ca1 fall") (error "'gpio-ca1!' expects :rise or :fall" :inval))})

; CA2: 0 (an output, low), 1 (high) or :in (an input)
(fun {gpio-ca2! v} {gpio.ctl ?((eq v :in) "ca2 in" (format "ca2 {}" ?((== v 0) 0 1)))})

; CA1's next edge waited for: the edges counted
(fun {gpio-wait} {dev.num "/dev/gpio/ca1"})

; The pins and the handshake lines, a hash: each pin (0-7) its direction and level, {:out 1}; :ca1 its edge and
; the edges counted, {:rise 3}; :ca2 its level, or :in
(fun {gpio-state} {hash-create (map gpio.entry (dev.lines "/dev/gpio/ctl"))})
(fun {gpio.entry line} {do
  =(w (str-split line " "))
  ?((digit? (char-at line 0))
    (list (val (fst w)) (list (to-atom (snd w)) (val (thd w))))
    ?((== (fst w) "ca1")
      (list :ca1 (list (to-atom (snd w)) (val (thd w))))
      (list (to-atom (fst w)) ?((== (snd w) "in") :in (val (snd w))))))})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; harn.hl - HarnMaster (third edition, 3.5) characters and their rules: (use "harn").  danlang's lib/harn.dl made
; for hylang's speed: the same rules, by the C SDK's numbers (harn.h's: a species 0-3, a sunsign 0-35 ...), so a
; character is harn.h's and its file harnfile.c's, which the C game and every generator read.  Each value's names are
; lists (nth): (nth sp harn.species-names).  harntest.hl has the tests, the penalties and development (as harn.h's
; harntest.c); combat and healing are harn.dl's and harn.h's.  As harn.dl, occupations, contacts, aging, psionics,
; magic and rituals are left out.
;
; A character is a hash: its attributes by harn.dl's keys (:sp :sx :bd :ss :ht :fr :owt :wt :cml :str ... :mor :dty
; :pty: harn.attr-keys), its family (:culture :social :sibrank :famsize :parent :estrange :clanhead), its colours
; (:complexion :hair :eyes), :med (its medical traits), :psy (its disorders, a list of {disorder severity}),
; :sexuality, :ml (a buffer: each skill's mastery level by its number, 0 not opened), its volatiles (:fl :bl :dp
; :state :shockhr, and :inj, a list of injuries: {loc aspect sev il hr flags}), and :sg (its sunsign's two signs'
; letters, for the skills' bonuses).
;
; hylang reads a library slowly, and compiles each function fun makes as it's read: these are def's and fn's, each
; compiled at its second call, so those a program calls once or not at all cost it no time.  The Skill Data table is
; text, for the same reason.  hylang's random can't be seeded: the same character twice is HyForth's (harn.fs) or C's.

; ****************
; *** Dice ***
; ****************
(def {harn.d} (fn {n} {+ 1 (random n)}))
(def {harn.dice} (fn {n s} {?((zero? n) 0 (+ 1 (random s) (harn.dice (- n 1) s)))}))

; A table's place for a roll: the first of its upper bounds the roll doesn't pass (the last if it passes them all)
(def {harn.table} (fn {upto r} {?((or (nil? (tail upto)) (<= r (fst upto))) 0 (+ 1 (harn.table (tail upto) r)))}))

; ***************************
; *** The names ***
; ***************************
(def {harn.attr-keys} {:sp :sx :bd :ss :ht :fr :owt :wt :cml :str :sta :dex :agl :eye :hrg :sml :voi :int :aur :wil
  :mor :dty :pty})
(def {harn.attr-names} {"Species" "Sex" "Birthday" "Sunsign" "Height" "Frame" "Optimum Weight" "Weight" "Comeliness"
  "Strength" "Stamina" "Dexterity" "Agility" "Eyesight" "Hearing" "Smell" "Voice" "Intelligence" "Aura" "Will"
  "Morality" "Deity" "Piety" "Endurance"})
(def {harn.species-names} {"Human" "Sindarin" "Khuzdul" "Other"})
(def {harn.sex-names} {"Female" "Male"})
(def {harn.month-names} {"Nuzyael" "Peonu" "Kelen" "Nolus" "Larane" "Agrazhar" "Azura" "Halane" "Savor" "Ilvin"
  "Navek" "Morgat"})
(def {harn.sign-names} {"Ulandus" "Aralius" "Feniri" "Ahnu" "Angberelius" "Nadai" "Hirin" "Tarael" "Tai" "Skorus"
  "Masara" "Lado"})
(def {harn.culture-names} {"Tribal" "Viking" "Feudal" "Imperial" "Khuzan" "Sindarin"})
(def {harn.class-names} {"Slave" "Serf" "Unguilded" "Guilded" "Noble"})
(def {harn.parent-names} {"Offspring" "Fostered" "Adopted" "Bastard" "Orphattributes, the
; medical traits, the personality, piety; then the automatic skills opened
; (A hash made whole is made faster than one put an entry at a time: the attributes as far as the physical ones,
; and harn.blank's, in one)
(def {harn.blank} {{:med {}} {:psy {}} {:inj {}} {:sexuality 0} {:fl 0} {:bl 0} {:dp 0} {:state 0} {:shockhr 0}})
(def {harn.new} (fn {} {hash-create (cons [:ml (buffer 100)] harn.blank)}))
(def {harn.signs-of} (fn {ss} {do
  =(s (harn.sunsign-signs ss))
  (list (char-at "abcdefghijkl" (fst s)) (char-at "abcdefghijkl" (snd s)))}))

(def {harn.species} NIL)                        ; A species fixed (0-2, harn_template's), or NIL: rolled
(def {harn.create} (fn {} {do
  =(rolled (harn.table {97 98 99 100} (harn.d 100)))
  =(sp ?((nil? harn.species) rolled harn.species))
  =(sx ?((<= (harn.d 100) (nth sp {48 45 75 48})) 1 0))
  =(m (harn.d 12))
  =(d (harn.d 30))
  =(ss (harn.sunsign-of m d))
  =(culture (nth sp {2 5 4 2}))
  =(social (harn.table (nth culture harn.class-table) (harn.d 100)))
  =(rank (+ 1 (harn.table {25 50 70 85 95 100} (max 1 (- (harn.d 100) ?((or (eq sp 1) (eq sp 2)) 20 0))))))
  =(size (+ rank (harn.d 6) -1))
  =(parent (harn.table {50 70 75 90 100} (harn.d 100)))
  =(est (harn.table {10 40 60 95 100} (min 100 (+ (harn.d 100) ?((eq rank 1) 5 0)))))
  =(head (harn.table {50 75 85 100} (harn.d 100)))
  =(ht (+ (nth sp ?((zero? sx) {52 50 40 52} {54 51 40 54})) (harn.dice 4 6)))
  =(fr (harn.table {5 8 12 15 99} (+ (harn.dice 3 6) (harn.species-attr-mod sp sx :fr))))
  =(wt (harn.weight ht fr))
  =(cml (harn.rand-attr sp sx fr wt :cml))
  =(c (harn.table (nth sp {{27 74 100} {97 99 100} {90 100 100} {27 74 100}}) (harn.d 100)))
  =(hair (harn.table (nth sp {{40 55 65 70 100} {25 48 50 60 100} {40 45 70 90 100} {40 55 65 70 100}})
    (harn.colour-roll sp c)))
  =(eyes (harn.table (nth sp {{40 55 56 70 100} {15 65 75 80 100} {50 69 70 85 100} {40 55 56 70 100}})
    (harn.colour-roll sp c)))
  =(ch (hash-create (join (list [:sp sp] [:sx sx] [:bd (+ (* 256 m) d)] [:ss ss] [:sg (harn.signs-of ss)]
    [:culture culture] [:social social] [:sibrank rank] [:famsize size] [:parent parent] [:estrange est]
    [:clanhead head] [:ht ht] [:fr fr] [:owt wt] [:wt wt] [:cml cml] [:complexion c] [:hair hair] [:eyes eyes]
    [:ml (buffer 100)])
    (harn.rolls sp sx fr wt {:str :sta :dex :agl :eye :hrg :sml :voi}) harn.blank)))
  (harn.rand-medical ch 0)
  =(e (ch :int+))
  (hash-put ch [:int (+ (harn.rand-attr sp sx fr wt :int) ?(e e 0))] [:aur (harn.rand-attr sp sx fr wt :aur)]
    [:wil (harn.rand-attr sp sx fr wt :wil)] [:mor (harn.rand-attr sp sx fr wt :mor)] [:dty 10] [:pty (harn.dice 5 6)])
  ?(e (hash-remove ch :int+) NIL)
  (harn.open-autos ch 0)
  ch}))

; Attributes rolled, a list of entries
(def {harn.rolls} (fn {sp sx fr wt l} {
  ?(l (cons [(fst l) (harn.rand-attr sp sx fr wt (fst l))] (harn.rolls sp sx fr wt (tail l))) {})}))

; The automatic skills, at their OMLs (from skill k on)
(def {harn.open-autos} (fn {ch k} {
  ?((< k 91) (do ?((eq (harn.sk k 38) \1) (harn.open-skill ch k) NIL) (harn.open-autos ch (+ k 1))) NIL)}))

; ************************************************
; *** Files (harnfile.c's): a line a thing ***
; ************************************************
; harn 1; att KEY VALUE (each attribute, harn.attr-keys' order); fam culture social sibrank famsize parent estrange
; clanhead; look complexion hair eyes; med (the traits); psy DISORDER SEVERITY (a line each); sexuality N; ml KEY ML
; (each open skill); vol fl bl dp state shockhr; inj loc aspect sev il hr flags (each injury); then the program's own
; lines (more: a list of strings, "name Dorn" ...)
(def {harn.att-line} (fn {ch a} {+ "att " (substring (to-str a) 1) " " (ch a)}))
(def {harn.ml-lines} (fn {ch k l} {?((< k 0) l (do =(ml (buffer-get (ch :ml) k))
  (harn.ml-lines ch (- k 1) ?((zero? ml) l (cons (+ "ml " (harn.skill-key k) " " ml) l)))))}))
(def {harn.of} (fn {ch a} {ch a}))
(def {harn.nums} (fn {ch l} {str-join (map (harn.of ch) l) " "}))
(def {harn.lines} (fn {ch} {join
  {"harn 1"}
  (map (harn.att-line ch) harn.attr-keys)
  (list (+ "fam " (harn.nums ch {:culture :social :sibrank :famsize :parent :estrange :clanhead}))
    (+ "look " (harn.nums ch {:complexion :hair :eyes}))
    (str-join (cons "med" (ch :med)) " "))
  (map (fn {x} {+ "psy " (fst x) " " (snd x)}) (ch :psy))
  (list (+ "sexuality " (ch :sexuality)))
  (harn.ml-lines ch 90 {})
  (list (+ "vol " (harn.nums ch {:fl :bl :dp :state :shockhr})))
  (map (fn {i} {str-join (cons "inj" i) " "}) (ch :inj))}))

(def {harn.write} (fn {path ch more} {write-file path (str-join (join (harn.lines ch) more {""}) "\n")}))

; A character read from a file (NIL: none there): its lines that aren't harn.h's in :other, a list
(def {harn.read} (fn {path} {do
  =(ch (harn.new))
  (hash-put ch [:other {}])
  (each (harn.read-line ch) (read-lines path))
  ?((ch :ss) (do (hash-put ch [:sg (harn.signs-of (ch :ss))]) ch) NIL)}))

(def {harn.put-all} (fn {ch keys vals} {?((and keys vals) (do (hash-put ch [(fst keys) (fst vals)])
  (harn.put-all ch (tail keys) (tail vals))) NIL)}))
(def {harn.read-line} (fn {ch l} {do
  =(w (str-split (str-trim l) " "))
  =(k (fst w))
  =(n (map val (filter digit? (tail w))))
  ?((eq k "att") (hash-put ch [(to-atom (snd w)) (val (thd w))])
  ?((eq k "fam") (harn.put-all ch {:culture :social :sibrank :famsize :parent :estrange :clanhead} n)
  ?((eq k "look") (harn.put-all ch {:complexion :hair :eyes} n)
  ?((eq k "med") (hash-put ch [:med n])
  ?((eq k "psy") (hash-put ch [:psy (join (ch :psy) (list n))])
  ?((eq k "sexuality") (hash-put ch [:sexuality (fst n)])
  ?((eq k "ml") (do =(sk ?((digit? (snd w)) (val (snd w)) (harn.skill-of ?((eq (snd w) "tar") "trt" (snd w)))))
    ?((>= sk 0) (harn.put-ml ch sk (val (thd w))) NIL))
  ?((eq k "vol") (harn.put-all ch {:fl :bl :dp :state :shockhr} n)
  ?((eq k "inj") (hash-put ch [:inj (join (ch :inj) (list n))])
  ?((or (eq k "harn") (eq k "")) NIL
  (hash-put ch [:other (join (ch :other) (list l))])))))))))))}))
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; harntest.hl - HarnMaster's tests, penalties and development (Skills 5-6, 21-22), for harn.hl's characters: (use
; "harntest"), which uses harn.  Kept apart from harn.hl, as harn.h's harntest.c is, so a program that only makes a
; character (hmchar.hl) doesn't wait for hylang to read them.  A test's result is 0 CF, 1 MF, 2 MS or 3 CS.

(use "harn")

; Development (Skills 6): d100 and SB over ML raise it by 1 (it can't pass 100 + SB): :improved, :not-improved,
; :maxed; a development point spent on one (apply-dr): :no-dp if there's none
(def {harn.develop} (fn {ch sk} {do
  =(ml (harn.get-ml ch sk))
  =(sb (harn.get-sb ch sk))
  ?((>= ml (+ 100 sb)) :maxed
    ?((> (+ (harn.d 100) sb) ml) (do (harn.put-ml ch sk (+ ml 1)) :improved) :not-improved))}))
(def {harn.apply-dr} (fn {ch sk} {?((zero? (ch :dp)) :no-dp
  (do =(r (harn.develop ch sk)) ?((eq r :maxed) NIL (hash-put ch [:dp (- (ch :dp) 1)])) r))}))

; d100 at or under the EML (kept from 5 to 95): 0 CF, 1 MF, 2 MS, 3 CS (a roll ending in 0 or 5 critical)
(def {harn.test} (fn {eml} {do
  =(r (harn.d 100))
  =(c ?((elem? (- r (* 10 (truncate (/ r 10)))) {0 5}) 1 0))
  ?((<= r (max 5 (min 95 eml))) (+ 2 c) (- 1 c))}))
(def {harn.success?} (fn {l} {>= l 2}))

; EML: ML less five times the physical penalty (physical and combat skills) or the universal (the rest)
(def {harn.eml} (fn {ch sk} {do
  =(g (harn.skill-group sk))
  (- (harn.get-ml ch sk) (* 5 ?((or (zero? g) (eq g 3)) (harn.get-pp ch) (harn.get-up ch))))}))
(def {harn.test-skill} (fn {ch sk mod} {harn.test (+ (harn.eml ch sk) mod)}))

; Skill against skill: :a won, :b won, or NIL (neither)
(def {harn.versus} (fn {a b} {?((> a b) :a ?((> b a) :b NIL))}))

; An attribute times n on d100, less 5 a point of penalty (the physical attributes' PP, the rest's UP); or 3d6 and
; the penalty at most the attribute (T); the shock roll (1d6 a point of UP over END: down), stumble and fumble
(def {harn.get-attr} (fn {ch a} {?((eq a :end) (harn.end ch) (ch a))}))
(def {harn.attr-penalty} (fn {ch a} {
  ?((elem? a {:str :st***************************
; *** Skills (Skills 3-4: the Skill Data table, its order) ***
; ***************************************************
; A line a skill, 42 bytes with its LF (skill n's from byte 1 + 42n): its key (harn.dl's, the file's), its name, its
; three attributes (S STR, T STA, D DEX, A AGL, E EYE, H HRG, M SML, V VOI, I INT, U AUR, W WIL, C CML), its sunsign
; bonuses (each a sign, a Ulandus ... l Lado, and its bonus), its OML's multiple of SB (L a native tongue, 50-80 + SB
; by social class; S a native script, 70 + SB), 1 if it's automatic, its group (0 physical, 1 communication,
; 2 religion, 3 combat, 4 craft: physical and combat skills take the physical penalty, the rest the universal), and a
; craft's months of teaching (0: opened on its first use).  (A table as text: hylang reads it many times faster)
(def {harn.skill-rows} (+ """
acr  Acrobatics         SAA f2g1     2000
cli  Climbing           SDA a2b2     4100
cnd  Condition          STW a1l1     5100
dan  Dancing            DAA h2g1i1   2000
jmp  Jumping            SAA f2g2     4100
leg  Legerdemain        DDW j2i2h2   1000
ski  Skiing             SDA k2j1l1   1000
stl  Stealth            AHW g2h2i2   3100
swi  Swimming           TDA j1k3l3   1000
thr  Throwing           SDE g2h1f1   4100
act  Acting             AVI h1i1     2010
awa  Awareness          EHM g2h2     4110
ntr  Intrigue           IUW i1h1j1   3110
lov  Lovecraft          CAV k1e1     3010
men  Mental Conflict    UWW          3010
mus  Musician           DHH k1e1     1010
ora  Oratory            CVI h1       2110
rhe  Rhetoric           VIW i1h1j1   3110
sng  Singing            HVV k1       3110
lan  Language           VIW i1       L110
scr  Script             DEI h1i1     S011
ragr Ritual: Agrik      VIS f2e1d1   1020
rhal Ritual: Halea      VIC h2g1k1   1020
rilv Ritual: Ilvir      VIU j2i1a1   1020
rlar Ritual: Larani     VIW e2d1c1   1020
rmor Ritual: Morgath    VIU l2d1k1   1020
rnav Ritual: Naveh      VIW k2j1h1   1020
rpeo Ritual: Peoni      VID b2e1a1   1020
rsar Ritual: Sarajin    VIS c2b1l1   1020
rsav Ritual: Save-K'nor VII i2j1h1   1020
rsie Ritual: Siem       VIU g2c1a1   1020
ini  Initiative         AWW          4130
una  Unarmed            SDA k2l2a2   4130
rid  Riding             DAW a1b1     1030
axe  Axe                SSD d1c1e1   3030
blo  Blowgun            TDE g2h1f1   4030
bow  Bow                SDE g1h1f1   2030
clu  Club               SSD a1b1     4030
dag  Dagger             DDE e2f2     3030
fla  Flail              DDD g1h1f1   1030
net  Net                DDE k1j1l1   1030
pol  Polearm            SSD e1b1     2030
shd  Shield             SDD a1l1k1   3030
slg  Sling              DDE g1h1f1   1030
spr  Spear              SSD b1c1a1   3030
swd  Sword              SDD e3d1f1   3030
whp  Whip               DDE g1f1     1030
dge  Dodge              AAA          5130
""" (substring """
agr  Agriculture        STW a2b2     2041
alc  Alchemy            MIU j3i2k2   1046
ani  Animalcraft        AVW a1b1     1041
ast  Astrology          EIU h1       1043
bre  Brewing            DMM j3i2k2   2041
cer  Ceramics           DDE a2b2     2042
coo  Cookery            DMM j1       3040
dra  Drawing            DEE j1i1     2041
emb  Embalming          DEM j1a1     1042
eng  Engineering        DII a2b2c1   1043
fis  Fishing            DEW k2l2     3040
fle  Fletching          DDE g2h1f1   1041
fol  Folklore           VII i2       3040
for  Foraging           DMI a2b2     3040
gla  Glassworking       DEW c2       1043
hrl  Heraldry           DEW j1i1     1041
hrb  Herblore           EMI a3b2     1041
hid  Hidework           DMW a1b1     2041
hun  Hunting            AMI a2b2     2040
ink  Inkcraft           EMI j2i1     1041
jew  Jewelcraft         DEW c3h1b1   1042
law  Law                VIW h1i1     1042
lck  Lockcraft          DEW c1       1042
lor  Lore               EII i2       2041
msn  Masonry            SDI a2b2     1041
mat  Mathematics        IIW i3h1j1   1043
met  Metalcraft         SDW c3d1e1   1042
mil  Milling            SDM a1       2041
min  Mining             SEI a2b2c1   1041
prf  Perfumery          MMI g1j1h1   1041
phy  Physician          DEI k2j1i1   1040
pil  Piloting           DEI l3k1     1046
run  Runecraft          IUU i2j1     1046
sea  Seamanship         SDA l3k1j1   2041
shw  Shipwright         SDI l3k1     1042
sur  Survival           SDI a2b1     3041
trt  Tarotry            IUW h2i2j1g1 1044
tex  Textilecraft       DDE a1b1     2041
tim  Timbercraft        SDA a3b1     2041
trk  Tracking           EMW a3b3     2041
wpn  Weaponcraft        SDW c3d1e1   1044
wea  Weatherlore        IEM g1h1k1l1 3041
woo  Woodcraft          DDW a2b1l1   2041
""" 1)))
(def {harn.nskills} 91)
(def {harn.codes} {:str :sta :dex :agl :eye :hrg :sml :voi :int :aur :wil :cml})

; A skill's byte i (its line's), its key, its name, its group; a skill by its key ("cli": -1, none)
(def {harn.sk} (fn {sk i} {char-at harn.skill-rows (+ 1 i (* 42 sk))}))
(def {harn.skill-key} (fn {sk} {str-trim (substring harn.skill-rows (+ 1 (* 42 sk)) 5)}))
(def {harn.skill-name} (fn {sk} {str-trim (substring harn.skill-rows (+ 6 (* 42 sk)) 19)}))
(def {harn.skill-group} (fn {sk} {- (char-code (harn.sk sk 39)) 48}))
(def {harn.skill-keys} (map harn.skill-key (range 0 91)))
(def {harn.skill-of} (fn {key} {index-of harn.skill-keys key}))

; *****************************
; *** A character's skills ***
; *****************************
; The average of three attributes, rounded (half up); Endurance: Strength's, Stamina's and Will's
(def {harn.avg} (fn {a b c} {shr (* (+ a b c a b c 3) 171) 10}))
(def {harn.end} (fn {ch} {harn.avg (ch :str) (ch :sta) (ch :wil)}))

; The best bonus of a skill's signs that the character's sunsign has (a cusp: either of its two; :sg, their letters)
(def {harn.get-ssb} (fn {ch sk} {harn.ssb (+ 29 (* 42 sk)) (fst (ch :sg)) (snd (ch :sg)) 0 0}))
(def {harn.ssb} (fn {o a b p m} {do
  =(c (char-at harn.skill-rows (+ o p p)))
  ?((or (eq p 4) (eq c \space)) m
    (harn.ssb o a b (+ p 1)
      ?((or (eq c a) (eq c b)) (max m (- (char-code (char-at harn.skill-rows (+ o p p 1))) 48)) m)))}))

; SB: the three attributes' average and the sunsign's bonus (Condition's SB is Endurance: Skills 9)
(def {harn.att} (fn {ch sk i} {ch (nth (index-of "STDAEHMVIUWC" (harn.sk sk i)) harn.codes)}))
(def {harn.get-sb} (fn {ch sk} {?((eq sk 2) (harn.end ch)
  (+ (harn.avg (harn.att ch sk 24) (harn.att ch sk 25) (harn.att ch sk 26)) (harn.get-ssb ch sk)))}))

; OML: SB times its multiple; a native script 70 + SB, a native tongue 50-80 + SB by social class (Skills 11)
(def {harn.get-oml} (fn {ch sk} {do
  =(m (harn.sk sk 37))
  =(sb (harn.get-sb ch sk))
  ?((eq m \S) (+ 70 sb) ?((eq m \L) (+ sb (nth (ch :social) {50 50 60 60 70})) (* sb (- (char-code m) 48))))}))

(def {harn.get-ml} (fn {ch sk} {buffer-get (ch :ml) sk}))
(def {harn.get-si} (fn {ch sk} {truncate (/ (harn.get-ml ch sk) 10)}))
(def {harn.put-ml} (fn {ch sk v} {buffer-put (ch :ml) sk (min 255 v)}))
(def {harn.open-skill} (fn {ch sk} {?((zero? (harn.get-ml ch sk)) (harn.put-ml ch sk (harn.get-oml ch sk)) NIL)}))

; *****************************************************************
; *** Penalties (Skills 6), move (Combat 6), size (Character 6) ***
; *****************************************************************
; UP: fatigue and the injuries' levels; PP: UP and EP, the load (:load, pounds) over Endurance, rounded
(def {harn.il} (fn {i} {nth 3 i}))
(def {harn.get-up} (fn {ch} {+ (ch :fl) (sum (map harn.il (ch :inj)))}))
(def {harn.get-ep} (fn {ch} {do =(l (ch :load)) =(e (harn.end ch)) ?(l (truncate (/ (+ l l e) (* 2 e))) 0)}))
(def {harn.get-pp} (fn {ch} {+ (harn.get-up ch) (harn.get-ep ch)}))
(def {harn.move} (fn {ch} {max 1 (- (ch :agl) (harn.get-pp ch))}))

; Size: 1-10 by weight (Character 6)
(def {harn.size} (fn {ch} {+ 1 (harn.table {65 75 90 110 135 165 200 240 285 9999} (ch :wt))}))

; ************************************************
; *** A new character (Character 2-12): harn.create ***
; ************************************************
; In harn_create's order (harngen.c's): birth, culture and class, family, appearance, the physical яяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяяя