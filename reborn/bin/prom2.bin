$0B constant tf_rom          \ TR_FRAME's: its paged ROM bank register ($01)
$0C constant tf_size         \
$00 constant ts_step         \ TASKSTEP: one instruction
$01 constant ts_next         \ TASKSTEP: one instruction, a JSR's subroutine whole
$02 constant ts_breaks       \ TASKSTEP: from now, the task's BRKs stop it (the debugger's breakpoints)
$03 constant ts_nobreaks     \ TASKSTEP: its BRKs are its own again (NOTE_BRK)
$00 constant ni_from         \ NSINFO's answer (NI_SIZE bytes): the mount point (PATH_MAX + 1 bytes, zero-term
$40 constant ni_path         \ NSINFO: the path in the device (zero-terminated, no leading /)
$80 constant ni_dev          \ NSINFO: the device letter
$81 constant ni_spec         \ NSINFO: the spec (8 bytes, zero-padded, and a 0)
$8A constant ni_flags        \ NSINFO: the flags (MCREATE)
$8B constant ni_seq          \ NSINFO: its place among the union's members (lowest first)
$8C constant ni_size         \
$80 constant key_up          \ Keys: a raw console read gives the terminal's cursor and function keys as one c
$81 constant key_down        \
