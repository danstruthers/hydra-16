$88 constant key_pgup        \
$89 constant key_pgdn        \
$8A constant key_f1          \ Keys: F1-F12 are $8A-$95
$8B constant key_f2          \
$8C constant key_f3          \
$8D constant key_f4          \
$8E constant key_f5          \
$8F constant key_f6          \
