; read from the ROM disk by its device's name (#fx), as a window's shell starts in an empty namespace: the namespace
; made (newns's), then /lib/hylang/profile.hl, through the /lib union (a card's or the RAM disk's in the ROM's place).

(load "#fx/lib/hylang/newns.hl")
(load "/lib/hylang/profile.hl")
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀s line} {shell.w (str-chars line) "" NIL {}})
(fun {shell.w cs w any ws} {if (nil? cs) (if any (join ws (list w)) ws) (do
  =(k (char-code (fst cs)))
  (if (or (== k 32) (== k 9)) (shell.w (tail cs) "" NIL (if any (join ws (list w)) ws))
  (if (== k 39) (shell.q (tail cs) w ws)
  (if (== k 36) (shell.v (tail cs) "" w ws)
  (shell.w (tail cs) (+ w (to-str (fst cs))) T ws)))))})
(fun {shell.q cs w ws} {if (nil? cs) (join ws (list w))
  (if (== (char-code (fst cs)) 39)
    (if (and (tail cs) (== (char-code (fst (tail cs))) 39))
      (shell.q (tail (tail cs)) (+ w "'") ws)
      (shell.w (tail cs) w T ws))
    (shell.q (tail cs) (+ w (to-str (fst cs))) ws))})
(fun {shell.v cs n w ws} {if (and cs (or (alpha? (fst cs)) (digit? (fst cs)) (== (char-code (fst cs)) 95)))
  (shell.v (tail cs) (+ n (to-str (fst cs))) w ws)
  (shell.w cs (+ w (shell.first (env n))) T ws)})
(fun {shell.first v} {if (nil? v) "" (if (string? v) v (fst v))})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; snd.hl - the YM2151, and the Vera X's PSG, through the sound driver's files (#a, /dev): (use "snd").  /dev/snd takes
; register/value pairs (the registers the chip doesn't have, below $20, are the driver's commands for a channel:
; SND_R_CH, then a patch, a note, key off, volume, speakers, bend, a drum, a frequency, a glide, a waveform);
; /dev/sndctl takes claim N P and release N P (masks of channels: the YM2151's, the PSG's), volume N (the master,
; 0-200: 100 as written) and reset, and each channel's commands as text.  Each is opened the first time it's wanted,
; and stays open: a task's claimed channels go back as its last #a file closes (at its end).  A channel's command
; goes with the channel in one write, so another program's can't come between.  A channel is 0-7 (the YM2151's) or
; 8-23 (with a Vera X, the PSG's: the same words, and snd-wave), a note MIDI's (60: middle C).  Songs are play's
; (the program).  A failure is the system's error.

(def {snd.fd} NIL)
(def {snd.ctlfd} NIL)

; Bytes to /dev/snd, a line to /dev/sndctl (each opened if it isn't)
(fun {snd.out bytes} {do
  (if snd.fd NIL (set! {snd.fd} (sys-open "/dev/snd" 1)))
  (sys-write snd.fd bytes)
  NIL})
(fun {snd.ctl line} {do
  (if snd.ctlfd NIL (set! {snd.ctlfd} (sys-open "/dev/sndctl" 1)))
  (sys-write snd.ctlfd line)
  NIL})

; A channel's command (SND_R_*) and its value (a byte: a negative one's two's complement)
(fun {snd.cmd ch cmd v} {snd.out (list 2 ch cmd (bit-and v 255))})

; The channels claimed (0-23), so no other program writes them; given back.  (sndctl's two masks: the YM2151's
; channels, 0-7, and the PSG's, 8-23)
(fun {snd.masks cs} {format "{} {}"
  (foldl (fn {m c} {if (< c 8) (bit-or m (shl 1 c)) m}) 0 cs)
  (foldl (fn {m c} {if (< c 8) m (bit-or m (shl 1 (- c 8)))}) 0 cs)})
(fun {snd-claim} {snd.ctl (format "claim {}" (snd.masks &_))})
(fun {snd-release} {snd.ctl (format "release {}" (snd.masks &_))})

; The master volume (0-200: 100 as written); the chip and every setting cleared (the claims stay)
(fun {snd-volume v} {snd.ctl (format "volume {}" v)})
(fun {snd-reset} {snd.ctl "reset"})

; Chip registers written: register and value, in pairs
(fun {snd-reg reg value} {snd.out (join (list reg value) &_)})

; A patch (the X16's, 0-162) into the channel; a note keyed on; keyed off (its release)
(fun {snd-patch ch n} {snd.cmd ch 3 n})
(fun {snd-note ch note} {snd.cmd ch 4 note})
(fun {snd-off ch} {snd.cmd ch 5 0})

; The channel's level, its volume (0-127: snd-volume is the master's; snd-vol, its old name); its speakers
; (:left, :right or :both); its bend (64ths of a semitone, signed)
(fun {snd-level ch v} {snd.cmd ch 6 v})
(fun {snd-vol ch v} {snd-level ch v})
(fun {snd-pan ch pan} {do
  =(p (+ 1 (index-of {:left :right :both} pan)))
  (if (> p 0) (snd.cmd ch 7 p) (error "'snd-pan' expects :left, :right or :both" :inval))})
(fun {snd-bend ch n} {snd.cmd ch 9 n})

; A General MIDI drum (35: a kick) keyed on, on the channel
(fun {snd-drum ch n} {snd.cmd ch 10 n})

; A note at a frequency (Hz: 0, off), keyed on; the pitch to a note without a new attack (legato)
(fun {snd-freq ch hz} {snd.out (list 2 ch 11 (bit-and hz 255) 12 (shr hz 8))})
(fun {snd-glide ch n} {snd.cmd ch 13 n})

; A PSG channel's waveform (:pulse, :saw, :triangle or :noise; or 0-3) and its width (0-63; 63, a square, if it
; isn't given)
(fun {snd-wave ch w} {do
  =(n (if (num? w) w (index-of {:pulse :saw :triangle :noise} w)))
  (if (and (>= n 0) (< n 4))
    (snd.cmd ch 14 (bit-or (shl n 6) (bit-and ?(&_ (fst &_) 63) 63)))
    (error "'snd-wave' expects :pulse, :saw, :triangle or :noise" :inval))})

; The chip's own registers: the LFO (the whole chip's: its rate, its depths of pitch and amplitude (0-127), its wave:
; 0 saw, 1 square, 2 triangle, 3 noise); a channel's sensitivity to it (vibrato 0-7, tremolo 0-3); channel 7's noise
; at frequency n (0-31; negative: off)
(fun {snd-lfo rate pmd amd wave} {snd.out (list 24 rate 25 (bit-or 128 pmd) 25 (bit-and amd 127) 27 (bit-and wave 3))})
(fun {snd-sens ch pms ams} {snd.out (list (+ 56 ch) (bit-or (shl (bit-and pms 7) 4) (bit-and ams 3)))})
(fun {snd-noise n} {snd.out (list 15 (if (< n 0) 0 (bit-or 128 (bit-and n 31))))})

; The chip's 256 registers as written (the driver's shadow: the chip's can't be read), a buffer: /dev/snd opened for
; it (from its start: the driver gives them in one read) and closed
(fun {snd-regs} {do
  =(fd (sys-open "/dev/snd" 0))
  =(regs (sys-read fd 256))
  (sys-close fd)
  (buffer regs)})

; A note's MIDI number, by its name: a letter, # or b, an octave (C4 60, C#4 and Db4 61, A4 69, B-1 11)
(fun {snd.bad} {error "'note-of' expects a note: C4, C#4, Db4 ..." :inval})
(fun {note-of name} {do
  (if (< (len name) 2) (snd.bad)
    (do
      =(semi (index-of "C.D.EF.G.A.B" (str-upper (substring name 0 1))))
      =(sh (index-of "b.#" (substring name 1 1)))
      =(at (if (>= sh 0) 2 1))
      =(oct (try (val (substring name at (- (len name) at))) NIL))
      (if (and (>= semi 0) (not (== (substring name 0 1) ".")) (num? oct))
        (+ (* 12 (+ oct 1)) semi (if (>= sh 0) (- sh 1) 0))
        (snd.bad))))})

; A tune played on the channel (0 if it isn't given) at a tempo (beats a minute: 120): a list of notes, each a note
; (a name, a number, or NIL for a rest) and its beats.  Each is keyed on at its beat, in step with the system's tick
; (from the next but one, so the first isn't late), the one before keyed off just before it; the same work before
; each, so they keep time
(fun {tune notes} {do
  =(ch ?(&_ (fst &_) 0))
  =(tempo ?((> (len &_) 1) (snd &_) 120))
  =(ns (map (fn {n} {list (snd.num (fst n)) (snd n)}) notes))
  (snd-off ch)
  (snd.tune ch ns (+ (ticks) 2) 0 (/ (* 60 (tick-rate)) tempo))})
(fun {snd.num n} {if (num? n) n (if (nil? n) NIL (note-of n))})
(fun {snd.tune ch notes t0 at per} {do
  (sleep-until (bit-and (+ t0 (truncate (* at per))) 65535))
  (snd-off ch)
  (if notes
    (do (if (fst (fst notes)) (snd-note ch (fst (fst notes))) NIL)
      (snd.tune ch (tail notes) t0 (+ at (snd (fst notes))) per))
    NIL)})

; A song (a ZSM file) played, times times (1 if it isn't given): play's (the program); its exit code
(fun {play path} {if &_ (run "play" path (to-str (- (fst &_) 1))) (run "play" path)})

; A line of MML (the score language's: play -m) on the channel, its own instrument if it names none, played to its
; end; a chord (play -c): its notes at once, a channel each from ch, with the commands before each.  play's exit code
(fun {snd-mml ch mml} {run "play" "-m" (to-str ch) mml})
(fun {snd-chord ch notes} {run "play" "-c" (to-str ch) notes})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; profile.hl - what hylang -l runs as it starts, after its namespace (login.hl): what /rom/lib/profile does for rc.
; Through the /lib union, a /lib/hylang/profile.hl on the RAM disk or a card takes the place of this one (the ROM's).
; $window is its window (init's, wstart's): its console goes at /dev, and its notes (Ctrl-C) to hylang's note group.

(use "shell")              ; The shell: an rc command line at the prompt; cd, bind, mount, unmount, newns, the prompt

(do
  =(w (env "window"))
  (if (and w (not (== w "0")))
    (do (unmount "/dev" "#c") (bind (+ "#c" w) "/dev" :after))
    NIL))
(dev.write "/dev/consctl" "group")
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; screen.dl - the terminal's screen, by ANSI's sequences (the Hydra's console is a terminal, and so is a PC's
; window): (use "screen").  Columns and rows count from 1, as the terminal's do.

(def {screen.colors} {:black :red :green :yellow :blue :magenta :cyan :white})

; A sequence: ESC [ and its text
(fun {screen.csi s} {write "\e[" s})

; The screen cleared, the cursor at its top left
(fun {cls} {do (screen.csi "2J") (screen.csi "H")})

; The cursor at a column and row
(fun {at col row} {screen.csi (format "{};{}H" row col)})

; The rest of the line cleared
(fun {clear-line} {screen.csi "K"})

; Colours (an atom of screen.colors): the text's, and its background's if given
(fun {color fg} {do
  =(f (index-of screen.colors fg))
  ?((< f 0) (error (format "{} isn't a colour" fg)) NIL)
  ?((defined? &1)
    (do
      =(b (index-of screen.colors &1))
      ?((< b 0) (error (format "{} isn't a colour" &1)) (screen.csi (format "{};{}m" (+ 30 f) (+ 40 b)))))
    (screen.csi (format "{}m" (+ 30 f))))
})

; Bold, and back to plain text (no colour)
(fun {bold} {screen.csi "1m"})
(fun {plain} {screen.csi "0m"})

; The cursor hidden, or shown
(fun {cursor-off} {screen.csi "?25l"})
(fun {cursor-on} {screen.csi "?25h"})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀; shell.hl - hylang as a shell (docs/design/hylang.md, "The prompt"): (use "shell"), as hylang -l's profile does.  At the
; prompt a line that starts with (, {, [, or a prefix right against ( or { (?(, =(, #( ...) is hylang's; any other is
; an rc command line, which the REPL hands to shell-line: run whole by rc (rc -c) and waited for, its code status
; (and $status, rc's, in the environment, so the next line's rc has it).  So pipes, redirections, globbing, quoting
; and $x are rc's; each line is an rc of its own, so what one sets (a variable, a function) goes with it, as in
; HyForth's shell.  A line ending in & isn't waited for: its task is $apid, in a note group of its own.  What an rc
; line can't do to hylang (it runs in a task of its own: hylang's directory and namespace stay as they were) is done
; here when it's the line's one command, its arguments parsed as rc's built-ins do ('...' quotes, '' in it a ';
; $name, the environment's variable, its first word): cd, bind, mount, unmount, newns; and exit ends hylang (its code
; status, or the one given).  Ctrl-C while rc runs is rc's (on-note's function takes it meanwhile), and the shell
; goes on.  The prompt is shell-prompt's: the directory (under /sd/N, N: and the path on the card) and "> ".

(use "dev")

(def {status} 0)
(def {shell.running} NIL)

; The prompt: /rom/lib> , 0:/games>
(fun {shell-prompt} {do
  =(d (cwd))
  =(card (and (>= (len d) 5) (== (substring d 0 4) "/sd/") (or (== (len d) 5) (== (substring d 5 1) "/"))))
  (+ (if card (+ (substring d 4 1) ":" (if (== (len d) 5) "/" (substring d 5 (- (len d) 5)))) d) "> ")})

; An rc command line typed at the prompt (the REPL's: an expression's first line that isn't hylang's).  A failure of
; the shell's own is said as rc says its ("/none: not found")
(fun {shell-line line} {do
  (try (shell.do line) (do (print &err) NIL))
  (set! {shell.running} NIL)
  NIL})

(fun {shell.do line} {do
  =(cmd (fst (str-split line " ")))
  (if (and (elem? cmd {"cd" "bind" "mount" "unmount" "newns" "exit"}) (shell.simple? line))
    (shell.builtin (shell.words line))
    (if (== (substring line (- (len line) 1) 1) "&")
      (shell.bg (str-trim (substring line 0 (- (len line) 1))))
      (shell.fg line)))})

; A line with no rc syntax but words and quotes: one command
(fun {shell.simple? line} {not (any? (fn {c} {elem? c (str-chars ";|&<>`{}()^=")}) (str-chars line))})

; ---- rc's lines

; Run, and waited for (Ctrl-C meanwhile rc's)
(fun {shell.fg line} {shell.waitfor (sys-spawn "/bin/rc" (list "-c" line))})
(fun {shell.waitfor tk} {do (set! {shell.running} T) (shell.ended (shell.wait tk))})
(fun {shell.wait tk} {try (sys-wait tk) (if (eq &code :intr) (shell.wait tk) (error &err &code))})

; Its end: status its code (its message's number, if it has one), $status its message (or its code); after Ctrl-C,
; a new line
(fun {shell.ended r} {do
  (set! {shell.running} NIL)
  =(code (snd r))
  =(msg (thd r))
  (set! {status} (if (> (len msg) 0) (try (val msg) code) code))
  (setenv "status" (if (> (len msg) 0) msg (if (== code 0) "" (to-str code))))
  (if (== msg "interrupt") (write "\n") NIL)                    ; (A new line, as rc gives)
  NIL})

; Run, not waited for, in a note group of its own (SPAWN_NEWGROUP): its task $apid
(fun {shell.bg line} {do
  (setenv "apid" (to-str (sys-spawn "/bin/rc" (list "-c" line) 1)))
  NIL})

; Ctrl-C while rc runs: rc's
(on-note (fn {n} {and shell.running (eq n :interrupt)}))

; ---- What rc can't do to hylang

(fun {shell.builtin w} {do
  =(cmd (fst w))
  =(a (tail w))
  (if (== cmd "cd") (shell.cd a)
  (if (== cmd "exit") (exit (if a (val (fst a)) status))
  (if (== cmd "newns") (if a (shell.usage "newns") (do (newns) NIL))
  (if (== cmd "unmount") (shell.unmount a)
  (shell.bindmount cmd a)))))})

(fun {shell.usage text} {error (+ "usage: " text)})

; cd [dir]: none, $home (or /)
(fun {shell.cd a} {do
  =(h (env "home"))
  (if (nil? a) (cd (if h (shell.first h) "/")) (if (tail a) (shell.usage "cd [dir]") (cd (fst a))))
  NIL})

; bind [-abc] new old; mount [-abc] '#x' old [spec]: -a after, -b before, -c create
(fun {shell.bindmount cmd a} {do
  =(o (shell.opts a {}))
  =(fl (fst o))
  =(r (snd o))
  =(u (if (== cmd "bind") "bind [-abc] new old" "mount [-abc] '#x' old [spec]"))
  (if (or (elem? :bad fl) (< (len r) 2) (> (len r) ?((== cmd "bind") 2 3))) (shell.usage u)
    (eval (join (list ?((== cmd "bind") bind mount) (fst r) (snd r)) (tail (tail r)) fl)))
  NIL})
(fun {shell.opts a fl} {if (and a (> (len (fst a)) 1) (== (substring (fst a) 0 1) "-"))
  (shell.opts (tail a) (join fl (map shell.flag (tail (str-chars (fst a))))))
  (list fl a)})
(fun {shell.flag c} {do =(i (index-of "abc" (to-str c))) (if (< i 0) :bad (nth i {:after :before :create}))})

; unmount [new] old
(fun {shell.unmount a} {do
  (if (== (len a) 1) (unmount (fst a))
    (if (== (len a) 2) (unmount (snd a) (fst a)) (shell.usage "unmount [new] old")))
  NIL})

; ---- A line's words, as rc's built-ins have them: blanks between them; '...' quotes ('' in it a '); $name, the
; environment's variable (its first word)

(fun {shell.word# /rom/lib/namespace: the default namespace (docs/design/reimplementation-from-scratch.md, appendix E).  init runs it as
# it starts, and a card's /lib/namespace after it.  A line a bind or a mount, as rc's built-ins take them:
#   bind [-a | -b] [-c] new old         new at old (-a after what's there, -b before it; -c: creates go there)
#   mount [-a | -b] [-c] dev old [spec] a device's server at old, with a spec
# $task is the shell's task.  The lines for the devices still to come are kept here, commented out, with the
# phase that brings them.

# the root and the devices
bind '#/' /
bind -a '#c' /dev           # cons consctl ser serctl
bind -a '#n' /dev           # null zero kmesg
bind -a '#t' /dev           # ticks
bind '#g' /dev/gpio         # 0-7 port ctl ca1: the VIA's port A on J27
bind '#i' /dev/i2c          # ctl, and a file each I2C device on PA0 and PA1
bind -a '#a' /dev           # snd sndctl bell psg
bind '#v' /dev/vid          # ctl term vram pal sprites font frame psg pcm pcmctl: the Vera X (none without a card)
bind '#d' /dev/sd
bind '#S' /dev/spi
bind '#m' /dev/mod
bind '#s' /dev/seg          # shared segments by name: ctl (name NAME N, free NAME), a file a name
mount '#e' /env            # the environment
mount '#p' /proc

# the disks
mount '#f' /sd              # the cards: /sd/0 ... /sd/f
mount '#f' /rom x           # the ROM disk
mount '#f' /sram s          # the shared RAM disk
mount -c '#f' /ram r/$task  # this shell's own area of the RAM disk

# programs and libraries: unions, the caches first
bind -c /ram/bin /bin
bind -a /sram/bin /bin
bind -a /sd/0/bin /bin      # (added only if the card has one)
bind -a /rom/bin /bin       # programs on the ROM disk (RAM programs: mkfs ...)
bind -a '#m/bin' /bin       # the ROM's program modules
bind -c /ram/lib /lib
bind -a /sram/lib /lib
bind -a /sd/0/lib /lib
bind -a /rom/lib /lib

# the PC
mount '#P' /pc              # a folder on the PC, through the serial port (the PC tool)
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀# /rom/lib/profile: what each shell runs as it starts (rc -l: after newns), before its first prompt.  $window is
# its window (init's: the kernel starts init for each window): its console goes at /dev, and its notes (Ctrl-C) to
# the shell's note group.

prompt=('% ' '	')
if(~ $#window 0) window=0
if(! ~ $window 0){
	unmount '#c' /dev
	bind -a '#c'^$window /dev
}
echo -n group >/dev/consctl
