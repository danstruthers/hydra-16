require search.fl            \ (library)
library hydra

\ ---- constants
$01 constant abi_version     \ The ABI version this include describes
$C8 constant tick_hz         \ Ticks a second
$350 constant task_args       \ A task's arguments: zero-terminated strings, an empty one after the last (176
$B0 constant args_max        \ SPAWN's arguments: their bytes at most (each string's 0, and the empty one that
$230 constant task_name       \ A task's name, zero-terminated
$01 constant ht_program      \ HYX2 module types
$02 constant ht_driver       \
$03 constant ht_library      \
$01 constant hf_inplace      \ HYX2 flags: runs in place in the paged ROM
$02 constant hf_boot         \ HYX2 flags: a driver the kernel starts at boot
$00 constant me_bank         \ MODINFO's answer (ME_SIZE bytes): the module's first paged ROM bank
$01 constant me_banks        \ MODINFO: the banks it spans
$02 constant me_type         \ MODINFO: its type (HT_*)
$03 constant me_flags        \ MODINFO: its flags (HF_*)
$04 constant me_name         \ MODINFO: its name (12 bytes, zero-padded)
$10 constant me_size         \
$00 constant ti_state        \ TASKINFO's answer: the task's state (0: free, 1 ready, 2 wait, 3 call, 4 idle,
$01 constant ti_flags        \ TASKINFO: its flags (TF_DRIVER, TF_STOPPED)
$01 constant tf_driver       \ TI_FLAGS: a driver
$80 constant tf_stopped      \ TI_FLAGS: stopped (/proc's ctl: TASKSTOP)
$02 constant ti_parent       \ TASKINFO: its parent ($FF: none)
$03 constant ti_cpu          \ TASKINFO: its CPU time, in ticks (3 bytes)
$06 constant ti_bank         \ TASKINFO: its module's paged ROM bank ($FF: none)
$07 constant ti_type         \ TASKINFO: its module's type (HT_*; 0: none)
$08 constant ti_name         \ TASKINFO: its name, zero-terminated (16 bytes)
$18 constant ti_group        \ TASKINFO: its note group
$19 constant ti_size         \ TASKINFO: the answer's size
$01 constant note_interrupt  \ Notes: Ctrl-C (default: the end, 130)
$02 constant note_kill       \ Notes: kill, never caught (137)
$03 constant note_hangup     \ Notes: hangup (129)
$04 constant note_alarm      \ Notes: alarm (142)
$05 constant note_brk        \ Notes: sys: brk, a BRK instruction (133)
$10 constant note_user       \ Notes: 16-31 are the programs' own (128 + the note)
$80 constant note_group      \ NOTE's .A: a note group, not a task
$01 constant sem_mutex       \ SEM_NEW's .X: a mutex (its count 1, given back only by its holder)
$01 constant reboot_hwtest   \ REBOOT's .A: into the hardware test
