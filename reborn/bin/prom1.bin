: run-while ( -- n ) 4000 1000 size b-while ;
: run-dotimes ( -- n ) 4000 1000 size b-dotimes ;
: run-nested ( -- n ) 60 30 size b-nested ;
: run-gcd ( -- n ) 20 10 size b-gcds ;
