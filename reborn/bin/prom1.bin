: run-digits ( -- n ) 1000 300 size b-digits ;

' run-calls s" calls" bench
' run-fib s" fib" bench
' run-tak s" tak" bench
' run-ack s" ack" bench
' run-loop s" loop" bench
' run-while s" while" bench
' run-dotimes s" dotimes" bench
' run-nested s" nested" bench
