# KiCad's own files next to a project (board/ is edited in KiCad: these are its backups, locks and caches)
*-backups/
~*.lck
fp-info-cache

# The build's work files (os_rom/.gitignore, programs/.gitignore have the rest)
node_modules/

# The manual's HTML (manual/build.js: the PDF's source, made again with it)
manual/hydra-16-manual.html
manual/companion/hydra-16-companion.html
manual/educator/hydra-16-course-guide.html
manual/reference/hydra-16-reference.html
